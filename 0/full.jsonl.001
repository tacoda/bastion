{"parentUuid":"e30ef374-3019-4d39-add7-c7b451aef59e","isSidechain":false,"attachment":{"type":"file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-spikes/examples/n8_gate.rs","content":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-spikes/examples/n8_gate.rs","content":"//! N8 (PLAN.md A5): can a `pre-trigger` hook deny one call and hold another,\n//! and can the app release a held call later?\n//!\n//! The hook denies `sandbox::fs::ls` with a reason, and holds `sandbox::exec`.\n//! The spike then releases the held call with `harness::function::resolve`\n//! (mode `execute`) and checks that the command ran and the turn finished.\n//!\n//! Paid: one short turn, about $0.01 on gpt-5-mini. Run against the stack:\n//! `cargo run -p bastion-spikes --example n8_gate`.\n\n#![allow(deprecated)]\n\nuse std::time::Duration;\n\nuse anyhow::Context;\nuse bastion_spikes::{Checks, call, call_default, connect, ensure};\nuse iii_sdk::protocol::RegisterTriggerInput;\nuse iii_sdk::{Error, RegisterFunction};\nuse serde_json::{Value, json};\nuse tokio::sync::mpsc;\nuse tokio::time::timeout;\n\n#[tokio::main]\nasync fn main() {\n    let iii = connect(\"spike-n8\");\n    let mut checks = Checks::default();\n    let tag = uuid::Uuid::new_v4().simple().to_string()[..8].to_string();\n    let session_id = format!(\"s_spike_n8_{tag}\");\n\n    let box_id = call_default(\n        &iii,\n        \"sandbox::create\",\n        json!({ \"image\": \"python\", \"network\": false, \"idle_timeout_secs\": 600 }),\n        120_000,\n    )\n    .await\n    .expect(\"sandbox::create\")[\"sandbox_id\"]\n        .as_str()\n        .expect(\"sandbox_id\")\n        .to_string();\n\n    let (held_tx, mut held) = mpsc::channel::<Value>(4);\n    let pinned = box_id.clone();\n    iii.register_function(\n        \"bastion::spike::n8::gate\",\n        RegisterFunction::new_async(move |envelope: Value| {\n            let (held_tx, pinned) = (held_tx.clone(), pinned.clone());\n            async move {\n                let function = envelope[\"call\"][\"function_id\"].as_str().unwrap_or_default().to_string();\n                let mut arguments = envelope[\"call\"][\"arguments\"].clone();\n                arguments[\"sandbox_id\"] = json!(pinned);\n                let answer = match function.as_str() {\n                    \"sandbox::fs::ls\" => json!({ \"decision\": \"deny\", \"reason\": \"n8: listing is not allowed in this stage\" }),\n                    \"sandbox::exec\" => {\n                        let _ = held_tx.send(envelope.clone()).await;\n                        json!({ \"decision\": \"hold\", \"reason\": \"n8: waiting for the owner\", \"mutations\": { \"arguments\": arguments } })\n                    }\n                    _ => json!({ \"decision\": \"continue\", \"mutations\": { \"arguments\": arguments } }),\n                };\n                Ok::<_, Error>(answer)\n            }\n        }),\n    );\n    let (done_tx, mut done) = mpsc::channel::<Value>(1);\n    iii.register_function(\n        \"bastion::spike::n8::done\",\n        RegisterFunction::new_async(move |event: Value| {\n            let done_tx = done_tx.clone();\n            async move {\n                let _ = done_tx.send(event).await;\n                Ok::<_, Error>(json!({}))\n            }\n        }),\n    );\n    let _ = iii.wait_until_registered(Duration::from_secs(5)).await;\n\n    checks\n        .run(\"a hook denies one call, holds another, and the app releases it\", async {\n            let hook = iii.register_trigger(RegisterTriggerInput::new(\n                \"harness::hook::pre-trigger\",\n                \"bastion::spike::n8::gate\",\n                json!({ \"functions\": [\"sandbox::*\"], \"on_error\": \"fail_closed\", \"timeout_ms\": 5000 }),\n            ))?;\n            let turn_done = iii.register_trigger(RegisterTriggerInput::new(\n                \"harness::turn-completed\",\n                \"bastion::spike::n8::done\",\n                json!({ \"session_id\": session_id }),\n            ))?;\n            call(&iii, \"approval::set-mode\", json!({ \"session_id\": session_id, \"mode\": \"full\" })).await?;\n            call(&iii, \"harness::send\", json!({\n                \"session_id\": session_id, \"model\": \"gpt-5-mini\", \"provider\": \"openai\",\n                \"message\": \"Make exactly these two calls through agent_trigger, in order, without checking first. 1) sandbox::fs::ls with {\\\"sandbox_id\\\": \\\"job\\\", \\\"path\\\": \\\"/\\\"}. 2) sandbox::exec with {\\\"sandbox_id\\\": \\\"job\\\", \\\"argv\\\": [\\\"echo\\\", \\\"n8-ran\\\"]}. Make call 2 even if call 1 fails. Then report exactly what each call returned, and reply DONE.\",\n                \"options\": { \"max_turns\": 6, \"functions\": { \"allow\": [\"sandbox::fs::ls\", \"sandbox::exec\"] } },\n            })).await?;\n\n            let envelope = timeout(Duration::from_secs(180), held.recv()).await?.context(\"the exec was never held\")?;\n            println!(\"held envelope keys: {:?}\", envelope.as_object().map(|o| o.keys().collect::<Vec<_>>()));\n            println!(\"held call: {}\", serde_json::to_string(&envelope[\"call\"]).unwrap_or_default());\n            let status = call(&iii, \"harness::status\", json!({ \"session_id\": session_id, \"verbose\": true })).await?;\n            println!(\"status while held: {}\", status[\"status\"]);\n            let call_id = envelope[\"call\"][\"call_id\"].as_str()\n                .or(envelope[\"call\"][\"function_call_id\"].as_str())\n                .or(envelope[\"call\"][\"id\"].as_str())\n                .unwrap_or_default().to_string();\n            // The owner approved: the app runs the call itself, pinned to the VM,\n            // and delivers its result to the parked turn.\n            let mut arguments = envelope[\"call\"][\"arguments\"].clone();\n            arguments[\"sandbox_id\"] = json!(box_id);\n            let ran = call_default(&iii, \"sandbox::exec\", arguments, 60_000).await?;\n            let released = call(&iii, \"harness::function::resolve\", json!({\n                \"session_id\": session_id, \"turn_id\": envelope[\"turn_id\"], \"function_call_id\": call_id, \"action\": \"deliver\",\n                \"content\": [{ \"type\": \"text\", \"text\": ran.to_string() }], \"details\": ran, \"is_error\": false,\n            })).await;\n            println!(\"resolve: {released:?}\");\n            released?;\n\n            timeout(Duration::from_secs(180), done.recv()).await?.context(\"turn-completed never fired\")?;\n            hook.unregister();\n            turn_done.unregister();\n            let messages = call(&iii, \"session::messages\", json!({ \"session_id\": session_id })).await?;\n            let results: Vec<String> = messages[\"messages\"].as_array().into_iter().flatten()\n                .filter(|m| m[\"message\"][\"role\"] == \"function_result\")\n                .map(|m| m[\"message\"][\"content\"].to_string())\n                .collect();\n            for r in &results {\n                println!(\"result: {}\", &r[..r.len().min(300)]);\n            }\n            ensure(results.iter().any(|r| r.contains(\"not allowed in this stage\")), \"the deny reason never reached the turn\")?;\n            ensure(results.iter().any(|r| r.contains(\"n8-ran\")), \"the released exec never ran\")?;\n            Ok(format!(\"{} results; denied ls, held then released exec\", results.len()))\n        })\n        .await;\n\n    let _ = call_default(\n        &iii,\n        \"sandbox::stop\",\n        json!({ \"sandbox_id\": box_id, \"wait\": true }),\n        60_000,\n    )\n    .await;\n    checks.finish(iii)\n}\n","numLines":143,"startLine":1,"totalLines":143}},"displayPath":"crates/bastion-spikes/examples/n8_gate.rs"},"type":"attachment","uuid":"ee757fc4-5400-495d-a129-1b4ba54509e7","timestamp":"2026-10-31T05:14:17.340Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/tacoda/tacoda/bastion/crates/bastion-spikes/examples/n8_gate.rs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t//! N8 (PLAN.md A5): can a `pre-trigger` hook deny one call and hold another,\n2\t//! and can the app release a held call later?\n3\t//!\n4\t//! The hook denies `sandbox::fs::ls` with a reason, and holds `sandbox::exec`.\n5\t//! The spike then releases the held call with `harness::function::resolve`\n6\t//! (mode `execute`) and checks that the command ran and the turn finished.\n7\t//!\n8\t//! Paid: one short turn, about $0.01 on gpt-5-mini. Run against the stack:\n9\t//! `cargo run -p bastion-spikes --example n8_gate`.\n10\t\n11\t#![allow(deprecated)]\n12\t\n13\tuse std::time::Duration;\n14\t\n15\tuse anyhow::Context;\n16\tuse bastion_spikes::{Checks, call, call_default, connect, ensure};\n17\tuse iii_sdk::protocol::RegisterTriggerInput;\n18\tuse iii_sdk::{Error, RegisterFunction};\n19\tuse serde_json::{Value, json};\n20\tuse tokio::sync::mpsc;\n21\tuse tokio::time::timeout;\n22\t\n23\t#[tokio::main]\n24\tasync fn main() {\n25\t    let iii = connect(\"spike-n8\");\n26\t    let mut checks = Checks::default();\n27\t    let tag = uuid::Uuid::new_v4().simple().to_string()[..8].to_string();\n28\t    let session_id = format!(\"s_spike_n8_{tag}\");\n29\t\n30\t    let box_id = call_default(\n31\t        &iii,\n32\t        \"sandbox::create\",\n33\t        json!({ \"image\": \"python\", \"network\": false, \"idle_timeout_secs\": 600 }),\n34\t        120_000,\n35\t    )\n36\t    .await\n37\t    .expect(\"sandbox::create\")[\"sandbox_id\"]\n38\t        .as_str()\n39\t        .expect(\"sandbox_id\")\n40\t        .to_string();\n41\t\n42\t    let (held_tx, mut held) = mpsc::channel::<Value>(4);\n43\t    let pinned = box_id.clone();\n44\t    iii.register_function(\n45\t        \"bastion::spike::n8::gate\",\n46\t        RegisterFunction::new_async(move |envelope: Value| {\n47\t            let (held_tx, pinned) = (held_tx.clone(), pinned.clone());\n48\t            async move {\n49\t                let function = envelope[\"call\"][\"function_id\"].as_str().unwrap_or_default().to_string();\n50\t                let mut arguments = envelope[\"call\"][\"arguments\"].clone();\n51\t                arguments[\"sandbox_id\"] = json!(pinned);\n52\t                let answer = match function.as_str() {\n53\t                    \"sandbox::fs::ls\" => json!({ \"decision\": \"deny\", \"reason\": \"n8: listing is not allowed in this stage\" }),\n54\t                    \"sandbox::exec\" => {\n55\t                        let _ = held_tx.send(envelope.clone()).await;\n56\t                        json!({ \"decision\": \"hold\", \"reason\": \"n8: waiting for the owner\", \"mutations\": { \"arguments\": arguments } })\n57\t                    }\n58\t                    _ => json!({ \"decision\": \"continue\", \"mutations\": { \"arguments\": arguments } }),\n59\t                };\n60\t                Ok::<_, Error>(answer)\n61\t            }\n62\t        }),\n63\t    );\n64\t    let (done_tx, mut done) = mpsc::channel::<Value>(1);\n65\t    iii.register_function(\n66\t        \"bastion::spike::n8::done\",\n67\t        RegisterFunction::new_async(move |event: Value| {\n68\t            let done_tx = done_tx.clone();\n69\t            async move {\n70\t                let _ = done_tx.send(event).await;\n71\t                Ok::<_, Error>(json!({}))\n72\t            }\n73\t        }),\n74\t    );\n75\t    let _ = iii.wait_until_registered(Duration::from_secs(5)).await;\n76\t\n77\t    checks\n78\t        .run(\"a hook denies one call, holds another, and the app releases it\", async {\n79\t            let hook = iii.register_trigger(RegisterTriggerInput::new(\n80\t                \"harness::hook::pre-trigger\",\n81\t                \"bastion::spike::n8::gate\",\n82\t                json!({ \"functions\": [\"sandbox::*\"], \"on_error\": \"fail_closed\", \"timeout_ms\": 5000 }),\n83\t            ))?;\n84\t            let turn_done = iii.register_trigger(RegisterTriggerInput::new(\n85\t                \"harness::turn-completed\",\n86\t                \"bastion::spike::n8::done\",\n87\t                json!({ \"session_id\": session_id }),\n88\t            ))?;\n89\t            call(&iii, \"approval::set-mode\", json!({ \"session_id\": session_id, \"mode\": \"full\" })).await?;\n90\t            call(&iii, \"harness::send\", json!({\n91\t                \"session_id\": session_id, \"model\": \"gpt-5-mini\", \"provider\": \"openai\",\n92\t                \"message\": \"Make exactly these two calls through agent_trigger, in order, without checking first. 1) sandbox::fs::ls with {\\\"sandbox_id\\\": \\\"job\\\", \\\"path\\\": \\\"/\\\"}. 2) sandbox::exec with {\\\"sandbox_id\\\": \\\"job\\\", \\\"argv\\\": [\\\"echo\\\", \\\"n8-ran\\\"]}. Make call 2 even if call 1 fails. Then report exactly what each call returned, and reply DONE.\",\n93\t                \"options\": { \"max_turns\": 6, \"functions\": { \"allow\": [\"sandbox::fs::ls\", \"sandbox::exec\"] } },\n94\t            })).await?;\n95\t\n96\t            let envelope = timeout(Duration::from_secs(180), held.recv()).await?.context(\"the exec was never held\")?;\n97\t            println!(\"held envelope keys: {:?}\", envelope.as_object().map(|o| o.keys().collect::<Vec<_>>()));\n98\t            println!(\"held call: {}\", serde_json::to_string(&envelope[\"call\"]).unwrap_or_default());\n99\t            let status = call(&iii, \"harness::status\", json!({ \"session_id\": session_id, \"verbose\": true })).await?;\n100\t            println!(\"status while held: {}\", status[\"status\"]);\n101\t            let call_id = envelope[\"call\"][\"call_id\"].as_str()\n102\t                .or(envelope[\"call\"][\"function_call_id\"].as_str())\n103\t                .or(envelope[\"call\"][\"id\"].as_str())\n104\t                .unwrap_or_default().to_string();\n105\t            // The owner approved: the app runs the call itself, pinned to the VM,\n106\t            // and delivers its result to the parked turn.\n107\t            let mut arguments = envelope[\"call\"][\"arguments\"].clone();\n108\t            arguments[\"sandbox_id\"] = json!(box_id);\n109\t            let ran = call_default(&iii, \"sandbox::exec\", arguments, 60_000).await?;\n110\t            let released = call(&iii, \"harness::function::resolve\", json!({\n111\t                \"session_id\": session_id, \"turn_id\": envelope[\"turn_id\"], \"function_call_id\": call_id, \"action\": \"deliver\",\n112\t                \"content\": [{ \"type\": \"text\", \"text\": ran.to_string() }], \"details\": ran, \"is_error\": false,\n113\t            })).await;\n114\t            println!(\"resolve: {released:?}\");\n115\t            released?;\n116\t\n117\t            timeout(Duration::from_secs(180), done.recv()).await?.context(\"turn-completed never fired\")?;\n118\t            hook.unregister();\n119\t            turn_done.unregister();\n120\t            let messages = call(&iii, \"session::messages\", json!({ \"session_id\": session_id })).await?;\n121\t            let results: Vec<String> = messages[\"messages\"].as_array().into_iter().flatten()\n122\t                .filter(|m| m[\"message\"][\"role\"] == \"function_result\")\n123\t                .map(|m| m[\"message\"][\"content\"].to_string())\n124\t                .collect();\n125\t            for r in &results {\n126\t                println!(\"result: {}\", &r[..r.len().min(300)]);\n127\t            }\n128\t            ensure(results.iter().any(|r| r.contains(\"not allowed in this stage\")), \"the deny reason never reached the turn\")?;\n129\t            ensure(results.iter().any(|r| r.contains(\"n8-ran\")), \"the released exec never ran\")?;\n130\t            Ok(format!(\"{} results; denied ls, held then released exec\", results.len()))\n131\t        })\n132\t        .await;\n133\t\n134\t    let _ = call_default(\n135\t        &iii,\n136\t        \"sandbox::stop\",\n137\t        json!({ \"sandbox_id\": box_id, \"wait\": true }),\n138\t        60_000,\n139\t    )\n140\t    .await;\n141\t    checks.finish(iii)\n142\t}\n143\t\n</system-reminder>"}],"renderedRole":"system","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
