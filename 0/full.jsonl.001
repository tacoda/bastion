udit(&entry).await?;"]},{"oldStart":831,"oldLines":8,"newStart":831,"newLines":8,"lines":["             detail: detail.into(),","         };","         tauri::async_runtime::block_on(async {","-            let first = super::record(&store, 1, what(\"continue\")).await.unwrap();","-            let second = super::record(&store, 2, what(\"hold\")).await.unwrap();","+            let first = write_audit(&store, 1, what(\"continue\")).await.unwrap();","+            let second = write_audit(&store, 2, what(\"hold\")).await.unwrap();","             assert_eq!((first.seq, second.prev.as_str()), (1, first.hash.as_str()));","             assert_eq!(audit::verify(&store.audit().await.unwrap()), Ok(()));","             assert!(store.append_audit(&second).await.is_err());"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/src-tauri/src/store.rs"]}},"serverClassifierContext":{"request":"a4f21a77-f329-4ee8-852e-940d5e13d30a","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"d2a84ea5-3bda-46b4-9443-6f1358276971","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
