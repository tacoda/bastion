ry, Message::Servers),","+                ]);","+            }","+            Message::Servers(Ok(all)) => {","                 self.servers = all;","-                return self.go(self.route.clone());","+                return self.page.reload(&self.ctx(), true);","             }","+            Message::Servers(Err(why)) => self.problem = Some(why),","             Message::Started(Err(why)) => self.problem = Some(why),","             Message::Go(route) => return self.go(route),","             Message::Choose(name) => {"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/jobs.rs","hunks":[{"oldStart":48,"oldLines":9,"newStart":48,"newLines":7,"lines":[" "," async fn read_all(ctx: Ctx, before: Vec<ServerJob>) -> (Vec<ServerJob>, Vec<String>) {","     let (mut all, mut errors) = (Vec::new(), Vec::new());","-    let t = std::time::Instant::now();","     for s in &ctx.servers {","-        eprintln!(\"TIMING read {} at {:?}\", s.name, t.elapsed());","         let read = ctx","             .clone()","             .get::<Vec<JobSummary>>(s.name.clone(), Ask::bare(command::JOBS))"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/start.rs","hunks":[{"oldStart":46,"oldLines":17,"newStart":46,"newLines":18,"lines":["     )"," }"," ","-/// Start or attach to `local`, then list every server, `local` first.","-/// Blocks until `local` answers, so it runs off the window's thread.","-pub fn start() -> Result<Vec<Server>, String> {","+/// Start or attach to `local`. Blocks until it answers, so it runs off the","+/// window's thread.","+pub fn start() -> Result<Server, String> {","     let checkout = Path::new(CHECKOUT)","         .canonicalize()","         .map_err(|e| e.to_string())?;","     let profiles = Profiles::load_or_create(&config_dir().join(profile::FILE_NAME), checkout)?;","-    let t = std::time::Instant::now();","-    let local = local::start(profiles.active(), &data_dir().join(\"server\"))?;","-    eprintln!(\"TIMING local {:?}\", t.elapsed());","-    let all = servers(local).all();","-    eprintln!(\"TIMING servers {:?}\", t.elapsed());","-    all","+    local::start(profiles.active(), &data_dir().join(\"server\"))","+}","+","+/// Every server, `local` first. The added servers' tokens come from the","+/// Keychain, which can take seconds, so the window shows `local` first.","+pub fn every(local: Server) -> Result<Vec<Server>, String> {","+    servers(local).all()"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/app.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/jobs.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/start.rs"]}},"serverClassifierContext":{"request":"53533848-b92f-4624-817d-9acf9a5cafaf","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":6,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"76c03307-aacd-4414-884e-f993e90583f9","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
