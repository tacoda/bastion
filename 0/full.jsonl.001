ved);\n    let (j, effects) = run(&events);\n    assert_eq!((j.state, j.error, effects), (State::Running, None, vec![Effect::Land]));\n}\n'''\nopen(p,'w').write(s)\np='src-tauri/src/factory.rs'; s=open(p).read()\ni=s.index('&format!(\"origin/{branch}..HEAD\"),', s.index(\"async fn land\"))\ns=s[:i]+'&format!(\"origin/{branch}..{branch}\"),'+s[i+len('&format!(\"origin/{branch}..HEAD\"),'):]\nopen(p,'w').write(s)\nEOF\ngrep -n 'origin/{branch}' src-tauri/src/factory.rs; cargo fmt -p bastion-core -p bastion && cargo test -p bastion-core -q 2>&1 | grep -E \"test result|FAILED|panicked\"; cargo test -p bastion -q 2>&1 | grep -E \"test result: ok. [1-9]|FAILED|panicked\"","description":"Keep a failed land waiting; fix the bundle ref","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1369,"cache_read_input_tokens":894274,"output_tokens":1559,"output_tokens_details":{"thinking_tokens":395},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1369,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1559,"cache_read_input_tokens":894274,"cache_creation_input_tokens":1369,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1369},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01CsheQR8EUkbrH6d2CN5KCf":{"command":"cd /Users/tacoda/tacoda/bastion && python3 - <<'EOF'\np='crates/bastion-core/src/lib.rs'; s=open(p).read()\na='''        (State::Running, Event::LandFailed { error }) if next.stage == Stage::Land => {\n            fail(&mut next, error)\n        }'''\ns=s.replace(a,'''        // A failed land keeps the VM and its commits, and waits on the owner:\n        // approve 