`denied`, `ask` or `allowed`.","+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]","+pub struct CapabilityView {","+    pub stage: String,","+    pub function: String,","+    pub rung: String,","+}","+","+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]","+pub struct AuditEntryView {","+    pub seq: u64,","+    pub at: u64,","+    pub kind: String,","+    pub subject: String,","+    pub detail: String,","+    pub hash: String,","+}","+","+/// The audit chain and whether it verifies (PLAN.md D21).","+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]","+pub struct AuditView {","+    pub entries: Vec<AuditEntryView>,","+    /// The `seq` of the first entry that breaks the chain, if one does.","+    pub broken_at: Option<u64>,"," }"," "," /// How each checkpoint is decided (PLAN.md D15): `ask`, `hold` or `auto`."]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-protocol/src/lib.rs"]}},"serverClassifierContext":{"request":"f690f07b-83f7-4e15-a53a-9d996cf9ccf2","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"192a160e-71a0-4b25-bc8e-cffffde3584c","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
