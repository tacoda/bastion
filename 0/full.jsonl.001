{"type":"file-history-snapshot","messageId":"f86a7085-a0b2-4748-ba26-900c91a122db","snapshot":{"messageId":"f86a7085-a0b2-4748-ba26-900c91a122db","trackedFileBackups":{"PLAN.md":{"backupFileName":"f48547e572172251@v12","version":12,"backupTime":"2026-10-31T05:04:39.046Z","realParentDir":"/Users/tacoda/tacoda/bastion"},"/Users/tacoda/.claude/projects/-Users-tacoda-tacoda-bastion/memory/bastion-rust-app.md":{"backupFileName":"913a72beafce78fd@v6","version":6,"backupTime":"2026-10-31T04:40:54.665Z","realParentDir":"/Users/tacoda/.claude/projects/-Users-tacoda-tacoda-bastion/memory"},"docs/levels.md":{"backupFileName":"dabb04f9270940b1@v6","version":6,"backupTime":"2026-10-31T05:12:55.874Z","realParentDir":"/Users/tacoda/tacoda/bastion/docs"},"crates/bastion-protocol/Cargo.toml":{"backupFileName":"f920433400e701cd@v2","version":2,"backupTime":"2026-10-31T00:52:22.350Z","realParentDir":"/Users/tacoda/tacoda/bastion/crates/bastion-protocol"},"src-tauri/src/engine/iii.rs":{"backupFileName":"a5bdb3bf3bcfe7be@v4","version":4,"backupTime":"2026-10-31T01:46:33.195Z","realParentDir":"/Users/tacoda/tacoda/bastion/src-tauri/src/engine"},"crates/bastion-protocol/src/lib.rs":{"backupFileName":"b76d82b78e7a0f4e@v7","version":7,"backupTime":"2026-10-31T04:40:54.665Z","realParentDir":"/Users/tacoda/tacoda/bastion/crates/bastion-protocol/src"},"src-tauri/src/engine/fake.rs":{"backupFileName":"e587ee15c231e72e@v4","version":4,"backupTime":"2026-10-31T01:46:33.194Z","realParentDir":"/Users/tacoda/tacoda/bastion/src-tauri/src/engine"},"src-tauri/src/engine/mod.rs":{"backupFileName":"2d20b64a25ea1e95@v4","version":4,"backupTime":"2026-10-31T01:46:33.195Z","realParentDir":"/Users/tacoda/tacoda/bastion/src-tauri/src/engine"},"src-tauri/src/commands/engine.rs":{"backupFileName":"52ccd1f5ee9bf850@v2","version":2,"backupTime":"2026-10-31T00:52:22.349Z","realParentDir":"/Users/tacoda/tacoda/bastion/src-tauri/src/commands"},"src-tauri/src/lib.rs":{"backupFileName":"c21cf981970ebd6a@v7","version":