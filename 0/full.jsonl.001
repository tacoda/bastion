{"type":"mode","mode":"normal","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48"}
{"type":"permission-mode","permissionMode":"auto","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48"}
