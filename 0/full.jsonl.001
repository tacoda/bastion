{"parentUuid":"6059760f-b9df-4432-bd4f-cee7e614b6b2","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgaUw5axKcjGzmXi5LCab","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"For step 2 I'll add four tables (constraints, capabilities, held_calls, audit) with Store methods for each, seeding defaults on open and keeping the fake in step. The audit table's seq primary key will reject any forked chain.\n\n","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8585,"cache_read_input_tokens":112095,"output_tokens":8048,"output_tokens_details":{"thinking_tokens":1107},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8585,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8048,"cache_read_input_tokens":112095,"cache_creation_input_tokens":8585,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8585},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"9d13f30b-a4e4-4b9a-8c10-b96daa6b5f58","apiBlockIndex":1,"requestId":"req_011CgaUw5LKgsVFADyCT9u2L","type":"assistant","uuid":"724f5130-ee14-46b3-9d3b-969f0c565cbf","timestamp":"2026-10-31T14:36:00.278Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
{"parentUuid":"724f5130-ee14-46b3-9d3b-969f0c565cbf","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgaUw5axKcjGzmXi5LCab","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VLEGamC3RxM1cwp6pCnY5q","name":"Bash","input":{"command":"python3 - <<'EOF'\np='src-tauri/src/store.rs'; s=open(p).read()\ndef rep(a,b):\n    global s\n    assert s.count(a)==1,a; s=s.replace(a,b)\n\nrep(\"\"\"//! (D8). `SqlStore` is the only code that writes SQL.\"\"\",\"\"\"//! (D8), and the governance rows of A5: constraints, capabilities, held\n//! calls and the audit chain. `SqlStore` is the only code that writes SQL.\"\"\")\nrep(\"use bastion_core::{Dial, Dials, Job, Stage};\",\"\"\"use bastion_core::audit::{self, Entry};\nuse bastion_core::govern::{self, Call, Capability, Constraint};\nuse bastion_core::{Dial, Dials, Job, Stage};\"\"\")\nrep(\"\"\"/// A save lost to another writer (D8).\"\"\",\"\"\"/// A call the gate held for the owner, with what is needed to run it later.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct HeldCall {\n    /// The harness's `function_call_id`.\n    pub id: String,\n    pub job: String,\n    pub session: String,\n    pub turn: String,\n    pub call: Call,\n    /// The call's arguments as the engine sent them, to run on approval.\n    pub arguments: Value,\n    pub at: u64,\n}\n\n/// A save lost to another writer (D8).\"\"\")\nrep(\"\"\"    fn set_dials<'a>(&'a self, dials: &'a Dials) -> Answer<'a, ()>;\n}\"\"\",\"\"\"    fn set_dials<'a>(&'a self, dials: &'a Dials) -> Answer<'a, ()>;\n    fn constraints(&self) -> Answer<'_, Vec<Constraint>>;\n    /// Add a constraint, or replace the one with its id.\n    fn set_constraint<'a>(&'a self, constraint: &'a Constraint) -> Answer<'a, ()>;\n    fn capabilities(&self) -> Answer<'_, Vec<Capability>>;\n    /// Add a grant, or replace the one for its stage and function.\n    fn set_capability<'a>(&'a self, grant: &'a Capability) -> Answer<'a, ()>;\n    fn hold<'a>(&'a self, call: &'a HeldCall) -> Answer<'a, ()>;\n    /// The calls held for a job, oldest first.\n    fn held<'a>(&'a self, job: &'a str) -> Answer<'a, Vec<HeldCall>>;\n    fn release<'a>(&'a self, id: &'a str) -> Answer<'a, ()>;\n    /// The whole audit chain, oldest first.\n    fn audit(&self) -> Answer<'_, Vec<Entry>>;\n    /// Add the next entry. A second entry with the same `seq` is refused, so\n    /// two writers cannot fork the chain.\n    fn append_audit<'a>(&'a self, entry: &'a Entry) -> Answer<'a, ()>;\n}\n\n/// Write the next audit entry after the last one in the store.\n// ponytail: reads the whole chain to find its tail; read only the last row when the chain grows large.\npub async fn record(store: &dyn Store, at: u64, what: audit::Record) -> Result<Entry, String> {\n    let chain = store.audit().await?;\n    let entry = audit::append(chain.last(), at, what);\n    store.append_audit(&entry).await?;\n    Ok(entry)\n}\"\"\")\nrep(\"\"\"const SCHEMA: [&str; 4] = [\"\"\",\"\"\"const SCHEMA: [&str; 8] = [\"\"\")\nrep(\"\"\"        dial TEXT NOT NULL CHECK (dial IN ('ask','hold','auto')))\",\n];\"\"\",\"\"\"        dial TEXT NOT NULL CHECK (dial IN ('ask','hold','auto')))\",\n    \"CREATE TABLE IF NOT EXISTS constraints (\n        id TEXT PRIMARY KEY CHECK (length(id) > 0),\n        rule TEXT NOT NULL CHECK (length(rule) > 0),\n        function TEXT NOT NULL,\n        contains TEXT NOT NULL,\n        rung TEXT NOT NULL CHECK (rung IN ('told','checked','enforced')),\n        source TEXT NOT NULL CHECK (source IN ('charter','owner')))\",\n    \"CREATE TABLE IF NOT EXISTS capabilities (\n        stage TEXT NOT NULL CHECK (stage IN ('plan','approve','build','review','land')),\n        function TEXT NOT NULL CHECK (length(function) > 0),\n        rung TEXT NOT NULL CHECK (rung IN ('denied','ask','allowed')),\n        PRIMARY KEY (stage, function))\",\n    // `arguments` is the engine's JSON, kept opaque to run the call later.\n    \"CREATE TABLE IF NOT EXISTS held_calls (\n        id TEXT PRIMARY KEY,\n        job TEXT NOT NULL REFERENCES jobs(id),\n        session TEXT NOT NULL,\n        turn TEXT NOT NULL,\n        function TEXT NOT NULL,\n        text TEXT NOT NULL,\n        arguments TEXT NOT NULL,\n        at INTEGER NOT NULL)\",\n    \"CREATE TABLE IF NOT EXISTS audit (\n        seq INTEGER PRIMARY KEY CHECK (seq >= 1),\n        at INTEGER NOT NULL,\n        kind TEXT NOT NULL,\n        subject TEXT NOT NULL,\n        detail TEXT NOT NULL,\n        prev TEXT NOT NULL CHECK (length(prev) = 64),\n        hash TEXT NOT NULL UNIQUE CHECK (length(hash) = 64))\",\n];\n\nconst UPSERT_CONSTRAINT: &str = \"INSERT INTO constraints (id, rule, function, contains, rung, source) VALUES (?, ?, ?, ?, ?, ?)\n    ON CONFLICT (id) DO UPDATE SET rule = excluded.rule, function = excluded.function, contains = excluded.contains, rung = excluded.rung, source = excluded.source\";\nconst UPSERT_CAPABILITY: &str = \"INSERT INTO capabilities (stage, function, rung) VALUES (?, ?, ?)\n    ON CONFLICT (stage, function) DO UPDATE SET rung = excluded.rung\";\n\nfn constraint_params(c: &Constraint) -> Value {\n    json!([c.id, c.rule, c.function, c.contains, name(c.rung), name(c.source)])\n}\n\nfn capability_params(g: &Capability) -> Value {\n    json!([name(g.stage), g.function, name(g.rung)])\n}\n\n/// The owner's defaults, written once. A row the owner changed is kept.\nfn seed() -> Vec<Value> {\n    let constraints = govern::default_constraints().into_iter().map(|c| {\n        json!({ \"sql\": \"INSERT OR IGNORE INTO constraints (id, rule, function, contains, rung, source) VALUES (?, ?, ?, ?, ?, ?)\", \"params\": constraint_params(&c) })\n    });\n    let grants = govern::default_capabilities().into_iter().map(|g| {\n        json!({ \"sql\": \"INSERT OR IGNORE INTO capabilities (stage, function, rung) VALUES (?, ?, ?)\", \"params\": capability_params(&g) })\n    });\n    constraints.chain(grants).collect()\n}\"\"\")\nrep(\"\"\"        let statements: Vec<Value> = SCHEMA\n            .iter()\n            .map(|sql| json!({ \"sql\": sql, \"params\": [] }))\n            .collect();\"\"\",\"\"\"        let statements: Vec<Value> = SCHEMA\n            .iter()\n            .map(|sql| json!({ \"sql\": sql, \"params\": [] }))\n            .chain(seed())\n            .collect();\"\"\")\nrep(\"\"\"fn job_params(r: &Record) -> Value {\"\"\",\"\"\"fn held_call(row: &Value) -> Result<HeldCall, String> {\n    let arguments: String = parse(row, \"arguments\")?;\n    Ok(HeldCall {\n        id: parse(row, \"id\")?,\n        job: parse(row, \"job\")?,\n        session: parse(row, \"session\")?,\n        turn: parse(row, \"turn\")?,\n        call: Call {\n            function: parse(row, \"function\")?,\n            text: parse(row, \"text\")?,\n        },\n        arguments: serde_json::from_str(&arguments).map_err(|e| format!(\"column arguments: {e}\"))?,\n        at: parse(row, \"at\")?,\n    })\n}\n\nfn entry(row: &Value) -> Result<Entry, String> {\n    Ok(Entry {\n        seq: parse(row, \"seq\")?,\n        at: parse(row, \"at\")?,\n        record: audit::Record {\n            kind: parse(row, \"kind\")?,\n            subject: parse(row, \"subject\")?,\n            detail: parse(row, \"detail\")?,\n        },\n        prev: parse(row, \"prev\")?,\n        hash: parse(row, \"hash\")?,\n    })\n}\n\nfn job_params(r: &Record) -> Value {\"\"\")\n# SqlStore impl additions: before closing of impl Store for SqlStore (ends right before \"#[cfg(test)]\\npub mod fake\")\nrep(\"\"\"            Ok(())\n        })\n    }\n}\n\n#[cfg(test)]\npub mod fake {\"\"\",\"\"\"            Ok(())\n        })\n    }\n\n    fn constraints(&self) -> Answer<'_, Vec<Constraint>> {\n        Box::pin(async move {\n            self.query(\"SELECT id, rule, function, contains, rung, source FROM constraints ORDER BY id\", json!([]))\n                .await?\n                .iter()\n                .map(|r| {\n                    Ok(Constraint {\n                        id: parse(r, \"id\")?,\n                        rule: parse(r, \"rule\")?,\n                        function: parse(r, \"function\")?,\n                        contains: parse(r, \"contains\")?,\n                        rung: parse(r, \"rung\")?,\n                        source: parse(r, \"source\")?,\n                    })\n                })\n                .collect()\n        })\n    }\n\n    fn set_constraint<'a>(&'a self, c: &'a Constraint) -> Answer<'a, ()> {\n        Box::pin(async move { self.execute(UPSERT_CONSTRAINT, constraint_params(c)).await.map(|_| ()) })\n    }\n\n    fn capabilities(&self) -> Answer<'_, Vec<Capability>> {\n        Box::pin(async move {\n            self.query(\"SELECT stage, function, rung FROM capabilities ORDER BY stage, function\", json!([]))\n                .await?\n                .iter()\n                .map(|r| {\n                    Ok(Capability {\n                        stage: parse(r, \"stage\")?,\n                        function: parse(r, \"function\")?,\n                        rung: parse(r, \"rung\")?,\n                    })\n                })\n                .collect()\n        })\n    }\n\n    fn set_capability<'a>(&'a self, g: &'a Capability) -> Answer<'a, ()> {\n        Box::pin(async move { self.execute(UPSERT_CAPABILITY, capability_params(g)).await.map(|_| ()) })\n    }\n\n    fn hold<'a>(&'a self, h: &'a HeldCall) -> Answer<'a, ()> {\n        Box::pin(async move {\n            self.execute(\n                \"INSERT INTO held_calls (id, job, session, turn, function, text, arguments, at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)\",\n                json!([h.id, h.job, h.session, h.turn, h.call.function, h.call.text, h.arguments.to_string(), h.at]),\n            )\n            .await\n            .map(|_| ())\n        })\n    }\n\n    fn held<'a>(&'a self, job: &'a str) -> Answer<'a, Vec<HeldCall>> {\n        Box::pin(async move {\n            self.query(\n                \"SELECT id, job, session, turn, function, text, arguments, at FROM held_calls WHERE job = ? ORDER BY at, id\",\n                json!([job]),\n            )\n            .await?\n            .iter()\n            .map(held_call)\n            .collect()\n        })\n    }\n\n    fn release<'a>(&'a self, id: &'a str) -> Answer<'a, ()> {\n        Box::pin(async move { self.execute(\"DELETE FROM held_calls WHERE id = ?\", json!([id])).await.map(|_| ()) })\n    }\n\n    fn audit(&self) -> Answer<'_, Vec<Entry>> {\n        Box::pin(async move {\n            self.query(\"SELECT seq, at, kind, subject, detail, prev, hash FROM audit ORDER BY seq\", json!([]))\n                .await?\n                .iter()\n                .map(entry)\n                .collect()\n        })\n    }\n\n    fn append_audit<'a>(&'a self, e: &'a Entry) -> Answer<'a, ()> {\n        Box::pin(async move {\n            self.execute(\n                \"INSERT INTO audit (seq, at, kind, subject, detail, prev, hash) VALUES (?, ?, ?, ?, ?, ?, ?)\",\n                json!([e.seq, e.at, e.record.kind, e.record.subject, e.record.detail, e.prev, e.hash]),\n            )\n            .await\n            .map(|_| ())\n        })\n    }\n}\n\n#[cfg(test)]\npub mod fake {\"\"\")\nrep(\"\"\"        pub dials: Mutex<Dials>,\n    }\"\"\",\"\"\"        pub dials: Mutex<Dials>,\n        pub constraints: Mutex<Vec<Constraint>>,\n        pub capabilities: Mutex<Vec<Capability>>,\n        pub held: Mutex<Vec<HeldCall>>,\n        pub audit: Mutex<Vec<Entry>>,\n    }\"\"\")\nrep(\"\"\"        fn set_dials<'a>(&'a self, dials: &'a Dials) -> Answer<'a, ()> {\n            *self.dials.lock().unwrap() = *dials;\n            Box::pin(async { Ok(()) })\n        }\n    }\"\"\",\"\"\"        fn set_dials<'a>(&'a self, dials: &'a Dials) -> Answer<'a, ()> {\n            *self.dials.lock().unwrap() = *dials;\n            Box::pin(async { Ok(()) })\n        }\n\n        fn constraints(&self) -> Answer<'_, Vec<Constraint>> {\n            let all = self.constraints.lock().unwrap().clone();\n            Box::pin(async move { Ok(all) })\n        }\n\n        fn set_constraint<'a>(&'a self, c: &'a Constraint) -> Answer<'a, ()> {\n            let mut all = self.constraints.lock().unwrap();\n            all.retain(|x| x.id != c.id);\n            all.push(c.clone());\n            Box::pin(async { Ok(()) })\n        }\n\n        fn capabilities(&self) -> Answer<'_, Vec<Capability>> {\n            let all = self.capabilities.lock().unwrap().clone();\n            Box::pin(async move { Ok(all) })\n        }\n\n        fn set_capability<'a>(&'a self, g: &'a Capability) -> Answer<'a, ()> {\n            let mut all = self.capabilities.lock().unwrap();\n            all.retain(|x| (x.stage, &x.function) != (g.stage, &g.function));\n            all.push(g.clone());\n            Box::pin(async { Ok(()) })\n        }\n\n        fn hold<'a>(&'a self, h: &'a HeldCall) -> Answer<'a, ()> {\n            self.held.lock().unwrap().push(h.clone());\n            Box::pin(async { Ok(()) })\n        }\n\n        fn held<'a>(&'a self, job: &'a str) -> Answer<'a, Vec<HeldCall>> {\n            let found = self.held.lock().unwrap().iter().filter(|h| h.job == job).cloned().collect();\n            Box::pin(async move { Ok(found) })\n        }\n\n        fn release<'a>(&'a self, id: &'a str) -> Answer<'a, ()> {\n            self.held.lock().unwrap().retain(|h| h.id != id);\n            Box::pin(async { Ok(()) })\n        }\n\n        fn audit(&self) -> Answer<'_, Vec<Entry>> {\n            let all = self.audit.lock().unwrap().clone();\n            Box::pin(async move { Ok(all) })\n        }\n\n        fn append_audit<'a>(&'a self, e: &'a Entry) -> Answer<'a, ()> {\n            let mut all = self.audit.lock().unwrap();\n            let result = if all.iter().any(|x| x.seq == e.seq) {\n                Err(format!(\"audit entry {} exists\", e.seq))\n            } else {\n                all.push(e.clone());\n                Ok(())\n            };\n            Box::pin(async move { result })\n        }\n    }\"\"\")\n# tests\nrep(\"\"\"    #[test]\n    fn a_row_reads_back_as_the_record_it_was_written_from() {\"\"\",\"\"\"    #[test]\n    fn audit_entries_chain_and_a_fork_is_refused() {\n        let store = FakeStore::default();\n        let what = |detail: &str| audit::Record {\n            kind: \"gate\".into(),\n            subject: \"j1\".into(),\n            detail: detail.into(),\n        };\n        tauri::async_runtime::block_on(async {\n            let first = super::record(&store, 1, what(\"continue\")).await.unwrap();\n            let second = super::record(&store, 2, what(\"hold\")).await.unwrap();\n            assert_eq!((first.seq, second.prev.as_str()), (1, first.hash.as_str()));\n            assert_eq!(audit::verify(&store.audit().await.unwrap()), Ok(()));\n            assert!(store.append_audit(&second).await.is_err());\n        });\n    }\n\n    #[test]\n    fn a_held_call_row_reads_back_with_its_arguments() {\n        let h = HeldCall {\n            id: \"fc1\".into(),\n            job: \"j1\".into(),\n            session: \"s\".into(),\n            turn: \"t\".into(),\n            call: Call {\n                function: \"sandbox::fs::write\".into(),\n                text: \"/work/repo/a.py\".into(),\n            },\n            arguments: json!({ \"path\": \"/work/repo/a.py\", \"content\": \"x\" }),\n            at: 9,\n        };\n        let row = json!({ \"id\": \"fc1\", \"job\": \"j1\", \"session\": \"s\", \"turn\": \"t\", \"function\": \"sandbox::fs::write\",\n            \"text\": \"/work/repo/a.py\", \"arguments\": h.arguments.to_string(), \"at\": 9 });\n        assert_eq!(held_call(&row).unwrap(), h);\n    }\n\n    #[test]\n    fn open_seeds_the_owner_defaults_without_overwriting() {\n        let engine = Arc::new(FakeEngine::new(Link::Up).answer(\"database::transaction\", Ok(json!({ \"committed\": true }))));\n        tauri::async_runtime::block_on(async {\n            SqlStore::open(engine.clone()).await.unwrap();\n        });\n        let calls = engine.calls.lock().unwrap();\n        let statements = calls[0].2[\"statements\"].as_array().unwrap();\n        let seeds: Vec<_> = statements.iter().filter(|s| s[\"sql\"].as_str().unwrap().starts_with(\"INSERT OR IGNORE\")).collect();\n        assert_eq!(seeds.len(), govern::default_constraints().len() + govern::default_capabilities().len());\n    }\n\n    #[test]\n    fn a_row_reads_back_as_the_record_it_was_written_from() {\"\"\")\nopen(p,'w').write(s)\nEOF\ncargo +1.97.0 fmt --all && cargo +1.97.0 test -p bastion 2>&1 | grep -E \"test result|FAILED|panicked|^error\" -A5 | head -30","description":"Add governance tables, Store methods, fake and tests","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8585,"cache_read_input_tokens":112095,"output_tokens":8048,"output_tokens_details":{"thinking_tokens":1107},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8585,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8048,"cache_read_input_tokens":112095,"cache_creation_input_tokens":8585,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8585},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01VLEGamC3RxM1cwp6pCnY5q":{"command":"cd /Users/tacoda/tacoda/bastion && python3 - <<'EOF'\np='src-tauri/src/store.rs'; s=open(p).read()\ndef rep(a,b):\n    global s\n    assert s.count(a)==1,a; s=s.replace(a,b)\n\nrep(\"\"\"//! (D8). `SqlStore` is the only code that writes SQL.\"\"\",\"\"\"//! (D8), and the governance rows of A5: constraints, capabilities, held\n//! calls and the audit chain. `SqlStore` is the only code that writes SQL.\"\"\")\nrep(\"use bastion_core::{Dial, Dials, Job, Stage};\",\"\"\"use bastion_core::audit::{self, Entry};\nuse bastion_core::govern::{self, Call, Capability, Constraint};\nuse bastion_core::{Dial, Dials, Job, Stage};\"\"\")\nrep(\"\"\"/// A save lost to another writer (D8).\"\"\",\"\"\"/// A call the gate held for the owner, with what is needed to run it later.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct HeldCall {\n    /// The harness's `function_call_id`.\n    pub id: String,\n    pub job: String,\n    pub session: String,\n    pub turn: String,\n    pub call: Call,\n    /// The call's arguments as the engine sent them, to run on approval.\n    pub arguments: Value,\n    pub at: u64,\n}\n\n/// A save lost to another writer (D8).\"\"\")\nrep(\"\"\"    fn set_dials<'a>(&'a self, dials: &'a Dials) -> Answer<'a, ()>;\n}\"\"\",\"\"\"    fn set_dials<'a>(&'a self, dials: &'a Dials) -> Answer<'a, ()>;\n    fn constraints(&self) -> Answer<'_, Vec<Constraint>>;\n    /// Add a constraint, or replace the one with its id.\n    fn set_constraint<'a>(&'a self, constraint: &'a Constraint) -> Answer<'a, ()>;\n    fn capabilities(&self) -> Answer<'_, Vec<Capability>>;\n    /// Add a grant, or replace the one for its stage and function.\n    fn set_capability<'a>(&'a self, grant: &'a Capability) -> Answer<'a, ()>;\n    fn hold<'a>(&'a self, call: &'a HeldCall) -> Answer<'a, ()>;\n    /// The calls held for a job, oldest first.\n    fn held<'a>(&'a self, job: &'a str) -> Answer<'a, Vec<HeldCall>>;\n    fn release<'a>(&'a self, id: &'a str) -> Answer<'a, ()>;\n    /// The whole audit chain, oldest first.\n    fn audit(&self) -> Answer<'_, Vec<Entry>>;\n    /// Add the next entry. A second entry with the same `seq` is refused, so\n    /// two writers cannot fork the chain.\n    fn append_audit<'a>(&'a self, entry: &'a Entry) -> Answer<'a, ()>;\n}\n\n/// Write the next audit entry after the last one in the store.\n// ponytail: reads the whole chain to find its tail; read only the last row when the chain grows large.\npub async fn record(store: &dyn Store, at: u64, what: audit::Record) -> Result<Entry, String> {\n    let chain = store.audit().await?;\n    let entry = audit::append(chain.last(), at, what);\n    store.append_audit(&entry).await?;\n    Ok(entry)\n}\"\"\")\nrep(\"\"\"const SCHEMA: [&str; 4] = [\"\"\",\"\"\"const SCHEMA: [&str; 8] = [\"\"\")\nrep(\"\"\"        dial TEXT NOT NULL CHECK (dial IN ('ask','hold','auto')))\",\n];\"\"\",\"\"\"        dial TEXT NOT NULL CHECK (dial IN ('ask','hold','auto')))\",\n    \"CREATE TABLE IF NOT EXISTS constraints (\n        id TEXT PRIMARY KEY CHECK (length(id) > 0),\n        rule TEXT NOT NULL CHECK (length(rule) > 0),\n        function TEXT NOT NULL,\n        contains TEXT NOT NULL,\n        rung TEXT NOT NULL CHECK (rung IN ('told','checked','enforced')),\n        source TEXT NOT NULL CHECK (source IN ('charter','owner')))\",\n    \"CREATE TABLE IF NOT EXISTS capabilities (\n        stage TEXT NOT NULL CHECK (stage IN ('plan','approve','build','review','land')),\n        function TEXT NOT NULL CHECK (length(function) > 0),\n        rung TEXT NOT NULL CHECK (rung IN ('denied','ask','allowed')),\n        PRIMARY KEY (stage, function))\",\n    // `arguments` is the engine's JSON, kept opaque to run the call later.\n    \"CREATE TABLE IF NOT EXISTS held_calls (\n        id TEXT PRIMARY KEY,\n        job TEXT NOT NULL REFERENCES jobs(id),\n        session TEXT NOT NULL,\n        turn TEXT NOT NULL,\n        function TEXT NOT NULL,\n        text TEXT NOT NULL,\n        arguments TEXT NOT NULL,\n        at INTEGER NOT NULL)\",\n    \"CREATE TABLE IF NOT EXISTS audit (\n        seq INTEGER PRIMARY KEY CHECK (seq >= 1),\n        at INTEGER NOT NULL,\n        kind TEXT NOT NULL,\n        subject TEXT NOT NULL,\n        detail TEXT NOT NULL,\n        prev TEXT NOT NULL CHECK (length(prev) = 64),\n        hash TEXT NOT NULL UNIQUE CHECK (length(hash) = 64))\",\n];\n\nconst UPSERT_CONSTRAINT: &str = \"INSERT INTO constraints (id, rule, function, contains, rung, source) VALUES (?, ?, ?, ?, ?, ?)\n    ON CONFLICT (id) DO UPDATE SET rule = excluded.rule, function = excluded.function, contains = excluded.contains, rung = excluded.rung, source = excluded.source\";\nconst UPSERT_CAPABILITY: &str = \"INSERT INTO capabilities (stage, function, rung) VALUES (?, ?, ?)\n    ON CONFLICT (stage, function) DO UPDATE SET rung = excluded.rung\";\n\nfn constraint_params(c: &Constraint) -> Value {\n    json!([c.id, c.rule, c.function, c.contains, name(c.rung), name(c.source)])\n}\n\nfn capability_params(g: &Capability) -> Value {\n    json!([name(g.stage), g.function, name(g.rung)])\n}\n\n/// The owner's defaults, written once. A row the owner changed is kept.\nfn seed() -> Vec<Value> {\n    let constraints = govern::default_constraints().into_iter().map(|c| {\n        json!({ \"sql\": \"INSERT OR IGNORE INTO constraints (id, rule, function, contains, rung, source) VALUES (?, ?, ?, ?, ?, ?)\", \"params\": constraint_params(&c) })\n    });\n    let grants = govern::default_capabilities().into_iter().map(|g| {\n        json!({ \"sql\": \"INSERT OR IGNORE INTO capabilities (stage, function, rung) VALUES (?, ?, ?)\", \"params\": capability_params(&g) })\n    });\n    constraints.chain(grants).collect()\n}\"\"\")\nrep(\"\"\"        let statements: Vec<Value> = SCHEMA\n            .iter()\n            .map(|sql| json!({ \"sql\": sql, \"params\": [] }))\n            .collect();\"\"\",\"\"\"        let statements: Vec<Value> = SCHEMA\n            .iter()\n            .map(|sql| json!({ \"sql\": sql, \"params\": [] }))\n            .chain(seed())\n            .collect();\"\"\")\nrep(\"\"\"fn job_params(r: &Record) -> Value {\"\"\",\"\"\"fn held_call(row: &Value) -> Result<HeldCall, String> {\n    let arguments: String = parse(row, \"arguments\")?;\n    Ok(HeldCall {\n        id: parse(row, \"id\")?,\n        job: parse(row, \"job\")?,\n        session: parse(row, \"session\")?,\n        turn: parse(row, \"turn\")?,\n        call: Call {\n            function: parse(row, \"function\")?,\n            text: parse(row, \"text\")?,\n        },\n        arguments: serde_json::from_str(&arguments).map_err(|e| format!(\"column arguments: {e}\"))?,\n        at: parse(row, \"at\")?,\n    })\n}\n\nfn entry(row: &Value) -> Result<Entry, String> {\n    Ok(Entry {\n        seq: parse(row, \"seq\")?,\n        at: parse(row, \"at\")?,\n        record: audit::Record {\n            kind: parse(row, \"kind\")?,\n            subject: parse(row, \"subject\")?,\n            detail: parse(row, \"detail\")?,\n        },\n        prev: parse(row, \"prev\")?,\n        hash: parse(row, \"hash\")?,\n    })\n}\n\nfn job_params(r: &Record) -> Value {\"\"\")\n# SqlStore impl additions: before closing of impl Store for SqlStore (ends right before \"#[cfg(test)]\\npub mod fake\")\nrep(\"\"\"            Ok(())\n        })\n    }\n}\n\n#[cfg(test)]\npub mod fake {\"\"\",\"\"\"            Ok(())\n        })\n    }\n\n    fn constraints(&self) -> Answer<'_, Vec<Constraint>> {\n        Box::pin(async move {\n            self.query(\"SELECT id, rule, function, contains, rung, source FROM constraints ORDER BY id\", json!([]))\n                .await?\n                .iter()\n                .map(|r| {\n                    Ok(Constraint {\n                        id: parse(r, \"id\")?,\n                        rule: parse(r, \"rule\")?,\n                        function: parse(r, \"function\")?,\n                        contains: parse(r, \"contains\")?,\n                        rung: parse(r, \"rung\")?,\n                        source: parse(r, \"source\")?,\n                    })\n                })\n                .collect()\n        })\n    }\n\n    fn set_constraint<'a>(&'a self, c: &'a Constraint) -> Answer<'a, ()> {\n        Box::pin(async move { self.execute(UPSERT_CONSTRAINT, constraint_params(c)).await.map(|_|