(\n    cell: State<'_, FactoryCell>,\n    stage: String,\n    function: String,\n    up: bool,\n) -> Result<(), String> {\n    let stage = serde_json::from_value(json!(stage)).map_err(|_| format!(\"{stage:?} is not a stage\"))?;\n    factory(&cell)?.gate().move_capability(stage, &function, up).await\n}\n\n/// The whole chain, verified as it is read.\n#[tauri::command]\npub async fn audit(cell: State<'_, FactoryCell>) -> Result<AuditView, String> {\n    let chain = factory(&cell)?.store().audit().await?;\n    let broken_at = audit::verify(&chain).err();\n    let entries = chain\n        .into_iter()\n        .map(|e| AuditEntryView {\n            seq: e.seq,\n            at: e.at,\n            kind: e.record.kind,\n            subject: e.record.subject,\n            detail: e.record.detail,\n            hash: e.hash,\n        })\n        .collect();\n    Ok(AuditView { entries, broken_at })\n}\nEOF\npython3 - <<'EOF'\nimport re\np='src-tauri/src/commands/mod.rs'; s=open(p).read(); s=s.replace(\"pub mod factory;\\n\",\"pub mod factory;\\npub mod govern;\\n\"); open(p,'w').write(s)\np='src-tauri/src/commands/factory.rs'; s=open(p).read()\ndef rep(a,b):\n    global s\n    assert s.count(a)==1,a; s=s.replace(a,b)\nrep(\"fn factory(cell: &FactoryCell)\",\"pub(super) fn factory(cell: &FactoryCell)\")\nrep(\"fn name<T: Serialize>\",\"pub(super) fn name<T: Serialize>\")\nrep(\"ArtifactView, DialsView, JobDetail,\",\"ArtifactView, DialsView, HeldCallView, JobDetail,\")\nrep(\"\"\"    Ok(JobDetail {\n        job: summary(&record, &factory.store().dials().await?),\n        steps,\n        artifacts,\n        transcript,\n    })\"\"\",\"\"\"    let held = factory\n        .store()\n        .held(&id)\n        .await?\n        .into_iter()\n        .map(|h| HeldCallView {\n            id: h.id,\n            function: h.call.function,\n            text: h.call.text,\n            at: h.at,\n        })\n        .collect();\n    Ok(JobDetail {\n        job: summary(&record, &factory.store().dials().await?),\n        steps,\n        artifacts,\n        transcript,\n        held,\n    })\"\"\")\nopen(p,'w').write(s)\np='src-tauri/src/lib.rs'; s=open(p).read()\ns=s.replace(\"\"\"            commands::factory::dials_set,\"\"\",\"\"\"            commands::factory::dials_set,\n            commands::govern::held_allow,\n            commands::govern::held_refuse,\n            commands::govern::constraints,\n            commands::govern::constraint_move,\n            commands::govern::capabilities,\n            commands::govern::capability_move,\n            commands::govern::audit,\"\"\")\nopen(p,'w').write(s)\nEOF\ncargo +1.97.0 fmt --all && cargo +1.97.0 clippy --workspace --all-targets -- -D warnings 2>&1 | grep -E \"^(error|warning)\" -A6 | head -40","description":"Add governance commands and register them","timeout":600000}},"wireIngestContext":{"toolu_01RmqgwnVagCY9bYLHnBVQQh":{"cwd":"/Users/tacoda/tacoda/bastion"}},"serverClassifierRequest":"57d591b0-34da-4e84-9d24-ab2f6a669e95","apiBlockIndex":0,"requestId":"req_011CgaVEzzd3uoSVedKHNRT4","type":"assistant","uuid":"26352adc-6272-4c7f-a131-784fafe9b1a6","timestamp":"2026-10-31T14:40:04.004Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
