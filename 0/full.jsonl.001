pe: Value| {\n                let mut arguments = envelope[\"call\"][\"arguments\"].clone();\n                arguments[\"sandbox_id\"] = envelope[\"metadata\"][\"sandbox_id\"].clone();\n                json!({ \"decision\": \"continue\", \"mutations\": { \"arguments\": arguments } })\n            }),\n        )?;\n        let factory = self.clone();\n        tauri::async_runtime::spawn(async move { factory.resume().await });\"\"\",\"\"\"    /// Put every `sandbox::*` call a turn makes through the gate, which pins\n    /// it to the job's VM, then resume.\n    pub fn start(self: &Arc<Self>) -> Result<(), String> {\n        let gate = self.gate.clone();\n        self.engine.bind(\n            \"harness::hook::pre-trigger\",\n            json!({ \"functions\": [\"sandbox::*\"], \"on_error\": \"fail_closed\", \"timeout_ms\": 5000 }),\n            Arc::new(move |envelope: Value| gate.judge(&envelope)),\n        )?;\n        let factory = self.clone();\n        tauri::async_runtime::spawn(async move {\n            if let Err(e) = factory.gate.reload().await {\n                eprintln!(\"the gate has no policy, so it refuses every call: {e}\");\n            }\n            factory.resume().await\n        });\"\"\")\nrep(\"\"\"        message.push_str(TOOL_GUIDE);\n        message.push_str(\"\\\\n\\\\n\");\"\"\",\"\"\"        message.push_str(TOOL_GUIDE);\n        message.push_str(\"\\\\n\\\\n\");\n        message.push_str(&self.gate.rules());\"\"\")\nrep(\"\"\"    async fn teardown(&self, record: &Record) -> Result<(), String> {\n        self.release(&record.job.id);\"\"\",\"\"\"    async fn teardown(&self, record: &Record) -> Result<(), String> {\n        self.release(&record.job.id);\n        self.gate.clear(&record.job.id).await;\"\"\")\nopen(p,'w').write(s)\np='src-tauri/src/lib.rs'; s=open(p).read()\ns=s.replace(\"mod factory;\\n\",\"mod factory;\\nmod gate;\\n\",1); open(p,'w').write(s)\nEOF\ncargo +1.97.0 fmt --all && cargo +1.97.0 test -p bastion 2>&1 | grep -E \"