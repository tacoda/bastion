s::update_list(s, m, ctx),","+            (Page::Eval(s), Message::Evals(m)) => return evals::update_one(s, m, ctx),","+            _ => {}","         }","+        Task::none()","     }"," ","     pub fn view<'a>(&'a self, route: &Route, ctx: &Ctx) -> Element<'a, Message> {"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/app.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/mod.rs"]}},"serverClassifierContext":{"request":"c5ef4fbb-adc6-4efb-959e-898a2c118540","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":4,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","platform":"macos"}},"sourceToolAssistantUUID":"4cb826b8-557f-4530-b425-bba5fca8d66c","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
