o; one for a page no\n    /// longer shown is dropped.\n    pub fn update(&mut self, message: Message, ctx: &Ctx) -> Task<Message> {\n        match (self, message) {\n            (Page::Jobs(s), Message::Jobs(m)) => jobs::update(s, m),\n            (Page::NewRequest(s), Message::NewRequest(m)) => return new_request::update(s, m, ctx),\n            (Page::Job(s), Message::Job(m)) => return job::update(s, m, ctx),\n            (Page::Govern(s), Message::Govern(m)) => return govern::update(s, m, ctx),\n            (Page::Engine(s), Message::Engine(m)) => return engine::update(s, m, ctx),\n            (Page::Evals(s), Message::Evals(m)) => return evals::update_list(s, m, ctx),\n            (Page::Eval(s), Message::Evals(m)) => return evals::update_one(s, m, ctx),\n            _ => {}\n        }\n        Task::none()\n    }\n\n'''+s[j:]\nopen(p,'w').write(s)\np='app.rs'; s=open(p).read()\ni=s.index(\"            Message::Jobs(msg) => {\"); j=s.index(\"            Message::OpenUrl(url) => open(&url),\")\ns=s[:i]+'''            page @ (Message::Jobs(_)\n            | Message::NewRequest(_)\n            | Message::Job(_)\n            | Message::Govern(_)\n            | Message::Engine(_)\n            | Message::Evals(_)) => {\n                let ctx = self.ctx();\n                return self.page.update(page, &ctx);\n            }\n'''+s[j:]\ns=s.replace(\"use crate::pages::{self, Ctx, Page, Push, engine, evals, govern, job, jobs, new_request};\",\"use crate::pages::{self, Ctx, Page, Push, engine, evals, govern, job, jobs, new_request};\")\nopen(p,'w').write(s)\nEOF\ncd /Users/tacoda/tacoda/bastion && export CARGO_INCREMENTAL=0 && cargo fmt --all && cargo clippy -p bastion-desktop --all-targets -- -D warnings 2>&1 | grep -E \"^(error|warning: [^t])|-->\" -A4 | head -20","description":"Move page messages into Page::update and split reload","timeout":600000}},"wireIngestContext":{"toolu_01DRvQshM8gv2fMymWjxdTKF":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src