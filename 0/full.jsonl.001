,"newLines":45,"lines":[" pub fn labeled<'a, M: 'a>(label: &'a str, field: impl Into<Element<'a, M>>) -> Element<'a, M> {","     column![text(label).size(13).color(theme::MUTED), field.into()].spacing(4).into()"," }","+","+/// The page the window shows, with its state.","+pub enum Page {","+    Jobs(jobs::State),","+    NewRequest(new_request::State),","+    /// A page G2 has not built yet.","+    Pending,","+}","+","+impl Page {","+    /// The page for `route`, and its first read.","+    pub fn open(route: &Route, ctx: &Ctx) -> (Page, Task<Message>) {","+        let page = match route {","+            Route::Jobs => Page::Jobs(jobs::State::default()),","+            Route::NewRequest => Page::NewRequest(new_request::State::default()),","+            _ => Page::Pending,","+        };","+        let first = page.reload(ctx, true);","+        (page, first)","+    }","+","+    /// Read again after a push. `everything` is a change to every job or a","+    /// resync, which also reaches what a page reads besides jobs.","+    pub fn reload(&self, ctx: &Ctx, everything: bool) -> Task<Message> {","+        match self {","+            Page::Jobs(s) => jobs::load(s, ctx).map(Message::Jobs),","+            Page::NewRequest(s) if everything => new_request::load(s, ctx),","+            _ => Task::none(),","+        }","+    }","+","+    pub fn view<'a>(&'a self, route: &Route, ctx: &Ctx) -> Element<'a, Message> {","+        match self {","+            Page::Jobs(s) => jobs::view(s, ctx),","+            Page::NewRequest(s) => new_request::view(s, ctx),","+            Page::Pending => {","+                let title = text(route.title()).size(24).font(theme::BOLD);","+                column![title, text(\"This page is built in G2.\").color(theme::MUTED)].spacing(12).into()","+            }","+        }","+    }","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/app.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/main.rs","