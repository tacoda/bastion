), ipc::Failure<String>>| match result {","+        Ok(()) => error.set(String::new()),","+        Err(e) => error.set(e.text()),","+    };","+    let allow = move |_| {","+        spawn_local(async move {","+            report(","+                ipc::call::<(), String>(","+                    command::HELD_ALLOW,","+                    Allow {","+                        held: held.get_value(),","+                    },","+                )","+                .await,","+            );","+        });","+    };","+    let refuse = move |_| {","+        spawn_local(async move {","+            let args = Refuse {","+                held: held.get_value(),","+                feedback: feedback.get_untracked(),","+            };","+            report(ipc::call::<(), String>(command::HELD_REFUSE, args).await);","+        });","+    };","+    view! {","+        <li class=\"grid gap-2 border-t border-line pt-3 first:border-t-0 first:pt-0\">","+            <p class=\"m-0\"><strong>{call.function}</strong>\" \"<code class=\"break-all\">{call.text}</code>","+                <span class=\"text-xs text-muted\">{format!(\" · held {}\", ago(call.at))}</span></p>","+            <textarea class=\"min-h-16 rounded border border-line bg-bg p-2 text-ink\" aria-label=\"What the agent should do instead\"","+                placeholder=\"What the agent should do instead\"","+                prop:value=feedback on:input=move |e| set_feedback.set(event_target_value(&e))></textarea>","+            <div class=\"flex flex-wrap gap-2\">","+                <button class=\"rounded-lg bg-primary px-3 py-2 font-semibold text-white hover:bg-primary-hover\" on:click=allow>\"Allow once\"</button>","+                <button class=\"rounded-lg border border-line px-3 py-2 hover:bg-line disabled:opacity-50\"","+                    disabled=move || feedback.get().trim().is_empty() on:click=refuse>\"Refuse with this note\"</button>","+            </div>","+        </li>","+    }","+}","+"," #[component]"," pub fn JobPage(id: String) -> impl IntoView {","     let go = nav();"]},{"oldStart":174,"oldLines":6,"newStart":238,"newLines":14,"lines":["                 </div>","             </section>","         </Show>","+        {move || detail.get().filter(|d| !d.held.is_empty()).map(|d| view! {","+            <section class=\"mb-4 grid gap-3 rounded-xl border border-warn bg-panel p-4\">","+                <h2 class=\"m-0 text-sm font-semibold text-warn\">\"The gate holds a call for you\"</h2>","+                <ul class=\"m-0 grid list-none gap-3 p-0\">","+                    {d.held.into_iter().map(|call| view! { <HeldCall job=d.job.id.clone() call=call error=set_error /> }).collect_view()}","+                </ul>","+            </section>","+        })}","         <p class=\"text-bad\" role=\"alert\">{error}</p>"," ","         <section class=\"rounded-xl border border-line bg-panel\">"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/src/pages/job.rs"]}},"serverClassifierContext":{"request":"2f3bec64-7011-4ac4-9022-f999d717be4e","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"8e9f8d53-e851-4f8b-abf4-992e436b8aca","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
