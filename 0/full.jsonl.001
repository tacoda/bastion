 (j, effects) = run(&events);","+    assert_eq!(","+        (j.stage, j.state, j.error.as_deref()),","+        (Stage::Land, State::NeedsYou, Some(\"no ref\"))","+    );","+    assert!(effects.is_empty(), \"the VM stays: no teardown\");","+    assert_eq!(actions(&j), vec![Action::Approve, Action::Stop]);","+    events.push(Event::Approved);","+    let (j, effects) = run(&events);","+    assert_eq!(","+        (j.state, j.error, effects),","+        (State::Running, None, vec![Effect::Land])","+    );","+}"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/src-tauri/src/factory.rs","hunks":[{"oldStart":616,"oldLines":7,"newStart":616,"newLines":7,"lines":["                 \"bundle\",","                 \"create\",","                 \"/work/out.bundle\",","-                &format!(\"origin/{branch}..HEAD\"),","+                &format!(\"origin/{branch}..{branch}\"),","             ],","         )","         .await"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","/Users/tacoda/tacoda/bastion/crates/bastion-core/src/tests.rs","/Users/tacoda/tacoda/bastion/src-tauri/src/factory.rs"]}},"serverClassifierContext":{"request":"db210c9a-de65-44dd-a1ec-77e116bc8530","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"85bc05ec-58d4-4b49-b644-5701818c1513","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main"}
