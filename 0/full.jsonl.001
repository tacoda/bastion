+#[tauri::command]","+pub async fn constraint_move(","+    cell: State<'_, FactoryCell>,","+    id: String,","+    up: bool,","+) -> Result<(), String> {","+    factory(&cell)?.gate().move_constraint(&id, up).await","+}","+","+#[tauri::command]","+pub async fn capabilities(cell: State<'_, FactoryCell>) -> Result<Vec<CapabilityView>, String> {","+    let all = factory(&cell)?.store().capabilities().await?;","+    Ok(all","+        .into_iter()","+        .map(|g| CapabilityView {","+            stage: name(g.stage),","+            function: g.function,","+            rung: name(g.rung),","+        })","+        .collect())","+}","+","+#[tauri::command]","+pub async fn capability_move(","+    cell: State<'_, FactoryCell>,","+    stage: String,","+    function: String,","+    up: bool,","+) -> Result<(), String> {","+    let stage =","+        serde_json::from_value(json!(stage)).map_err(|_| format!(\"{stage:?} is not a stage\"))?;","+    factory(&cell)?","+        .gate()","+        .move_capability(stage, &function, up)","+        .await","+}","+","+/// The whole chain, verified as it is read.","+#[tauri::command]","+pub async fn audit(cell: State<'_, FactoryCell>) -> Result<AuditView, String> {","+    let chain = factory(&cell)?.store().audit().await?;","+    let broken_at = audit::verify(&chain).err();","+    let entries = chain","+        .into_iter()","+        .map(|e| AuditEntryView {","+            seq: e.seq,","+            at: e.at,","+            kind: e.record.kind,","+            subject: e.record.subject,","+            detail: e.record.detail,","+            hash: e.hash,","+        })","+        .collect();","+    Ok(AuditView { entries, broken_at })","+}"]}],"created":true},{"filePath":"/Users/tacoda/tacoda/bastion/src-tauri/src/commands/mod.rs","hunks":[{"oldStart":5,"oldLines":4,"newStart":5,"newLines":5,"lines":[" pub mod doctor;"," pub mod engine;"," pub mod factory;","+pub mod govern;"," pub mod stack;"]}]},{"filePath":"/Users/tacoda/tacoda/basti