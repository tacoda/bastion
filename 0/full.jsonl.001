{"parentUuid":"0681ae68-b348-43cf-9ae4-66c926bba375","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/mod.rs","snippet":"4\tpub mod jobs;\n5\tpub mod new_request;\n6\t\n7\tuse std::collections::BTreeSet;\n8\tuse std::time::{SystemTime, UNIX_EPOCH};\n9\t\n10\tuse bastion_protocol::Server;\n11\tuse iced::widget::{column, container, text};\n12\tuse iced::{Color, Element, Fill, Task};\n13\tuse serde::de::DeserializeOwned;\n14\t\n15\tuse crate::app::Message;\n16\tuse crate::client::{self, Ask};\n17\tuse crate::route::Route;\n18\tuse crate::theme;\n19\t\n20\t/// What a page may read: the servers, which one is shown, and which cannot\n21\t/// be reached now. Cheap to clone into a task.\n22\t#[derive(Clone)]\n23\tpub struct Ctx {\n24\t    pub http: reqwest::Client,\n25\t    pub servers: Vec<Server>,\n...\n70\t    let style = if accent { theme::accented } else { theme::panel };\n71\t    container(column![head, theme::rule(), body]).width(Fill).style(style).into()\n72\t}\n73\t\n74\t/// A label above a field, as the forms show them.\n75\tpub fn labeled<'a, M: 'a>(label: &'a str, field: impl Into<Element<'a, M>>) -> Element<'a, M> {\n76\t    column![text(label).size(13).color(theme::MUTED), field.into()].spacing(4).into()\n77\t}\n78\t\n79\t/// The page the window shows, with its state.\n80\tpub enum Page {\n81\t    Jobs(jobs::State),\n82\t    NewRequest(new_request::State),\n83\t    /// A page G2 has not built yet.\n84\t    Pending,\n85\t}\n86\t\n87\timpl Page {\n88\t    /// The page for `route`, and its first read.\n89\t    pub fn open(route: &Route, ctx: &Ctx) -> (Page, Task<Message>) {\n90\t        let page = match route {\n91\t            Route::Jobs => Page::Jobs(jobs::State::default()),\n92\t            Route::NewRequest => Page::NewRequest(new_request::State::default()),\n93\t            _ => Page::Pending,\n94\t        };\n95\t        let first = page.reload(ctx, true);\n96\t        (page, first)\n97\t    }\n98\t\n99\t    /// Read again after a push. `everything` is a change to every job or a\n100\t    /// resync, which also reaches what a page reads besides jobs.\n101\t    pub fn reload(&self, ctx: &Ctx, everything: bool) -> Task<Message> {\n102\t        match self {\n103\t            Page::Jobs(s) => jobs::load(s, ctx).map(Message::Jobs),\n104\t            Page::NewRequest(s) if everything => new_request::load(s, ctx),\n105\t            _ => Task::none(),\n106\t        }\n107\t    }\n108\t\n109\t    pub fn view<'a>(&'a self, route: &Route, ctx: &Ctx) -> Element<'a, Message> {\n110\t        match self {\n111\t            Page::Jobs(s) => jobs::view(s, ctx),\n112\t            Page::NewRequest(s) => new_request::view(s, ctx),\n113\t            Page::Pending => {\n114\t                let title = text(route.title()).size(24).font(theme::BOLD);\n115\t                column![title, text(\"This page is built in G2.\").color(theme::MUTED)].spacing(12).into()\n116\t            }\n117\t        }\n118\t    }\n119\t}"},"type":"attachment","uuid":"9a2c6651-970a-4d77-aace-1adbfd77227b","timestamp":"2026-11-09T21:09:12.806Z","rendered":[{"content":"<system-reminder>\nNote: /Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/mod.rs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n4\tpub mod jobs;\n5\tpub mod new_request;\n6\t\n7\tuse std::collections::BTreeSet;\n8\tuse std::time::{SystemTime, UNIX_EPOCH};\n9\t\n10\tuse bastion_protocol::Server;\n11\tuse iced::widget::{column, container, text};\n12\tuse iced::{Color, Element, Fill, Task};\n13\tuse serde::de::DeserializeOwned;\n14\t\n15\tuse crate::app::Message;\n16\tuse crate::client::{self, Ask};\n17\tuse crate::route::Route;\n18\tuse crate::theme;\n19\t\n20\t/// What a