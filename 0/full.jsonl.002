:Handle::from_memory(source.into_bytes())\n}\n\n/// One 16 px icon in `color`.\npub fn icon<'a, M: 'a>(inner: &str, color: Color) -> Element<'a, M> {\n    let source = format!(\n        r#\"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"black\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{inner}</svg>\"#\n    );\n    svg(svg::Handle::from_memory(source.into_bytes()))\n        .width(Length::Fixed(16.0))\n        .height(Length::Fixed(16.0))\n        .style(move |_, _| svg::Style { color: Some(color) })\n        .into()\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"127d45f9-7cc7-4ad5-9104-8c6717d6edad","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"187c06ee-5b99-4535-87d4-3c41f68c1f81","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
