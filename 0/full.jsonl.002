.iter().rev().find(|a| a.stage == stage);","-            found.map(|a| a.body.clone())","-        };","-        let decided = self.store.entries_of(\"decide\").await?.into_iter();","-        let waived = decided","-            .filter(|e| e.record.subject == *id && e.record.detail.contains(\", waiving: \"))","-            .map(|e| e.record.detail)","-            .collect();","-        Ok(forge::Notes {","-            briefing: last(Stage::Comprehend),","-            uat: last(Stage::Uat),","-            proof: last(Stage::Prove),","-            waived,","-            issue: record.runtime.issue.clone(),","-        })","-    }","-","-    /// Keep the commit the merge made, as a land keeps its own: GitHub's","-    /// Revert button reverts that commit, and a squash or a rebase lands","-    /// none of the job's own ids.","-    async fn keep_merge_commit(&self, record: &Record, hub: &forge::GitHub<'_>, url: &str) {","-        let Ok(sha) = hub.merge_commit(url).await else {","-            return;","-        };","-        let Some(body) = escape::commits_artifact(&format!(\"{sha} Merge {url}\")) else {","-            return;","-        };","-        let artifact = Artifact {","-            stage: Stage::Merge,","-            body,","-            created_at: super::now(),","-        };","-        let _ = self.store.add_artifact(&record.job.id, &artifact).await;","-    }","-","-    /// Say the pull request's text again with the proof and the briefing","-    /// that came after it opened, merge it, then bring the workspace's branch","-    /// up to date.","-    pub(super) async fn merge(&self, record: &Record) -> Result<(), String> {","-        let url = record.job.pr.clone().ok_or(\"the job has no pull request\")?;","-        let ws = self.workspace(record).await?;","-        let pr = self.pr_text(record, &ws.branch).await?;","-        let hub = forge::GitHub {","-            engine: &*self.engine,","-            slug: self.slug(record).await?,","-        };","-        hub.edit(&url, &pr.body).await?;","-        hub.merge(&url).await?;","-        self.keep_merge_commit(record, &hub, &url).await;","-        // Best effort: a workspace with local changes keeps them and stays behind.","-        let pull = [\"pull\", \"-q\", \"--ff-only\", \"origin\", &ws.branch];","-        let _ = self.machine.run(\"git\", &pull, Some(Path::new(&ws.path)));","-        let _ = self.sweep_reverts().await;","-        Ok(())","-    }","-}","-","-/// Polls with no deployment of the merge commit before a deploy counts as","-/// one nothing watches: two minutes at one poll each 20 s.","-const NO_DEPLOY_POLLS: u32 = 6;","-","-/// What one poll of the merge commit's deployment says, and the note to keep:","-/// none while it runs, or while one may still appear.","-fn deploy_outcome(","-    found: Result<Option<forge::Deployment>, String>,","-    polls: u32,","-    sha: &str,","-) -> Option<(Event, String)> {","-    let short = &sha[..sha.len().min(7)];","-    match found {","-        Ok(Some(d)) if d.state == forge::Deployed::Succeeded => {","-            let at = d.url.map(|u| format!(\" at <{u}>\")).unwrap_or_default();","-            Some((Event::StepPassed, format!(\"Deployed {short}{at}.\")))","-        }","-        Ok(Some(d)) if d.state == forge::Deployed::Failed => {","-            let detail = format!(\"The deployment of {short} failed.\");","-            Some((","-                Event::StepStuck {","-                    detail: detail.clone(),","-                },","-                detail,","-            ))","-        }","-        Ok(None) if polls >= NO_DEPLOY_POLLS => {","-            let note = format!(\"Nothing deployed {short}, so there was nothing to watch.\");","-            Some((Event::StepPassed, note))","-        }","-        Err(detail) => Some((","-            Event::StepStuck {","-                detail: detail.clone(),","-            },","-            detail,","-        )),","-        _ => None,","-    }","-}","-","-#[cfg(test)]","-