he change.\", 0),","+            node(\"tests\", Stage::Shell, \"make test\", \"\", 100),","+            pr,","+        ],","+        links: Vec::new(),","+    };","+    assert_eq!(g.check(), Ok(()), \"no land step is needed\");","+    let mut j = job(Pipeline::Short).running(g.steps().unwrap());","+    j.state = State::Running;","+    let (j, _) = go(&j, &done());","+    assert_eq!(j.node.as_deref(), Some(\"tests\"));","+    let (j, _) = go(&j, &Event::Ran { output: \"ok\".into() });","+    assert_eq!(j.node.as_deref(), Some(\"pr\"));","+    assert!(j.step().unwrap().reach.network);","+    let (j, effects) = go(&j, &Event::Ran { output: \"opened\".into() });","+    assert_eq!((j.state, effects), (State::Running, vec![Effect::Finish]));","+    let (stuck, _) = go(&j, &Event::LandFailed { error: \"conflict\".into() });","+    assert_eq!(stuck.state, State::NeedsYou);","+    let (landed, effects) = go(&j, &Event::Landed);","+    assert_eq!((landed.state, effects), (State::Landed, vec![Effect::Teardown]));","+    let mut bad = g.clone();","+    bad.nodes[0].reach.network = true;","+    assert!(bad.check().unwrap_err().contains(\"only a shell step\"));","+    let mut bad = g;","+    bad.nodes[2].reach.secrets = vec![\"gh token\".into()];","+    assert!(bad.check().unwrap_err().contains(\"not a secret's name\"));","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/full_tests.rs"]}},"serverClassifierContext":{"request":"5100fb70-3f15-47ae-9fa7-f7c911a140b0","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"fa3e1b4c-e5ed-4c66-880c-ff80aae