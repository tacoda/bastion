{"parentUuid":"7a33c464-f9da-4de8-82fb-362d12d3cbcf","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PreToolUse:Bash","toolUseID":"toolu_011MBxrmjtcRhwYYdDm8UV2f","hookEvent":"PreToolUse","content":"","stdout":"{}\n","stderr":"","exitCode":0,"command":"if [ -n \"${CMUX_CLAUDE_HOOK_SPOOL_DIR:-}\" ] && [ -x /bin/zsh ]; then exec /bin/zsh -fc 'LC_ALL=C␤export CMUX_CLAUDE_PID=${CMUX_CLAUDE_PID:-$PPID}␤export CMUX_AGENT_HOOK_INVOKER_PID=$PPID␤cmux_fallback() { { print -rn -- \"$cmux_p\"; /bin/cat; } | /bin/sh -c \"$1\" >&3; exit $?; }␤zmodload zsh/system zsh/datetime zsh/files 2>/dev/null || exec /bin/sh -c \"$1\" >&3␤cmux_p= cmux_c= cmux_e=0␤while (( ${#cmux_p} < 262144 )); do sysread -i 0 -s 65536 cmux_c || { cmux_e=$?; break; }; cmux_p+=$cmux_c; done␤[[ -n ${CMUX_SURFACE_ID:-} && ${CMUX_CLAUDE_HOOKS_DISABLED:-} != 1 ]] || { (( cmux_e == 5 )) || /bin/cat >/dev/null; print -r -- '\\''{}'\\'' >&3; exit 0; }␤cmux_d=$CMUX_CLAUDE_HOOK_SPOOL_DIR␤(( cmux_e == 5 )) && [[ -f $cmux_d/keys ]] || cmux_fallback \"$1\"␤cmux_r=\"cmux-agent-hook-v1\"$'\\''\\n'\\''\"claude\"$'\\''\\n'\\''\"$2\"$'\\''\\n'\\''␤for cmux_k in ${(f)\"$(<$cmux_d/keys)\"}; do (( ${+parameters[$cmux_k]} )) && cmux_r+=\"$cmux_k=${(P)cmux_k}\"$'\\''\\0'\\''; done␤cmux_r+=$'\\''\\0'\\''\"$cmux_p\"␤(( ${#cmux_r} <= 524288 )) || cmux_fallback \"$1\"␤umask 077␤cmux_n=$cmux_d/$epochtime[1].$epochtime[2]-$$␤{ print -rn -- \"$cmux_r\" >| $cmux_n.tmp && mv -f -- $cmux_n.tmp $cmux_n.rec; } 2>/dev/null || { rm -f -- $cmux_n.tmp 2>/dev/null; cmux_fallback \"$1\"; }␤if zsystem flock -t 0 -r -f cmux_l $cmux_d/forwarder.lock 2>/dev/null; then␤  zsystem flock -u $cmux_l␤  rm -- $cmux_n.rec 2>/dev/null && cmux_fallback \"$1\"␤fi␤print -r -- '\\''{}'\\'' >&3' cmux-hook 'cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' pre-tool-use 3>&1 1>&2; else cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi","durationMs":41},"type":"attachment","uuid":"04b7adda-94d4-44c9-97ff-ee43ae39ac40","timestamp":"2026-11-11T21:36:57.719Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"7a33c464-f9da-4de8-82fb-362d12d3cbcf","isSidechain":false,"promptId":"1d9ef2db-03d5-4a58-b720-e211c5a548e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011MBxrmjtcRhwYYdDm8UV2f","type":"tool_result","content":"    }\n}\n\n/// What a step's one text box holds.\n#[derive(Clone, Copy, Debug, PartialEq)]\nenum Text {\n    /// The instructions, or for a stage, its instructions in place of the\n    /// built-in ones.\n    Note,\n    /// A shell step's script.\n    Script,\n    /// A step Bastion does itself, with nothing to write.\n    Nothing,\n}\n\nfn text_of(n: &bastion_protocol::NodeView) -> Text {\n    let custom = CUSTOM.iter().any(|(s, _)| *s == n.stage);\n    match n.stage.as_str() {\n        \"shell\" => Text::Script,\n        _ if custom || !n.builtin.is_empty() => Text::Note,\n        _ => Text::Nothing,\n    }\n}\n\n/// The text a step's box starts with: its script, its note, or a stage's\n/// built-in instructions while the note is empty.\nfn shown(n: &bastion_protocol::NodeView) -> String {\n    match text_of(n) {\n        Text::Script => n.run.clone(),\n        Text::Note if n.note.trim().is_empty() => n.builtin.clone(),\n        Text::Note => n.note.clone(),\n        Text::Nothing => String::new(),\n    }\n}\n\n/// Keep what was typed: a script as the step's run, instructions as its\n/// note, and instructions left as built in as no note, so the step keeps\n/// following the built-in ones.\nfn keep_text(n: &mut bastion_protocol::NodeView, typed: String) {\n    match text_of(n) {\n        Text::Script => n.run = typed,\n        Text::Note if !n.builtin.is_empty() && typed.trim() == n.builtin.trim() => n.note.clear(),\n        Text::Note => n.note = typed,\n        Text::Nothing => {}\n    }\n}\n\n/// A Bastion stage's built-in instructions, as any workflow shown has them.\nfn builtin_of(all: &[WorkflowView], stage: &str) -> String {\n    all.iter()\n        .flat_map(|w| &w.nodes)\n        .find(|n| n.stage == stage && !n.builtin.is_empty())\n        .map(|n| n.builtin.clone())\n        .unwrap_or_default()\n}\n\nfn on_pointer(state: &mut State, p: Pointer) {\n    let editable = state.editable();\n    let Some(w) = state.draft.as_mut() else {\n        return;\n    };\n}\n\nfn change(state: &mut State, msg: Msg) {\n    match msg {\n        Msg::Pointer(p) => on_pointer(state, p),\n        Msg::AddStep(stage) => state\n            .draft\n            .iter_mut()\n            .for_each(|w| edit::add_step(w, &stage)),\n        Msg::Field(f, v) => on_field(state, f, v),\n        Msg::Kind(_) if !state.editable() => {}\n        Msg::Kind(c) => {\n            let builtin = builtin_of(&state.all, &c.id);\n            state.step(|n| (n.stage, n.builtin) = (c.id, builtin));\n            state.pick(state.picked.clone());\n        }\n        Msg::Network(on) => state.step(|n| n.reach.network = on),\n        Msg::ReadsOnly(on) => state.step(|n| n.reach.reads_only = on),\n        Msg::Text(a) => {\n            state.text.perform(a);\n            let typed = state.text.text();\n        other => change(state, other),\n    }\n    Task::none()\n}\n\n/// The shown workflow's facts: built in or not, its version and its level.\nfn facts(w: &WorkflowView) -> String {\n    let kind = if w.built_in {\n        \"built in, copy it to change it\"\n    } else {\n        \"yours to change\"\n    };\n    let level = w.level.replace('_', \" \").replace(\"lights on\", \"lights-on\");\n    format!(\"{kind} · version {} · runs {level}\", w.version)\n}\n\nfn small<'a>(label: &'a str, msg: Option<Message>) -> Element<'a, Message> {\n    button(text(label).size(13))\n        .padding([4, 12])\n        .style(theme::secondary)\n        .on_press_maybe(msg)\n        .into()\n}\n\nfn chooser(state: &State) -> Element<'_, Message> {\n    let all: Vec<Choice> = state\n        .all\n        .iter()\n        .map(|w| Choice::new(&w.id, &w.name))\n        .collect();\n    let shown = all.iter().find(|c| c.id == state.chosen).cloned();\n    let pick = pick_list(all, shown, |c| wrap(Msg::Choose(c))).style(theme::select);\n    let facts = text(state.draft.as_ref().map(facts).unwrap_or_default())\n        .size(13)\n        .color(theme::MUTED);\n    row![pick, facts].spacing(12).align_y(iced::Center).into()\n}\n\n/// What deleting the shown workflow does: a changed built-in resets to\n/// the original, one of the owner's goes, and an unchanged built-in stays.\nfn delete_label(w: &WorkflowView) -> Option<&'static str> {\n    match (w.ships, w.built_in) {\n        (true, true) => None,\n        (true, false) => Some(\"Reset to the original\"),\n        (false, _) => Some(\"Delete\"),\n    }\n}\n\n/// Start a new workflow, or copy the shown one, under the name typed; and\n/// delete or reset the shown one.\nfn manage_view(state: &State) -> Element<'_, Message> {\n    match stage {\n        \"agent\" => Some(\"Agent: a file in .claude/agents, without .md\"),\n        \"skill\" => Some(\"Skill: a folder in .claude/skills\"),\n        \"command\" => Some(\"Command: a file in .claude/commands, without .md\"),\n        _ => None,\n    }\n}\n\n/// What the step's one text box is for.\nfn text_label(n: &bastion_protocol::NodeView) -> &'static str {\n    match (text_of(n), n.stage.as_str()) {\n        (Text::Script, _) => \"Script, run by sh in the repository in the job's VM\",\n        (Text::Note, \"prompt\") => \"Instructions\",\n        (Text::Note, _) if !n.builtin.is_empty() => {\n            \"Instructions (Bastion's own until you change them; clear to restore)\"\n        }\n        (Text::Note, _) => \"Added instructions (optional)\",\n        (Text::Nothing, _) => \"Bastion does this step itself; it runs no agent and no script.\",\n    }\n}\n\n/// How a step runs: its kind, its dial, and an agent's, skill's or\n/// command's name.\nfn how_row<'a>(n: &bastion_protocol::NodeView, editable: bool) -> Element<'a, Message> {\n    let all = kinds(&n.stage);\n    let kind = all.iter().find(|c| c.id == n.stage).cloned();\n                .padding([8, 12])\n                .style(theme::primary)\n                .on_press(wrap(Msg::Save)),\n        );\n    }\n    scrolled(body.push(text(&state.said).size(13).color(theme::MUTED)))\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn workflow(id: &str, version: u64, built_in: bool) -> WorkflowView {\n        WorkflowView {\n            id: id.into(),\n            name: id.into(),\n            version,\n            built_in,\n            ..WorkflowView::default()\n        }\n    }\n\n    #[test]\n    fn a_draft_stays_until_the_server_keeps_a_new_version() {\n        let mut state = State {\n            all: vec![workflow(\"short\", 1, true), workflow(\"mine\", 1, false)],\n            ..State::default()\n        };\n        state.show_latest();\n        assert_eq!(state.chosen, \"short\");\n        state.chosen = \"mine\".into();\n        state.draft = None;\n        state.show_latest();\n        state.draft.as_mut().unwrap().name = \"edited\".into();\n        state.show_latest();\n        assert_eq!(\n            state.draft.as_ref().unwrap().name,\n            \"edited\",\n            \"the same version keeps the draft\"\n        );\n        state.all[1].version = 2;\n        state.show_latest();\n        assert_eq!(state.draft.as_ref().unwrap().version, 2);\n        assert_eq!(state.draft.as_ref().unwrap().name, \"mine\");\n    }\n\n    #[test]\n    fn an_admin_changes_any_workflow_and_resets_a_changed_built_in() {\n        let mut state = State {\n            draft: Some(workflow(\"mine\", 1, false)),\n            ..State::default()\n        };\n        assert!(!state.editable());\n        state.admin = true;\n        assert!(state.editable());\n        let mut short = workflow(\"short\", 0, true);\n        short.ships = true;\n        state.draft = Some(short.clone());\n        assert!(state.editable(), \"a built-in is changed as the admin's\");\n        assert_eq!(delete_label(&short), None);\n        short.built_in = false;\n        assert_eq!(delete_label(&short), Some(\"Reset to the original\"));\n        assert_eq!(delete_label(&workflow(\"mine\", 1, false)), Some(\"Delete\"));\n    }\n\n    #[test]\n    fn results_are_kept_as_typed_and_stored_as_a_list() {\n        let mut w = workflow(\"mine\", 1, false);\n        edit::add_step(&mut w, \"plan\");\n        let mut state = State {\n            draft: Some(w),\n            admin: true,\n            ..State::default()\n        };\n        state.pick(Pick::Step(\"plan\".into()));\n        on_field(&mut state, StepField::Results, \"design-notes, \".into());\n        assert_eq!(state.results, \"design-notes, \");\n        assert_eq!(state.draft.unwrap().nodes[0].results, [\"design-notes\"]);\n    }\n\n    #[test]\n    fn a_step_is_renamed_with_its_links_once_the_name_is_free() {\n        let mut w = workflow(\"mine\", 1, false);\n        edit::add_step(&mut w, \"prompt\");\n        edit::add_step(&mut w, \"shell\");\n        assert_eq!(\n            (w.nodes[0].id.as_str(), w.nodes[1].id.as_str()),\n            (\"step\", \"step2\")\n        );\n        edit::add_link(&mut w, \"step\", \"step2\");\n        let mut state = State {\n            draft: Some(w),\n            admin: true,\n            ..State::default()\n        };\n        state.pick(Pick::Step(\"step\".into()));\n        on_field(&mut state, StepField::Name, \"step2\".into());\n        assert_eq!(\n            state.picked,\n            Pick::Step(\"step\".into()),\n            \"a taken name waits\"\n        );\n        on_field(&mut state, StepField::Name, \"plan\".into());\n        let w = state.draft.as_ref().unwrap();\n        assert_eq!(\n            (w.nodes[0].id.as_str(), w.links[0].from.as_str()),\n            (\"plan\", \"plan\")\n        );\n        assert_eq!(state.picked, Pick::Step(\"plan\".into()));\n    }\n\n    #[test]\n    fn a_step_shows_its_text_and_keeps_only_what_differs_from_the_built_in() {\n        let mut w = workflow(\"mine\", 1, false);\n        edit::add_step(&mut w, \"plan\");\n        w.nodes[0].builtin = \"Plan the change.\".into();\n        let mut short = workflow(\"short\", 1, true);\n        short.nodes = w.nodes.clone();\n        let mut state = State {\n            all: vec![short],\n            draft: Some(w),\n            admin: true,\n            ..State::default()\n        };\n        let node = |state: &State| state.draft.as_ref().unwrap().nodes[0].clone();\n        state.pick(Pick::Step(\"plan\".into()));\n        assert_eq!(state.text.text(), \"Plan the change.\", \"the built-in shows\");\n        let typed = |state: &mut State, words: &str| {\n            state.text = text_editor::Content::with_text(words);\n            let words = state.text.text();\n            state.step(|n| keep_text(n, words));\n        };\n        typed(&mut state, \"Plan in three lines.\");\n        assert_eq!(node(&state).note, \"Plan in three lines.\");\n        typed(&mut state, \"Plan the change.\");\n        assert_eq!(\n            node(&state).note,\n            \"\",\n            \"the built-in text is kept as no note\"\n        );\n        change(&mut state, Msg::Kind(Choice::new(\"shell\", \"Shell script\")));\n        assert_eq!(\n            (node(&state).stage.as_str(), node(&state).builtin.as_str()),\n            (\"shell\", \"\")\n        );\n        typed(&mut state, \"make lint\\nmake test\");\n        assert_eq!(\n            node(&state).run,\n            \"make lint\\nmake test\",\n            \"a script is the step's run\"\n        );\n        change(&mut state, Msg::Kind(Choice::new(\"plan\", \"plan\")));\n        assert_eq!(\n            node(&state).builtin,\n            \"Plan the change.\",\n            \"a stage finds its built-in\"\n        );\n        state.admin = false;\n        change(&mut state, Msg::Kind(Choice::new(\"prompt\", \"Prompt\")));\n        assert_eq!(node(&state).stage, \"plan\", \"a reader cannot change a step\");\n    }\n}","is_error":false}]},"uuid":"5915b4ff-80ec-4d05-bd3e-9e188175f8a1","timestamp":"2026-11-11T21:36:58.510Z","toolUseResult":{"stdout":"    }\n}\n\n/// What a step's one text box holds.\n#[derive(Clone, Copy, Debug, PartialEq)]\nenum Text {\n    /// The instructions, or for a stage, its instructions in place of the\n    /// built-in ones.\n    Note,\n    /// A shell step's script.\n    Script,\n    /// A step Bastion does itself, with nothing to write.\n    Nothing,\n}\n\nfn text_of(n: &bastion_protocol::NodeView) -> Text {\n    let custom = CUSTOM.iter().any(|(s, _)| *s == n.stage);\n    match n.stage.as_str() {\n        \"shell\" => Text::Script,\n        _ if custom || !n.builtin.is_empty() => Text::Note,\n        _ => Text::Nothing,\n    }\n}\n\n/// The text a step's box starts with: its script, its note, or a stage's\n/// built-in instructions while the note is empty.\nfn shown(n: &bastion_protocol::NodeView) -> String {\n    match text_of(n) {\n        Text::Script => n.run.clone(),\n        Text::Note if n.note.trim().is_empty() => n.builtin.clone(),\n        Text::Note => n.note.clone(),\n        Text::Nothing => String::new(),\n    }\n}\n\n/// Keep what was typed: a script as the step's run, instructions as its\n/// note, and instructions left as built in as no note, so the step keeps\n/// following the built-in ones.\nfn keep_text(n: &mut bastion_protocol::NodeView, typed: String) {\n    match text_of(n) {\n        Text::Script => n.run = typed,\n        Text::Note if !n.builtin.is_empty() && typed.trim() == n.builtin.trim() => n.note.clear(),\n        Text::Note => n.note = typed,\n        Text::Nothing => {}\n    }\n}\n\n/// A Bastion stage's built-in instructions, as any workflow shown has them.\nfn builtin_of(all: &[WorkflowView], stage: &str) -> String {\n    all.iter()\n        .flat_map(|w| &w.nodes)\n        .find(|n| n.stage == stage && !n.builtin.is_empty())\n        .map(|n| n.builtin.clone())\n        .unwrap_or_default()\n}\n\nfn on_pointer(state: &mut State, p: Pointer) {\n    let editable = state.editable();\n    let Some(w) = state.draft.as_mut() else {\n        return;\n    };\n}\n\nfn change(state: &mut State, msg: Msg) {\n    match msg {\n        Msg::Pointer(p) => on_pointer(state, p),\n        Msg::AddStep(stage) => state\n            .draft\n            .iter_mut()\n            .for_each(|w| edit::add_step(w, &stage)),\n        Msg::Field(f, v) => on_field(state, f, v),\n        Msg::Kind(_) if !state.editable() => {}\n        Msg::Kind(c) => {\n            let builtin = builtin_of(&state.all, &c.id);\n            state.step(|n| (n.stage, n.builtin) = (c.id, builtin));\n            state.pick(state.picked.clone());\n        }\n        Msg::Network(on) => state.step(|n| n.reach.network = on),\n        Msg::ReadsOnly(on) => state.step(|n| n.reach.reads_only = on),\n        Msg::Text(a) => {\n            state.text.perform(a);\n            let typed = state.text.text();\n        other => change(state, other),\n    }\n    Task::none()\n}\n\n/// The shown workflow's facts: built in or not, its version and its level.\nfn facts(w: &WorkflowView) -> String {\n    let kind = if w.built_in {\n        \"built in, copy it to change it\"\n    } else {\n        \"yours to change\"\n    };\n    let level = w.level.replace('_', \" \").replace(\"lights on\", \"lights-on\");\n    format!(\"{kind} · version {} · runs {level}\", w.version)\n}\n\nfn small<'a>(label: &'a str, msg: Option<Message>) -> Element<'a, Message> {\n    button(text(label).size(13))\n        .padding([4, 12])\n        .style(theme::secondary)\n        .on_press_maybe(msg)\n        .into()\n}\n\nfn chooser(state: &State) -> Element<'_, Message> {\n    let all: Vec<Choice> = state\n        .all\n        .iter()\n        .map(|w| Choice::new(&w.id, &w.name))\n        .collect();\n    let shown = all.iter().find(|c| c.id == state.chosen).cloned();\n    let pick = pick_list(all, shown, |c| wrap(Msg::Choose(c))).style(theme::select);\n    let facts = text(state.draft.as_ref().map(facts).unwrap_or_default())\n        .size(13)\n        .color(theme::MUTED);\n    row![pick, facts].spacing(12).align_y(iced::Center).into()\n}\n\n/// What deleting the shown workflow does: a changed built-in resets to\n/// the original, one of the owner's goes, and an unchanged built-in stays.\nfn delete_label(w: &WorkflowView) -> Option<&'static str> {\n    match (w.ships, w.built_in) {\n        (true, true) => None,\n        (true, false) => Some(\"Reset to the original\"),\n        (false, _) => Some(\"Delete\"),\n    }\n}\n\n/// Start a new workflow, or copy the shown one, under the name typed; and\n/// delete or reset the shown one.\nfn manage_view(state: &State) -> Element<'_, Message> {\n    match stage {\n        \"agent\" => Some(\"Agent: a file in .claude/agents, without .md\"),\n        \"skill\" => Some(\"Skill: a folder in .claude/skills\"),\n        \"command\" => Some(\"Command: a file in .claude/commands, without .md\"),\n        _ => None,\n    }\n}\n\n/// What the step's one text box is for.\nfn text_label(n: &bastion_protocol::NodeView) -> &'static str {\n    match (text_of(n), n.stage.as_str()) {\n        (Text::Script, _) => \"Script, run by sh in the repository in the job's VM\",\n        (Text::Note, \"prompt\") => \"Instructions\",\n        (Text::Note, _) if !n.builtin.is_empty() => {\n            \"Instructions (Bastion's own until you change them; clear to restore)\"\n        }\n        (Text::Note, _) => \"Added instructions (optional)\",\n        (Text::Nothing, _) => \"Bastion does this step itself; it runs no agent and no script.\",\n    }\n}\n\n/// How a step runs: its kind, its dial, and an agent's, skill's or\n/// command's name.\nfn how_row<'a>(n: &bastion_protocol::NodeView, editable: bool) -> Element<'a, Message> {\n    let all = kinds(&n.stage);\n    let kind = all.iter().find(|c| c.id == n.stage).cloned();\n                .padding([8, 12])\n                .style(theme::primary)\n                .on_press(wrap(Msg::Save)),\n        );\n    }\n    scrolled(body.push(text(&state.said).size(13).color(theme::MUTED)))\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn workflow(id: &str, version: u64, built_in: bool) -> WorkflowView {\n        WorkflowView {\n            id: id.into(),\n            name: id.into(),\n            version,\n            built_in,\n            ..WorkflowView::default()\n        }\n    }\n\n    #[test]\n    fn a_draft_stays_until_the_server_keeps_a_new_version() {\n        let mut state = State {\n            all: vec![workflow(\"short\", 1, true), workflow(\"mine\", 1, false)],\n            ..State::default()\n        };\n        state.show_latest();\n        assert_eq!(state.chosen, \"short\");\n        state.chosen = \"mine\".into();\n        state.draft = None;\n        state.show_latest();\n        state.draft.as_mut().unwrap().name = \"edited\".into();\n        state.show_latest();\n        assert_eq!(\n            state.draft.as_ref().unwrap().name,\n            \"edited\",\n            \"the same version keeps the draft\"\n        );\n        state.all[1].version = 2;\n        state.show_latest();\n        assert_eq!(state.draft.as_ref().unwrap().version, 2);\n        assert_eq!(state.draft.as_ref().unwrap().name, \"mine\");\n    }\n\n    #[test]\n    fn an_admin_changes_any_workflow_and_resets_a_changed_built_in() {\n        let mut state = State {\n            draft: Some(workflow(\"mine\", 1, false)),\n            ..State::default()\n        };\n        assert!(!state.editable());\n        state.admin = true;\n        assert!(state.editable());\n        let mut short = workflow(\"short\", 0, true);\n        short.ships = true;\n        state.draft = Some(short.clone());\n        assert!(state.editable(), \"a built-in is changed as the admin's\");\n        assert_eq!(delete_label(&short), None);\n        short.built_in = false;\n        assert_eq!(delete_label(&short), Some(\"Reset to the original\"));\n        assert_eq!(delete_label(&workflow(\"mine\", 1, false)), Some(\"Delete\"));\n    }\n\n    #[test]\n    fn results_are_kept_as_typed_and_stored_as_a_list() {\n        let mut w = workflow(\"mine\", 1, false);\n        edit::add_step(&mut w, \"plan\");\n        let mut state = State {\n            draft: Some(w),\n            admin: true,\n            ..State::default()\n        };\n        state.pick(Pick::Step(\"plan\".into()));\n        on_field(&mut state, StepField::Results, \"design-notes, \".into());\n        assert_eq!(state.results, \"design-notes, \");\n        assert_eq!(state.draft.unwrap().nodes[0].results, [\"design-notes\"]);\n    }\n\n    #[test]\n    fn a_step_is_renamed_with_its_links_once_the_name_is_free() {\n        let mut w = workflow(\"mine\", 1, false);\n        edit::add_step(&mut w, \"prompt\");\n        edit::add_step(&mut w, \"shell\");\n        assert_eq!(\n            (w.nodes[0].id.as_str(), w.nodes[1].id.as_str()),\n            (\"step\", \"step2\")\n        );\n        edit::add_link(&mut w, \"step\", \"step2\");\n        let mut state = State {\n            draft: Some(w),\n            admin: true,\n            ..State::default()\n        };\n        state.pick(Pick::Step(\"step\".into()));\n        on_field(&mut state, StepField::Name, \"step2\".into());\n        assert_eq!(\n            state.picked,\n            Pick::Step(\"step\".into()),\n            \"a taken name waits\"\n        );\n        on_field(&mut state, StepField::Name, \"plan\".into());\n        let w = state.draft.as_ref().unwrap();\n        assert_eq!(\n            (w.nodes[0].id.as_str(), w.links[0].from.as_str()),\n            (\"plan\", \"plan\")\n        );\n        assert_eq!(state.picked, Pick::Step(\"plan\".into()));\n    }\n\n    #[test]\n    fn a_step_shows_its_text_and_keeps_only_what_differs_from_the_built_in() {\n        let mut w = workflow(\"mine\", 1, false);\n        edit::add_step(&mut w, \"plan\");\n        w.nodes[0].builtin = \"Plan the change.\".into();\n        let mut short = workflow(\"short\", 1, true);\n        short.nodes = w.nodes.clone();\n        let mut state = State {\n            all: vec![short],\n            draft: Some(w),\n            admin: true,\n            ..State::default()\n        };\n        let node = |state: &State| state.draft.as_ref().unwrap().nodes[0].clone();\n        state.pick(Pick::Step(\"plan\".into()));\n        assert_eq!(state.text.text(), \"Plan the change.\", \"the built-in shows\");\n        let typed = |state: &mut State, words: &str| {\n            state.text = text_editor::Content::with_text(words);\n            let words = state.text.text();\n            state.step(|n| keep_text(n, words));\n        };\n        typed(&mut state, \"Plan in three lines.\");\n        assert_eq!(node(&state).note, \"Plan in three lines.\");\n        typed(&mut state, \"Plan the change.\");\n        assert_eq!(\n            node(&state).note,\n            \"\",\n            \"the built-in text is kept as no note\"\n        );\n        change(&mut state, Msg::Kind(Choice::new(\"shell\", \"Shell script\")));\n        assert_eq!(\n            (node(&state).stage.as_str(), node(&state).builtin.as_str()),\n            (\"shell\", \"\")\n        );\n        typed(&mut state, \"make lint\\nmake test\");\n        assert_eq!(\n            node(&state).run,\n            \"make lint\\nmake test\",\n            \"a script is the step's run\"\n        );\n        change(&mut state, Msg::Kind(Choice::new(\"plan\", \"plan\")));\n        assert_eq!(\n            node(&state).builtin,\n            \"Plan the change.\",\n            \"a stage finds its built-in\"\n        );\n        state.admin = false;\n        change(&mut state, Msg::Kind(Choice::new(\"prompt\", \"Prompt\")));\n        assert_eq!(node(&state).stage, \"plan\", \"a reader cannot change a step\");\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"cd90d515-63f8-4496-902f-323fb01e2