                   </li>","                 }","             }).collect_view()}"]},{"oldStart":131,"oldLines":6,"newStart":155,"newLines":72,"lines":["     }"," }"," ","+#[derive(Serialize)]","+struct AddArgs {","+    constraint: ConstraintView,","+}","+","+/// The form to add an owner's constraint.","+#[component]","+fn AddConstraint(","+    added: impl Fn(Result<(), String>) + Copy + Send + Sync + 'static,","+) -> impl IntoView {","+    let field = |label: &'static str, hint: &'static str, value: RwSignal<String>| {","+        view! {","+            <label class=\"grid gap-1 text-xs text-muted\">{label}","+                <input class=\"rounded border border-line bg-bg px-2 py-1 text-sm text-ink\" placeholder=hint spellcheck=\"false\"","+                    prop:value=value on:input=move |e| value.set(event_target_value(&e)) />","+            </label>","+        }","+    };","+    let (id, rule, function, contains) = (","+        RwSignal::new(String::new()),","+        RwSignal::new(String::new()),","+        RwSignal::new(String::new()),","+        RwSignal::new(String::new()),","+    );","+    let rung = RwSignal::new(\"told\".to_string());","+    let submit = move |_| {","+        let constraint = ConstraintView {","+            id: id.get_untracked(),","+            rule: rule.get_untracked(),","+            function: function.get_untracked(),","+            contains: contains.get_untracked(),","+            rung: rung.get_untracked(),","+            source: \"owner\".into(),","+        };","+        send(","+            command::CONSTRAINT_ADD,","+            AddArgs { constraint },","+            move |result| {","+                if result.is_ok() {","+                    for s in [id, rule, function, contains] {","+                        s.set(String::new());","+                    }","+                }","+                added(result)","+            },","+        );","+    };","+    view! {","+        <details class=\"mb-4 rounded-xl border border-line bg-panel\">","+            <summary class=\"cursor-pointer px-3 py-2 text-sm font-semibold text-muted\">\"Add a constraint\"</summary>","+            <div class=\"grid gap-2 p-3 sm:grid-cols-2\">","+                {field(\"Id\", \"no-curl\", id)}","+                {field(\"Rule the agent is told\", \"Do not fetch from the network.\", rule)}","+                {field(\"Calls it binds (empty binds none)\", \"sandbox::exec\", function)}","+                {field(\"Words the call holds, in order\", \"curl\", contains)}","+                <label class=\"grid gap-1 text-xs text-muted\">\"Rung\"","+                    <select class=\"rounded border border-line bg-bg px-2 py-1 text-sm text-ink\" on:change=move |e| rung.set(event_target_value(&e))>","+                        {[\"told\", \"checked\", \"enforced\"].map(|r| view! { <option value=r selected=move || rung.get() == r>{r}</option> })}","+                    </select>","+                </label>","+                <div class=\"flex items-end\"><button class=STEP on:click=submit>\"Add\"</button></div>","+            </div>","+        </details>","+    }","+}","+"," #[component]"," fn GrantsList(","     grants: ReadSignal<Vec<CapabilityView>>,"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/src/pages/govern.rs"]}},"serverClassifierContext":{"request":"6fe0b43f-769d-4b1d-89fb-1e7deb23716f","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"2a658cfd-1ce0-408b-8201-36261d91b4a5","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sess