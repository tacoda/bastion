ind::Turn && n.reach.reads_only {\n        return Err(format!(\"{}: only an agent's step reads only\", n.id));\n    }'''),\n])\ned('crates/bastion-core/src/notice.rs',[\n('''    let stage = format!(\"{:?}\", job.stage).to_lowercase();''','''    // A workflow's step goes by its name; an old pipeline's by its stage.\n    let stage = job\n        .node\n        .clone()\n        .unwrap_or_else(|| format!(\"{:?}\", job.stage).to_lowercase());'''),\n])\ned('crates/bastion-server/src/factory.rs',[\n('''\"metadata\": { \"sandbox_id\": sandbox, \"job\": job.id, \"stage\": stage } },''','''\"metadata\": { \"sandbox_id\": sandbox, \"job\": job.id, \"stage\": stage, \"reads_only\": job.step().is_some_and(|s| s.reach.reads_only) } },'''),\n])\ned('crates/bastion-server/src/gate.rs',[\n('''        self.note(\"gate\", &job, bastion_core::eval::describe(&call, &verdict));''','''        let verdict = reads_only(envelope, &call, verdict);\n        self.note(\"gate\", &job, bastion_core::eval::describe(&call, &verdict));'''),\n])\ns=open('crates/bastion-server/src/gate.rs').read()\ni=s.index('    /// The hook: decide one call, pin it to the job')\nj=s.rfind('\\nimpl ',0,i)\ns=s[:j]+'''\n/// A step that only reads (D42) may not write a file, whatever its kind's\n/// grants allow.\nfn reads_only(envelope: &Value, call: &Call, verdict: Verdict) -> Verdict {\n    let narrowed = envelope[\"metadata\"][\"reads_only\"] == true;\n    match narrowed && call.function == \"sandbox::fs::write\" {\n        true => Verdict {\n            decision: Decision::Deny {\n                reason: \"This step only reads: it may not write a file.\".into(),\n            },\n            ..verdict\n        },\n        false => verdict,\n    }\n}\n'''+s[j:]\nopen('crates/bastion-server/src/gate.rs','w').write(s)\nEOF\ngrep -n \"^use bastion_core::govern\\|Call\\b\" crates/bastion-server/src/gate.rs | head -4; CARGO_INCREMENTAL=0 cargo build -q -p bastion-server 2>&1 | grep -E \"^error\" -A8 | head -20","descri