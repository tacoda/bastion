j1\");","+        assert_eq!(state.shown(None)[0].job.id, \"j1\");","     }"," ","     #[test]"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/app.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/jobs.rs"]}},"serverClassifierContext":{"request":"fac8f042-d867-4bf6-b90e-1682bc15a017","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":5,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","platform":"macos"}},"sourceToolAssistantUUID":"5733a83a-19aa-4471-8c2d-8ca8adc3e48a","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
