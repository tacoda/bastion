{"parentUuid":"f14b972a-642c-48dc-8245-35f79b817dbc","isSidechain":false,"promptId":"ee2f2cfc-2593-4c4c-adc6-7ac60d273c30","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017NuvKRj3uyXu7vvJqJniKP","type":"tool_result","content":"File created successfully at: /Users/tacoda/tacoda/bastion/crates/bastion-cli/src/update.rs (file state is current in your context — no need to Read it back)"}]},"uuid":"90318ca8-6213-4d20-ba24-573e5af6486e","timestamp":"2026-11-11T03:18:16.422Z","toolUseResult":{"type":"create","filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-cli/src/update.rs","content":"//! `bastion update` (F10): replace this install with the newest release,\n//! once the release's sums carry the release key's signature and the\n//! download matches its sum. A running server goes on with the old build\n//! until it is started again.\n\nuse std::path::{Path, PathBuf};\nuse std::process::Command;\n\nuse minisign_verify::{PublicKey, Signature};\nuse sha2::{Digest, Sha256};\n\nconst REPO: &str = \"https://github.com/tacoda/bastion\";\n/// The release key's public half; `scripts/minisign.pub` holds it.\nconst PUBKEY: &str = include_str!(\"../../../scripts/minisign.pub\");\n/// The version a release build carries; a dev build has none.\nconst VERSION: Option<&str> = option_env!(\"BASTION_VERSION\");\n\n/// What was installed, read from where this program runs.\n#[derive(Debug, PartialEq, Eq)]\nenum Install {\n    /// `Bastion.app`, at its path.\n    App(PathBuf),\n    /// A desktop or server tarball unpacked in `lib`, by its folder.\n    Tarball { lib: PathBuf, desktop: bool },\n}\n\nfn install_of(exe: &Path) -> Option<Install> {\n    let app = exe.ancestors().find(|a| a.extension().is_some_and(|e| e == \"app\"));\n    if let Some(app) = app {\n        return Some(Install::App(app.to_path_buf()));\n    }\n    let folder = exe.parent()?.parent()?;\n    let name = folder.file_name()?.to_str()?;\n    let lib = folder.parent()?.to_path_buf();\n    match name {\n        n if n.starts_with(\"bastion-desktop-\") => Some(Install::Tarball { lib, desktop: true }),\n        n if n.starts_with(\"bastion-\") => Some(Install::Tarball { lib, desktop: false }),\n        _ => None,\n    }\n}\n\n/// The release file for an install of `install` at `version` on `target`.\nfn asset(install: &Install, version: &str, target: &str) -> String {\n    let v = version.trim_start_matches('v');\n    match install {\n        Install::App(_) => format!(\"bastion-desktop-{v}-{target}.zip\"),\n        Install::Tarball { desktop: true, .. } => format!(\"bastion-desktop-{v}-{target}.tar.gz\"),\n        Install::Tarball { desktop: false, .. } => format!(\"bastion-{v}-{target}.tar.gz\"),\n    }\n}\n\n/// The sum `sums` lists for `file`.\nfn sum_of<'a>(sums: &'a str, file: &str) -> Option<&'a str> {\n    sums.lines().find_map(|l| {\n        let (sum, name) = l.split_once(char::is_whitespace)?;\n        (name.trim_start_matches(['*', ' ']) == file).then_some(sum)\n    })\n}\n\n/// Whether the sums carry the release key's signature.\nfn signed(sums: &[u8], signature: &str) -> Result<(), String> {\n    let key_line = PUBKEY.lines().find(|l| !l.starts_with(\"untrusted comment\")).unwrap_or_default();\n    let key = PublicKey::from_base64(key_line.trim())\n        .map_err(|_| \"this build has no release key, so it cannot check an update\".to_string())?;\n    let signature = Signature::decode(signature).map_err(|e| format!(\"the release's signature: {e}\"))?;\n    key.verify(sums, &signature, false)\n        .map_err(|_| \"the release's signature does not check; nothing was changed\".into())\n}\n\npub async fn run() -> Result<(), String> {\n    let Some(current) = VERSION else {\n        return Err(\"this is a dev build; update it with git pull and cargo build\".into());\n    };\n    let exe = std::env::current_exe().map_err(|e| e.to_string())?;\n    let exe = exe.canonicalize().unwrap_or(exe);\n    let install = install_of(&exe).ok_or_else(|| format!(\"{} is not an installed Bastion\", exe.display()))?;\n    let http = reqwest::Client::builder()\n        .redirect(reqwest::redirect::Policy::none())\n        .build()\n        .map_err(|e| e.to_string())?;\n    let newest = newest(&http).await?;\n    if newest.trim_start_matches('v') == current {\n        println!(\"Bastion {current} is the newest release\");\n        return Ok(());\n    }\n    let get = |file: String| fetch(newest.clone(), file);\n    let sums = get(\"SHA256SUMS\".into()).await?;\n    let signature = String::from_utf8_lossy(&get(\"SHA256SUMS.minisig\".into()).await?).to_string();\n    signed(&sums, &signature)?;\n    let target = env!(\"BASTION_TARGET\");\n    let file = asset(&install, &newest, target);\n    let bytes = get(file.clone()).await?;\n    let sums = String::from_utf8_lossy(&sums);\n    let want = sum_of(&sums, &file).ok_or_else(|| format!(\"{file} is not in the release's sums\"))?;\n    let got = format!(\"{:x}\", Sha256::digest(&bytes));\n    if got != want {\n        return Err(format!(\"{file} does not match its sum; nothing was changed\"));\n    }\n    replace(&install, &file, &bytes)?;\n    println!(\"Bastion {newest} is installed; start the server again to run it\");\n    Ok(())\n}\n\n/// The newest release's tag, from where `/releases/latest` points.\nasync fn newest(http: &reqwest::Client) -> Result<String, String> {\n    let answer = http.get(format!(\"{REPO}/releases/latest\")).send().await.map_err(|e| e.to_string())?;\n    let to = answer.headers().get(\"location\").and_then(|l| l.to_str().ok()).unwrap_or_default();\n    let tag = to.rsplit('/').next().unwrap_or_default();\n    match tag.starts_with('v') {\n        true => Ok(tag.to_string()),\n        false => Err(\"could not read the newest release\".into()),\n    }\n}\n\nasync fn fetch(tag: String, file: String) -> Result<Vec<u8>, String> {\n    let url = format!(\"{REPO}/releases/download/{tag}/{file}\");\n    let answer = reqwest::get(&url).await.map_err(|e| format!(\"{file}: {e}\"))?;\n    if !answer.status().is_success() {\n        return Err(format!(\"{file}: {}\", answer.status()));\n    }\n    Ok(answer.bytes().await.map_err(|e| e.to_string())?.to_vec())\n}\n\n/// Unpack the new release beside the old one, then put it in its place.\nfn replace(install: &Install, file: &str, bytes: &[u8]) -> Result<(), String> {\n    let work = std::env::temp_dir().join(format!(\"bastion-update-{}\", std::process::id()));\n    std::fs::create_dir_all(&work).map_err(|e| e.to_string())?;\n    let archive = work.join(file);\n    std::fs::write(&archive, bytes).map_err(|e| e.to_string())?;\n    let run = |program: &str, args: &[&str], at: &Path| -> Result<(), String> {\n        let ok = Command::new(program).args(args).current_dir(at).status().map_err(|e| e.to_string())?;\n        ok.success().then_some(()).ok_or(format!(\"{program} {}\", args.join(\" \")))\n    };\n    let path = archive.display().to_string();\n    match install {\n        Install::App(app) => {\n            run(\"unzip\", &[\"-q\", &path], &work)?;\n            let _ = std::fs::remove_dir_all(app);\n            std::fs::rename(work.join(\"Bastion.app\"), app).map_err(|e| e.to_string())\n        }\n        Install::Tarball { lib, .. } => {\n            run(\"tar\", &[\"-xzf\", &path], lib)?;\n            relink(lib, file)\n        }\n    }\n}\n\n/// Point the links in `~/.local/bin` (beside `lib`) at the new folder.\nfn relink(lib: &Path, file: &str) -> Result<(), String> {\n    let folder = file.trim_end_matches(\".tar.gz\").rsplit_once('-').map(|(f, _)| f).unwrap_or(file);\n    let folder = folder.rsplit_once('-').map(|(f, _)| f).unwrap_or(folder);\n    let new_bin = lib.join(folder.trim_end_matches(\"-aarch64-unknown\").trim_end_matches(\"-x86_64-unknown\")).join(\"bin\");\n    let bin = lib.parent().unwrap_or(lib).join(\"bin\");\n    for entry in std::fs::read_dir(&new_bin).map_err(|e| format!(\"{}: {e}\", new_bin.display()))? {\n        let program = entry.map_err(|e| e.to_string())?.path();\n        let link = bin.join(program.file_name().unwrap_or_default());\n        let _ = std::fs::remove_file(&link);\n        std::os::unix::fs::symlink(&program, &link).map_err(|e| format!(\"{}: {e}\", link.display()))?;\n    }\n    Ok(())\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn an_install_is_read_from_where_its_binary_is() {\n        let app = Path::new(\"/Users/ada/Applications/Bastion.app/Contents/MacOS/bastion\");\n        assert_eq!(install_of(app), Some(Install::App(\"/Users/ada/Applications/Bastion.app\".into())));\n        let desk = Path::new(\"/home/ada/.local/lib/bastion-desktop-0.2.0/bin/bastion\");\n        let lib = PathBuf::from(\"/home/ada/.local/lib\");\n        assert_eq!(install_of(desk), Some(Install::Tarball { lib: lib.clone(), desktop: true }));\n        let server = Path::new(\"/home/ada/.local/lib/bastion-0.2.0/bin/bastion\");\n        assert_eq!(install_of(server), Some(Install::Tarball { lib, desktop: false }));\n        assert_eq!(install_of(Path::new(\"/repo/target/debug/bastion\")), None);\n    }\n\n    #[test]\n    fn the_release_file_and_its_sum_are_found_by_name() {\n        let server = Install::Tarball { lib: \"/l\".into(), desktop: false };\n        assert_eq!(asset(&server, \"v0.2.0\", \"x86_64-unknown-linux-gnu\"), \"bastion-0.2.0-x86_64-unknown-linux-gnu.tar.gz\");\n        assert_eq!(asset(&Install::App(\"/A\".into()), \"v0.2.0\", \"aarch64-apple-darwin\"), \"bastion-desktop-0.2.0-aarch64-apple-darwin.zip\");\n        let sums = \"abc  bastion-0.2.0-x.tar.gz\\ndef  SHA256SUMS.minisig\\n\";\n        assert_eq!(sum_of(sums, \"bastion-0.2.0-x.tar.gz\"), Some(\"abc\"));\n        assert_eq!(sum_of(sums, \"missing\"), None);\n    }\n\n    #[test]\n    fn a_build_without_a_release_key_refuses_to_update() {\n        if PUBKEY.contains(\"REPLACE\") {\n            assert!(signed(b\"sums\", \"x\").unwrap_err().contains(\"no release key\"));\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"f14b972a-642c-48dc-8245-35f79b817dbc","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
