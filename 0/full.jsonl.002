"ship\" | \"merge\" => (latest(\"comprehend\"), latest(\"review\")),\n260:        stage => (latest(stage), None),\n265:fn what_a_release_approve_does(stage: &str, failed: bool, has_pr: bool) -> Option<&'static str> {\n266:    Some(match stage {\n267:        \"land\" if has_pr && !failed => {\n270:        \"land\" | \"ship\" | \"merge\" | \"deploy\" if failed => {\n273:        \"land\" => \"Approve lands the change on the workspace's branch.\",\n284:    if let Some(release) = what_a_release_approve_does(&d.job.stage, failed, d.job.pr.is_some()) {\n285:        return release;\n287:    match d.job.stage.as_str() {\n441:    let title = match (d.job.state.as_str(), d.job.stage.as_str()) {\n443:        (_, \"land\" | \"merge\") => \"The land failed; the VM and its commits are kept\",\n503:/// While scope waits: the parts it proposed, one per line, for the person to\n505:fn parts(state: &State) -> Option<Element<'_, Message>> {\n507:    if (job.stage.as_str(), job.state.as_str()) != (\"scope\", \"needs_you\") {\n510:    let label = \"Parts, one per line, landed in this order (one line keeps it one job)\";\n511:    let editor = text_editor(&state.parts)\n512:        .on_action(|a| Message::Job(Msg::EditParts(a)))\n514:    let set = button(\"Set parts\")\n517:        .on_press(Message::Job(Msg::Act(Action::SetParts)));\n571:    body = body.extend(parts(state));\n683:    let head = text(format!(\"{} artifact · {}\", a.stage, ago(a.created_at)))\n741:            .filter(|a| a.stage == step.stage)\n744:    if turn_step == Some(step.stage.as_str()) && !d.transcript.is_empty() {\n757:        |s: &&StepView| matches!(s.stage.as_str(), \"plan\" | \"build\") && s.state != \"pending\";\n758:    let turn_step = d.steps.iter().rev().find(agent).map(|s| s.stage.as_str());\n873:            stage: \"build\".into(),\n884:    fn parts_are_the_lines_typed_without_the_blank_ones() {\n919:    fn approve_says_what_it_does_at_a_release_step() {\n920:        assert_eq!(what_a_release_approve_does(\"plan\", false, false), None);\n922:            what_a_release_approve_does(\"land\", false, true)\n927:            what_a_release_approve_does(\"merge\", true, false)\n933:            stage: \"skill\".into(),","is_error":false}]},"uuid":"c5bc4686-db1a-48fa-8cfb-40f941202499","timestamp":"2026-11-11T21:38:01.357Z","toolUseResult":{"stdout":"458:pub struct JobSummary {\n459-    pub id: String,\n460-    pub workspace: String,\n461-    pub request: String,\n463-    pub stage: String,\n465-    pub state: String,\n466-    pub question: Option<String>,\n467-    pub error: Option<String>,\n468-    pub created_at: u64,\n469-    pub updated_at: u64,\n471-    pub actions: Vec<String>,\n473-    pub issue: Option<String>,\n476-    pub requester: Option<String>,\n480-pub struct ArtifactView {\n481-    pub stage: String,\n482-    pub body: String,\n483-    pub created_at: u64,\n487-pub struct TranscriptLine {\n488-    pub role: String,\n489-    pub text: String,\n494-pub struct StepView {\n496-    pub id: String,\n497-    pub stage: String,\n28:    /// Scope's parts, one per line, as the person is setting them.\n29:    parts: text_editor::Content,\n30:    parts_edited: bool,\n51:            parts: text_editor::Content::new(),\n52:            parts_edited: false,\n74:    EditParts(text_editor::Action),\n93:    SetParts,\n182:        Action::SetParts => {\n183:            let parts = lines(&state.parts.text());\n184:            ask(ctx, api::JobParts { id, parts })\n211:            if !state.parts_edited {\n212:                state.parts = text_editor::Content::with_text(&d.job.parts.join(\"\\n\"));\n218:        Msg::EditParts(action) => {\n219:            state.parts_edited |= action.is_edit();\n220:            state.parts.perform(action);\n225:            state.parts_edited = false;\n249:    let latest = |stage: &str| {\n253:            .find(|a| a.stage == stage)\n256:    match d.job.stage.as_str() {\n257:        \"build\" | \"code_review\" => (latest(&d.job.stage), latest(\"