{"parentUuid":"611aedd7-90d4-4cd1-97a6-b2a84d66fc4b","isSidechain":false,"promptId":"305cbff3-a896-4b01-84bb-b6b3038a90f7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014E3hjKDzMj5n1r4zrKfdLG","type":"tool_result","content":"14:fn a_preview_a_host_deployed_for_the_branch_is_kept_for_reviewers() {\n36:fn a_revert_of_a_landed_commit_is_an_escape_of_its_job_once() {\n75:fn a_paused_intake_admits_nothing_until_it_opens() {\n101:fn a_job_that_names_a_model_runs_its_turns_on_it() {\n129:fn a_requests_screenshots_are_kept_and_put_in_its_vm() {\n//! The factory's later features end to end on the fake engine, store and\n//! machine (F7 to F11), on the rig in `tests.rs`.\n\nuse std::time::Duration;\n\nuse bastion_core::{Pipeline, Stage, State};\nuse serde_json::json;\n\nuse super::tests::*;\nuse crate::machine::fake::FakeMachine;\nuse crate::store::{Artifact, Store};\n\n#[test]\nfn a_preview_a_host_deployed_for_the_branch_is_kept_for_reviewers() {\n    let deployed =\n        json!({ \"id\": 1, \"state\": \"success\", \"environment_url\": \"https://pr-1.example.dev\" });\n    let gh = json!({ \"exit_code\": 0, \"stdout\": json!([deployed]).to_string() });\n    let rig = rig_on(engine().answer(\"github::exec\", Ok(gh)));\n    crate::rt::block_on(async {\n        let record = record_at(Pipeline::Full, Stage::Ci, State::Running);\n        rig.store.insert(&record).await.unwrap();\n        let hub = crate::forge::GitHub {\n            engine: &*rig.engine,\n            slug: \"o/r\".into(),\n        };\n        rig.factory.keep_preview(&record, &hub).await;\n        let kept = rig.store.artifacts(\"j1\").await.unwrap();\n        assert_eq!(kept[0].body, \"Preview: <https://pr-1.example.dev>\");\n        let calls = rig.engine.calls.lock().unwrap();\n        let listed = &calls.iter().find(|c| c.1 == \"github::exec\").unwrap().2[\"args\"][1];","is_error":false}]},"uuid":"df43aba2-fadb-4e71-9339-c9e2a31b70f5","timestamp":"2026-11-11T04:28:28.710Z","toolUseResult":{"stdout":"14:fn a_preview_a_host_deployed_for_the_branch_is_kept_for_reviewers() {\n36:fn a_revert_of_a_landed_commit_is_an_escape_of_its_job_once() {\n75:fn a_paused_intake_admits_nothing_until_it_opens() {\n101:fn a_job_that_names_a_model_runs_its_turns_on_it() {\n129:fn a_requests_screenshots_are_kept_and_put_in_its_vm() {\n//! The factory's later features end to end on the fake engine, store and\n//! machine (F7 to F11), on the rig in `tests.rs`.\n\nuse std::time::Duration;\n\nuse bastion_core::{Pipeline, Stage, State};\nuse serde_json::json;\n\nuse super::tests::*;\nuse crate::machine::fake::FakeMachine;\nuse crate::store::{Artifact, Store};\n\n#[test]\nfn a_preview_a_host_deployed_for_the_branch_is_kept_for_reviewers() {\n    let deployed =\n        json!({ \"id\": 1, \"state\": \"success\", \"environment_url\": \"https://pr-1.example.dev\" });\n    let gh = json!({ \"exit_code\": 0, \"stdout\": json!([deployed]).to_string() });\n    let rig = rig_on(engine().answer(\"github::exec\", Ok(gh)));\n    crate::rt::block_on(async {\n        let record = record_at(Pipeline::Full, Stage::Ci, State::Running);\n        rig.store.insert(&record).await.unwrap();\n        let hub = crate::forge::GitHub {\n            engine: &*rig.engine,\n            slug: \"o/r\".into(),\n        };\n        rig.factory.keep_preview(&record, &hub).await;\n        let kept = rig.store.artifacts(\"j1\").await.unwrap();\n        assert_eq!(kept[0].body, \"Preview: <https://pr-1.example.dev>\");\n        let calls = rig.engine.calls.lock().unwrap();\n        let listed = &calls.iter().find(|c| c.1 == \"github::exec\").unwrap().2[\"args\"][1];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"530c0784-2884-4259-824b-04d7ad454131","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"611aedd7-90d4-4cd1-97a6-b2a84d66fc4b","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
