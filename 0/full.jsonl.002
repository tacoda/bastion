', 0); ioctl($s, 0x8913, $r) or die $!; \\","+my (undef, $f) = unpack('a16 s', $r); \\","+ioctl($s, 0x8914, pack('a16 s', 'lo', $f | 1)) or die $!;\";"," "," impl Workspace {","     /// The environment as a VM takes it, one `K=V` per entry."]},{"oldStart":52,"oldLines":10,"newStart":59,"newLines":15,"lines":["             .engine","             .call_for(DEFAULT_NAMESPACE, \"sandbox::create\", vm, SLOW_MS)","             .await?;","-        made[\"sandbox_id\"]","+        let vm = made[\"sandbox_id\"]","             .as_str()","             .map(String::from)","-            .ok_or(\"sandbox::create gave no sandbox_id\".into())","+            .ok_or(\"sandbox::create gave no sandbox_id\")?;","+        // A VM without loopback still runs whatever needs no local server.","+        if let Err(e) = self.vm_exec(&vm, &[\"perl\", \"-e\", LOOPBACK_UP]).await {","+            eprintln!(\"vm {vm}: loopback stays down: {e}\");","+        }","+        Ok(vm)","     }"," ","     /// Fill the job's VM with the job's branch, set up by the workspace's"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-server/src/factory/setup.rs"]}},"serverClassifierContext":{"request":"70e30678-139a-4322-a77f-a43f961b49f8","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"4ac9c10c-5c6d-4dac-8cb3-1ed6ca3e9ae6","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
