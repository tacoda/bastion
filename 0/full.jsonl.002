ons\",","+        (Text::Note, _) if !n.builtin.is_empty() => {","+            \"Instructions (Bastion's own until you change them; clear to restore)\"","+        }","+        (Text::Note, _) => \"Added instructions (optional)\",","+        (Text::Nothing, _) => \"Bastion does this step itself; it runs no agent and no script.\",","+    }"," }"," "," fn step_detail<'a>(state: &'a State, id: &str, editable: bool) -> Option<Element<'a, Message>> {"]},{"oldStart":459,"oldLines":24,"newStart":479,"newLines":16,"lines":["         .and_then(|w| edit::node(w, id))?","         .clone();","     let on = |m: Msg| editable.then_some(wrap(m));","-    let mut body = column![","-        row![","-            text(title(&n)).font(theme::BOLD),","-            text(n.id.clone()).size(13).color(theme::MUTED)","-        ]","-        .spacing(8)","-    ];","-    let run_label = match n.stage.as_str() {","-        \"skill\" => Some(\"Skill: the folder under .claude/skills\"),","-        \"command\" => Some(\"Command line, run in the repository\"),","-        _ => None,","-    };","-    if let Some(label) = run_label {","-        let input = text_input(\"\", &n.run)","-            .on_input_maybe(editable.then_some(|v| wrap(Msg::Field(StepField::Run, v))))","-            .style(theme::field);","-        body = body.push(labeled(label, input));","-    }","+    let head = row![","+        text(title(&n)).font(theme::BOLD),","+        text(n.id.clone()).size(13).color(theme::MUTED)","+    ]","+    .spacing(8);","+    let all = kinds(state, &n.stage);","+    let kind = all.iter().find(|c| c.id == n.stage).cloned();","+    let kind = pick_list(all, kind, |c| wrap(Msg::Kind(c)))","+        .width(Fill)","+        .style(theme::select);","     let dials: Vec<Choice> = DIALS","         .iter()","         .map(|(id, name)| Choice::new(id, name))"]},{"oldStart":486,"oldLines":26,"newStart":498,"newLines":41,"lines":["         .find(|c| c.id == n.dial)","         .cloned()","         .or_else(|| dial