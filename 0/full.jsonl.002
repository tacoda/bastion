{"parentUuid":"edceb096-c8d7-42eb-8226-4ad52776c410","isSidechain":false,"promptId":"7438ab95-81e7-4f90-9667-d936ce612756","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JfUKhD6sm4CTbDYJxQqhGc","type":"tool_result","content":"diff --git a/crates/bastion-desktop/src/pages/jobs.rs b/crates/bastion-desktop/src/pages/jobs.rs\nindex 5b1b745..091869a 100644\n--- a/crates/bastion-desktop/src/pages/jobs.rs\n+++ b/crates/bastion-desktop/src/pages/jobs.rs\n@@ -168,8 +168,26 @@ fn line(job: &JobSummary, server: &str, down: bool) -> String {\n     )\n }\n \n+/// The most of a request a row shows; the job's page shows all of it.\n+const TITLE_CHARS: usize = 120;\n+\n+/// A request as a row's title: its first line, cut at a word to\n+/// [`TITLE_CHARS`], with an ellipsis when anything was cut.\n+fn title(request: &str) -> String {\n+    let first = request.trim().lines().next().unwrap_or_default();\n+    let cut = first.char_indices().nth(TITLE_CHARS).map(|(i, _)| i);\n+    match cut {\n+        None if first.len() == request.trim().len() => first.to_string(),\n+        None => format!(\"{first} …\"),\n+        Some(i) => {\n+            let at_word = first[..i].rfind(' ').unwrap_or(i);\n+            format!(\"{}…\", first[..at_word].trim_end())\n+        }\n+    }\n+}\n+\n fn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {\n-    let mut about = column![text(sj.job.request.clone()).font(theme::BOLD)].spacing(2);\n+    let mut about = column![text(title(&sj.job.request)).size(15).font(theme::MEDIUM)].spacing(3);\n     if let Some(p) = &sj.job.part {\n         about = about.push(text(format!(\"Part: {p}\")).size(13));\n     }\n@@ -195,7 +213,7 @@ fn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {\n     let row_button = button(body)\n         .width(Fill)\n         .padding([10, 12])\n-        .style(theme::row_button)\n+        .style(theme::card_row)\n         .on_press(open);\n     let faded = if down { 0.6 } else { 1.0 };\n     container(row_button)\n@@ -220,7 +238,8 @@ fn group<'a>(title: String, jobs: Vec<ServerJob>, ctx: &Ctx, accent: bool) -> El\n             let down = ctx.down.contains(&j.server);\n             job_row(j, down)\n         });\n-        Column::with_children(rows).into()\n+        // Inset, so a hovered row leaves the card's edge in view.\n+        Column::with_children(rows).spacing(2).padding(6).into()\n     };\n     section(title, body, accent)\n }\n@@ -370,4 +389,17 @@ mod tests {\n         update(&mut state, Msg::Search(\"REQUEST J1\".into()));\n         assert_eq!(state.shown()[0].job.id, \"j1\");\n     }\n+\n+    #[test]\n+    fn a_long_request_is_cut_at_a_word_for_its_row() {\n+        assert_eq!(\n+            title(\"Add shout(x) to calc.py.\"),\n+            \"Add shout(x) to calc.py.\"\n+        );\n+        assert_eq!(title(\"First line\\nmore detail\"), \"First line …\");\n+        let long = \"word \".repeat(40);\n+        let shown = title(&long);\n+        assert!(shown.ends_with(\"word…\"), \"{shown}\");\n+        assert!(shown.chars().count() <= TITLE_CHARS + 1);\n+    }\n }","is_error":false}]},"uuid":"b774e4b5-5f2c-47a5-b400-8d15bc314e25","timestamp":"2026-11-11T18:03:43.916Z","toolUseResult":{"stdout":"diff --git a/crates/bastion-desktop/src/pages/jobs.rs b/crates/bastion-desktop/src/pages/jobs.rs\nindex 5b1b745..091869a 100644\n--- a/crates/bastion-desktop/src/pages/jobs.rs\n+++ b/crates/bastion-desktop/src/pages/jobs.rs\n@@ -168,8 +168,26 @@ fn line(job: &JobSummary, server: &str, down: bool) -> String {\n     )\n }\n \n+/// The most of a request a row shows; the job's page shows all of it.\n+const TITLE_CHARS: usize = 120;\n+\n+/// A request as a row's title: its first line, cut at a word to\n+/// [`TITLE_CHARS`], with an ellipsis when anything was cut.\n+fn title(request: &str) -> String {\n+    let first = request.trim().lines().next().unwrap_or_default();\n+    let cut = first.char_indices().nth(TITLE_CHARS).map(|(i, _)| i);\n+    match cut {\n+        None if first.len() == request.trim().len() => first.to_string(),\n+        None => format!(\"{first} …\"),\n+        Some(i) => {\n+            let at_word = first[..i].rfind(' ').unwrap_or(i);\n+            format!(\"{}…\", first[..at_word].trim_end())\n+        }\n+    }\n+}\n+\n fn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {\n-    let mut about = column![text(sj.job.request.clone()).font(theme::BOLD)].spacing(2);\n+    let mut about = column![text(title(&sj.job.request)).size(15).font(theme::MEDIUM)].spacing(3);\n     if let Some(p) = &sj.job.part {\n         about = about.push(text(format!(\"Part: {p}\")).size(13));\n     }\n@@ -195,7 +213,7 @@ fn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {\n     let row_button = button(body)\n         .width(Fill)\n         .padding([10, 12])\n-        .style(theme::row_button)\n+        .style(theme::card_row)\n         .on_press(open);\n     let faded = if down { 0.6 } else { 1.0 };\n     container(row_button)\n@@ -220,7 +238,8 @@ fn group<'a>(title: String, jobs: Vec<ServerJob>, ctx: &Ctx, accent: bool) -> El\n             let down = ctx.down.contains(&j.server);\n             job_row(j, down)\n         });\n-        Column::with_children(rows).into()\n+        // Inset, so a hovered row leaves the card's edge in view.\n+        Column::with_children(rows).spacing(2).padding(6).into()\n     };\n     section(title, body, accent)\n }\n@@ -370,4 +389,17 @@ mod tests {\n         update(&mut state, Msg::Search(\"REQUEST J1\".into()));\n         assert_eq!(state.shown()[0].job.id, \"j1\");\n     }\n+\n+    #[test]\n+    fn a_long_request_is_cut_at_a_word_for_its_row() {\n+        assert_eq!(\n+            title(\"Add shout(x) to calc.py.\"),\n+            \"Add shout(x) to calc.py.\"\n+        );\n+        assert_eq!(title(\"First line\\nmore detail\"), \"First line …\");\n+        let long = \"word \".repeat(40);\n+        let shown = title(&long);\n+        assert!(shown.ends_with(\"word…\"), \"{shown}\");\n+        assert!(shown.chars().count() <= TITLE_CHARS + 1);\n+    }\n }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"bbde0853-5e2d-4fa4-bab5-af6c393bb008","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"edceb096-c8d7-42eb-8226-4ad52776c410","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
