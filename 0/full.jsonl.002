       .font(theme::BOLD)\n121:                .color(theme::MUTED),\n122:            );\n123:            let comment = |path, n| Message::Job(Msg::CommentAt(path, n));\n124:            body = body.push(diff::view(&change, comment, state.pick.as_ref()));\n125:        }\n126:    }\n127:    body = body.extend(parts(state));\n128:    body = body.extend(note(state));\n129:    container(body.push(actions(state)))\n130:        .padding(16)\n131:        .width(Fill)\n132:        .style(theme::accented)\n133:        .into()\n134:}\n135:\n136:/// One call the gate holds: allow exactly it once, or refuse it\n137:/// with a note the agent reads as the call's result.\n138:fn held_call<'a>(state: &'a State, call: &'a HeldCallView) -> Element<'a, Message> {\n139:    let typed = state.feedback.get(&call.id).cloned().unwrap_or_default();\n140:    let id = call.id.clone();\n141:    let field = text_input(\"What the agent should do instead\", &typed)\n142:        .on_input(move |t| Message::Job(Msg::Feedback(id.clone(), t)))\n143:        .style(theme::field);\n144:    let allow = button(\"Allow once\")\n145:        .padding([8, 12])\n146:        .style(theme::primary)\n147:        .on_press(Message::Job(Msg::Allow(call.id.clone())));\n148:    let refuse = button(\"Refuse with this note\")\n149:        .padding([8, 12])\n150:        .style(theme::secondary);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"eb0a5d1f-8005-48e5-ae02-073280952ed6","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":11,"modified":50,"untracked":null,"untracked_normal":3},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","platform":"macos