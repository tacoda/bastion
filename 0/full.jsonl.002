,"oldLines":7,"newStart":104,"newLines":7,"lines":["     if got != want {","         return Err(format!(\"{file} does not match its sum; nothing was changed\"));","     }","-    replace(&install, &file, &bytes)?;","+    replace(&install, &file, &folder(&install, &newest), &bytes)?;","     println!(\"Bastion {newest} is installed; start the server again to run it\");","     Ok(())"," }"]},{"oldStart":122,"oldLines":7,"newStart":130,"newLines":7,"lines":[" }"," "," /// Unpack the new release beside the old one, then put it in its place.","-fn replace(install: &Install, file: &str, bytes: &[u8]) -> Result<(), String> {","+fn replace(install: &Install, file: &str, folder: &str, bytes: &[u8]) -> Result<(), String> {","     let work = std::env::temp_dir().join(format!(\"bastion-update-{}\", std::process::id()));","     std::fs::create_dir_all(&work).map_err(|e| e.to_string())?;","     let archive = work.join(file);"]},{"oldStart":140,"oldLines":16,"newStart":148,"newLines":14,"lines":["         }","         Install::Tarball { lib, .. } => {","             run(\"tar\", &[\"-xzf\", &path], lib)?;","-            relink(lib, file)","+            relink(lib, folder)","         }","     }"," }"," ","-/// Point the links in `~/.local/bin` (beside `lib`) at the new folder.","-fn relink(lib: &Path, file: &str) -> Result<(), String> {","-    let folder = file.trim_end_matches(\".tar.gz\").rsplit_once('-').map(|(f, _)| f).unwrap_or(file);","-    let folder = folder.rsplit_once('-').map(|(f, _)| f).unwrap_or(folder);","-    let new_bin = lib.join(folder.trim_end_matches(\"-aarch64-unknown\").trim_end_matches(\"-x86_64-unknown\")).join(\"bin\");","+/// Point the links in `bin`, beside `lib`, at the new folder's programs.","+fn relink(lib: &Path, folder: &str) -> Result<(), String> {","+    let new_bin = lib.join(folder).join(\"bin\");","     let bin = lib.parent().unwrap_or(lib).join(\"bin\");","     for entry in std::fs::read_dir(&new_bin).map_err(|e| format!(\"{}: {e}\", new_bin.display()))? {","         let program = entry.map_err(|e| e.to_string())?.path();"]},{"oldStart":179,"oldLines":6,"newStart":185,"newLines":7,"lines":["     #[test]","     fn the_release_file_and_its_sum_are_found_by_name() {","         let server = Install::Tarball { lib: \"/l\".into(), desktop: false };","+        assert_eq!(folder(&server, \"v0.2.0\"), \"bastion-0.2.0\");","         assert_eq!(asset(&server, \"v0.2.0\", \"x86_64-unknown-linux-gnu\"), \"bastion-0.2.0-x86_64-unknown-linux-gnu.tar.gz\");","         assert_eq!(asset(&Install::App(\"/A\".into()), \"v0.2.0\", \"aarch64-apple-darwin\"), \"bastion-desktop-0.2.0-aarch64-apple-darwin.zip\");","         let sums = \"abc  bastion-0.2.0-x.tar.gz\\ndef  SHA256SUMS.minisig\\n\";"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/scripts/minisign.pub","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":2,"lines":["+untrusted comment: the Bastion release key's public half goes here (minisign -G -W -p scripts/minisign.pub)","+RWQ_REPLACE_WITH_THE_RELEASE_PUBLIC_KEY"]}],"created":true},{"filePath":"/Users/tacoda/tacoda/bastion/scripts/package.sh","hunks":[{"oldStart":12,"oldLines":6,"newStart":12,"newLines":8,"lines":[" out=\"dist\""," rel=\"target/$target/release\""," ","+# The version a release build carries, which `bastion update` compares.","+export BASTION_VERSION=\"$version\""," cargo build --release --locked --target \"$target\" \\","   -p bastion-server -p bastion-cli -p bastion-openai-compat -p bastion-desktop -p bastion-tray"," "]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-cli/Cargo.toml","/Users/tacoda/tacoda/bastion/crates/bastion-cli/build.rs","/Users/tacoda/tacoda/bastion/crates/bastion-cli/src/update.rs","/Users/tacoda/tacoda/bastion/scripts/minisign.pub","/Users/tacoda/tacoda/bastion/scripts/package.sh"]}},"serverClassifierContext":{"request":"32058444-ec2a-419d-b1e6-fb10f8f85014","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/