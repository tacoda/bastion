ff);","+    constraints","+        .iter()","+        .filter(|c| {","+            c.function == DIFF && c.contains == DELETED_TESTS && c.rung != Enforcement::Told","+        })","+        .filter(|_| !gone.is_empty())","+        .map(|c| Finding {","+            constraint: c.id.clone(),","+            rung: c.rung,","+            rule: c.rule.clone(),","+            detail: format!(\"Deleted tests: {}\", gone.join(\", \")),","+        })","+        .collect()","+}","+","+/// The test functions a unified diff removes and does not add back, by name:","+/// `def test_x`, `fn test_x`, and `#[test]` functions.","+pub fn deleted_tests(diff: &str) -> Vec<String> {","+    let names = |sign: char| -> Vec<String> {","+        let mut found = Vec::new();","+        let mut marked = false;","+        for line in diff","+            .lines()","+            .filter(|l| l.starts_with(sign) && !l.starts_with(\"+++\") && !l.starts_with(\"---\"))","+        {","+            let code = line[1..].trim();","+            if code == \"#[test]\" {","+                marked = true;","+                continue;","+            }","+            let name = code","+                .strip_prefix(\"def \")","+                .or_else(|| code.strip_prefix(\"async def \"))","+                .or_else(|| code.strip_prefix(\"fn \"))","+                .or_else(|| code.strip_prefix(\"pub fn \"))","+                .and_then(|rest| rest.split(['(', '<']).next());","+            if let Some(name) = name.filter(|n| marked || n.starts_with(\"test_\")) {","+                found.push(name.to_string());","+            }","+            marked = false;","+        }","+        found","+    };","+    let added = names('+');","+    names('-')","+        .into_iter()","+        .filter(|n| !added.contains(n))","+        .collect()","+}","+"," /// The owner's default constraints, from what agents did in A4 (PLAN.md)."," pub fn default_constraints() -> Vec<Constraint> {","     let rule = |id: &str, rule: &str, function: &str, contains: &str, rung| Constraint {"]},{"oldStart":200,"oldLines":6,"newStart":269,"newLines":13,"lines":["             \"git rm\",","             Enforcement::Told,","         ),","+        rule(","+            \"tests-kept\",","+            \"Every existing test still exists at review.\",","+            DIFF,","+            DELETED_TESTS,","+            Enforcement::Checked,","+        ),","         rule(","             \"commit-work\",","             \"Commit every change before you reply.\","]},{"oldStart":368,"oldLines":6,"newStart":444,"newLines":44,"lines":["         );","     }"," ","+    const DIFF_TEXT: &str = \"diff --git a/test_calc.py b/test_calc.py\\n--- a/test_calc.py\\n+++ b/test_calc.py\\n@@ -1,8 +1,4 @@\\n-def test_add():\\n-    assert add(2, 3) == 5\\n-def test_sub():\\n+def test_sub():\\n+def test_modulo():\\n\";","+","+    #[test]","+    fn a_diff_that_drops_a_test_is_found_and_a_renamed_one_is_not_kept() {","+        assert_eq!(deleted_tests(DIFF_TEXT), [\"test_add\"]);","+        assert_eq!(deleted_tests(\"-    #[test]\\n-    fn adds() {\\n\"), [\"adds\"]);","+        assert!(deleted_tests(\"+def test_new():\\n\").is_empty());","+    }","+","+    #[test]","+    fn review_findings_follow_the_rung() {","+        let mut rules = default_constraints();","+        let found = review(DIFF_TEXT, &rules);","+        assert_eq!(found.len(), 1);","+        assert_eq!(","+            (found[0].constraint.as_str(), found[0].rung),","+            (\"tests-kept\", Enforcement::Checked)","+        );","+        assert!(found[0].detail.contains(\"test_add\"));","+        let kept = rules.iter_mut().find(|c| c.id == \"tests-kept\").unwrap();","+        kept.rung = Enforcement::Told;","+        assert!(review(DIFF_TEXT, &rules).is_empty());","+        assert!(review(\"+def test_new():\\n\", &default_constraints()).is_empty());","+    }","+","+    #[test]","+    fn diff_rules_bind_no_call() {","+        let rules = default_constraints();","+        let call = Call {","+            function: \"sandbox::exec\".into(),","+            text: \"deleted tests\".into(),","+        };","+        assert_eq!(","+            gate(&call, Stage::Build, &rules, &default_capabilities()).flagged,","+            Vec::<String>::new()","+        );","+    }","+","     #[test]","     fn told_rules_bind_no_call() {","         let rules = default_constraints();"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/govern.rs"]}},"serverClassifierContext":{"request":"6fe6eb5d-1354-484c-a843-3c7431e44662","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"e2ddd242-23f6-4964-ac42-aae73b7e0eaf","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
