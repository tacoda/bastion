{"parentUuid":"6e4239e7-f64f-44b9-90a7-a1914ff3a74f","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgwmPeCfTRZ18TmT3Qji7","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"I've designed four new workflows in Rust and planned how the eleven seeded ones convert, with the pull-request steps going through GitHub's API from Python. I'm starting on the seeding module next.\n\n","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":775,"cache_read_input_tokens":682247,"output_tokens":8261,"output_tokens_details":{"thinking_tokens":2650},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":775,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8261,"cache_read_input_tokens":682247,"cache_creation_input_tokens":775,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":775},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"a3cc4b88-f77a-4a13-813e-2686888b39b2","apiBlockIndex":1,"requestId":"req_011CgwmPddwUPu496kLwzGQc","type":"assistant","uuid":"f4a64387-9f88-4a11-8441-ed497a03e62e","timestamp":"2026-11-11T20:24:32.454Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"f4a64387-9f88-4a11-8441-ed497a03e62e","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgwmPeCfTRZ18TmT3Qji7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WVJ54Qv7PjXR6hMHwDpXWi","name":"Write","input":{"file_path":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/seed_flows.rs","content":"//! The workflows Bastion ships, as steps with their text filled in (D39).\n//! Each is the owner's to change: one is saved only while no workflow has\n//! its id, and a workflow seeded as stages is turned into steps only while\n//! its first version is unchanged.\n\nuse bastion_core::workflow::{Graph, Link, Node, Reach};\nuse bastion_core::{Dial, Stage};\n\nuse crate::store::Store;\nuse crate::workflow_store::{self, Workflow};\n\n/// A planning prompt: it reads, changes nothing, and gives the plan.\nconst PLAN: &str = \"\\\nYou are planning a change to the repository in /work/repo. Do not change any file.\nRead what you need. Then reply with the plan, and nothing before it, in this shape:\n\nRESULT plan:\n1. The file to change, and what changes in it.\n2. The test that proves it.\n\nWrite it in ASD-STE100 Simplified Technical English: one idea per sentence, at\nmost 20 words in an instruction and 25 in an explanation, active voice that\nnames what acts, and one word for each thing. Keep file, function and command\nnames exact.\";\n\n/// A building prompt: it carries out the plan linked into it.\nconst BUILD: &str = \"\\\nCarry out the plan above in the repository in /work/repo. Change the code and\nits tests, and run the tests until they pass. Do not weaken or delete a test to\nmake it pass. Commit what you change with git, with clear messages.\";\n\n/// A reviewing prompt: it reads the change against its base, and fixes it.\nconst REVIEW: &str = \"\\\nReview the change in /work/repo: `git diff bastion-base` shows it. Check that\nit does what the request asks. Look for bugs, missing tests and security\nproblems. Fix what you find and commit it. Reply with what you found and what\nyou fixed.\";\n\n/// A prompt that writes the acceptance criteria.\nconst CRITERIA: &str = \"\\\nWrite the acceptance criteria for the request: what its user can observe when\nit is met. Do not change any file. Reply in this shape, and nothing before it:\n\nRESULT criteria:\nC1. One observable behaviour, in the requester's words.\";\n\n/// A prompt that writes failing acceptance tests for the criteria.\nconst ACCEPTANCE: &str = \"\\\nWrite acceptance tests for the criteria above. Drive the code the way its user\nwould. Change no product code. Each test must fail now, because the behaviour\nis missing, not because the test is broken. Commit the tests.\";\n\n/// The workspace's checks, as its settings name them.\nconst CHECKS: &str = r#\"if [ -z \"$BASTION_CHECKS\" ]; then\n  echo \"The workspace names no checks.\"\n  exit 0\nfi\nsh -c \"$BASTION_CHECKS\"\"#;\n\n/// What the GitHub steps share: a call to GitHub's API with the token.\nconst GITHUB: &str = r#\"import json, os, sys, time, urllib.request\n\nREPO = os.environ[\"BASTION_REPO\"]\nBRANCH = os.environ[\"BASTION_BRANCH\"]\n\n\ndef call(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    request = urllib.request.Request(\n        f\"https://api.github.com/repos/{REPO}{path}\",\n        data=data,\n        method=method,\n        headers={\n            \"Authorization\": \"Bearer \" + os.environ[\"GH_TOKEN\"],\n            \"Accept\": \"application/vnd.github+json\",\n        },\n    )\n    with urllib.request.urlopen(request) as answer:\n        return json.load(answer)\n\n\ndef pull_request():\n    owner = REPO.split(\"/\")[0]\n    found = call(\"GET\", f\"/pulls?state=open&head={owner}:{BRANCH}\")\n    return found[0] if found else None\n\"#;\n\n/// Push the branch with the token as a header, never in a URL, then open\n/// its pull request if none is open.\nconst PULL_REQUEST: &str = r#\"set -e\nauth=\"Authorization: Basic $(printf 'x-access-token:%s' \"$GH_TOKEN\" | base64 | tr -d '\\n')\"\ngit -c http.extraHeader=\"$auth\" push -q \"https://github.com/$BASTION_REPO.git\" \"HEAD:refs/heads/$BASTION_BRANCH\"\npython3 - <<'PY'\n@GITHUB@\nimport subprocess\npr = pull_request()\nif pr is None:\n    title = subprocess.run([\"git\", \"log\", \"-1\", \"--format=%s\"], capture_output=True, text=True).stdout.strip()\n    pr = call(\"POST\", \"/pulls\", {\"title\": title, \"head\": BRANCH, \"base\": os.environ[\"BASTION_BASE\"]})\nprint(pr[\"html_url\"])\nPY\"#;\n\n/// Wait for the pull request's checks, at most 14 minutes.\nconst CI: &str = r#\"python3 - <<'PY'\n@GITHUB@\npr = pull_request()\nif pr is None:\n    sys.exit(\"No open pull request for \" + BRANCH)\nsha = pr[\"head\"][\"sha\"]\nfor _ in range(84):\n    runs = call(\"GET\", f\"/commits/{sha}/check-runs\")[\"check_runs\"]\n    if runs and all(r[\"status\"] == \"completed\" for r in runs):\n        failed = [r[\"name\"] for r in runs if r[\"conclusion\"] not in (\"success\", \"skipped\", \"neutral\")]\n        if failed:\n            sys.exit(\"Failed: \" + \", \".join(failed))\n        print(\"Passed: \" + \", \".join(r[\"name\"] for r in runs))\n        sys.exit(0)\n    time.sleep(10)\nsys.exit(\"The checks did not finish in 14 minutes.\")\nPY\"#;\n\n/// Merge the pull request.\nconst MERGE: &str = r#\"python3 - <<'PY'\n@GITHUB@\npr = pull_request()\nif pr is None:\n    sys.exit(\"No open pull request for \" + BRANCH)\nmerged = call(\"PUT\", f\"/pulls/{pr['number']}/merge\", {\"merge_method\": \"merge\"})\nprint(\"Merged \" + pr[\"html_url\"] + \" as \" + merged[\"sha\"])\nPY\"#;\n\n/// The seeded workflows that are made of stages, by id.\nconst STAGED: [&str; 11] = [\n    \"research\",\n    \"bug-fix\",\n    \"dependency-upgrade\",\n    \"test-coverage\",\n    \"weekly-status\",\n    \"decision-record\",\n    \"onboarding-guide\",\n    \"incident-response\",\n    \"incident-postmortem\",\n    \"runbook\",\n    \"infrastructure-change\",\n];\n\n/// One step, `x` from the left.\nstruct Step {\n    id: &'static str,\n    stage: Stage,\n    dial: Dial,\n    text: &'static str,\n    results: &'static [&'static str],\n    network: bool,\n}\n\nconst fn prompt(id: &'static str, dial: Dial, text: &'static str) -> Step {\n    Step {\n        id,\n        stage: Stage::Prompt,\n        dial,\n        text,\n        results: &[],\n        network: false,\n    }\n}\n\nconst fn shell(id: &'static str, dial: Dial, script: &'static str) -> Step {\n    Step {\n        id,\n        stage: Stage::Shell,\n        dial,\n        text: script,\n        results: &[],\n        network: false,\n    }\n}\n\n/// A GitHub step: a shell script with the network and `GH_TOKEN`.\nconst fn github(id: &'static str, dial: Dial, script: &'static str) -> Step {\n    Step {\n        network: true,\n        ..shell(id, dial, script)\n    }\n}\n\nconst PLAN_STEP: Step = Step {\n    results: &[\"plan\"],\n    ..prompt(\"plan\", Dial::LightsOn, PLAN)\n};\nconst BUILD_STEP: Step = prompt(\"build\", Dial::Dark, BUILD);\n\n/// The steps a pull request adds after the checks.\nconst GITHUB_STEPS: [Step; 3] = [\n    github(\"pull-request\", Dial::Dark, PULL_REQUEST),\n    github(\"ci\", Dial::LightsOn, CI),\n    github(\"merge\", Dial::Dark, MERGE),\n];\n\n/// The workflows Bastion ships as steps: id, name, steps in order.\nfn shipped() -> Vec<(&'static str, &'static str, Vec<Step>)> {\n    let review = prompt(\"review\", Dial::Dark, REVIEW);\n    let criteria = Step {\n        results: &[\"criteria\"],\n        ..prompt(\"criteria\", Dial::LightsOn, CRITERIA)\n    };\n    let checks = |dial| shell(\"checks\", dial, CHECKS);\n    let to_github = |mut steps: Vec<Step>| {\n        steps.extend(GITHUB_STEPS);\n        steps\n    };\n    vec![\n        (\n            \"short\",\n            \"Short\",\n            vec![PLAN_STEP, BUILD_STEP, checks(Dial::LightsOn)],\n        ),\n        (\n            \"pull-request\",\n            \"Pull request\",\n            to_github(vec![PLAN_STEP, BUILD_STEP, checks(Dial::Dark)]),\n        ),\n        (\n            \"full\",\n            \"Full\",\n            to_github(vec![\n                PLAN_STEP,\n                criteria,\n                prompt(\"acceptance-tests\", Dial::Dark, ACCEPTANCE),\n                BUILD_STEP,\n                checks(Dial::Dark),\n                prompt(\"review\", Dial::Dark, REVIEW),\n            ]),\n        ),\n        (\n            \"full_no_acceptance\",\n            \"Full, without acceptance tests\",\n            to_github(vec![PLAN_STEP, BUILD_STEP, checks(Dial::Dark), review]),\n        ),\n    ]\n}\n\n/// The graph of steps in a row, each linked to the next.\nfn chain(steps: Vec<Step>) -> Graph {\n    let ids: Vec<&str> = steps.iter().map(|s| s.id).collect();\n    let nodes = steps.into_iter().enumerate().map(|(i, s)| {\n        let shell = s.stage == Stage::Shell;\n        Node {\n            id: s.id.into(),\n            stage: s.stage,\n            run: if shell { s.text.replace(\"@GITHUB@\", GITHUB) } else { String::new() },\n            dial: s.dial,\n            note: if shell { String::new() } else { s.text.into() },\n            results: s.results.iter().map(|r| r.to_string()).collect(),\n            reach: Reach {\n                network: s.network,\n                secrets: if s.network { vec![\"GH_TOKEN\".into()] } else { Vec::new() },\n            },\n            x: 220 * i as i32,\n            y: 0,\n        }\n    });\n    let links = ids.windows(2).map(|w| Link {\n        from: w[0].into(),\n        to: w[1].into(),\n    });\n    Graph {\n        nodes: nodes.collect(),\n        links: links.collect(),\n    }\n}\n\n/// A seeded workflow of stages as steps: plan reads and changes nothing,\n/// build is the gate before the finish, and land goes, as the finish\n/// lands (D41).\nfn as_steps(g: &Graph) -> Graph {\n    let nodes = g.nodes.iter().filter(|n| n.stage != Stage::Land).map(|n| {\n        let mut n = n.clone();\n        match n.stage {\n            Stage::Plan => {\n                n.stage = Stage::Prompt;\n                n.note = format!(\"Do not change any file. {}\", n.note);\n            }\n            Stage::Build => {\n                n.stage = Stage::Prompt;\n                n.dial = Dial::LightsOn;\n            }\n            _ => {}\n        }\n        n\n    });\n    let land: Vec<&str> = g.nodes.iter().filter(|n| n.stage == Stage::Land).map(|n| n.id.as_str()).collect();\n    let links = g.links.iter().filter(|l| !land.contains(&l.from.as_str()) && !land.contains(&l.to.as_str()));\n    Graph {\n        nodes: nodes.collect(),\n        links: links.cloned().collect(),\n    }\n}\n\n/// Save each shipped workflow no workflow has the id of, and turn each\n/// seeded workflow still as seeded into steps.\npub async fn seed(store: &dyn Store) -> Result<(), String> {\n    let kept = store.workflows().await?;\n    let has = |id: &str| kept.iter().any(|k| k.0 == id);\n    for (id, name, steps) in shipped() {\n        if !has(id) {\n            save(store, id, name, chain(steps)).await?;\n        }\n    }\n    for (id, name, version) in kept.iter().filter(|k| STAGED.contains(&k.0.as_str()) && k.2 == 1) {\n        let Some(graph) = store.graph_at(id, *version).await? else {\n            continue;\n        };\n        if graph.nodes.iter().any(|n| matches!(n.stage, Stage::Plan | Stage::Build | Stage::Land)) {\n            save(store, id, name, as_steps(&graph)).await?;\n        }\n    }\n    Ok(())\n}\n\nasync fn save(store: &dyn Store, id: &str, name: &str, graph: Graph) -> Result<u64, String> {\n    let w = Workflow {\n        id: id.into(),\n        name: name.into(),\n        version: 0,\n        graph,\n    };\n    workflow_store::save(store, &w, crate::factory::now()).await\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn every_shipped_workflow_is_steps_only_and_checks() {\n        for (id, _, steps) in shipped() {\n            let g = chain(steps);\n            assert_eq!(g.check(), Ok(()), \"{id}\");\n            assert!(g.nodes.iter().all(|n| bastion_core::workflow::custom(n.stage)), \"{id}\");\n            let script = g.nodes.iter().map(|n| n.run.as_str()).collect::<String>();\n            assert!(!script.contains(\"@GITHUB@\"), \"{id}\");\n        }\n        let pr = chain(shipped().remove(1).2);\n        let merge = pr.nodes.iter().find(|n| n.id == \"merge\").unwrap();\n        assert!(merge.reach.network && merge.reach.secrets == [\"GH_TOKEN\"]);\n        assert!(merge.run.contains(\"def pull_request\"));\n    }\n\n    #[test]\n    fn a_seeded_workflow_of_stages_turns_into_steps_without_its_land() {\n        let node = |id: &str, stage, note: &str| Node {\n            id: id.into(),\n            stage,\n            run: String::new(),\n            dial: Dial::Dark,\n            note: note.into(),\n            results: Vec::new(),\n            reach: Reach::default(),\n            x: 0,\n            y: 0,\n        };\n        let link = |from: &str, to: &str| Link {\n            from: from.into(),\n            to: to.into(),\n        };\n        let staged = Graph {\n            nodes: vec![\n                node(\"plan\", Stage::Plan, \"Find the cause.\"),\n                node(\"build\", Stage::Build, \"Fix it.\"),\n                node(\"land\", Stage::Land, \"\"),\n            ],\n            links: vec![link(\"plan\", \"build\"), link(\"build\", \"land\")],\n        };\n        let steps = as_steps(&staged);\n        assert_eq!(steps.check(), Ok(()));\n        assert_eq!(steps.nodes.len(), 2);\n        assert_eq!(steps.nodes[0].note, \"Do not change any file. Find the cause.\");\n        assert_eq!((steps.nodes[1].stage, steps.nodes[1].dial), (Stage::Prompt, Dial::LightsOn));\n        assert_eq!(steps.links.len(), 1);\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":775,"cache_read_input_tokens":682247,"output_tokens":8261,"output_tokens_details":{"thinking_tokens":2650},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":775,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8261,"cache_read_input_tokens":682247,"cache_creation_input_tokens":775,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":775},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01WVJ54Qv7PjXR6hMHwDpXWi":{"file_path":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/seed_flows.rs","content":"//! The workflows Bastion ships, as steps with their text filled in (D39).\n//! Each is the owner's to change: one is saved only while no workflow has\n//! its id, and a workflow seeded as stages is turned into steps only while\n//! its first version is unchanged.\n\nuse bastion_core::workflow::{Graph, Link, Node, Reach};\nuse bastion_core::{Dial, Stage};\n\nuse crate::store::Store;\nuse crate::workflow_store::{self, Workflow};\n\n/// A planning prompt: it reads, changes nothing, and gives the plan.\nconst PLAN: &str = \"\\\nYou are planning a change to the repository in /work/repo. Do not change any file.\nRead what you need. Then reply with the plan, and nothing before it, in this shape:\n\nRESULT plan:\n1. The file to change, and what changes in it.\n2. The test that proves it.\n\nWrite it in ASD-STE100 Simplified Technical English: one idea per sentence, at\nmost 20 words in an instruction and 25 in an explanation, active voice that\nnames what acts, and one word for each thing. Keep file, function and command\nnames exact.\";\n\n/// A building prompt: it carries out the plan linked into it.\nconst BUILD: &str = \"\\\nCarry out the plan above in the repository in /work/repo. Change the code and\nits tests, and run the tests until they pass. Do not weaken or delete a test to\nmake it pass. Commit what you change with git, with clear messages.\";\n\n/// A reviewing prompt: it reads the change against its base, and fixes it.\nconst REVIEW: &str = \"\\\nReview the change in /work/repo: `git diff bastion-base` shows it. Check that\nit does what the request asks. Look for bugs, missing tests and security\nproblems. Fix what you find and commit it. Reply with what you found and what\nyou fixed.\";\n\n/// A prompt that writes the acceptance criteria.\nconst CRITERIA: &str = \"\\\nWrite the acceptance criteria for the request: what its user can observe when\nit is met. Do not change any file. Reply in this shape, and nothing before it:\n\nRESULT criteria:\nC1. One observable behaviour, in the requester's words.\";\n\n/// A prompt that writes failing acceptance tests for the criteria.\nconst ACCEPTANCE: &str = \"\\\nWrite acceptance tests for the criteria above. Drive the code the way its user\nwould. Change no product code. Each test must fail now, because the behaviour\nis missing, not because the test is broken. Commit the tests.\";\n\n/// The workspace's checks, as its settings name them.\nconst CHECKS: &str = r#\"if [ -z \"$BASTION_CHECKS\" ]; then\n  echo \"The workspace names no checks.\"\n  exit 0\nfi\nsh -c \"$BASTION_CHECKS\"\"#;\n\n/// What the GitHub steps share: a call to GitHub's API with the token.\nconst GITHUB: &str = r#\"import json, os, sys, time, urllib.request\n\nREPO = os.environ[\"BASTION_REPO\"]\nBRANCH = os.environ[\"BASTION_BRANCH\"]\n\n\ndef call(method, path, body=None):\n    data = json.dumps(body).encode() if body is not None else None\n    request = urllib.request.Request(\n        f\"https://api.github.com/repos/{REPO}{path}\",\n        data=data,\n        method=method,\n        headers={\n            \"Authorization\": \"Bearer \" + os.environ[\"GH_TOKEN\"],\n            \"Accept\": \"application/vnd.github+json\",\n        },\n    )\n    with urllib.request.urlopen(request) as answer:\n        return json.load(answer)\n\n\ndef pull_request():\n    owner = REPO.split(\"/\")[0]\n    found = call(\"GET\", f\"/pulls?state=open&head={owner}:{BRANCH}\")\n    return found[0] if found else None\n\"#;\n\n/// Push the branch with the token as a header, never in a URL, then open\n/// its pull request if none is open.\nconst PULL_REQUEST: &str = r#\"set -e\nauth=\"Authorization: Basic $(printf 'x-access-token:%s' \"$GH_TOKEN\" | base64 | tr -d '\\n')\"\ngit -c http.extraHeader=\"$auth\" push -q \"https://github.com/$BASTION_REPO.git\" \"HEAD:refs/heads/$BASTION_BRANCH\"\npython3 - <<'PY'\n@GITHUB@\nimport subprocess\npr = pull_request()\nif pr is None:\n    title = subprocess.run([\"git\", \"log\", \"-1\", \"--format=%s\"], capture_output=True, text=True).stdout.strip()\n    pr = call(\"POST\", \"/pulls\", {\"title\": title, \"head\": BRANCH, \"base\": os.environ[\"BASTION_BASE\"]})\nprint(pr[\"html_url\"])\nPY\"#;\n\n/// Wait for the pull request's checks, at most 14 minutes.\nconst CI: &str = r#\"python3 - <<'PY'\n@GITHUB@\npr = pull_request()\nif pr is None:\n    sys.exit(\"No open pull request for \" + BRANCH)\nsha = pr[\"head\"][\"sha\"]\nfor _ in range(84):\n    runs = call(\"GET\", f\"/commits/{sha}/check-runs\")[\"check_runs\"]\n    if runs and all(r[\"status\"] == \"completed\" for r in runs):\n        failed = [r[\"name\"] for r in runs if r[\"conclusion\"] not in (\"success\", \"skipped\", \"neutral\")]\n        if failed:\n            sys.exit(\"Failed: \" + \", \".join(failed))\n        print(\"Passed: \" + \", \".join(r[\"name\"] for r in runs))\n        sys.exit(0)\n    time.sleep(10)\nsys.exit(\"The checks did not finish in 14 minutes.\")\nPY\"#;\n\n/// Merge the pull request.\nconst MERGE: &str = r#\"python3 - <<'PY'\n@GITHUB@\npr = pull_request()\nif pr is None:\n    sys.exit(\"No open pull request for \" + BRANCH)\nmerged = call(\"PUT\", f\"/pulls/{pr['number']}/merge\", {\"merge_method\": \"merge\"})\nprint(\"Merged \" + pr[\"html_url\"] + \" as \" + merged[\"sha\"])\nPY\"#;\n\n/// The seeded workflows that are made of stages, by id.\nconst STAGED: [&str; 11] = [\n    \"research\",\n    \"bug-fix\",\n    \"dependency-upgrade\",\n    \"test-coverage\",\n    \"weekly-status\",\n    \"decision-record\",\n    \"onboarding-guide\",\n    \"incident-response\",\n    \"incident-postmortem\",\n    \"runbook\",\n    \"infrastructure-change\",\n];\n\n/// One step, `x` from the left.\nstruct Step {\n    id: &'static str,\n    stage: Stage,\n    dial: Dial,\n    text: &'static str,\n    results: &'static [&'static str],\n    network: bool,\n}\n\nconst fn prompt(id: &'static str, dial: Dial, text: &'static str) -> Step {\n    Step {\n        id,\n        stage: Stage::Prompt,\n        dial,\n        text,\n        results: &[],\n        network: false,\n    }\n}\n\nconst fn shell(id: &'static str, dial: Dial, script: &'static str) -> Step {\n    Step {\n        id,\n        stage: Stage::Shell,\n        dial,\n        text: script,\n        results: &[],\n        network: false,\n    }\n}\n\n/// A GitHub step: a shell script with the network and `GH_TOKEN`.\nconst fn github(id: &'static str, dial: Dial, script: &'static str) -> Step {\n    Step {\n        network: true,\n        ..shell(id, dial, script)\n    }\n}\n\nconst PLAN_STEP: Step = Step {\n    results: &[\"plan\"],\n    ..prompt(\"plan\", Dial::LightsOn, PLAN)\n};\nconst BUILD_STEP: Step = prompt(\"build\", Dial::Dark, BUILD);\n\n/// The steps a pull request adds after the checks.\nconst GITHUB_STEPS: [Step; 3] = [\n    github(\"pull-request\", Dial::Dark, PULL_REQUEST),\n    github(\"ci\", Dial::LightsOn, CI),\n    github(\"merge\", Dial::Dark, MERGE),\n];\n\n/// The workflows Bastion ships as steps: id, name, steps in order.\nfn shipped() -> Vec<(&'static str, &'static str, Vec<Step>)> {\n    let review = prompt(\"review\", Dial::Dark, REVIEW);\n    let criteria = Step {\n        results: &[\"criteria\"],\n        ..prompt(\"criteria\", Dial::LightsOn, CRITERIA)\n    };\n    let checks = |dial| shell(\"checks\", dial, CHECKS);\n    let to_github = |mut steps: Vec<Step>| {\n        steps.extend(GITHUB_STEPS);\n        steps\n    };\n    vec![\n        (\n            \"short\",\n            \"Short\",\n            vec![PLAN_STEP, BUILD_STEP, checks(Dial::LightsOn)],\n        ),\n        (\n            \"pull-request\",\n            \"Pull request\",\n            to_github(vec![PLAN_STEP, BUILD_STEP, checks(Dial::Dark)]),\n        ),\n        (\n            \"full\",\n            \"Full\",\n            to_github(vec![\n                PLAN_STEP,\n                criteria,\n                prompt(\"acceptance-tests\", Dial::Dark, ACCEPTANCE),\n                BUILD_STEP,\n                checks(Dial::Dark),\n                prompt(\"review\", Dial::Dark, REVIEW),\n            ]),\n        ),\n        (\n            \"full_no_acceptance\",\n            \"Full, without acceptance tests\",\n            to_github(vec![PLAN_STEP, BUILD_STEP, checks(Dial::Dark), review]),\n        ),\n    ]\n}\n\n/// The graph of steps in a row, each linked to the next.\nfn chain(steps: Vec<Step>) -> Graph {\n    let ids: Vec<&str> = steps.iter().map(|s| s.id).collect();\n    let nodes = steps.into_iter().enumerate().map(|(i, s)| {\n        let shell = s.stage == Stage::Shell;\n        Node {\n            id: s.id.into(),\n            stage: s.stage,\n            run: if shell { s.text.replace(\"@GITHUB@\", GITHUB) } else { String::new() },\n            dial: s.dial,\n            note: if shell { String::new() } else { s.text.into() },\n            results: s.results.iter().map(|r| r.to_string()).collect(),\n            reach: Reach {\n                network: s.network,\n                secrets: if s.network { vec![\"GH_TOKEN\".into()] } else { Vec::new() },\n            },\n            x: 220 * i as i32,\n            y: 0,\n        }\n    });\n    let links = ids.windows(2).map(|w| Link {\n        from: w[0].into(),\n        to: w[1].into(),\n    });\n    Graph {\n        nodes: nodes.collect(),\n        links: links.collect(),\n    }\n}\n\n/// A seeded workflow of stages as steps: plan reads and changes nothing,\n/// build is the gate before the finish, and land goes, as the finish\n/// lands (D41).\nfn as_steps(g: &Graph) -> Graph {\n    let nodes = g.nodes.iter().filter(|n| n.stage != Stage::Land).map(|n| {\n        let mut n = n.clone();\n        match n.stage {\n            Stage::Plan => {\n                n.stage = Stage::Prompt;\n                n.note = format!(\"Do not change any file. {}\", n.note);\n            }\n            Stage::Build => {\n                n.stage = Stage::Prompt;\n                n.dial = Dial::LightsOn;\n            }\n            _ => {}\n        }\n        n\n    });\n    let land: Vec<&str> = g.nodes.iter().filter(|n| n.stage == Stage::Land).map(|n| n.id.as_str()).collect();\n    let links = g.links.iter().filter(|l| !land.contains(&l.from.as_str()) && !land.contains(&l.to.as_str()));\n    Graph {\n        nodes: nodes.collect(),\n        links: links.cloned().collect(),\n    }\n}\n\n/// Save each shipped workflow no workflow has the id of, and turn each\n/// seeded workflow still as seeded into steps.\npub async fn seed(store: &dyn Store) -> Result<(), String> {\n    let kept = store.workflows().await?;\n    let has = |id: &str| kept.iter().any(|k| k.0 == id);\n    for (id, name, steps) in shipped() {\n        if !has(id) {\n            save(store, id, name, chain(steps)).await?;\n        }\n    }\n    for (id, name, version) in kept.iter().filter(|k| STAGED.contains(&k.0.as_str()) && k.2 == 1) {\n        let Some(graph) = store.graph_at(id, *version).await? else {\n            continue;\n        };\n        if graph.nodes.iter().any(|n| matches!(n.stage, Stage::Plan | Stage::Build | Stage::Land)) {\n            save(store, id, name, as_steps(&graph)).await?;\n        }\n    }\n    Ok(())\n}\n\nasync fn save(store: &dyn Store, id: &str, name: &str, graph: Graph) -> Result<u64, String> {\n    let w = Workflow {\n        id: id.into(),\n        name: name.into(),\n        version: 0,\n        graph,\n    };\n    workflow_store::save(store, &w, crate::factory::now()).await\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn every_shipped_workflow_is_steps_only_and_checks() {\n        for (id, _, steps) in shipped() {\n            let g = chain(steps);\n            assert_eq!(g.check(), Ok(()), \"{id}\");\n            assert!(g.nodes.iter().all(|n| bastion_core::workflow::custom(n.stage)), \"{id}\");\n            let script = g.nodes.iter().map(|n| n.run.as_str()).collect::<String>();\n            assert!(!script.contains(\"@GITHUB@\"), \"{id}\");\n        }\n        let pr = chain(shipped().remove(1).2);\n        let merge = pr.nodes.iter().find(|n| n.id == \"merge\").unwrap();\n        assert!(merge.reach.network && merge.reach.secrets == [\"GH_TOKEN\"]);\n        assert!(merge.run.contains(\"def pull_request\"));\n    }\n\n    #[test]\n    fn a_seeded_workflow_of_stages_turns_into_steps_without_its_land() {\n        let node = |id: &str, stage, note: &str| Node {\n            id: id.into(),\n            stage,\n            run: String::new(),\n            dial: Dial::Dark,\n            note: note.into(),\n            results: Vec::new(),\n            reach: Reach::default(),\n            x: 0,\n            y: 0,\n        };\n        let link = |from: &str, to: &str| Link {\n            from: from.into(),\n            to: to.into(),\n        };\n        let staged = Graph {\n            nodes: vec![\n                node(\"plan\", Stage::Plan, \"Find the cause.\"),\n                node(\"build\", Stage::Build, \"Fix it.\"),\n                node(\"land\", Stage::Land, \"\"),\n            ],\n            links: vec![link(\"plan\", \"build\"), link(\"build\", \"land\")],\n        };\n        let steps = as_steps(&staged);\n        assert_eq!(steps.check(), Ok(()));\n        assert_eq!(steps.nodes.len(), 2);\n        assert_eq!(steps.nodes[0].note, \"Do not change any file. Find the cause.\");\n        assert_eq!((steps.nodes[1].stage, steps.nodes[1].dial), (Stage::Prompt, Dial::LightsOn));\n        assert_eq!(steps.links.len(), 1);\n    }\n}\n"}},"serverClassifierRequest":"a3cc4b88-f77a-4a13-813e-2686888b39b2","apiBlockIndex":2,"requestId":"req_011CgwmPddwUPu496kLwzGQc","type":"assistant","uuid":"586070bb-7f88-4d96-8bbe-86455c80e1e9","timestamp":"2026-11-11T20:25:10.324Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
