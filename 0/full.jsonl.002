f)| *f == function)","+        .map_or(\"Bash\", |(t, _)| t)","+}","+","+/// The sandbox functions a hook matcher such as `Bash|Write` or `*` covers.","+pub fn hook_functions(matcher: &str) -> Vec<&'static str> {","+    let names: Vec<&str> = matcher.split('|').map(str::trim).collect();","+    let all = matcher.trim().is_empty() || names.contains(&\"*\");","+    let mut functions: Vec<&'static str> = TOOLS","+        .iter()","+        .filter(|(tool, _)| all || names.contains(tool))","+        .map(|(_, f)| *f)","+        .collect();","+    functions.dedup();","+    functions","+}","+","+/// The repository's `deny` and `ask` rules as constraints. A `Bash(...)` rule","+/// binds the command's words; any other rule can only be told, for now. An","+/// unattended turn has no one to ask, so `ask` refuses like `deny`.","+pub fn constraints(deny: &[String], ask: &[String]) -> Vec<Constraint> {","+    let rules = deny","+        .iter()","+        .map(|r| (r, \"denies\"))","+        .chain(ask.iter().map(|r| (r, \"asks first for\")));","+    rules","+        .enumerate()","+        .map(|(i, (rule, verb))| match bash_words(rule) {","+            Some(words) => Constraint {","+                id: format!(\"charter-{}\", i + 1),","+                rule: format!(\"The repository {verb} {rule}.\"),","+                function: \"sandbox::exec\".into(),","+                contains: words,","+                rung: Enforcement::Enforced,","+                source: Source::Charter,","+            },","+            None => Constraint {","+                id: format!(\"charter-{}\", i + 1),","+                rule: format!(","+                    \"The repository {verb} {rule}. Bastion tells the agent but cannot bind it yet.\"","+                ),","+                function: String::new(),","+                contains: String::new(),","+                rung: Enforcement::Told,","+                source: Source::Charter,","+            },","+        })","+        .collect()","+}","+","+/// `Bash(git push:*)` gives `git push`; `Bash` alone gives no words.","+fn bash_words(rule: &str) -> Option<String> {","+    let inner = rule.strip_prefix(\"Bash(\")?.strip_suffix(')')?;","+    let words = inner.trim_end_matches('*').trim_end_matches(':').trim();","+    (!words.is_empty()).then(|| words.to_string())","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+    use crate::Stage;","+    use crate::govern::{Call, Decision, default_capabilities, gate};","+","+    #[test]","+    fn hook_matchers_cover_the_sandbox_functions() {","+        assert_eq!(hook_functions(\"Bash\"), [\"sandbox::exec\"]);","+        assert_eq!(hook_functions(\"Write|Edit\"), [\"sandbox::fs::write\"]);","+        assert_eq!(hook_functions(\"*\").len(), 4);","+        assert_eq!(hook_functions(\"\").len(), 4);","+        assert!(hook_functions(\"WebFetch\").is_empty());","+        assert_eq!(tool_name(\"sandbox::fs::write\"), \"Write\");","+    }","+","+    #[test]","+    fn a_denied_bash_rule_refuses_the_command_and_others_are_told() {","+        let rules = constraints(","+            &[\"Bash(git push:*)\".into(), \"Read(./.env)\".into()],","+            &[\"Bash(rm -rf)\".into()],","+        );","+        assert_eq!(rules[0].contains, \"git push\");","+        assert_eq!(rules[1].rung, Enforcement::Told);","+        assert_eq!(rules[2].contains, \"rm -rf\");","+        let push = Call {","+            function: \"sandbox::exec\".into(),","+            text: \"git -C /work/repo push origin\".into(),","+        };","+        let Decision::Deny { reason } =","+            gate(&push, Stage::Build, &rules, &default_capabilities()).decision","+        else {","+            panic!(\"a denied command must be refused\");","+        };","+        assert!(reason.contains(\"Bash(git push:*)\"), \"{reason}\");","+    }","+}"]}],"created":true},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","hunks":[{"oldStart":4,"oldLines":6,"newStart":4,"newLines":7,"lines":[" "," pub mod audit;"," mod brief;","+pub mod charter;"," pub mod govern;"," "," use serde::{Deserialize, Serialize};"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-spikes/examples/schema.rs","hunks":[{"oldStart":1,"oldLines":15,"newStart":0,"newLines":0,"lines":["-//! Print one function's entry from `engine::functions::list`:","-//! `cargo run -p bastion-spikes --example schema -- sandbox::exec`.","-","-use bastion_spikes::{call_default, connect};","-use serde_json::json;","-","-#[tokio::main]","-async fn main() {","-    let id = std::env::args().nth(1).expect(\"a function id\");","-    let iii = connect(\"spike-schema\");","-    let all = call_default(&iii, \"engine::functions::list\", json!({}), 10_000).await.expect(\"list\");","-    let found = all[\"functions\"].as_array().into_iter().flatten().find(|f| f[\"function_id\"] == id.as_str());","-    println!(\"{}\", serde_json::to_string_pretty(&found).unwrap());","-    std::process::exit(0);","-}"]}],"deleted":true}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/charter.rs","/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","/Users/tacoda/tacoda/bastion/crates/bastion-spikes/examples/schema.rs"]}},"serverClassifierContext":{"request":"b6946f96-e2c1-46bd-abbb-9c97c22d6648","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"379092d3-aab2-4a89-a2e9-bfdc96c1af9c","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.2