'''fn on_field(state: &mut State, field: StepField, value: String) {''','''/// A comma-separated list as typed, as its names.\nfn listed(typed: &str) -> Vec<String> {\n    let names = typed.split(',').map(str::trim).filter(|r| !r.is_empty());\n    names.map(String::from).collect()\n}\n\nfn on_field(state: &mut State, field: StepField, value: String) {'''),\n('''        Msg::Text(a) => {''','''        Msg::Network(on) => state.step(|n| n.reach.network = on),\n        Msg::Text(a) => {'''),\n('''    let results = text_input(\"\", &state.results)\n        .on_input_maybe(editable.then_some(|v| wrap(Msg::Field(StepField::Results, v))))\n        .style(theme::field);\n    body = body''','''    if n.stage == \"shell\" {\n        let network = iced::widget::checkbox(n.reach.network)\n            .label(\"Needs the network: runs in a VM of its own with these secrets\")\n            .on_toggle_maybe(editable.then_some(|on| wrap(Msg::Network(on))));\n        let secrets = text_input(\"GH_TOKEN\", &state.secrets)\n            .on_input_maybe(editable.then_some(|v| wrap(Msg::Field(StepField::Secrets, v))))\n            .style(theme::field);\n        body = body.push(network).push(labeled(\n            \"Secrets from the vault, as environment variables, comma-separated\",\n            secrets,\n        ));\n    }\n    let results = text_input(\"\", &state.results)\n        .on_input_maybe(editable.then_some(|v| wrap(Msg::Field(StepField::Results, v))))\n        .style(theme::field);\n    body = body'''),\n])\nEOF\ncargo fmt --all && CARGO_INCREMENTAL=0 cargo build -q -p bastion-desktop 2>&1 | grep -E \"^error\" -A12 | head -30","description":"Add network and secrets to the shell step panel","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":640,"cache_read_input_tokens":618589,"output_tokens":1604,"output_tokens_details":{"thinking_tokens":153},"