{"parentUuid":"577dd0cb-76eb-43c3-8ae1-1bc200ac2c93","isSidechain":false,"promptId":"1d9ef2db-03d5-4a58-b720-e211c5a548e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011iZ15EqS3fdkDRQ9wYWb8d","type":"tool_result","content":"        .load(id)\n        .await\n        .map_err(|e| match crate::store::is_no_job(&e) {\n            true => Refusal::NoJob(e),\n            false => Refusal::NotReady,\n        })?;\n    let requester = record.runtime.requester.unwrap_or_default();\n    check(\n        person,\n        Act::OnJob {\n            own: requester == person.name,\n        },\n    )\n    .map_err(|_| Refusal::Forbidden(format!(\"only {requester} or an admin may act on job {id}\")))\n}\n\n/// Run `on_job`, and at a UAT step also require the job's requester: the\n/// sign-off is theirs, so not even an admin gives it for them.\npub async fn approve(server: &Server, person: &Person, id: &str) -> Result<(), Refusal> {\n    on_job(server, person, id).await?;\n    let factory = server.factory.get().ok_or(Refusal::NotReady)?;\n    let record = factory.store().load(id).await.map_err(Refusal::NoJob)?;\n    let requester = record.runtime.requester.unwrap_or_default();\n    signs_off(record.job.stage, &requester, &person.name).map_err(Refusal::Forbidden)\n}\n\ncrates/bastion-server/src/access.rs:133:pub async fn approve(server: &Server, person: &Person, id: &str) -> Result<(), Refusal> {\ncrates/bastion-server/src/access.rs:138:    signs_off(record.job.stage, &requester, &person.name).map_err(Refusal::Forbidden)\ncrates/bastion-server/src/access.rs:143:fn signs_off(stage: Stage, requester: &str, person: &str) -> Result<(), String> {\ncrates/bastion-server/src/access.rs:158:    fn only_the_requester_signs_off_a_uat_script() {\ncrates/bastion-server/src/access.rs:159:        assert!(signs_off(Stage::Uat, \"ada\", \"ada\").is_ok());\ncrates/bastion-server/src/access.rs:160:        let refused = signs_off(Stage::Uat, \"ada\", \"root\").unwrap_err();\n