@v4"," ","-      - name: Linux packages","-        if: runner.os == 'Linux'","-        # A mirror that hangs or drops a file fails here, not after hours.","-        timeout-minutes: 15","-        run: |","-          sudo apt-get -o Acquire::Retries=3 update","-          sudo apt-get -o Acquire::Retries=3 install -y libgtk-3-dev libxdo-dev libayatana-appindicator3-dev","-","       - name: Target","         run: rustup target add ${{ matrix.target }}"," "]}]},{"filePath":"/Users/tacoda/tacoda/bastion/Cargo.toml","hunks":[{"oldStart":7,"oldLines":7,"newStart":7,"newLines":6,"lines":["     \"crates/bastion-cli\",","     \"crates/bastion-client\",","     \"crates/bastion-desktop\",","-    \"crates/bastion-tray\",","     \"workers/bastion-openai-compat\","," ]"," "]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/app.rs","hunks":[{"oldStart":204,"oldLines":7,"newStart":204,"newLines":7,"lines":["                 let page = self.page.reload(&self.ctx(), Push::All);","                 return Task::batch([self.count_waiting(&server), page]);","             }","-            // The tray shows the notice itself; the window counts it.","+            // The window counts the notice.","             Feed::Change(Change::Notice { waiting, .. }) => {","                 self.waiting.insert(server, waiting);","                 Push::Job"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/main.rs","hunks":[{"oldStart":17,"oldLines":34,"newStart":17,"newLines":7,"lines":[" /// The castle, as 64 x 64 RGBA pixels, from `assets/icon/bastion.svg`."," const ICON: &[u8] = include_bytes!(\"../../../assets/icon/bastion-64.rgba\");"," ","-/// Start the tray beside this program (F9). It shows the notices, and a","-/// second copy exits, so starting it each time is safe.","-fn start_tray() {","-    let beside = std::env::current_exe()","-        .ok()","-        .and_then(|p| p.parent().map(|d| d.join(\"bastion-tray\")));","-    let Some(tray) = beside.filter(|t| t.exists()) else {","-        return;","-    };","-    // What it says goes to a log beside the client's files, so a tray that","-    // stops at once leaves its reason.","-    let log = std::fs::OpenOptions::new()","-        .create(true)","-        .append(true)","-        .open(bastion_client::start::config_dir().join(\"tray.log\"));","-    let mut command = std::process::Command::new(tray);","-    if let Ok(log) = log {","-        let err = log.try_clone();","-        command.stdout(log);","-        command.stderr(err.map_or_else(|_| std::process::Stdio::null(), Into::into));","-    }","-    if let Err(e) = command.spawn() {","-        eprintln!(\"the tray did not start: {e}\");","-    }","-}","-"," fn main() -> iced::Result {","-    start_tray();","     let window = window::Settings {","         size: Size::new(1280.0, 860.0),","         min_size: Some(Size::new(720.0, 480.0)),"]}]}],"moreFiles":9,"changedFiles":["/Users/tacoda/tacoda/bastion/.github/workflows/ci.yml","/Users/tacoda/tacoda/bastion/.github/workflows/release.yml","/Users/tacoda/tacoda/bastion/Cargo.toml","/Users/tacoda/tacoda/bastion/assets/icon/tray-36.rgba","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/app.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/main.rs","/Users/tacoda/tacoda/bastion/crates/bastion-tray/Cargo.toml","/Users/tacoda/tacoda/bastion/crates/bastion-tray/src/main.rs","/Users/tacoda/tacoda/bastion/crates/bastion-tray/src/menu.rs","/Users/tacoda/tacoda/bastion/crates/bastion-tray/src/notify.rs","/Users/tacoda/tacoda/bastion/crates/bastion-tray/src/worker.rs","/Users/tacoda/tacoda/bastion/scripts/check-seams.sh","/Users/tacoda/tacoda/bastion/scripts/install.sh","/Users/tacoda/tacoda/bastion/scripts/package.sh"]}},"serverClassifierContext":{"request":"d0856c7a-8fd5-4dd7-8243-063809e17f3b","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":tru