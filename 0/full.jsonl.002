{"parentUuid":"187f6216-ec63-4bc3-b4ac-148c317eca1a","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/tacoda/tacoda/bastion/.github/workflows/release.yml","snippet":"18\t          - { os: ubuntu-24.04, target: x86_64-unknown-linux-gnu }\n19\t          - { os: ubuntu-24.04-arm, target: aarch64-unknown-linux-gnu }\n20\t    runs-on: ${{ matrix.os }}\n21\t    steps:\n22\t      - uses: actions/checkout@v4\n23\t\n24\t      - name: Linux packages\n25\t        if: runner.os == 'Linux'\n26\t        # A mirror that hangs or drops a file fails here, not after hours.\n27\t        timeout-minutes: 15\n28\t        run: |\n29\t          sudo apt-get -o Acquire::Retries=3 update\n30\t          sudo apt-get -o Acquire::Retries=3 install -y libgtk-3-dev libxdo-dev libayatana-appindicator3-dev\n31\t\n32\t      - name: Target\n33\t        run: rustup target add ${{ matrix.target }}\n34\t\n35\t      - name: Package\n36\t        run: scripts/package.sh \"${GITHUB_REF_NAME#v}\" ${{ matrix.target }}\n37\t\n38\t      - uses: actions/upload-artifact@v4\n...\n49\t          pattern: dist-*\n50\t          merge-multiple: true\n51\t          path: dist\n52\t\n53\t      - name: Sums, signed\n54\t        env:\n55\t          MINISIGN_SECRET_KEY: ${{ secrets.MINISIGN_SECRET_KEY }}\n56\t        run: |\n57\t          sudo apt-get -o Acquire::Retries=3 update && sudo apt-get -o Acquire::Retries=3 install -y minisign\n58\t          cd dist\n59\t          sha256sum * > SHA256SUMS\n60\t          key=\"$(mktemp)\"\n61\t          printf '%s\\n' \"$MINISIGN_SECRET_KEY\" > \"$key\"\n62\t          minisign -S -s \"$key\" -m SHA256SUMS -t \"bastion $GITHUB_REF_NAME\"\n63\t          rm -f \"$key\"\n64\t\n65\t      - name: Publish"},"type":"attachment","uuid":"95753f79-269f-41a9-900a-78fbb1c42ee4","timestamp":"2026-11-11T16:28:02.444Z","rendered":[{"content":"<system-reminder>\nNote: /Users/tacoda/tacoda/bastion/.github/workflows/release.yml changed on disk since you last read it. Th