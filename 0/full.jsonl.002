on_core::Dial::Dark,","+            note: String::new(),","+            needs: Vec::new(),","+            gives: Vec::new(),","+            reach: Reach::default(),","+        }];","+        record.job.node = Some(\"tests\".into());","+        rig.factory.command_step(&record).await;","+        let calls = rig.engine.calls.lock().unwrap().clone();","+        let ran = calls.iter().find(|c| c.1 == \"sandbox::exec\").unwrap();","+        let line = ran.2[\"argv\"][2].as_str().unwrap();","+        assert!(","+            line.contains(\"BASTION_BRANCH='iii/wt1' BASTION_BASE='main'\"),","+            \"{line}\"","+        );","+        assert!(line.ends_with(\"make test\"));","+        assert!(","+            !calls.iter().any(|c| c.1 == \"sandbox::create\"),","+            \"the job's own VM\"","+        );","+","+        let value = rig.factory.vault_value(\"GH_TOKEN\").await;","+        assert_eq!(value.as_deref(), Ok(\"t0k\"));","+        let calls = rig.engine.calls.lock().unwrap().clone();","+        let access: Vec<&serde_json::Value> = calls","+            .iter()","+            .filter(|c| c.1 == \"secrets::access\")","+            .map(|c| &c.2[\"consumers\"])","+            .collect();","+        let me = crate::engine::worker_name();","+        assert_eq!(access[0], &json!([\"llm-router\", me]));","+        assert_eq!(access[1], &json!([\"llm-router\"]), \"put back as it was\");","+    });","+}"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/factory/shell.rs","hunks":[{"oldStart":66,"oldLines":7,"newStart":66,"newLines":7,"lines":["     /// A secret's value from the vault. The vault gives a value only to a","     /// worker it names as a consumer, so this process is named for the read","     /// and the consumers are put back as they were.","-    async fn vault_value(&self, name: &str) -> Result<String, String> {","+    pub(super) async fn vault_value(&self, name: &str) -> Result<String, String> {","         let missing = |_| format!