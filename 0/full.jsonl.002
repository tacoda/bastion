{"type":"file-history-delta","messageId":"cd494a65-e8ce-472f-8a10-215c27b75788","snapshotMessageId":"4cc0fea4-84a4-4dfd-a04f-4e71e3a4518a","trackingPath":"src-tauri/src/commands/evals.rs","backup":{"backupFileName":null,"version":1,"backupTime":"2026-10-31T16:36:56.582Z","realParentDir":"/Users/tacoda/tacoda/bastion/src-tauri/src/commands"},"timestamp":"2026-10-31T16:36:56.588Z"}
{"parentUuid":"297c5531-c4aa-4ece-a8f0-f84ef48f404b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cgae8W8v2Qf2qRbD5sHiZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XYeToyZfHyy5qoL8XFsqaB","name":"Write","input":{"file_path":"/Users/tacoda/tacoda/bastion/src-tauri/src/commands/evals.rs","content":"//! Commands for A/B evals (PLAN.md A6).\n\nuse std::sync::Arc;\n\nuse bastion_core::eval::{self, Override, Run};\nuse bastion_protocol::{EvalRow, EvalSummary, EvalView, NewEval, RunView};\nuse serde_json::json;\nuse tauri::State;\n\nuse super::factory::{FactoryCell, factory};\nuse crate::eval_store::{Eval, EvalRun};\nuse crate::evals::{self, Plan, RunRead};\nuse crate::factory::Factory;\nuse crate::machine::Machine;\n\n/// `constraint:<id>` or `capability:<stage>:<function>`, at one rung.\nfn override_of(target: &str, rung: &str) -> Result<Override, String> {\n    let value = |text: &str| json!(text);\n    let bad = || format!(\"{target:?} at {rung:?} is not a constraint or a grant at a rung\");\n    match target.split_once(':') {\n        Some((\"constraint\", id)) => Ok(Override::Constraint {\n            id: id.into(),\n            rung: serde_json::from_value(value(rung)).map_err(|_| bad())?,\n        }),\n        Some((\"capability\", rest)) => {\n            let (stage, function) = rest.split_once(':').ok_or_else(bad)?;\n            Ok(Override::Capability {\n                stage: serde_json::from_value(value(stage)).map_err(|_| bad())?,\n                function: function.into(),\n                rung: serde_json::from_value(value(rung)).map_err(|_| bad())?,\n            })\n        }\n        _ => Err(bad()),\n    }\n}\n\nfn describe(o: &Override) -> String {\n    match o {\n        Override::Constraint { id, rung } => format!(\"constraint {id} at {rung:?}\"),\n        Override::Capability { stage, function, rung } => format!(\"{stage:?} {function} at {rung:?}\"),\n    }\n}\n\nfn view_of(t: &Run, job: &str, state: &str, refused_calls: Vec<String>) -> RunView {\n    RunView {\n        job: job.into(),\n        state: state.into(),\n        reviewed: t.reviewed,\n        passed: t.passed,\n        refused: t.refused,\n        held: t.held,\n        flagged: t.flagged,\n        hook_refused: t.hook_refused,\n        findings: t.findings,\n        turns: t.usage.turns,\n        cost_micros: t.usage.cost_micros,\n        seconds: t.seconds,\n        grade: t.grade,\n        refused_calls,\n    }\n}\n\nfn finished(r: &RunRead) -> bool {\n    let over = matches!(r.state.as_str(), \"stopped\" | \"failed\" | \"landed\");\n    over && (!r.tally.reviewed || r.run.grade.is_some())\n}\n\nasync fn reads(factory: &Factory, e: &Eval) -> Result<Vec<RunRead>, String> {\n    let chain = factory.gate().audit()?.read().await?.chain;\n    let mut out = Vec::new();\n    for run in factory.store().eval_runs(&e.id).await? {\n        out.push(evals::read_run(&**factory.store(), &chain, run).await?);\n    }\n    Ok(out)\n}\n\nfn summary(e: Eval, runs: &[RunRead]) -> EvalSummary {\n    EvalSummary {\n        id: e.id,\n        name: e.name,\n        workspace: e.workspace,\n        base: e.base,\n        created_at: e.created_at,\n        runs: runs.len() as u32,\n        done: runs.iter().filter(|r| finished(r)).count() as u32,\n    }\n}\n\n#[tauri::command]\npub async fn evals(cell: State<'_, FactoryCell>) -> Result<Vec<EvalSummary>, String> {\n    let factory = factory(&cell)?;\n    let mut out = Vec::new();\n    for e in factory.store().evals().await? {\n        let runs = reads(&factory, &e).await?;\n        out.push(summary(e, &runs));\n    }\n    Ok(out)\n}\n\n#[tauri::command]\npub async fn eval_create(\n    cell: State<'_, FactoryCell>,\n    machine: State<'_, Arc<dyn Machine>>,\n    eval: NewEval,\n) -> Result<String, String> {\n    let plan = Plan {\n        name: eval.name,\n        workspace: eval.workspace,\n        requests: eval.requests,\n        a: vec![override_of(eval.target.trim(), &eval.rung_a)?],\n        b: vec![override_of(eval.target.trim(), &eval.rung_b)?],\n    };\n    evals::create(&factory(&cell)?, machine.inner().as_ref(), plan).await\n}\n\n/// One eval: each request under A and B, the totals, and what differs.\n#[tauri::command]\npub async fn eval(cell: State<'_, FactoryCell>, id: String) -> Result<EvalView, String> {\n    let factory = factory(&cell)?;\n    let e = factory.store().eval(&id).await?;\n    let (arm_a, arm_b) = (factory.store().arm(&id, \"a\").await?, factory.store().arm(&id, \"b\").await?);\n    let runs = reads(&factory, &e).await?;\n    let pick = |arm: &str, idx: u32| runs.iter().find(|r| r.run.arm == arm && r.run.idx == idx);\n    let mut idxs: Vec<u32> = runs.iter().map(|r| r.run.idx).collect();\n    idxs.dedup();\n    let rows = idxs\n        .into_iter()\n        .map(|idx| {\n            let (a, b) = (pick(\"a\", idx), pick(\"b\", idx));\n            let differences = match (a, b) {\n                (Some(a), Some(b)) => eval::differences(&a.tally, &b.tally),\n                _ => Vec::new(),\n            };\n            let view = |r: Option<&RunRead>| r.map(|r| view_of(&r.tally, &r.run.job, &r.state, r.refused.clone()));\n            EvalRow {\n                idx,\n                request: a.or(b).map(|r| r.run.request.clone()).unwrap_or_default(),\n                a: view(a),\n                b: view(b),\n                differences,\n            }\n        })\n        .collect();\n    let total = |arm: &str| eval::total(&runs.iter().filter(|r| r.run.arm == arm).map(|r| r.tally.clone()).collect::<Vec<_>>());\n    let (total_a, total_b) = (total(\"a\"), total(\"b\"));\n    Ok(EvalView {\n        summary: summary(e, &runs),\n        arm_a: arm_a.iter().map(describe).collect(),\n        arm_b: arm_b.iter().map(describe).collect(),\n        rows,\n        differences: eval::differences(&total_a, &total_b),\n        total_a: view_of(&total_a, \"\", \"\", Vec::new()),\n        total_b: view_of(&total_b, \"\", \"\", Vec::new()),\n    })\n}\n\n/// Set the live policy to one arm's rungs, and record which eval it came from.\n#[tauri::command]\npub async fn eval_apply(cell: State<'_, FactoryCell>, id: String, arm: String) -> Result<(), String> {\n    let factory = factory(&cell)?;\n    let overrides = factory.store().arm(&id, &arm).await?;\n    if overrides.is_empty() {\n        return Err(format!(\"eval {id} has no arm {arm:?}\"));\n    }\n    factory.gate().apply_arm(&id, &arm, &overrides).await\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use bastion_core::Stage;\n    use bastion_core::govern::{Access, Enforcement};\n\n    #[test]\n    fn a_target_reads_as_an_override() {\n        assert_eq!(\n            override_of(\"constraint:keep-tests\", \"enforced\"),\n            Ok(Override::Constraint { id: \"keep-tests\".into(), rung: Enforcement::Enforced })\n        );\n        assert_eq!(\n            override_of(\"capability:plan:sandbox::fs::write\", \"allowed\"),\n            Ok(Override::Capability { stage: Stage::Plan, function: \"sandbox::fs::write\".into(), rung: Access::Allowed })\n        );\n        assert!(override_of(\"constraint:keep-tests\", \"allowed\").is_err());\n        assert!(override_of(\"keep-tests\", \"told\").is_err());\n    }\n\n    #[test]\n    fn a_run_counts_as_done_once_over_and_graded() {\n        let run = |state: &str, reviewed: bool, grade: Option<u8>| RunRead {\n            run: EvalRun { eval: \"e\".into(), arm: \"a\".into(), idx: 0, request: \"r\".into(), job: \"j\".into(), grade },\n            state: state.into(),\n            tally: Run { reviewed, ..Run::default() },\n            refused: vec![],\n        };\n        assert!(!finished(&run(\"running\", false, None)));\n        assert!(!finished(&run(\"stopped\", true, None)), \"waits for its grade\");\n        assert!(finished(&run(\"stopped\", true, Some(7))));\n        assert!(finished(&run(\"failed\", false, None)));\n    }\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1917,"cache_read_input_tokens":693271,"output_tokens":4646,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1917,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":4646,"cache_read_input_tokens":693271,"cache_creation_input_tokens":1917,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1917},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01XYeToyZfHyy5qoL8XFsqaB":{"file_path":"/Users/tacoda/tacoda/bastion/src-tauri/src/commands/evals.rs","content":"//! Commands for A/B evals (PLAN.md A6).\n\nuse std::sync::Arc;\n\nuse bastion_core::eval::{self, Override, Run};\nuse bastion_protocol::{EvalRow, EvalSummary, EvalView, NewEval, RunView};\nuse serde_json::json;\nuse tauri::State;\n\nuse super::factory::{FactoryCell, factory};\nuse crate::eval_store::{Eval, EvalRun};\nuse crate::evals::{self, Plan, RunRead};\nuse crate::factory::Factory;\nuse crate::machine::Machine;\n\n/// `constraint:<id>` or `capability:<stage>:<function>`, at one rung.\nfn override_of(target: &str, rung: &str) -> Result<Override, String> {\n    let value = |text: &str| json!(text);\n    let bad = || format!(\"{target:?} at {rung:?} is not a constraint or a grant at a rung\");\n    match target.split_once(':') {\n        Some((\"constraint\", id)) => Ok(Override::Constraint {\n            id: id.into(),\n            rung: serde_json::from_value(value(rung)).map_err(|_| bad())?,\n        }),\n        Some((\"capability\", rest)) => {\n            let (stage, function) = rest.split_once(':').ok_or_else(bad)?;\n            Ok(Override::Capability {\n                stage: serde_json::from_value(value(stage)).map_err(|_| bad())?,\n                function: function.into(),\n                rung: serde_json::from_value(value(rung)).map_err(|_| bad())?,\n            })\n        }\n        _ => Err(bad()),\n    }\n}\n\nfn describe(o: &Override) -> String {\n    match o {\n        Override::Constraint { id, rung } => format!(\"constraint {id} at {rung:?}\"),\n        Override::Capability { stage, function, rung } => format!(\"{stage:?} {function} at {rung:?}\"),\n    }\n}\n\nfn view_of(t: &Run, job: &str, state: &str, refused_calls: Vec<String>) -> RunView {\n    RunView {\n        job: job.into(),\n        state: state.into(),\n        reviewed: t.reviewed,\n        passed: t.passed,\n        refused: t.refused,\n        held: t.held,\n        flagged: t.flagged,\n        hook_refused: t.hook_refused,\n        findings: t.findings,\n        turns: t.usage.turns,\n        cost_micros: t.usage.cost_micros,\n        seconds: t.seconds,\n        grade: t.grade,\n        refused_calls,\n    }\n}\n\nfn finished(r: &RunRead) -> bool {\n    let over = matches!(r.state.as_str(), \"stopped\" | \"failed\" | \"landed\");\n    over && (!r.tally.reviewed || r.run.grade.is_some())\n}\n\nasync fn reads(factory: &Factory, e: &Eval) -> Result<Vec<RunRead>, String> {\n    let chain = factory.gate().audit()?.read().await?.chain;\n    let mut out = Vec::new();\n    for run in factory.store().eval_runs(&e.id).await? {\n        out.push(evals::read_run(&**factory.store(), &chain, run).await?);\n    }\n    Ok(out)\n}\n\nfn summary(e: Eval, runs: &[RunRead]) -> EvalSummary {\n    EvalSummary {\n        id: e.id,\n        name: e.name,\n        workspace: e.workspace,\n        base: e.base,\n        created_at: e.created_at,\n        runs: runs.len() as u32,\n        done: runs.iter().filter(|r| finished(r)).count() as u32,\n    }\n}\n\n#[tauri::command]\npub async fn evals(cell: State<'_, FactoryCell>) -> Result<Vec<EvalSummary>, String> {\n    let factory = factory(&cell)?;\n    let mut out = Vec::new();\n    for e in factory.store().evals().await? {\n        let runs = reads(&factory, &e).await?;\n        out.push(summary(e, &runs));\n    }\n    Ok(out)\n}\n\n#[tauri::command]\npub async fn eval_create(\n    cell: State<'_, FactoryCell>,\n    machine: State<'_, Arc<dyn Machine>>,\n    eval: NewEval,\n) -> Result<String, String> {\n    let plan = Plan {\n        name: eval.name,\n        workspace: eval.workspace,\n        requests: eval.requests,\n        a: vec![override_of(eval.target.trim(), &eval.rung_a)?],\n        b: vec![override_of(eval.target.trim(), &eval.rung_b)?],\n    };\n    evals::create(&factory(&cell)?, machine.inner().as_ref(), plan).await\n}\n\n/// One eval: each request under A and B, the totals, and what differs.\n#[tauri::command]\npub async fn eval(cell: State<'_, FactoryCell>, id: String) -> Result<EvalView, String> {\n    let factory = factory(&cell)?;\n    let e = factory.store().eval(&id).await?;\n    let (arm_a, arm_b) = (factory.store().arm(&id, \"a\").await?, factory.store().arm(&id, \"b\").await?);\n    let runs = reads(&factory, &e).await?;\n    let pick = |arm: &str, idx: u32| runs.iter().find(|r| r.run.arm == arm && r.run.idx == idx);\n    let mut idxs: Vec<u32> = runs.iter().map(|r| r.run.idx).collect();\n    idxs.dedup();\n    let rows = idxs\n        .into_iter()\n        .map(|idx| {\n            let (a, b) = (pick(\"a\", idx), pick(\"b\", idx));\n            let differences = match (a, b) {\n                (Some(a), Some(b)) => eval::differences(&a.tally, &b.tally),\n                _ => Vec::new(),\n            };\n            let view = |r: Option<&RunRead>| r.map(|r| view_of(&r.tally, &r.run.job, &r.state, r.refused.clone()));\n            EvalRow {\n                idx,\n                request: a.or(b).map(|r| r.run.request.clone()).unwrap_or_default(),\n                a: view(a),\n                b: view(b),\n                differences,\n            }\n        })\n        .collect();\n    let total = |arm: &str| eval::total(&runs.iter().filter(|r| r.run.arm == arm).map(|r| r.tally.clone()).collect::<Vec<_>>());\n    let (total_a, total_b) = (total(\"a\"), total(\"b\"));\n    Ok(EvalView {\n        summary: summary(e, &runs),\n        arm_a: arm_a.iter().map(describe).collect(),\n        arm_b: arm_b.iter().map(describe).collect(),\n        rows,\n        differences: eval::differences(&total_a, &total_b),\n        total_a: view_of(&total_a, \"\", \"\", Vec::new()),\n        total_b: view_of(&total_b, \"\", \"\", Vec::new()),\n    })\n}\n\n/// Set the live policy to one arm's rungs, and record which eval it came from.\n#[tauri::command]\npub async fn eval_apply(cell: State<'_, FactoryCell>, id: String, arm: String) -> Result<(), String> {\n    let factory = factory(&cell)?;\n    let overrides = factory.store().arm(&id, &arm).await?;\n    if overrides.is_empty() {\n        return Err(format!(\"eval {id} has no arm {arm:?}\"));\n    }\n    factory.gate().apply_arm(&id, &arm, &overrides).await\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use bastion_core::Stage;\n    use bastion_core::govern::{Access, Enforcement};\n\n    #[test]\n    fn a_target_reads_as_an_override() {\n        assert_eq!(\n            override_of(\"constraint:keep-tests\", \"enforced\"),\n            Ok(Override::Constraint { id: \"keep-tests\".into(), rung: Enforcement::Enforced })\n        );\n        assert_eq!(\n            override_of(\"capability:plan:sandbox::fs::write\", \"allowed\"),\n            Ok(Override::Capability { stage: Stage::Plan, function: \"sandbox::fs::write\".into(), rung: Access::Allowed })\n        );\n        assert!(override_of(\"constraint:keep-tests\", \"allowed\").is_err());\n        assert!(override_of(\"keep-tests\", \"told\").is_err());\n    }\n\n    #[test]\n    fn a_run_counts_as_done_once_over_and_graded() {\n        let run = |state: &str, reviewed: bool, grade: Option<u8>| RunRead {\n            run: EvalRun { eval: \"e\".into(), arm: \"a\".into(), idx: 0, request: \"r\".into(), job: \"j\".into(), grade },\n            state: state.into(),\n            tally: Run { reviewed, ..Run::default() },\n            refused: vec![],\n        };\n        assert!(!finished(&run(\"running\", false, None)));\n        assert!(!finished(&run(\"stopped\", true, None)), \"waits for its grade\");\n        assert!(finished(&run(\"stopped\", true, Some(7))));\n        assert!(finished(&run(\"failed\", false, None)));\n    }\n}\n"}},"serverClassifierRequest":"96116853-add2-4a63-a433-1c4a79d8858f","apiBlockIndex":0,"requestId":"req_011Cgae8VhdtNJ7xRyiVzyvK","type":"assistant","uuid":"cd494a65-e8ce-472f-8a10-215c27b75788","timestamp":"2026-10-31T16:36:45.591Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
{"parentUuid":"cd494a65-e8ce-472f-8a10-215c27b75788","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011Cgae8W8v2Qf2qRbD5sHiZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019NsyTscH8QefJjCQkoVNQg","name":"Bash","input":{"command":"python3 - <<'EOF'\np='src-tauri/src/gate.rs'; s=open(p).read()\na=\"\"\"    /// Move a constraint one rung up or down its ladder, and record it.\"\"\"\nb=\"\"\"    /// Set the live policy to an eval arm's rungs, and record the eval the\n    /// owner acted on with each move.\n    pub async fn apply_arm(&self, eval: &str, arm: &str, overrides: &[Override]) -> Result<(), String> {\n        let (mut constraints, mut grants) = (self.store.constraints().await?, self.store.capabilities().await?);\n        let (was_c, was_g) = (constraints.clone(), grants.clone());\n        bastion_core::eval::apply(&mut constraints, &mut grants, overrides);\n        for (c, was) in constraints.iter().zip(&was_c).filter(|(c, w)| c.rung != w.rung) {\n            self.store.set_constraint(c).await?;\n            self.note(\"apply-eval\", &c.id, format!(\"{eval} arm {arm}: {:?} -> {:?}\", was.rung, c.rung));\n        }\n        for (g, was) in grants.iter().zip(&was_g).filter(|(g, w)| g.rung != w.rung) {\n            self.store.set_capability(g).await?;\n            let subject = format!(\"{:?} {}\", g.stage, g.function);\n            self.note(\"apply-eval\", &subject, format!(\"{eval} arm {arm}: {:?} -> {:?}\", was.rung, g.rung));\n        }\n        self.note_eval(eval, format!(\"the owner applied arm {arm}\"));\n        self.reload().await\n    }\n\n    /// Move a constraint one rung up or down its ladder, and record it.\"\"\"\nassert s.count(a)==1; s=s.replace(a,b)\na=\"\"\"    #[test]\n    fn the_brief_names_every_rule() {\"\"\"\nb=\"\"\"    #[test]\n    fn applying_an_arm_moves_the_live_rung_and_records_the_eval() {\n        let r = rig();\n        let b = [Override::Constraint { id: \"keep-tests\".into(), rung: govern::Enforcement::Enforced }];\n        tauri::async_runtime::block_on(r.gate.apply_arm(\"e1\", \"b\", &b)).unwrap();\n        let rm = envelope(\"build\", \"sandbox::exec\", json!({ \"argv\": [\"git\", \"rm\", \"t.py\"] }));\n        assert_eq!(r.gate.judge(&rm)[\"decision\"], \"deny\");\n        settle();\n        let chain = r.store.audit.lock().unwrap().clone();\n        let applied = chain.iter().find(|e| e.record.kind == \"apply-eval\").unwrap();\n        assert_eq!(applied.record.subject, \"keep-tests\");\n        assert!(applied.record.detail.starts_with(\"e1 arm b: Told -> Enforced\"));\n    }\n\n    #[test]\n    fn the_brief_names_every_rule() {\"\"\"\nassert s.count(a)==1; s=s.replace(a,b)\nopen(p,'w').write(s)\np='src-tauri/src/commands/mod.rs'; s=open(p).read(); s=s.replace(\"pub mod engine;\\n\",\"pub mod engine;\\npub mod evals;\\n\",1); open(p,'w').write(s)\np='src-tauri/src/lib.rs'; s=open(p).read()\ns=s.replace(\"            commands::govern::audit,\",\"            commands::govern::audit,\\n            commands::evals::evals,\\n            commands::evals::eval,\\n            commands::evals::eval_create,\\n            commands::evals::eval_apply,\",1)\nopen(p,'w').write(s)\nEOF\ncargo +1.97.0 fmt --all; cargo +1.97.0 test -p bastion 2>&1 | grep -E \"^error|test result: ok. [1-9]|FAILED|panicked\" -A8 | head -40","description":"Add apply_arm, register eval commands, test","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1917,"cache_read_input_tokens":693271,"output_tokens":4646,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1917,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":4646,"cache_read_input_tokens":693271,