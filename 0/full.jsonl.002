merge-multiple: true\n          path: dist\n\n      - name: Sums, signed\n        env:\n          MINISIGN_SECRET_KEY: ${{ secrets.MINISIGN_SECRET_KEY }}\n        run: |\n          sudo apt-get update && sudo apt-get install -y minisign\n          cd dist\n          sha256sum * > SHA256SUMS\n          key=\"$(mktemp)\"\n          printf '%s\\n' \"$MINISIGN_SECRET_KEY\" > \"$key\"\n          minisign -S -s \"$key\" -m SHA256SUMS -t \"bastion $GITHUB_REF_NAME\"\n          rm -f \"$key\"\n\n      - name: Publish\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: |\n          gh release create \"$GITHUB_REF_NAME\" dist/* \\\n            --repo \"$GITHUB_REPOSITORY\" \\\n            --title \"Bastion $GITHUB_REF_NAME\" \\\n            --notes \"Install: curl -fsSL https://tacoda.github.io/bastion/install.sh | sh\"\nEOF\necho ok","description":"Ad-hoc sign the app and write the release workflow"}},"wireIngestContext":{"toolu_011ooRz9japm85YHxut8DEku":{"cwd":"/Users/tacoda/tacoda/bastion"}},"serverClassifierRequest":"7992749e-ac4f-4da7-b066-2f789c13be83","apiBlockIndex":2,"requestId":"req_011CgvQzrRtwsAjPRFZgQXWg","type":"assistant","uuid":"d3b5ad96-8707-478e-b7e1-8ae2984254f2","timestamp":"2026-11-11T03:16:27.494Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
