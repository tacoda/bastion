says what the","+product is for and how its pages split between jobs and servers.","+[DECISIONS.md](DECISIONS.md) holds the"," goals and the decisions (cited in code as `DECISIONS.md D<n>`); read it"," before a change."," "]}]},{"filePath":"/Users/tacoda/tacoda/bastion/README.md","hunks":[{"oldStart":7,"oldLines":8,"newStart":7,"newLines":8,"lines":[" it. Bastion is a server and its clients: `bastion-server` runs the factory on"," the [iii](https://iii.dev) engine, and the desktop app (on"," [iced](https://iced.rs)) and the `bastion` command line talk to it over HTTP.","-It's early, and [DECISIONS.md](DECISIONS.md) holds the goals and the decisions","-behind it.","+It's early. [VISION.md](VISION.md) says where it is going, and","+[DECISIONS.md](DECISIONS.md) holds the goals and the decisions behind it."," "," ## Install"," "]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/CLAUDE.md","/Users/tacoda/tacoda/bastion/README.md"]}},"serverClassifierContext":{"request":"12d3827f-ebcd-4af1-9c48-41fd91a972fb","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":11,"modified":1,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"01e46b8c-514c-4a5d-a83e-94dfacf8f3a9","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
