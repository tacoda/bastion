essage::Costs)","+    let read = ctx.clone().each(api::Costs);","+    Task::perform(read, |r| Message::Costs(Msg::Read(Box::new(r))))"," }"," "," pub fn update(state: &mut State, msg: Msg) {","     match msg {","-        Msg::Read(Ok(view)) => (state.view, state.error) = (Some(*view), String::new()),","-        Msg::Read(Err(e)) => state.error = e,","+        Msg::Read(r) => {","+            let (read, failed) = *r;","+            (state.view, state.failed) = (Some(combine(&read)), failed);","+        }","+    }","+}","+","+/// Every server's costs added up, each turn with its server.","+#[derive(Debug, Default, PartialEq)]","+struct Combined {","+    total: Tally,","+    by_server: Vec<Tally>,","+    by_workspace: Vec<Tally>,","+    by_stage: Vec<Tally>,","+    /// Newest day first.","+    by_day: Vec<Tally>,","+    /// Newest turn first.","+    sessions: Vec<(String, SessionView)>,","+}","+","+fn add(into: &mut Tally, t: &Tally) {","+    into.sessions += t.sessions;","+    into.turns += t.turns;","+    into.calls += t.calls;","+    into.call_errors += t.call_errors;","+    into.cost_micros += t.cost_micros;","+}","+","+/// The tallies with the same key added into one, the costliest first.","+fn merge(all: impl Iterator<Item = Tally>) -> Vec<Tally> {","+    let mut by: BTreeMap<String, Tally> = BTreeMap::new();","+    for t in all {","+        let kept = by.entry(t.key.clone()).or_insert_with(|| Tally {","+            key: t.key.clone(),","+            ..Tally::default()","+        });","+        add(kept, &t);","+    }","+    let mut merged: Vec<Tally> = by.into_values().collect();","+    merged.sort_by_key(|t| std::cmp::Reverse(t.cost_micros));","+    merged","+}","+","+/// What `read` cost, added up across its servers. A workspace is named","+/// with its server when several servers show, as two may share a name.","+fn combine(read: &[(String, CostsView)]) -> Combined {","+    let many = read.len() > 1;","+    let mut total = Tally::default();","+    read.iter().for_each(|(_, v)| add(&mut total, &v.total));","+    let by_server = read.iter().map(|(server, v)| Tally {","+        key: server.clone(),","+        ..v.total.clone()","+    });","+    let workspaces = read.iter().flat_map(|(server, v)| {","+        v.by_workspace.iter().map(move |t| Tally {","+            key: match many {","+                true => format!(\"{server} · {}\", t.key),","+                false => t.key.clone(),","+            },","+            ..t.clone()","+        })","+    });","+    let mut by_day = merge(read.iter().flat_map(|(_, v)| v.by_day.clone()));","+    by_day.sort_by(|a, b| b.key.cmp(&a.key));","+    let mut sessions: Vec<(String, SessionView)> = read","+        .iter()","+        .flat_map(|(server, v)| v.sessions.iter().map(move |s| (server.clone(), s.clone())))","+        .collect();","+    sessions.sort_by_key(|(_, s)| std::cmp::Reverse(s.ended_at));","+    Combined {","+        total,","+        by_server: merge(by_server),","+        by_workspace: merge(workspaces),","+        by_stage: merge(read.iter().flat_map(|(_, v)| v.by_stage.clone())),","+        by_day,","+        sessions,","     }"," }"," "]},{"oldStart":60,"oldLines":10,"newStart":139,"newLines":11,"lines":["     section(title.into(), rows, false)"," }"," ","-/// One turn: its job, a link to it, and what it used.","-fn session_row<'a>(s: &SessionView, ctx: &Ctx) -> Element<'a, Message> {","+/// One turn: its server when several show, its job, a link to it, and","+/// what it used.","+fn session_row<'a>(server: &str, s: &SessionView, many: bool) -> Element<'a, Message> {","     let open = Message::OpenJob {","-        server: ctx.current.clone(),","+        server: server.to_string(),","         id: s.job.clone(),","     };","     let job = button(text(s.job.clone()).size(13).font(theme::MONO))"]},{"oldStart":72,"oldLines":27,"newStart":152,"newLines":42,"lines":["     let steps = button(text(\"steps\").size(13))","         .style(theme::link)","         .on_press(Message::Go(Route::Session(s.session.clone())));","-    row![","-        job,","-        steps,","-        text(format!(\"{} · {}\", s.workspace, s.stage.replace('_', \" \"))).width(Fill),","-        text(dollars(s.cost_micros)).size(13).font(theme::MONO),","-        text(format!(\"{} calls, {} failed\", s.calls, s.call_errors)).size(13),","-        text(ago(s.ended_at)).size(13).color(theme::MUTED),","-    ]","-    .spacing(12)","-    .padding([4, 12])","-    .align_y(iced::Center)","-    .into()","+    let mut line = row![].spacing(12).padding([4, 12]).align_y(iced::Center);","+    if many {","+        line = line.push(text(server.to_string()).size(13).color(theme::LINK));","+    }","+    line.extend([job.into(), steps.into()])","+        .extend([","+            text(format!(\"{} · {}\", s.workspace, s.stage.replace('_', \" \")))","+                .width(Fill)","+                .into(),","+            text(dollars(s.cost_micros))","+                .size(13)","+                .font(theme::MONO)","+                .into(),","+            text(format!(\"{} calls, {} failed\", s.calls, s.call_errors))","+                .size(13)","+                .into(),","+            text(ago(s.ended_at)).size(13).color(theme::MUTED).into(),","+        ])","+        .into()"," }"," "," pub fn view<'a>(state: &'a State, ctx: &Ctx) -> Element<'a, Message> {","-    let lede = \"What the turns on this Bastion server cost, as each turn's end metered it: in all, by workspace, by step and by day, then the newest turns one by one.\";","+    let many = ctx.all;","+    let lede = match many {","+        true => \"What the turns on every Bastion server cost, as each turn's end metered it.\",","+        false => \"What the turns on this Bastion server cost, as each turn's end metered it.\",","+    };","+    let failed = state","+        .failed","+        .iter()","+        .map(|f| text(f.clone()).color(theme::BAD).into());","     let mut body = column![","         text(\"Costs\").size(24).font(theme::BOLD),","         text(lede).size(13).color(theme::MUTED),","-        text(&state.error).color(theme::BAD),","-    ];","+    ]","+    .extend(failed);","     let Some(v) = &state.view else {","         return scrolled(body.spacing(12));","     };"]},{"oldStart":102,"oldLines":9,"newStart":197,"newLines":15,"lines":["         v.total.turns,","         v.total.sessions","     );","-    let sessions = v.sessions.iter().map(|s| session_row(s, ctx));","+    body = body.push(container(text(total).size(18).font(theme::BOLD)));","+    if many {","+        body = body.push(tallies(\"By server\", &v.by_server));","+    }","+    let sessions = v","+        .sessions","+        .iter()","+        .map(|(server, s)| session_row(server, s, many));","     body = body.extend([","-        container(text(total).size(18).font(theme::BOLD)).into(),","         tallies(\"By workspace\", &v.by_workspace),","         tallies(\"By step\", &v.by_stage),","         tallies(\"By day\", &v.by_day),"]},{"oldStart":126,"oldLines":4,"newStart":227,"newLines":38,"lines":["         assert_eq!(dollars(11_175), \"$0.0112\");","         assert_eq!(dollars(0), \"$0.0000\");","     }","+","+    #[test]","+    fn every_servers_costs_add_up_by_key_and_name_their_server() {","+        let t = |key: &str, cost| Tally {","+            key: key.into(),","+            sessions: 1,","+            cost_micros: cost,","+            ..Tally::default()","+        };","+        let costs = |ws: &str, cost| CostsView {","+            total: t(\"\", cost),","+            by_workspace: vec![t(ws, cost)],","+            by_stage: vec![t(\"prompt\", cost)],","+            by_day: vec![t(\"2026-11-10\", cost)],","+            sessions: Vec::new(),","+        };","+        let read = vec![","+            (\"local\".to_string(), costs(\"demo\", 100)),","+            (\"team\".to_string(), costs(\"demo\", 300)),","+        ];","+        let all = combine(&read);","+        assert_eq!((all.total.cost_micros, all.total.sessions), (400, 2));","+        let keys = |ts: &[Tally]| ts.iter().map(|t| t.key.clone()).collect::<Vec<_>>();","+        assert_eq!(keys(&all.by_server), [\"team\", \"local\"]);","+        assert_eq!(keys(&all.by_workspace), [\"team · demo\", \"local · demo\"]);","+        assert_eq!((all.by_stage.len(), all.by_stage[0].cost_micros), (1, 400));","+        assert_eq!(all.by_day[0].sessions, 2);","+        let one = combine(&read[..1]);","+        assert_eq!(","+            keys(&one.by_workspace),","+            [\"demo\"],","+            \"one server names no server\"","+        );","+    }"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/costs.rs"]}},"serverClassifierContext":{"request":"283dc71e-fcb1-40be-9961-cdf5a4a95941","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"4c4ed0ce-9f54-49b3-ba3d-78516a4757ef","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
