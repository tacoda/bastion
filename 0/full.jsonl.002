X_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' pre-tool-use 3>&1 1>&2; else cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi","durationMs":66},"type":"attachment","uuid":"6ec9e8f5-e6a6-473e-a9e6-97de4c3a13f2","timestamp":"2026-11-11T21:34:23.164Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"87a6d94d-11e7-405b-835c-6292a65c423e","isSidechain":false,"promptId":"1d9ef2db-03d5-4a58-b720-e211c5a548e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EiWcSzojf3T8LE7ERdqTNp","type":"tool_result","content":"//! The factory's later features end to end on the fake engine, store and\n//! machine (F7 to F11), on the rig in `tests.rs`.\n\nuse std::time::Duration;\n\nuse bastion_core::{Pipeline, Stage, State};\nuse serde_json::json;\n\nuse super::tests::*;\nuse crate::machine::fake::FakeMachine;\nuse crate::store::{Artifact, Store};\n\n#[test]\nfn a_preview_a_host_deployed_for_the_branch_is_kept_for_reviewers() {\n    let deployed =\n        json!({ \"id\": 1, \"state\": \"success\", \"environment_url\": \"https://pr-1.example.dev\" });\n    let gh = json!({ \"exit_code\": 0, \"stdout\": json!([deployed]).to_string() });\n    let rig = rig_on(engine().answer(\"github::exec\", Ok(gh)));\n    crate::rt::block_on(async {\n        let record = record_at(Pipeline::Full, Stage::Ci, State::Running);\n        rig.store.insert(&record).await.unwrap();\n        let hub = crate::forge::GitHub {\n            engine: &*rig.engine,\n            slug: \"o/r\".into(),\n        };\n        rig.factory.keep_preview(&record, &hub).await;\n        let kept = rig.store.artifacts(\"j1\").await.unwrap();\n        assert_eq!(kept[0].body, \"Preview: <https://pr-1.example.dev>\");\n        let calls = rig.engine.calls.lock().unwrap();\n        let listed = &calls.iter().find(|c| c.1 == \"github::exec\").unwrap().2[\"args\"][1];\n        assert_eq!(listed, \"repos/o/r/deployments?ref=bastion/j1&per_page=1\");\n    });\n}\n\n#[test]\nfn a_revert_of_a_landed_commit_is_an_escape_of_its_job_once() {\n    use crate::govern_store::GovernStore;\n    let log = \"r9\\u{1f}Revert it\\n\\nThis reverts commit a1b2c3d4e5f6.\\n\\u{1e}\";\n    let key = \"ab\".repeat(32);\n    let machine = FakeMachine::new()\n        .run_ok(\"git\", log)\n        .run_ok(\"security\", &key);\n    let rig = rig_with(engine(), machine);\n    crate::rt::block_on(async {\n        rig.store\n            .insert(&record_at(Pipeline::Short, Stage::Land, State::Landed))\n            .await\n            .unwrap();\n        let commits = bastion_core::escape::commits_artifact(\"a1b2c3d4e5f6 Add cube\").unwrap();\n        let kept = Artifact {\n            stage: Stage::Land,\n            body: commits,\n            created_at: 1,\n        };\n        rig.store.add_artifact(\"j1\", &kept).await.unwrap();\n        let escapes = async || rig.store.entries_of(crate::factory::ESCAPE).await.unwrap();\n        rig.factory.sweep_reverts().await.unwrap();\n        assert!(\n            eventually(async || !escapes().await.is_empty()).await,\n            \"no escape kept\"\n        );\n        rig.factory.sweep_reverts().await.unwrap();\n        tokio::time::sleep(Duration::from_millis(50)).await;\n        let all = escapes().await;\n        assert_eq!(all.len(), 1, \"a revert is kept once\");\n        let (job, detail) = (&all[0].record.subject, &all[0].record.detail);\n        assert_eq!(\n            (job.as_str(), detail.as_str()),\n            (\"j1\", \"a1b2c3d4e5f6 reverted by r9\")\n        );\n    });\n}\n\n#[test]\nfn a_paused_intake_admits_nothing_until_it_opens() {\n    use crate::settings_store::SettingsStore;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let paused = bastion_core::settings::Settings {\n            intake_paused: true,\n            ..Default::default()\n        };\n        rig.store.add_version(&paused, \"paused\", 1).await.unwrap();\n        let id = rig.factory.submit(\"w\", \"x\").await.unwrap();\n        tokio::time::sleep(Duration::from_millis(50)).await;\n        assert_eq!(\n            job_of(&rig, &id).await.state,\n            State::Queued,\n            \"held while paused\"\n        );\n        rig.store\n            .add_version(&Default::default(), \"open\", 2)\n            .await\n            .unwrap();\n        rig.factory.pump();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n    });\n}\n\n#[test]\nfn a_job_that_names_a_model_runs_its_turns_on_it() {\n    use super::Submission;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let how = |model: &str| Submission {\n            model: Some(model.into()),\n            ..Submission::default()\n        };\n        let refused = rig.factory.submit_with(\"w\", \"x\", how(\"no-slash\")).await;\n        assert!(refused.unwrap_err().contains(\"provider/model\"));\n        let id = rig\n            .factory\n            .submit_with(\"w\", \"x\", how(\"deepseek/deepseek-flash\"))\n            .await\n            .unwrap();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n        let sent = async || rig.engine.called(\"harness::send\");\n        assert!(eventually(sent).await, \"no turn started\");\n        let calls = rig.engine.calls.lock().unwrap();\n        let send = calls.iter().find(|c| c.1 == \"harness::send\").unwrap();\n        assert_eq!(\n            (&send.2[\"provider\"], &send.2[\"model\"]),\n            (&json!(\"deepseek\"), &json!(\"deepseek-flash\"))\n        );\n    });\n}\n\n#[test]\nfn a_requests_screenshots_are_kept_and_put_in_its_vm() {\n    use super::Submission;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let how = Submission {\n            screenshots: vec![(\"broken.png\".into(), vec![1, 2, 3])],\n            criteria: Some(\"2 + 2 is 4\".into()),\n            ..Submission::default()\n        };\n        let id = rig\n            .factory\n            .submit_with(\"w\", \"Fix the total\", how)\n            .await\n            .unwrap();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n        let written = rig.machine.calls.lock().unwrap().clone();\n        assert!(\n            written.contains(&format!(\"write /s/requests/{id}/broken.png\")),\n            \"{written:?}\"\n        );\n        let job = job_of(&rig, &id).await;\n        assert_eq!(\n            (job.results[\"screenshots\"].as_str(), job.criteria.as_deref()),\n            (\"broken.png\", Some(\"2 + 2 is 4\"))\n        );\n        let calls = rig.engine.calls.lock().unwrap();\n        let put = |c: &&(String, String, serde_json::Value)| {\n            c.1 == \"sandbox::fs::write\" && c.2[\"path\"] == \"/work/request/broken.png\"\n        };\n        assert!(calls.iter().any(|c| put(&c)), \"the screenshot is in the VM\");\n    });\n}\n\n#[test]\nfn a_job_that_comes_to_wait_is_a_notice_with_the_count_waiting() {\n    use bastion_protocol::Change;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let id = rig.factory.submit(\"w\", \"Add /health\").await.unwrap();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n        finish_turn(&rig, &id).await;\n        until(&rig, &id, Stage::Plan, State::NeedsYou).await;\n        let told = rig.told.lock().unwrap().clone();\n        let notices: Vec<_> = told\n            .iter()\n            .filter(|c| matches!(c, Change::Notice { .. }))\n            .collect();\n        let Some(Change::Notice {\n            job,\n            state,\n            text,\n            waiting,\n            ..\n        }) = notices.first()\n        else {\n            panic!(\"no notice in {told:?}\");\n        };\n        assert_eq!((job, state.as_str(), *waiting), (&id, \"needs_you\", 1));\n        assert!(text.contains(\"waits for you at plan\"), \"{text}\");\n        assert_eq!(notices.len(), 1, \"the job's other changes are not notices\");\n    });\n}\n\n#[test]\nfn a_turns_screenshot_is_kept_once_with_the_job() {\n    let listing = json!({ \"entries\": [{ \"name\": \"home.png\", \"is_dir\": false, \"size\": 3 }] });\n    let mut engine = engine()\n        .answer(\"sandbox::fs::ls\", Ok(listing))\n        .answer(\"sandbox::fs::read\", Ok(json!({ \"content\": {} })));\n    engine.channel_bytes = vec![1, 2, 3];\n    let rig = rig_on(engine);\n    crate::rt::block_on(async {\n        let record = record_at(Pipeline::Short, Stage::Build, State::Running);\n        rig.store.insert(&record).await.unwrap();\n        rig.factory.keep_media(&record).await;\n        rig.factory.keep_media(&record).await;\n        let kept = rig.store.artifacts(\"j1\").await.unwrap();\n        let named: Vec<_> = kept\n            .iter()\n            .filter_map(|a| bastion_core::media::named(&a.body))\n            .collect();\n        assert_eq!(named, [\"home.png\"], \"kept once\");\n        let written = rig.machine.calls.lock().unwrap().clone();\n        assert!(\n            written.contains(&\"write /s/media/j1/home.png\".to_string()),\n            \"{written:?}\"\n        );\n    });\n}\n\n#[test]\nfn a_new_vm_brings_loopback_up_and_a_browser_vm_finds_its_browsers() {\n    let rig = rig();\n    crate::rt::block_on(async {\n        let ws = workspace();\n        let vm = rig\n            .factory\n            .create_vm_from(\"browser\", &ws, super::setup::Access::network(false))\n            .await;\n        assert_eq!(vm.as_deref(), Ok(\"vm1\"));\n        let calls = rig.engine.calls.lock().unwrap().clone();\n        let made = calls.iter().find(|c| c.1 == \"sandbox::create\").unwrap();\n        let env = made.2[\"env\"].as_array().unwrap();\n        assert!(env.contains(&json!(\"PLAYWRIGHT_BROWSERS_PATH=/ms-playwright\")));\n        let exec = calls.iter().find(|c| c.1 == \"sandbox::exec\").unwrap();\n        assert_eq!(exec.2[\"argv\"][0], \"perl\", \"loopback comes up first\");\n        assert!(exec.2[\"argv\"][2].as_str().unwrap().contains(\"0x8914\"));\n    });\n}\n\n#[test]\nfn a_shell_step_gets_the_jobs_branch_and_the_vault_names_this_server_only_for_a_read() {\n    use bastion_core::workflow::{Reach, Step};\n    let rig = rig_on(\n        engine()\n            .answer(\n                \"secrets::get\",\n                Ok(json!({ \"name\": \"GH_TOKEN\", \"consumers\": [\"llm-router\"] })),\n            )\n            .answer(\"secrets::access\", Ok(json!({})))\n            .answer(\"secrets::resolve\", Ok(json!({ \"value\": \"t0k\" }))),\n    );\n    crate::rt::block_on(async {\n        let mut record = record_at(Pipeline::Short, Stage::Shell, State::Running);\n        record.job.flow = vec![Step {\n            id: \"tests\".into(),\n            stage: Stage::Shell,\n            run: \"make test\".into(),\n            dial: bastion_core::Dial::Dark,\n            note: String::new(),\n            needs: Vec::new(),\n            gives: Vec::new(),\n            reach: Reach::default(),\n        }];\n        record.job.node = Some(\"tests\".into());\n        rig.factory.command_step(&record).await;\n        let calls = rig.engine.calls.lock().unwrap().clone();\n        let ran = calls.iter().find(|c| c.1 == \"sandbox::exec\").unwrap();\n        let line = ran.2[\"argv\"][2].as_str().unwrap();\n        assert!(\n            line.contains(\"BASTION_BRANCH='iii/wt1' BASTION_BASE='main'\"),\n            \"{line}\"\n        );\n        assert!(line.ends_with(\"make test\"));\n        assert!(\n            !calls.iter().any(|c| c.1 == \"sandbox::create\"),\n            \"the job's own VM\"\n        );\n\n        let value = rig.factory.vault_value(\"GH_TOKEN\").await;\n        assert_eq!(value.as_deref(), Ok(\"t0k\"));\n        let calls = rig.engine.calls.lock().unwrap().clone();\n        let access: Vec<&serde_json::Value> = calls\n            .iter()\n            .filter(|c| c.1 == \"secrets::access\")\n            .map(|c| &c.2[\"consumers\"])\n            .collect();\n        let me = crate::engine::worker_name();\n        assert_eq!(access[0], &json!([\"llm-router\", me]));\n        assert_eq!(access[1], &json!([\"llm-router\"]), \"put back as it was\");\n    });\n}","is_error":false}]},"uuid":"bb1f48a7-f49b-4ba9-b2fd-7b01ae7c2308","timestamp":"2026-11-11T21:34:23.831Z","toolUseResult":{"stdout":"//! The factory's later features end to end on the fake engine, store and\n//! machine (F7 to F11), on the rig in `tests.rs`.\n\nuse std::time::Duration;\n\nuse bastion_core::{Pipeline, Stage, State};\nuse serde_json::json;\n\nuse super::tests::*;\nuse crate::machine::fake::FakeMachine;\nuse crate::store::{Artifact, Store};\n\n#[test]\nfn a_preview_a_host_deployed_for_the_branch_is_kept_for_reviewers() {\n    let deployed =\n        json!({ \"id\": 1, \"state\": \"success\", \"environment_url\": \"https://pr-1.example.dev\" });\n    let gh = json!({ \"exit_code\": 0, \"stdout\": json!([deployed]).to_string() });\n    let rig = rig_on(engine().answer(\"github::exec\", Ok(gh)));\n    crate::rt::block_on(async {\n        let record = record_at(Pipeline::Full, Stage::Ci, State::Running);\n        rig.store.insert(&record).await.unwrap();\n        let hub = crate::forge::GitHub {\n            engine: &*rig.engine,\n            slug: \"o/r\".into(),\n        };\n        rig.factory.keep_preview(&record, &hub).await;\n        let kept = rig.store.artifacts(\"j1\").await.unwrap();\n        assert_eq!(kept[0].body, \"Preview: <https://pr-1.example.dev>\");\n        let calls = rig.engine.calls.lock().unwrap();\n        let listed = &calls.iter().find(|c| c.1 == \"github::exec\").unwrap().2[\"args\"][1];\n        assert_eq!(listed, \"repos/o/r/deployments?ref=bastion/j1&per_page=1\");\n    });\n}\n\n#[test]\nfn a_revert_of_a_landed_commit_is_an_escape_of_its_job_once() {\n    use crate::govern_store::GovernStore;\n    let log = \"r9\\u{1f}Revert it\\n\\nThis reverts commit a1b2c3d4e5f6.\\n\\u{1e}\";\n    let key = \"ab\".repeat(32);\n    let machine = FakeMachine::new()\n        .run_ok(\"git\", log)\n        .run_ok(\"security\", &key);\n    let rig = rig_with(engine(), machine);\n    crate::rt::block_on(async {\n        rig.store\n            .insert(&record_at(Pipeline::Short, Stage::Land, State::Landed))\n            .await\n            .unwrap();\n        let commits = bastion_core::escape::commits_artifact(\"a1b2c3d4e5f6 Add cube\").unwrap();\n        let kept = Artifact {\n            stage: Stage::Land,\n            body: commits,\n            created_at: 1,\n        };\n        rig.store.add_artifact(\"j1\", &kept).await.unwrap();\n        let escapes = async || rig.store.entries_of(crate::factory::ESCAPE).await.unwrap();\n        rig.factory.sweep_reverts().await.unwrap();\n        assert!(\n            eventually(async || !escapes().await.is_empty()).await,\n            \"no escape kept\"\n        );\n        rig.factory.sweep_reverts().await.unwrap();\n        tokio::time::sleep(Duration::from_millis(50)).await;\n        let all = escapes().await;\n        assert_eq!(all.len(), 1, \"a revert is kept once\");\n        let (job, detail) = (&all[0].record.subject, &all[0].record.detail);\n        assert_eq!(\n            (job.as_str(), detail.as_str()),\n            (\"j1\", \"a1b2c3d4e5f6 reverted by r9\")\n        );\n    });\n}\n\n#[test]\nfn a_paused_intake_admits_nothing_until_it_opens() {\n    use crate::settings_store::SettingsStore;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let paused = bastion_core::settings::Settings {\n            intake_paused: true,\n            ..Default::default()\n        };\n        rig.store.add_version(&paused, \"paused\", 1).await.unwrap();\n        let id = rig.factory.submit(\"w\", \"x\").await.unwrap();\n        tokio::time::sleep(Duration::from_millis(50)).await;\n        assert_eq!(\n            job_of(&rig, &id).await.state,\n            State::Queued,\n            \"held while paused\"\n        );\n        rig.store\n            .add_version(&Default::default(), \"open\", 2)\n            .await\n            .unwrap();\n        rig.factory.pump();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n    });\n}\n\n#[test]\nfn a_job_that_names_a_model_runs_its_turns_on_it() {\n    use super::Submission;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let how = |model: &str| Submission {\n            model: Some(model.into()),\n            ..Submission::default()\n        };\n        let refused = rig.factory.submit_with(\"w\", \"x\", how(\"no-slash\")).await;\n        assert!(refused.unwrap_err().contains(\"provider/model\"));\n        let id = rig\n            .factory\n            .submit_with(\"w\", \"x\", how(\"deepseek/deepseek-flash\"))\n            .await\n            .unwrap();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n        let sent = async || rig.engine.called(\"harness::send\");\n        assert!(eventually(sent).await, \"no turn started\");\n        let calls = rig.engine.calls.lock().unwrap();\n        let send = calls.iter().find(|c| c.1 == \"harness::send\").unwrap();\n        assert_eq!(\n            (&send.2[\"provider\"], &send.2[\"model\"]),\n            (&json!(\"deepseek\"), &json!(\"deepseek-flash\"))\n        );\n    });\n}\n\n#[test]\nfn a_requests_screenshots_are_kept_and_put_in_its_vm() {\n    use super::Submission;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let how = Submission {\n            screenshots: vec![(\"broken.png\".into(), vec![1, 2, 3])],\n            criteria: Some(\"2 + 2 is 4\".into()),\n            ..Submission::default()\n        };\n        let id = rig\n            .factory\n            .submit_with(\"w\", \"Fix the total\", how)\n            .await\n            .unwrap();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n        let written = rig.machine.calls.lock().unwrap().clone();\n        assert!(\n            written.contains(&format!(\"write /s/requests/{id}/broken.png\")),\n            \"{written:?}\"\n        );\n        let job = job_of(&rig, &id).await;\n        assert_eq!(\n            (job.results[\"screenshots\"].as_str(), job.criteria.as_deref()),\n            (\"broken.png\", Some(\"2 + 2 is 4\"))\n        );\n        let calls = rig.engine.calls.lock().unwrap();\n        let put = |c: &&(String, String, serde_json::Value)| {\n            c.1 == \"sandbox::fs::write\" && c.2[\"path\"] == \"/work/request/broken.png\"\n        };\n        assert!(calls.iter().any(|c| put(&c)), \"the screenshot is in the VM\");\n    });\n}\n\n#[test]\nfn a_job_that_comes_to_wait_is_a_notice_with_the_count_waiting() {\n    use bastion_protocol::Change;\n    let rig = rig();\n    crate::rt::block_on(async {\n        let id = rig.factory.submit(\"w\", \"Add /health\").await.unwrap();\n        until(&rig, &id, Stage::Plan, State::Running).await;\n        finish_turn(&rig, &id).await;\n        until(&rig, &id, Stage::Plan, State::NeedsYou).await;\n        let told = rig.told.lock().unwrap().clone();\n        let notices: Vec<_> = told\n            .iter()\n            .filter(|c| matches!(c, Change::Notice { .. }))\n            .collect();\n        let Some(Change::Notice {\n            job,\n            state,\n            text,\n            waiting,\n            ..\n        }) = notices.first()\n        else {\n            panic!(\"no notice in {told:?}\");\n        };\n        assert_eq!((job, state.as_str(), *waiting), (&id, \"needs_you\", 1));\n        assert!(text.contains(\"waits for you at plan\"), \"{text}\");\n        assert_eq!(notices.len(), 1, \"the job's other changes are not notices\");\n    });\n}\n\n#[test]\nfn a_turns_screenshot_is_kept_once_with_the_job() {\n    let listing = json!({ \"entries\": [{ \"name\": \"home.png\", \"is_dir\": false, \"size\": 3 }] });\n    let mut engine = engine()\n        .answer(\"sandbox::fs::ls\", Ok(listing))\n        .answer(\"sandbox::fs::read\", Ok(json!({ \"content\": {} })));\n    engine.channel_bytes = vec![1, 2, 3];\n    let rig = rig_on(engine);\n    crate::rt::block_on(async {\n        let record = record_at(Pipeline::Short, Stage::Build, State::Running);\n        rig.store.insert(&record).await.unwrap();\n        rig.factory.keep_media(&record).await;\n        rig.factory.keep_media(&record).await;\n        let kept = rig.store.artifacts(\"j1\").await.unwrap();\n        let named: Vec<_> = kept\n            .iter()\n            .filter_map(|a| bastion_core::media::named(&a.body))\n            .collect();\n        assert_eq!(named, [\"home.png\"], \"kept once\");\n        let written = rig.machine.calls.lock().unwrap().clone();\n        assert!(\n            written.contains(&\"write /s/media/j1/home.png\".to_string()),\n            \"{written:?}\"\n        );\n    });\n}\n\n#[test]\nfn a_new_vm_brings_loopback_up_and_a_browser_vm_finds_its_browsers() {\n    let rig = rig();\n    crate::rt::block_on(async {\n        let ws = workspace();\n        let vm = rig\n            .factory\n            .create_vm_from(\"browser\", &ws, super::setup::Access::network(false))\n            .await;\n        assert_eq!(vm.as_deref(), Ok(\"vm1\"));\n        let calls = rig.engine.calls.lock().unwrap().clone();\n        let made = calls.iter().find(|c| c.1 == \"sandbox::create\").unwrap();\n        let env = made.2[\"env\"].as_array().unwrap();\n        assert!(env.contains(&json!(\"PLAYWRIGHT_BROWSERS_PATH=/ms-playwright\")));\n        let exec = calls.iter().find(|c| c.1 == \"sandbox::exec\").unwrap();\n        assert_eq!(exec.2[\"argv\"][0], \"perl\", \"loopback comes up first\");\n        assert!(exec.2[\"argv\"][2].as_str().unwrap().contains(\"0x8914\"));\n    });\n}\n\n#[test]\nfn a_shell_step_gets_the_jobs_branch_and_the_vault_names_this_server_only_for_a_read() {\n    use bastion_core::workflow::{Reach, Step};\n    let rig = rig_on(\n        engine()\n            .answer(\n                \"secrets::get\",\n                Ok(json!({ \"name\": \"GH_TOKEN\", \"consumers\": [\"llm-router\"] })),\n            )\n            .answer(\"secrets::access\", Ok(json!({})))\n            .answer(\"secrets::resolve\", Ok(json!({ \"value\": \"t0k\" }))),\n    );\n    crate::rt::block_on(async {\n        let mut record = record_at(Pipeline::Short, Stage::Shell, State::Running);\n        record.job.flow = vec![Step {\n            id: \"tests\".into(),\n            stage: Stage::Shell,\n            run: \"make test\".into(),\n            dial: bastion_core::Dial::Dark,\n            note: String::new(),\n            needs: Vec::new(),\n            gives: Vec::new(),\n            reach: Reach::default(),\n        }];\n        record.job.node = Some(\"tests\".into());\n        rig.factory.command_step(&record).await;\n        let calls = rig.engine.calls.lock().unwrap().clone();\n        let ran = calls.iter().find(|c| c.1 == \"sandbox::exec\").unwrap();\n        let line = ran.2[\"argv\"][2].as_str().unwrap();\n        assert!(\n            line.contains(\"BASTION_BRANCH='iii/wt1' BASTION_BASE='main'\"),\n            \"{line}\"\n        );\n        assert!(line.ends_with(\"make test\"));\n        assert!(\n            !calls.iter().any(|c| c.1 == \"sandbox::create\"),\n            \"the job's own VM\"\n        );\n\n        let value = rig.factory.vault_value(\"GH_TOKEN\").await;\n        assert_eq!(value.as_deref(), Ok(\"t0k\"));\n        let calls = rig.engine.calls.lock().unwrap().clone();\n        let access: Vec<&serde_json::Value> = calls\n            .iter()\n            .filter(|c| c.1 == \"secrets::access\")\n            .map(|c| &c.2[\"consumers\"])\n            .collect();\n        let me = crate::engine::worker_name();\n        assert_eq!(access[0], &json!([\"llm-router\", me]));\n        assert_eq!(access[1], &json!([\"llm-router\"]), \"put back as it was\");\n    });\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/factory/tests.rs","hunks":[{"oldStart":12,"oldLines":7,"newStart":12,"newLines":7,"lines":[" use crate::engine::fake::FakeEngine;"," use crate::machine::fake::FakeMachine;"," use crate::store::fake::FakeStore;","-use crate::store::{Artifact, Record, Runtime, Store, Workspace};","+use crate::store::{Record, Runtime, Store, Workspace};"," "," pub(super) fn engine() -> FakeEngine {","     FakeEngine::new(Link::Up)"