X_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' pre-tool-use 3>&1 1>&2; else cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi","durationMs":53},"type":"attachment","uuid":"8eb12352-fdd1-407b-be5f-81470454325c","timestamp":"2026-11-11T21:31:10.064Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"ddf0d7b2-3621-4d90-af79-c701ed373179","isSidechain":false,"promptId":"1d9ef2db-03d5-4a58-b720-e211c5a548e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y1ejZ5sYuZJ7JaPbYR1en9","type":"tool_result","content":"        assert_eq!(day(951_782_400), \"2000-02-29\");\n    }\n\n    #[test]\n    fn turns_are_tallied_in_all_by_workspace_by_step_and_by_day() {\n        let all = vec![\n            (turn(\"s3\", Stage::Build, 300, 1_794_349_646), \"b\".into()),\n            (turn(\"s2\", Stage::Plan, 200, 1_794_349_000), \"a\".into()),\n            (turn(\"s1\", Stage::Plan, 100, 1_794_200_000), \"a\".into()),\n        ];\n        let view = tally(&all);\n        assert_eq!((view.total.sessions, view.total.cost_micros), (3, 600));\n        assert_eq!(view.total.calls, 9);\n    use bastion_core::{Dial, Stage};\n\n    #[test]\n    fn a_view_reads_back_as_its_graph_and_a_bad_word_is_refused() {\n        let w = Workflow {\n            id: \"short\".into(),\n            name: \"Short\".into(),\n            version: 0,\n            graph: Graph::chain(&[Stage::Plan, Stage::Build, Stage::Land], |_| {\n                Dial::LightsOn\n            }),\n        };\n        let v = view_of(&w);\n        assert_eq!((v.built_in, v.level.as_str()), (true, \"lights_on\"));\n        assert_eq!(graph_of(&v), Ok(w.graph));\n        let mut bad = v;\n        bad.nodes[0].stage = \"nap\".into();\n        assert!(graph_of(&bad).unwrap_err().contains(\"does not read\"));\n    }\n    #[test]\n    fn a_turn_is_metered_from_its_session_totals() {\n        let engine = FakeEngine::new(Link::Up).answer(\n            \"harness::metrics\",\n            Ok(json!({ \"totals\": { \"turns\": 17, \"function_calls\": 16, \"function_call_errors\": 3, \"cost_usd\": 0.0111751 } })),\n        );\n        let store = FakeStore::default();\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 1);\n        job.stage = Stage::Build;\n        crate::rt::block_on(meter(&engine, &store, &job, \"s1\"));\n        let turns = store.eval_rows.turns.lock().unwrap().clone();\n        assert_eq!(\n            turns[0].usage,\n            Usage {\n                turns: 17,\n                calls: 16,\n                call_errors: 3,\n                cost_micros: 11175\n            }\n        );\n    }\n\n    #[test]\n    fn a_run_is_graded_from_the_judge_reply() {\n        let engine = FakeEngine::new(Link::Up)\n            .answer(\"harness::send\", Ok(json!({})))\n            .answer(\"harness::status\", Ok(json!({ \"status\": \"completed\" })))\n            .answer(\"session::messages\", Ok(json!({ \"messages\": [\n                { \"message\": { \"role\": \"assistant\", \"content\": [{ \"type\": \"text\", \"text\": \"Does it.\\nGRADE: 9\" }] } },\n            ] })));\n        let store = FakeStore::default();\n        let run = EvalRun {\n            eval: \"e1\".into(),\n            arm: \"a\".into(),\n            idx: 0,\n            request: \"r\".into(),\n            job: \"j1\".into(),\n            grade: None,\n            contract: None,\n        };\n        store.eval_rows.runs.lock().unwrap().push(run.clone());\n        crate::rt::block_on(async {\n            assert!(grade(&engine, &store, &run).await.is_err(), \"no diff yet\");\n            let diff = Artifact {\n                stage: Stage::Review,\n                body: \"+x\".into(),\n                created_at: 1,\n            };\n            store.add_artifact(\"j1\", &diff).await.unwrap();\nmod tests {\n    use super::*;\n    use bastion_core::State;\n\n    #[test]\n    fn a_persons_decision_names_the_step_and_the_person() {\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 1);\n        job.stage = Stage::CodeReview;\n        let note = Event::Commented {\n            text: \"fix 1\".into(),\n        };\n        assert_eq!(\n            decision(&job, &note, \"ada\"),\n            \"code_review: sent back by ada: fix 1\"\n        );\n        assert_eq!(\n            decision(&job, &Event::Approved, \"ada\"),\n            \"code_review: approved by ada\"\n        );\n        assert_eq!(\n            decision(&job, &Event::Retried, \"ada\"),\n            \"code_review: retried by ada\"\n        );\n        job.state = State::NeedsYou;\n        job.error = Some(\"2 tests failed\\nlong output\".into());\n        assert_eq!(\n            decision(&job, &Event::Approved, \"ada\"),\n            \"code_review: shipped anyway by ada, waiving: 2 tests failed\"\n        );\n        job.stage = Stage::Land;\n        assert_eq!(\n            decision(&job, &Event::Approved, \"ada\"),\n            \"land: approved by ada\"\n        );\n        (job.stage, job.error) = (Stage::CodeReview, None);\n        job.question = Some(\"Which port?\".into());\n        assert_eq!(\n            decision(&job, &note, \"ada\"),\n            \"code_review: answered by ada: fix 1\"\n        );\n    }\n\n    #[test]\n    fn a_resumed_turn_keeps_only_what_is_left_of_its_cap() {\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 1_000);\n        job.updated_at = 1_000;\n        assert_eq!(cap_left(&job, 1_000 + 600), TURN_CAP_SECS - 600);\n        assert_eq!(cap_left(&job, 1_000 + TURN_CAP_SECS + 5), 0);\n    }\n\n    #[test]\n    fn a_land_with_its_pull_request_up_watches_ci_again() {\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 0);\n        (job.stage, job.state, job.pr) =\n            (Stage::Land, State::Running, Some(\"https://x/pull/1\".into()));\n        assert_eq!(\n            again(&job, &bastion_core::Dials::default()),\n            vec![Effect::WatchCi]\n        );\n        job.pr = None;\n        assert_eq!(\n            again(&job, &bastion_core::Dials::default()),\n            vec![Effect::Land]\n        );\n    }\n}\n    }\n\n    fn turn(session: &str) -> Turn {\n        Turn {\n            job: \"j1-2\".into(),\n            session: session.into(),\n        }\n    }\n\n    #[test]\n    fn a_turn_counts_only_at_the_step_it_was_started_for() {\n        let build = Turn::start(\"j1-2\", Stage::Build);\n        assert!(build.session.starts_with(\"j1-2-build-\"));\n        assert!(build.owns(&record(Stage::Build, &build.session)));\n        assert!(\n            !build.owns(&record(Stage::Verify, &build.session)),\n            \"a build's reply at verify\"\n        );\n        assert!(!turn(\"j1-2-build-other\").owns(&record(Stage::Build, &build.session)));\n        let review = Turn::start(\"j1-2\", Stage::CodeReview);\n        assert!(review.owns(&record(Stage::CodeReview, &review.session)));\n    }\n\n    #[test]\n    fn a_turn_on_a_provider_without_a_key_is_refused_by_name() {\n        use crate::engine::fake::FakeEngine;\n        use bastion_protocol::Link;\n        let listed = json!({ \"providers\": [\n            { \"id\": \"openai\", \"configured\": false },\n            { \"id\": \"deepseek\", \"configured\": true },\n        ]});\n        let engine = FakeEngine::new(Link::Up).answer(\"router::provider::list\", Ok(listed));\n        crate::rt::block_on(async {\n            let refused = provider_ready(&engine, \"openai\").await.unwrap_err();\n            assert!(refused.starts_with(\"openai has no key\"), \"{refused}\");\n            assert!(provider_ready(&engine, \"deepseek\").await.is_ok());\n            assert!(provider_ready(&engine, \"openai-codex\").await.is_ok());\n            assert!(provider_ready(&engine, \"unlisted\").await.is_ok());\n        });\n    }\n\n    #[test]\n    fn a_session_from_before_steps_were_named_counts_at_any_step() {\n        assert!(turn(\"j1-2-a1b2c3d4\").owns(&record(Stage::Verify, \"j1-2-a1b2c3d4\")));\n    }\n}\n            ..Default::default()\n        });\n        reads::<Text>(api::JobComment {\n            id: s(\"j1\"),\n            text: s(\"x\"),\n        });\n        reads::<Parts>(api::JobParts {\n            id: s(\"j1\"),\n            parts: vec![s(\"a\")],\n        });\n        reads::<SetDial>(api::DialsSet {\n            stage: s(\"plan\"),\n            dial: s(\"dark\"),\n        });\n        reads::<Arm>(api::EvalApply {\n            id: s(\"e1\"),\n            arm: s(\"a\"),\n        });\n        reads::<RefuseCall>(api::HeldRefuse {\n            held: held.clone(),\n            feedback: s(\"no\"),\n        });\n        reads::<HeldCallRef>(api::HeldAllow(held));\n        reads::<Up>(api::ConstraintMove {\n            id: s(\"c\"),\n            up: true,\n        });\n        reads::<Grant>(api::CapabilityMove {\n            stage: s(\"build\"),\n            function: s(\"f\"),\n            up: false,\n        });\n        reads::<Preset>(api::SettingsPreset { preset: s(\"low\") });\n        reads::<Version>(api::SettingsRestore { version: 3 });\n    }\n\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use bastion_core::settings::{Forge, Model};\n\n    use super::*;\n    use crate::store::fake::FakeStore;\n\n    #[test]\n    fn a_change_is_a_version_and_restore_brings_an_old_one_back_as_the_newest() {\n        let store = FakeStore::default();\n        crate::rt::block_on(async {\n            let first = Settings::default();\n            assert_eq!(\n                change(&store, &first, 1).await,\n                Ok(None),\n                \"nothing moved from the defaults\"\n            );\n            let github = Settings {\n                forge: Forge::Github,\n                ..Settings::default()\n            };\n            assert_eq!(change(&store, &github, 2).await, Ok(Some(1)));\n            let bigger = Settings {\n                build_model: Model {\n                    provider: \"openai\".into(),\n                    model: \"gpt-5\".into(),\n                },\n                ..github.clone()\n            };\n            assert_eq!(change(&store, &bigger, 3).await, Ok(Some(2)));\n            assert_eq!(current(&store).await.unwrap().build_model.model, \"gpt-5\");\n\n            assert_eq!(restore(&store, 1, 4).await, Ok(3));\n            let now = current(&store).await.unwrap();\n            assert_eq!(\n                (now.build_model.model.as_str(), now.forge),\n                (\"gpt-5-mini\", Forge::Github)\n            );\n            let newest = store.versions().await.unwrap()[0].clone();\n            assert_eq!(\n//! The store in memory, for the tests.\n\nuse std::collections::BTreeMap;\nuse std::sync::Mutex;\n\nuse super::*;\nuse bastion_core::audit::Entry;\nuse bastion_core::govern::{Capability, Constraint};\nuse bastion_core::{Dials, Stage, State};\n\n/// The rows `keep` picks, in order.\npub(crate) fn matching<T: Clone>(rows: &Mutex<Vec<T>>, keep: impl Fn(&T) -> bool) -> Vec<T> {\n    rows.lock()\n        .unwrap()\n        .iter()\n        .filter(|r| keep(r))\n        .cloned()\n        .collect()\n}\n\n        all.sort_by_key(|r| std::cmp::Reverse(r.created_at));\n        let some = all.into_iter().skip(offset).take(limit).collect();\n        Box::pin(async move { Ok(some) })\n    }\n\n    fn active(&self) -> Answer<'_, Vec<Record>> {\n        let all = self.jobs.lock().unwrap();\n        let waited_on: Vec<String> = all\n            .values()\n            .filter(|r| r.job.state == State::Queued)\n            .filter_map(|r| r.job.after.clone())\n            .collect();\n        let mut some: Vec<Record> = all\n            .values()\n            .filter(|r| !r.job.state.finished() || waited_on.contains(&r.job.id))\n            .cloned()\n            .collect();\n        some.sort_by_key(|r| std::cmp::Reverse(r.created_at));\n        Box::pin(async move { Ok(some) })\n    }\n\n            \"workflow_nodes\",\n            \"workflow_results\",\n            \"workflow_links\"\n        ]\n    );\n}\n\n#[test]\nfn a_row_reads_back_as_the_record_it_was_written_from() {\n    let mut r = record();\n    r.job.state = State::NeedsYou;\n    // Kept at a checkpoint before D33.\n    r.job.stage = Stage::Approve;\n    r.job.plan = Some(\"1. x\".into());\n    r.job.pipeline = bastion_core::Pipeline::Full;\n    r.job.back_to = Some(Stage::Checks);\n    r.job.done_tasks = 2;\n    r.job.node = Some(\"lint\".into());\n    r.runtime.sandbox = Some(\"vm-1\".into());\n    r.runtime.workflow = Some(\"w1\".into());\n    r.runtime.workflow_version = Some(3);\n    r.runtime.approved = vec![\"tests/a.py\".into(), \"tests/b.py\".into()];\n    let columns: Vec<&str> = JOB_COLUMNS.split(\", \").collect();\n    let values = job_params(&r);\n    let row: serde_json::Map<String, Value> = columns\n        .iter()\n        .zip(values.as_array().unwrap())\n        .map(|(c, v)| (c.to_string(), v.clone()))\n        .collect();\n    let mut folded = r;\n    folded.job.stage = Stage::Plan;\n    assert_eq!(sql::record(&Value::Object(row)).unwrap(), folded);\n}\n\n#[test]\nfn a_job_row_that_does_not_parse_is_left_out_of_the_list() {","is_error":false}]},"uuid":"3d47ff0d-3cbb-4bc9-ade6-f92758e3b19a","timestamp":"2026-11-11T21:31:10.477Z","toolUseResult":{"stdout":"        assert_eq!(day(951_782_400), \"2000-02-29\");\n    }\n\n    #[test]\n    fn turns_are_tallied_in_all_by_workspace_by_step_and_by_day() {\n        let all = vec![\n            (turn(\"s3\", Stage::Build, 300, 1_794_349_646), \"b\".into()),\n            (turn(\"s2\", Stage::Plan, 200, 1_794_349_000), \"a\".into()),\n            (turn(\"s1\", Stage::Plan, 100, 1_794_200_000), \"a\".into()),\n        ];\n        let view = tally(&all);\n        assert_eq!((view.total.sessions, view.total.cost_micros), (3, 600));\n        assert_eq!(view.total.calls, 9);\n    use bastion_core::{Dial, Stage};\n\n    #[test]\n    fn a_view_reads_back_as_its_graph_and_a_bad_word_is_refused() {\n        let w = Workflow {\n            id: \"short\".into(),\n            name: \"Short\".into(),\n            version: 0,\n            graph: Graph::chain(&[Stage::Plan, Stage::Build, Stage::Land], |_| {\n                Dial::LightsOn\n            }),\n        };\n        let v = view_of(&w);\n        assert_eq!((v.built_in, v.level.as_str()), (true, \"lights_on\"));\n        assert_eq!(graph_of(&v), Ok(w.graph));\n        let mut bad = v;\n        bad.nodes[0].stage = \"nap\".into();\n        assert!(graph_of(&bad).unwrap_err().contains(\"does not read\"));\n    }\n    #[test]\n    fn a_turn_is_metered_from_its_session_totals() {\n        let engine = FakeEngine::new(Link::Up).answer(\n            \"harness::metrics\",\n            Ok(json!({ \"totals\": { \"turns\": 17, \"function_calls\": 16, \"function_call_errors\": 3, \"cost_usd\": 0.0111751 } })),\n        );\n        let store = FakeStore::default();\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 1);\n        job.stage = Stage::Build;\n        crate::rt::block_on(meter(&engine, &store, &job, \"s1\"));\n        let turns = store.eval_rows.turns.lock().unwrap().clone();\n        assert_eq!(\n            turns[0].usage,\n            Usage {\n                turns: 17,\n                calls: 16,\n                call_errors: 3,\n                cost_micros: 11175\n            }\n        );\n    }\n\n    #[test]\n    fn a_run_is_graded_from_the_judge_reply() {\n        let engine = FakeEngine::new(Link::Up)\n            .answer(\"harness::send\", Ok(json!({})))\n            .answer(\"harness::status\", Ok(json!({ \"status\": \"completed\" })))\n            .answer(\"session::messages\", Ok(json!({ \"messages\": [\n                { \"message\": { \"role\": \"assistant\", \"content\": [{ \"type\": \"text\", \"text\": \"Does it.\\nGRADE: 9\" }] } },\n            ] })));\n        let store = FakeStore::default();\n        let run = EvalRun {\n            eval: \"e1\".into(),\n            arm: \"a\".into(),\n            idx: 0,\n            request: \"r\".into(),\n            job: \"j1\".into(),\n            grade: None,\n            contract: None,\n        };\n        store.eval_rows.runs.lock().unwrap().push(run.clone());\n        crate::rt::block_on(async {\n            assert!(grade(&engine, &store, &run).await.is_err(), \"no diff yet\");\n            let diff = Artifact {\n                stage: Stage::Review,\n                body: \"+x\".into(),\n                created_at: 1,\n            };\n            store.add_artifact(\"j1\", &diff).await.unwrap();\nmod tests {\n    use super::*;\n    use bastion_core::State;\n\n    #[test]\n    fn a_persons_decision_names_the_step_and_the_person() {\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 1);\n        job.stage = Stage::CodeReview;\n        let note = Event::Commented {\n            text: \"fix 1\".into(),\n        };\n        assert_eq!(\n            decision(&job, &note, \"ada\"),\n            \"code_review: sent back by ada: fix 1\"\n        );\n        assert_eq!(\n            decision(&job, &Event::Approved, \"ada\"),\n            \"code_review: approved by ada\"\n        );\n        assert_eq!(\n            decision(&job, &Event::Retried, \"ada\"),\n            \"code_review: retried by ada\"\n        );\n        job.state = State::NeedsYou;\n        job.error = Some(\"2 tests failed\\nlong output\".into());\n        assert_eq!(\n            decision(&job, &Event::Approved, \"ada\"),\n            \"code_review: shipped anyway by ada, waiving: 2 tests failed\"\n        );\n        job.stage = Stage::Land;\n        assert_eq!(\n            decision(&job, &Event::Approved, \"ada\"),\n            \"land: approved by ada\"\n        );\n        (job.stage, job.error) = (Stage::CodeReview, None);\n        job.question = Some(\"Which port?\".into());\n        assert_eq!(\n            decision(&job, &note, \"ada\"),\n            \"code_review: answered by ada: fix 1\"\n        );\n    }\n\n    #[test]\n    fn a_resumed_turn_keeps_only_what_is_left_of_its_cap() {\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 1_000);\n        job.updated_at = 1_000;\n        assert_eq!(cap_left(&job, 1_000 + 600), TURN_CAP_SECS - 600);\n        assert_eq!(cap_left(&job, 1_000 + TURN_CAP_SECS + 5), 0);\n    }\n\n    #[test]\n    fn a_land_with_its_pull_request_up_watches_ci_again() {\n        let mut job = Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 0);\n        (job.stage, job.state, job.pr) =\n            (Stage::Land, State::Running, Some(\"https://x/pull/1\".into()));\n        assert_eq!(\n            again(&job, &bastion_core::Dials::default()),\n            vec![Effect::WatchCi]\n        );\n        job.pr = None;\n        assert_eq!(\n            again(&job, &bastion_core::Dials::default()),\n            vec![Effect::Land]\n        );\n    }\n}\n    }\n\n    fn turn(session: &str) -> Turn {\n        Turn {\n            job: \"j1-2\".into(),\n            session: session.into(),\n        }\n    }\n\n    #[test]\n    fn a_turn_counts_only_at_the_step_it_was_started_for() {\n        let build = Turn::start(\"j1-2\", Stage::Build);\n        assert!(build.session.starts_with(\"j1-2-build-\"));\n        assert!(build.owns(&record(Stage::Build, &build.session)));\n        assert!(\n            !build.owns(&record(Stage::Verify, &build.session)),\n            \"a build's reply at verify\"\n        );\n        assert!(!turn(\"j1-2-build-other\").owns(&record(Stage::Build, &build.session)));\n        let review = Turn::start(\"j1-2\", Stage::CodeReview);\n        assert!(review.owns(&record(Stage::CodeReview, &review.session)));\n    }\n\n    #[test]\n    fn a_turn_on_a_provider_without_a_key_is_refused_by_name() {\n        use crate::engine::fake::FakeEngine;\n        use bastion_protocol::Link;\n        let listed = json!({ \"providers\": [\n            { \"id\": \"openai\", \"configured\": false },\n            { \"id\": \"deepseek\", \"configured\": true },\n        ]});\n        let engine = FakeEngine::new(Link::Up).answer(\"router::provider::list\", Ok(listed));\n        crate::rt::block_on(async {\n            let refused = provider_ready(&engine, \"openai\").await.unwrap_err();\n            assert!(refused.starts_with(\"openai has no key\"), \"{refused}\");\n            assert!(provider_ready(&engine, \"deepseek\").await.is_ok());\n            assert!(provider_ready(&engine, \"openai-codex\").await.is_ok());\n            assert!(provider_ready(&engine, \"unlisted\").await.is_ok());\n        });\n    }\n\n    #[test]\n    fn a_session_from_before_steps_were_named_counts_at_any_step() {\n        assert!(turn(\"j1-2-a1b2c3d4\").owns(&record(Stage::Verify, \"j1-2-a1b2c3d4\")));\n    }\n}\n            ..Default::default()\n        });\n        reads::<Text>(api::JobComment {\n            id: s(\"j1\"),\n            text: s(\"x\"),\n        });\n        reads::<Parts>(api::JobParts {\n            id: s(\"j1\"),\n            parts: vec![s(\"a\")],\n        });\n        reads::<SetDial>(api::DialsSet {\n            stage: s(\"plan\"),\n            dial: s(\"dark\"),\n        });\n        reads::<Arm>(api::EvalApply {\n            id: s(\"e1\"),\n            arm: s(\"a\"),\n        });\n        reads::<RefuseCall>(api::HeldRefuse {\n            held: held.clone(),\n            feedback: s(\"no\"),\n        });\n        reads::<HeldCallRef>(api::HeldAllow(held));\n        reads::<Up>(api::ConstraintMove {\n            id: s(\"c\"),\n            up: true,\n        });\n        reads::<Grant>(api::CapabilityMove {\n            stage: s(\"build\"),\n            function: s(\"f\"),\n            up: false,\n        });\n        reads::<Preset>(api::SettingsPreset { preset: s(\"low\") });\n        reads::<Version>(api::SettingsRestore { version: 3 });\n    }\n\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use bastion_core::settings::{Forge, Model};\n\n    use super::*;\n    use crate::store::fake::FakeStore;\n\n    #[test]\n    fn a_change_is_a_version_and_restore_brings_an_old_one_back_as_the_newest() {\n        let store = FakeStore::default();\n        crate::rt::block_on(async {\n            let first = Settings::default();\n            assert_eq!(\n                change(&store, &first