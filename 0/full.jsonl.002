ox=\"0 0 24 24\" fill=\"none\" stroke=\"black\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{inner}</svg>\"#\n    );\n    svg(svg::Handle::from_memory(source.into_bytes()))\n        .width(Length::Fixed(16.0))\n        .height(Length::Fixed(16.0))\n        .style(move |_, _| svg::Style { color: Some(color) })\n        .into()\n}","is_error":false}]},"uuid":"7c5b32c1-2235-4817-941f-769255b8f51d","timestamp":"2026-11-11T21:55:05.856Z","toolUseResult":{"stdout":"            .filter(in_place)\n            .filter(matches)\n            .cloned()\n            .collect()\n    }\n\n    /// The workspaces with jobs on the chosen server, or on any.\n    fn places(&self) -> Vec<String> {\n        let on = self.jobs.iter().filter(|j| self.on_server(j));\n        let mut all: Vec<String> = on.map(|j| j.job.workspace.clone()).collect();\n        all.sort();\n        all.dedup();\n        all.insert(0, EVERY.into());\n        all\n    }\n\n    fn servers(&self) -> Vec<String> {\n        let mut all: Vec<String> = self.jobs.iter().map(|j| j.server.clone()).collect();\n        all.sort();\n        all.dedup();\n        all.insert(0, EVERY_SERVER.into());\n        all\n    }\n}\n\nfn line(job: &JobSummary, server: &str, down: bool) -> String {\n    let unreachable = if down { \" · unreachable\" } else { \"\" };\n    let by = job\n        .requester\n        .as_ref()\n        .map_or_else(String::new, |who| format!(\" · by {who}\"));\n    let state = job.state.replace('_', \" \");\n    format!(\n        \"{server}{unreachable} · {} · {} · {state} · {}{by}\",\n        job.workspace,\n        job.id,\n        ago(job.created_at)\n    )\n}\n\n/// The most of a request a row shows; the job's page shows all of it.\nconst TITLE_CHARS: usize = 120;\n\n/// A request as a row's title: its first line, cut at a word to\n/// [`TITLE_CHARS`], with an ellipsis when anything was cut.\nfn title(request: &str) -> String {\n    let first = request.trim().lines().next().unwrap_or_default();\n    let cut = first.char_indices().nth(TITLE_CHARS).map(|(i, _)| i);\n    match cut {\n        None if first.len() == request.trim().len() => first.to_string(),\n        None => format!(\"{first} …\"),\n        Some(i) => {\n            let at_word = first[..i].rfind(' ').unwrap_or(i);\n            format!(\"{}…\", first[..at_word].trim_end())\n        }\n    }\n}\n\nfn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {\n    let about = column![text(title(&sj.job.request)).size(15).font(theme::MEDIUM)].spacing(3);\n    let about = about.push(\n        text(line(&sj.job, &sj.server, down))\n            .size(12)\n            .color(theme::MUTED),\n    );\n    let at = sj.job.node.as_deref().unwrap_or(\"finish\").replace('_', \" \");\n    let stage = container(text(at).size(12))\n        .padding([2, 8])\n        .style(theme::chip);\n    let body = row![\n        container(super::mark_view(&sj.job.state, 18.0)).width(24),\n        about.width(Fill),\n        stage\n    ]\n    .spacing(12);\n    let open = Message::OpenJob {\n        server: sj.server,\n        id: sj.job.id,\n    };\n    let row_button = button(body)\n        .width(Fill)\n        .padding([10, 12])\n        .style(theme::card_row)\n        .on_press(open);\n    let faded = if down { 0.6 } else { 1.0 };\n    container(row_button)\n        .style(move |_| container::Style {\n            text_color: Some(iced::Color {\n                a: faded,\n                ..theme::INK\n            }),\n            ..container::Style::default()\n        })\n        .into()\n}\n\nfn group<'a>(title: String, jobs: Vec<ServerJob>, ctx: &Ctx, accent: bool) -> Element<'a, Message> {\n    let body: Element<'a, Message> = if jobs.is_empty() {\n        container(text(\"Nothing here.\").size(13).color(theme::MUTED))\n            .padding([10, 12])\n            .into()\n    } else {\n        let rows = jobs.into_iter().map(|j| {\n            let down = ctx.down.contains(&j.server);\n            job_row(j, down)\n        });\n        // Inset, so a hovered row leaves the card's edge in view.\n        Column::with_children(rows).spacing(2).padding(6).into()\n    };\n    section(title, body, accent)\n}\n\nfn filters(state: &State) -> Element<'_, Message> {\n    let server = Some(state.server.clone().unwrap_or_else(|| EVERY_SERVER.into()));\n    let server =\n        pick_list(state.servers(), server, |s| Message::Jobs(Msg::Server(s))).style(theme::select);\n    let shown = Some(state.place.clone().unwrap_or_else(|| EVERY.into()));\n    let place =\n        pick_list(state.places(), shown, |p| Message::Jobs(Msg::Place(p))).style(theme::select);\n    let search = text_input(\"Request or id\", &state.search)\n        .on_input(|s| Message::Jobs(Msg::Search(s)))\n        .style(theme::field)\n        .width(260);\n    row![\n        labeled(\"Bastion server\", server),\n        labeled(\"Workspace\", place),\n        labeled(\"Search\", search)\n    ]\n    .spacing(12)\n    .into()\n}\n\nfn groups<'a>(state: &State, ctx: &Ctx) -> Element<'a, Message> {\n    let all = state.shown();\n    let pick = |states: &[&str]| -> Vec<ServerJob> {\n        all.iter()\n            .filter(|j| states.contains(&j.job.state.as_str()))\n            .cloned()\n            .collect()\n    };\n    let (waiting, active, done) = (\n        pick(&[\"needs_you\"]),\n        pick(&super::IN_PROGRESS),\n        pick(&FINISHED),\n    );\n    let mut list = Column::new().spacing(16);\n    if !waiting.is_empty() {\n        list = list.push(group(\n            format!(\"Waiting for you ({})\", waiting.len()),\n            waiting,\n            ctx,\n            true,\n        ));\n    }\n    list = list.push(group(\n        format!(\"In progress ({})\", active.len()),\n        active,\n        ctx,\n        false,\n    ));\n    let arrow = if state.show_finished { \"▾\" } else { \"▸\" };\n    let toggle = button(text(format!(\"{arrow} Finished ({})\", done.len())).size(13))\n        .style(theme::link)\n        .on_press(Message::Jobs(Msg::ToggleFinished));\n    list = list.push(toggle);\n    if state.show_finished {\n        list = list.push(group(\n            format!(\"Finished ({})\", done.len()),\n            done,\n            ctx,\n            false,\n        ));\n    }\n    list.into()\n}\n\npub fn view<'a>(state: &'a State, ctx: &Ctx) -> Element<'a, Message> {\n    let new = button(\"New request\")\n        .padding([8, 12])\n        .style(theme::primary)\n        .on_press(Message::Go(Route::NewRequest));\n20:pub const BG: Color = hex(0x0f0d17);\n21:pub const PANEL: Color = hex(0x19162a);\n22:pub const INK: Color = hex(0xece9f5);\n23:pub const MUTED: Color = hex(0xa39cb8);\n24:pub const LINE: Color = hex(0x2c2742);\n27:pub const RAISED: Color = hex(0x221e34);\n28:pub const PRIMARY: Color = hex(0x7c3aed);\n29:pub const PRIMARY_HOVER: Color = hex(0x6d28d9);\n30:pub const LINK: Color = hex(0xc4b5fd);\n31:pub const OK: Color = hex(0x4ade80);\n32:pub const BAD: Color = hex(0xf87171);\n33:pub const WARN: Color = hex(0xfbbf24);\n37:pub fn bastion() -> Theme {\n52:pub const FONT: Font = Font::with_name(\"Helvetica Neue\");\n53:pub const BOLD: Font = Font {\n58:pub const MEDIUM: Font = Font {\n79:pub fn page(_: &Theme) -> container::Style {\n88:pub fn sidebar(_: &Theme) -> container::Style {\n101:pub fn panel(_: &Theme) -> container::Style {\n110:pub fn veil(_: &Theme) -> container::Style {\n121:pub fn nav(here: bool) -> impl Fn(&Theme, button::Status) -> button::Style {\n141:pub fn primary(_: &Theme, status: button::Status) -> button::Style {\n156:pub fn secondary(_: &Theme, status: button::Status) -> button::Style {\n173:pub fn quiet(_: &Theme, status: button::Status) -> button::Style {\n183:pub fn select(_: &Theme, _: pick_list::Status) -> pick_list::Style {\n193:pub fn field(_: &Theme, status: text_input::Status) -> text_input::Style {\n213:pub fn accented(theme: &Theme) -> container::Style {\n224:pub fn rule<'a, M: 'a>() -> iced::Element<'a, M> {