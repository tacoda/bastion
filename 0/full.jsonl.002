{"parentUuid":"3bc87f0a-8362-4cf2-aa58-d81f10a21c22","isSidechain":false,"promptId":"1d9ef2db-03d5-4a58-b720-e211c5a548e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015atyUwNrnbgMfQ52fLGK8b","type":"tool_result","content":"12:fn decision(job: &Job, event: &Event, by: &str) -> String {\n13-    let verdict = match (event, &job.question) {\n14-        (Event::Commented { text }, Some(_)) => format!(\"answered by {by}: {text}\"),\n15-        (Event::Commented { text }, None) => format!(\"sent back by {by}: {text}\"),\n16-        (Event::Retried, _) => format!(\"retried by {by}\"),\n17-        (Event::Extended, _) => format!(\"extended by {by}\"),\n18-        _ if stuck(job) => format!(\"shipped anyway by {by}, waiving: {}\", waived(job)),\n19-        _ => format!(\"approved by {by}\"),\n20-    };\n21-    format!(\"{}: {verdict}\", job.node.as_deref().unwrap_or(\"the finish\"))\n22-}\n23-\n24-/// The job waits at a step that failed, which approve goes on without.\n25-fn stuck(job: &Job) -> bool {\n26-    bastion_core::actions(job).contains(&bastion_core::Action::Retry)\n27-}\n28-\n29-/// The first line of what failed, short enough for one audit line.\n30-fn waived(job: &Job) -> String {\n31-    let error = job.error.as_deref().unwrap_or_default();\n32-    error\n140:    use bastion_core::Dial;\nconst GITHUB_STEPS: [Step; 3] = [\n    github(\"pull-request\", Dial::Dark, PULL_REQUEST),\n    github(\"ci\", Dial::LightsOn, CI),\n    github(\"merge\", Dial::Dark, MERGE),\n];\n\n/// The workflows Bastion ships as steps: id, name, steps in order.\nfn shipped() -> Vec<(&'static str, &'static str, Vec<Step>)> {\n    let review = prompt(\"review\", Dial::Dark, REVIEW);\n    let criteria = Step {\n        results: &[\"criteria\"],\n        reads_only: true,\n        ..prompt(\"criteria\", Dial::LightsOn, CRITERIA)\n    };\n    let checks = |dial| shell(\"checks\", dial, CHECKS);\n    let to_github = |mut steps: Vec<Step>| {\n        steps.extend(GITHUB_STEPS);\n        steps\n    };\n    vec![\n        (\n            \"short\",\n            \"Short\",\n            vec![PLAN_STEP, BUILD_STEP, checks(Dial::LightsOn)],\n        ),\n        (\n            \"pull-request\",\n            \"Pull request\",\n            to_github(vec![PLAN_STEP, BUILD_STEP, checks(Dial::Dark)]),\n        ),\n        (\n            \"full\",\n            \"Full\",\n            to_github(vec![\n                PLAN_STEP,\n                criteria,\n                prompt(\"acceptance-tests\", Dial::Dark, ACCEPTANCE),\n                BUILD_STEP,\n                checks(Dial::Dark),\n                prompt(\"review\", Dial::Dark, REVIEW),\n            ]),\n        ),\n        (\n            \"full_no_acceptance\",\n            \"Full, without acceptance tests\",\n            to_github(vec![PLAN_STEP, BUILD_STEP, checks(Dial::Dark), review]),\n        ),\n    ]\n}\n\n/// The graph of steps in a row, each linked to the next.\nfn chain(steps: Vec<Step>) -> Graph {\n    let ids: Vec<&str> = steps.iter().map(|s| s.id).collect();\n    let nodes = steps.into_iter().enumerate().map(|(i, s)| {\n        let shell = s.stage == Stage::Shell;\n        Node {\n            id: s.id.into(),\n            stage: s.stage,\n            run: if shell {\n                s.text.replace(\"@GITHUB@\", GITHUB)\n            } else {\n                String::new()\n            },\n            dial: s.dial,\n            note: if shell { String::new() } else { s.text.into() },\n            results: s.results.iter().map(|r| r.to_string()).collect(),\n            reach: Reach {\n                network: s.network,\n                secrets: if s.network {\n                    vec![\"GH_TOKEN\".into()]\n                } else {\n                    Vec::new()\n                },\n                reads_only: s.reads_only,\n            },\n            x: 220 * i as i32,\n            y: 0,\n        }\n    });\n    let links = ids.windows(2).map(|w| Link {\n        from: w[0].i