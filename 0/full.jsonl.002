rt":19,"newLines":10,"lines":["     Started(Result<Server, String>),","     Servers(Result<Vec<Server>, String>),","     Go(Route),","+    /// Show one server, by name.","     Choose(String),","+    /// Show every server on the records pages.","+    ChooseAll,","     Feed((String, Feed)),","     CloseRequested,","     StackRunning(bool),"]},{"oldStart":58,"oldLines":7,"newStart":59,"newLines":10,"lines":[" pub struct App {","     http: reqwest::Client,","     servers: Vec<Server>,","+    /// The server the pages show, or the last one picked while `all` is on.","     current: String,","+    /// Whether the records pages show every server.","+    all: bool,","     route: Route,","     /// Servers whose stream is down, so what was read from them may be stale.","     down: BTreeSet<String>,"]},{"oldStart":77,"oldLines":6,"newStart":81,"newLines":7,"lines":["             http: client::http(),","             servers: vec![],","             current: LOCAL.into(),","+            all: true,","             route: Route::Jobs,","             down: BTreeSet::new(),","             page: Page::Pending,"]},{"oldStart":102,"oldLines":6,"newStart":107,"newLines":7,"lines":["             http: self.http.clone(),","             servers: self.servers.clone(),","             current: self.current.clone(),","+            all: self.all && self.route.records(),","             down: self.down.clone(),","             shift: self.shift,","         }"]},{"oldStart":121,"oldLines":6,"newStart":127,"newLines":16,"lines":["         Task::perform(every, Message::Servers)","     }"," ","+    /// The page to show after the server changes: the same one, or for one","+    /// record's page, the list it sits under, as the record is the old","+    /// server's.","+    fn again(&self) -> Route {","+        match self.route.one_record() {","+            true => self.route.section(),","+            false => self.route.clone(),","+        }","+    }","+","     /// Show `route`'s page and read it.","     fn go(&mut self, route: Route) -> Task<Message> {","         let (page, first) = Page::open(&route, &self.ctx());"]},{"oldStart":149,"oldLines":8,"newStart":165,"newLines":12,"lines":["             Message::Started(Err(why)) => self.problem = Some(why),","             Message::Go(route) => return self.go(route),","             Message::Choose(name) => {","-                self.current = name;","-                return self.go(self.route.clone());","+                (self.current, self.all) = (name, false);","+                return self.go(self.again());","+            }","+            Message::ChooseAll => {","+                self.all = true;","+                return self.go(self.again());","             }","             Message::OpenJob { server, id } => {","                 // The job's page talks to the server it runs on."]},{"oldStart":268,"oldLines":11,"newStart":288,"newLines":8,"lines":["     }"," ","     pub fn view(&self) -> Element<'_, Message> {","-        let main = column![self.picker(), self.page()]","-            .spacing(16)","-            .padding(32)","-            .width(Fill);","-        let shell = container(row![self.sidebar(), main])","+        let main = container(self.page()).padding([24, 32]).width(Fill).height(Fill);","+        let shell = container(column![self.bar(), main])","             .width(Fill)","             .height(Fill)","             .style(theme::page);"]},{"oldStart":286,"oldLines":63,"newStart":303,"newLines":50,"lines":["         .into()","     }"," ","-    fn sidebar(&self) -> Element<'_, Message> {","+    /// The castle, the pages, and the server switcher.","+    fn bar(&self) -> Element<'_, Message> {","+        let castle = svg(svg::Handle::from_memory(CASTLE))","+            .width(28)","+            .height(28);","+        let brand = row![castle, text(\"Bastion\").size(17).font(theme::BOLD)]","+            .spacing(8)","+            .align_y(iced::Center);","+        let waiting: u32 = self.waiting.values().sum();","         let here = self.route.section();","-        let mut items = vec![text(\"Bastion\").size(18).font(theme::BOLD).into()];","-        for (route, label, glyph) in PAGES {","-            let on = route == here;","-            let color = if on { iced::Color::WHITE } else { theme::INK };","-            let waiting: u32 = self.waiting.values().sum();","+        let pages = PAGES.into_iter().map(|(route, label, glyph)| {","             let label = match (route == Route::Jobs, waiting) {","                 (true, n) if n > 0 => format!(\"{label} ({n})\"),","                 _ => label.to_string(),","             };","-            let entry = row![icons::icon(glyph, color), text(label)]","-                .spacing(8)","-                .align_y(iced::Center);","-            items.push(","-                button(entry)","-                    .width(Fill)","-                    .padding([6, 8])","-                    .style(theme::nav(on))","-                    .on_press(Message::Go(route))","-                    .into(),","-            );","-        }","-        let list = Column::with_children(items).spacing(4);","-        let body = column![list, iced::widget::space::vertical(), self.reach()];","-        container(body)","-            .width(200)","-            .height(Fill)","-            .padding(12)","-            .style(theme::sidebar)","+            tab(label, glyph, route == here, Message::Go(route))","+        });","+        let top = row![brand, iced::widget::space::horizontal(), self.switcher()]","+            .spacing(16)","+            .align_y(iced::Center);","+        let nav = Row::with_children(pages).spacing(2).wrap();","+        container(column![top, nav].spacing(10))","+            .padding([12, 24])","+            .width(Fill)","+            .style(theme::bar)","             .into()","     }"," ","-    /// Each server and whether its stream is up.","-    fn reach(&self) -> Element<'_, Message> {","-        let rows = self.servers.iter().map(|s| {","+    /// One button per server, each with a dot for its stream, and All","+    /// servers on a records page (VISION.md).","+    fn switcher(&self) -> Element<'_, Message> {","+        let all_on = self.all && self.route.records();","+        let mut choices: Vec<Element<'_, Message>> = Vec::new();","+        if self.route.records() {","+            choices.push(choice(\"All servers\".into(), None, all_on, Message::ChooseAll));","+        }","+        for s in &self.servers {","             let up = !self.down.contains(&s.name);","-            let mark =","-                text(if up { \"●\" } else { \"○\" }).color(if up { theme::OK } else { theme::BAD });","-            row![mark, text(&s.name).size(12).color(theme::MUTED)]","-                .spacing(6)","-                .into()","-        });","-        Column::with_children(rows).spacing(2).into()","-    }","-","-    /// Which Bastion server a page about one server shows (D30).","-    fn picker(&self) -> Element<'_, Message> {","-        if !self.route.about_one_server() {","-            return column![].into();","+            let on = !all_on && s.name == self.current;","+            choices.push(choice(s.name.clone(), Some(up), on, Message::Choose(s.name.clone())));","         }","-        let names: Vec<String> = self.servers.iter().map(|s| s.name.clone()).collect();","-        let pick =","-            pick_list(names, Some(self.current.clone()), Message::Choose).style(theme::select);","-        row![text(\"Bastion server\").color(theme::MUTED), pick]","-            .spacing(8)","-            .align_y(iced::Center)","+        container(Row::with_children(choices).spacing(2).wrap())","+            .padding(3)","+            .style(theme::panel)","             .into()","     }"," "]},{"oldStart":354,"oldLines":6,"newStart":358,"newLines":37,"lines":["     }"," }"," ","+/// The castle, from the app's icon.","+const CASTLE: &[u8] = include_bytes!(\"../../../assets/icon/bastion.svg\");","+","+/// One page in the top bar.","+fn tab<'a>(label: String, glyph: &str, on: bool, go: Message) -> Element<'a, Message> {","+    let color = if on { iced::Color::WHITE } else { theme::INK };","+    let body = row![icons::icon(glyph, color), text(label).size(13)]","+        .spacing(6)","+        .align_y(iced::Center);","+    button(body)","+        .padding([6, 10])","+        .style(theme::nav(on))","+        .on_press(go)","+        .into()","+}","+","+/// One choice in the server switcher, with its stream's dot when it is a","+/// server.","+fn choice<'a>(label: String, up: Option<bool>, on: bool, pick: Message) -> Element<'a, Message> {","+    let mut body = row![].spacing(6).align_y(iced::Center);","+    if let Some(up) = up {","+        let (mark, color) = if up { (\"●\", theme::OK) } else { (\"○\", theme::BAD) };","+        body = body.push(text(mark).size(10).color(color));","+    }","+    button(body.push(text(label).size(13)))","+        .padding([4, 10])","+        .style(theme::nav(on))","+        .on_press(pick)","+        .into()","+}","+"," /// Open `url` in the browser."," fn open(url: &str) {","     let opener = if cfg!(target_os = \"macos\") {"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/app.rs"]}},"serverClassifierContext":{"request":"40aa3d90-4401-43ba-a593-79086aa28a6d","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","platform":"macos"}},"sourceToolAssistantUUID":"b4e41007-e142-47ea-a34b-da1577ebdea8","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda