On)","-        );","-    }","-","-    #[test]","-    fn each_preset_makes_its_level_on_both_pipelines() {","-        use crate::{Level, Pipeline};","-        for pipeline in [Pipeline::Short, Pipeline::Full] {","-            for (preset, level) in [","-                (Oversight::LightsOn, Level::LightsOn),","-                (Oversight::Dim, Level::Dim),","-                (Oversight::Dark, Level::Dark),","-            ] {","-                assert_eq!(","-                    preset.dials().level(&pipeline.stages()),","-                    level,","-                    \"{preset:?} {pipeline:?}\"","-                );","-            }","-        }","-    }","-","-    #[test]","-    fn a_gate_only_after_the_merge_leaves_the_workflow_dark() {","-        use crate::{Level, Pipeline};","-        let mut d = Dials::all(Dial::Dark);","-        d.set(Stage::Learn, Dial::LightsOn);","-        assert_eq!(d.level(&Pipeline::Full.stages()), Level::Dark);","-        d.set(Stage::Plan, Dial::LightsOn);","-        assert_eq!(d.level(&Pipeline::Full.stages()), Level::Dim);","-    }","-","-    #[test]","-    fn a_version_kept_before_d33_maps_each_old_dial_to_the_steps_it_judged() {","-        let pairs = [","-            (\"dial.approve\", \"auto\"),","-            (\"dial.review\", \"auto\"),","-            (\"dial.questions\", \"hold\"),","-            (\"dial.uat\", \"ask\"),","-        ]","-        .map(|(k, v)| (k.to_string(), v.to_string()));","-        let d = Settings::from_pairs(&pairs).dials;","-        assert_eq!(d.at(Stage::Plan), Dial::Dark);","-        assert_eq!(","-            d.at(Stage::Build),","-            Dial::LightsOn,","-            \"review never went below hold\"","-        );","-        assert_eq!(d.at(Stage::CodeReview), Dial::LightsOn);","-        assert_eq!(d.at(Stage::Discover), Dial::LightsOn, \"hold is lights-on\");","-        assert_eq!(d.at(Stage::Comprehend), Dial::LightsOn);","-        assert_eq!(d.at(Stage::Checks), Dial::LightsOn, \"a step no dial judged\");","-        let medium = Settings {","-            dials: Oversight::Dim.dials(),","-            ..Settings::default()","-        };","-        assert_eq!(Settings::from_pairs(&medium.to_pairs()), medium);","-    }","-","-    #[test]","-    fn changes_name_each_key_that_moved() {","-        let before = Settings::default();","-        let after = Settings {","-            forge: Forge::Github,","-            ..Settings::default()","-        };","-        assert_eq!(after.changes(&before), [\"forge: local -> github\"]);","-        assert_eq!(after.model(Stage::Build), &Model::default());","-    }"," }"]}],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"489bb5d1-c0b1-4d82-a096-4cf54e6a0f38","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
