X_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' pre-tool-use 3>&1 1>&2; else cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi","durationMs":66},"type":"attachment","uuid":"d6273bc8-1761-47d9-a8a6-9abc23dc2924","timestamp":"2026-11-11T17:57:29.775Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"4a912554-853f-44d6-a196-282494fa567f","isSidechain":false,"promptId":"b8e0bbe3-cc96-42f3-aab3-6917145b7fe2","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qc785Sbch43o1JQdrysopt","type":"tool_result","content":"fn line(job: &JobSummary, server: &str, down: bool) -> String {\n    let unreachable = if down { \" · unreachable\" } else { \"\" };\n    let by = job\n        .requester\n        .as_ref()\n        .map_or_else(String::new, |who| format!(\" · by {who}\"));\n    let state = job.state.replace('_', \" \");\n    format!(\n        \"{server}{unreachable} · {} · {} · {state} · {}{by}\",\n        job.workspace,\n        job.id,\n        ago(job.created_at)\n    )\n}\n\nfn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {\n    let mut about = column![text(sj.job.request.clone()).font(theme::BOLD)].spacing(2);\n    if let Some(p) = &sj.job.part {\n        about = about.push(text(format!(\"Part: {p}\")).size(13));\n    }\n    about = about.push(\n        text(line(&sj.job, &sj.server, down))\n            .size(12)\n            .color(theme::MUTED),\n    );\n    let stage = container(text(sj.job.stage.clone()).size(12))\n        .padding([2, 8])\n        .style(theme::chip);\n    let body = row![\n        container(super::mark_view(&sj.job.state, 18.0)).width(24),\n        about.width(Fill),\n        stage\n    ]\n    .spacing(12);\n    let indent = if sj.job.parent.is_some() { 24 } else { 0 };\n    let open = Message::OpenJob {\n        server: sj.server,\n        id: sj.job.id,\n    };\n    let row_button = button(body)\n        .width(Fill)\n        .padding([10, 12])\n        .style(theme::row_button)\n        .on_press(open);\n    let faded = if down { 0.6 } else { 1.0 };\n    container(row_button)\n        .padding(iced::Padding::ZERO.left(indent))\n        .style(move |_| container::Style {\n            text_color: Some(iced::Color {\n                a: faded,\n                ..theme::INK\n            }),\n            ..container::Style::default()\n        })\n        .into()\n}\n\nfn group<'a>(title: String, jobs: Vec<ServerJob>, ctx: &Ctx, accent: bool) -> Element<'a, Message> {\n    let body: Element<'a, Message> = if jobs.is_empty() {\n        container(text(\"Nothing here.\").size(13).color(theme::MUTED))\n            .padding([10, 12])\n            .into()\n    } else {\n        let rows = families(jobs).into_iter().map(|j| {\n            let down = ctx.down.contains(&j.server);\n            job_row(j, down)\n        });\n        Column::with_children(rows).into()\n    };\n    section(title, body, accent)\n}\n\nfn filters(state: &State) -> Element<'_, Message> {\n    let shown = Some(state.place.clone().unwrap_or_else(|| EVERY.into()));\n    let place =\n        pick_list(state.places(), shown, |p| Message::Jobs(Msg::Place(p))).style(theme::select);\n    let search = text_input(\"Request or id\", &state.search)\n        .on_input(|s| Message::Jobs(Msg::Search(s)))\n        .style(theme::field)\n        .width(260);\n    row![labeled(\"Workspace\", place), labeled(\"Search\", search)]\n        .spacing(12)\n        .into()\n}\n\n//! D4's theme: one dark theme, purple as the main color, as iced styles.\n\nuse iced::theme::Palette;\nuse iced::widget::{button, container, pick_list, text_input};\nuse iced::{Background, Border, Color, Font, Theme, font};\n\nconst fn byte(rgb: u32, shift: u32) -> f32 {\n    ((rgb >> shift) & 0xff) as f32 / 255.0\n}\n\nconst fn hex(rgb: u32) -> Color {\n    Color {\n        r: byte(rgb, 16),\n        g: byte(rgb, 8),\n        b: byte(rgb, 0),\n        a: 1.0,\n    }\n}\n\npub const BG: Color = hex(0x0f0d17);\npub const PANEL: Color = hex(0x19162a);\npub const INK: Color = hex(0xece9f5);\npub const MUTED: Color = hex(0xa39cb8);\npub const LINE: Color = hex(0x2c2742);\npub const PRIMARY: Color = hex(0x7c3aed);\npub const PRIMARY_HOVER: Color = hex(0x6d28d9);\npub const LINK: Color = hex(0xc4b5fd);\npub const OK: Color = hex(0x4ade80);\npub const BAD: Color = hex(0xf87171);\npub const WARN: Color = hex(0xfbbf24);\n\n/// The app's theme, so a widget with no style of its own still reads\n/// light on dark.\npub fn bastion() -> Theme {\n    let palette = Palette {\n        background: BG,\n        text: INK,\n        primary: PRIMARY,\n        success: OK,\n        warning: WARN,\n        danger: BAD,\n    };\n    Theme::custom(\"Bastion\".to_string(), palette)\n}\n\n/// The text face. macOS's system face is variable, and iced draws no bold\n/// from it, so the client uses a face with a real bold.\n// ponytail: Helvetica Neue on macOS; other systems fall back to their own sans.\npub const FONT: Font = Font::with_name(\"Helvetica Neue\");\npub const BOLD: Font = Font {\n    weight: font::Weight::Bold,\n    ..FONT\n};\n\nfn rounded(radius: f32) -> Border {\n    Border {\n        radius: radius.into(),\n        ..Border::default()\n    }\n}\n\nfn lined(radius: f32) -> Border {\n    Border {\n        radius: radius.into(),\n        width: 1.0,\n        color: LINE,\n    }\n}\n\n/// The window behind every page.\npub fn page(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(BG)),\n        text_color: Some(INK),\n        ..container::Style::default()\n    }\n}\n\n/// The sidebar: the panel color, a line on its right.\npub fn sidebar(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(PANEL)),\n        border: Border {\n            width: 1.0,\n            color: LINE,\n            ..Border::default()\n        },\n        ..container::Style::default()\n    }\n}\n\n/// A section or a row: the panel color in a rounded, lined box.\npub fn panel(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(PANEL)),\n        border: lined(12.0),\n        ..container::Style::default()\n    }\n}\n\n/// The dark veil behind a dialog.\npub fn veil(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(Color {\n            a: 0.6,\n            ..Color::BLACK\n        })),\n        ..container::Style::default()\n    }\n}\n\n/// A sidebar entry: purple when its page is shown, a line on hover.\npub fn nav(here: bool) -> impl Fn(&Theme, button::Status) -> button::Style {\n    move |_, status| {\n        let background = match (here, status) {\n            (true, _) => Some(Background::Color(PRIMARY)),\n            (false, button::Status::Hovered | button::Status::Pressed) => {\n                Some(Background::Color(LINE))\n            }\n            _ => None,\n        };\n        let text_color = if here { Color::WHITE } else { INK };\n        button::Style {\n            background,\n            text_color,\n            border: rounded(8.0),\n            ..button::Style::default()\n        }\n    }\n}\n\n/// The main action: white on purple.\npub fn primary(_: &Theme, status: button::Status) -> button::Style {\n    let fill = match status {\n        button::Status::Hovered => PRIMARY_HOVER,\n        button::Status::Disabled => Color { a: 0.5, ..PRIMARY },\n        _ => PRIMARY,\n    };\n    button::Style {\n        background: Some(Background::Color(fill)),\n        text_color: Color::WHITE,\n        border: rounded(8.0),\n        ..button::Style::default()\n    }\n}\n\n/// Any other button: a lined box that fills on hover.\npub fn secondary(_: &Theme, status: button::Status) -> button::Style {\n    let background = (status == button::Status::Hovered).then_some(Background::Color(LINE));\n    // A button that cannot be pressed now reads faded, as `disabled:opacity-40` did.\n    let text_color = if status == button::Status::Disabled {\n        LINE\n    } else {\n        INK\n    };\n    button::Style {\n        background,\n        text_color,\n        border: lined(8.0),\n        ..button::Style::default()\n    }\n}\n\n/// A plain button with muted text, as Cancel.\npub fn quiet(_: &Theme, status: button::Status) -> button::Style {\n    let background = (status == button::Status::Hovered).then_some(Background::Color(LINE));\n    button::Style {\n        background,\n        text_color: MUTED,\n        border: rounded(8.0),\n        ..button::Style::default()\n    }\n}\n\npub fn select(_: &Theme, _: pick_list::Status) -> pick_list::Style {\n    pick_list::Style {\n        text_color: INK,\n        placeholder_color: MUTED,\n        handle_color: MUTED,\n        background: Background::Color(BG),\n        border: lined(4.0),\n    }\n}\n\npub fn field(_: &Theme, status: text_input::Status) -> text_input::Style {\n    let edge = if matches!(status, text_input::Status::Focused { .. }) {\n        PRIMARY\n    } else {\n        LINE\n    };\n    text_input::Style {\n        background: Background::Color(BG),\n        border: Border {\n            color: edge,\n            ..lined(4.0)\n        },\n        icon: MUTED,\n        placeholder: MUTED,\n        value: INK,\n        selection: PRIMARY,\n    }\n}\n\n/// A section that wants attention: a warning-colored edge.\npub fn accented(theme: &Theme) -> container::Style {\n    container::Style {\n        border: Border {\n            color: WARN,\n            ..lined(12.0)\n        },\n        ..panel(theme)\n    }\n}\n\n/// A 1 px line across a section.\npub fn rule<'a, M: 'a>() -> iced::Element<'a, M> {\n    container(iced::widget::space::horizontal())\n        .height(1)\n        .width(iced::Fill)\n        .style(|_| container::Style {\n            background: Some(Background::Color(LINE)),\n            ..container::Style::default()\n        })\n        .into()\n}\n\n/// A whole row that opens something: no fill until hovered.\npub fn row_button(_: &Theme, status: button::Status) -> button::Style {\n    let background = matches!(status, button::Status::Hovered | button::Status::Pressed)\n        .then_some(Background::Color(LINE));\n    button::Style {\n        background,\n        text_color: INK,\n        ..button::Style::default()\n    }\n}\n\n/// A small text button, muted until hovered, as \"← All jobs\".\npub fn link(_: &Theme, status: button::Status) -> button::Style {\n    let text_color = if status == button::Status::Hovered {\n        INK\n    } else {\n        MUTED\n    };\n    button::Style {\n        text_color,\n        ..button::Style::default()\n    }\n}\n\n/// A pill around a short label, as a job's stage.\npub fn chip(_: &Theme) -> container::Style {\n    container::Style {\n        text_color: Some(MUTED),\n        border: Border {\n            radius: 999.0.into(),\n            width: 1.0,\n            color: LINE,\n        },\n        ..container::Style::default()\n    }\n}\n\n/// A section that says something failed: a red edge.\npub fn alarmed(theme: &Theme) -> container::Style {\n    container::Style {\n        border: Border {\n            color: BAD,\n            ..lined(12.0)\n        },\n        ..panel(theme)\n    }\n}\n\n/// Code, a report or a diff: the page color, slightly rounded.\npub fn code(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(BG)),\n        border: rounded(4.0),\n        ..container::Style::default()\n    }\n}\n\npub const MONO: Font = Font::MONOSPACE;","is_error":false}]},"uuid":"1d4d07f7-d79e-49d0-9b61-2fdb3839d444","timestamp":"2026-11-11T17:57:30.961Z","toolUseResult":{"stdout":"fn line(job: &JobSummary, server: &str, down: bool) -> String {\n    let unreachable = if down { \" · unreachable\" } else { \"\" };\n    let by = job\n        .requester\n        .as_ref()\n        .map_or_else(String::new, |who| format!(\" · by {who}\"));\n    let state = job.state.replace('_', \" \");\n    format!(\n        \"{server}{unreachable} · {} · {} · {state} · {}{by}\",\n        job.workspace,\n        job.id,\n        ago(job.created_at)\n    )\n}\n\nfn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {\n    let mut about = column![text(sj.job.request.clone()).font(theme::BOLD)].spacing(2);\n    if let Some(p) = &sj.job.part {\n        about = about.push(text(format!(\"Part: {p}\")).size(13));\n    }\n    about = about.push(\n        text(line(&sj.job, &sj.server, down))\n            .size(12)\n            .color(theme::MUTED),\n    );\n    let stage = container(text(sj.job.stage.clone()).size(12))\n        .padding([2, 8])\n        .style(theme::chip);\n    let body = row![\n        container(super::mark_view(&sj.job.state, 18.0)).width(24),\n        about.width(Fill),\n        stage\n    ]\n    .spacing(12);\n    let indent = if sj.job.parent.is_some() { 24 } else { 0 };\n    let open = Message::OpenJob {\n        server: sj.server,\n        id: sj.job.id,\n    };\n    let row_button = button(body)\n        .width(Fill)\n        .padding([10, 12])\n        .style(theme::row_button)\n        .on_press(open);\n    let faded = if down { 0.6 } else { 1.0 };\n    container(row_button)\n        .padding(iced::Padding::ZERO.left(indent))\n        .style(move |_| container::Style {\n            text_color: Some(iced::Color {\n                a: faded,\n                ..theme::INK\n            }),\n            ..container::Style::default()\n        })\n        .into()\n}\n\nfn group<'a>(title: String, jobs: Vec<ServerJob>, ctx: &Ctx, accent: bool) -> Element<'a, Message> {\n    let body: Element<'a, Message> = if jobs.is_empty() {\n        container(text(\"Nothing here.\").size(13).color(theme::MUTED))\n            .padding([10, 12])\n            .into()\n    } else {\n        let rows = families(jobs).into_iter().map(|j| {\n            let down = ctx.down.contains(&j.server);\n            job_row(j, down)\n        });\n        Column::with_children(rows).into()\n    };\n    section(title, body, accent)\n}\n\nfn filters(state: &State) -> Element<'_, Message> {\n    let shown = Some(state.place.clone().unwrap_or_else(|| EVERY.into()));\n    let place =\n        pick_list(state.places(), shown, |p| Message::Jobs(Msg::Place(p))).style(theme::select);\n    let search = text_input(\"Request or id\", &state.search)\n        .on_input(|s| Message::Jobs(Msg::Search(s)))\n        .style(theme::field)\n        .width(260);\n    row![labeled(\"Workspace\", place), labeled(\"Search\", search)]\n        .spacing(12)\n        .into()\n}\n\n//! D4's theme: one dark theme, purple as the main color, as iced styles.\n\nuse iced::theme::Palette;\nuse iced::widget::{button, container, pick_list, text_input};\nuse iced::{Background, Border, Color, Font, Theme, font};\n\nconst fn byte(rgb: u32, shift: u32) -> f32 {\n    ((rgb >> shift) & 0xff) as f32 / 255.0\n}\n\nconst fn hex(rgb: u32) -> Color {\n    Color {\n        r: byte(rgb, 16),\n        g: byte(rgb, 8),\n        b: byte(rgb, 0),\n        a: 1.0,\n    }\n}\n\npub const BG: Color = hex(0x0f0d17);\npub const PANEL: Color = hex(0x19162a);\npub const INK: Color = hex(0xece9f5);\npub const MUTED: Color = hex(0xa39cb8);\npub const LINE: Color = hex(0x2c2742);\npub const PRIMARY: Color = hex(0x7c3aed);\npub const PRIMARY_HOVER: Color = hex(0x6d28d9);\npub const LINK: Color = hex(0xc4b5fd);\npub const OK: Color = hex(0x4ade80);\npub const BAD: Color = hex(0xf87171);\npub const WARN: Color = hex(0xfbbf24);\n\n/// The app's theme, so a widget with no style of its own still reads\n/// light on dark.\npub fn bastion() -> Theme {\n    let palette = Palette {\n        background: BG,\n        text: INK,\n        primary: PRIMARY,\n        success: OK,\n        warning: WARN,\n        danger: BAD,\n    };\n    Theme::custom(\"Bastion\".to_string(), palette)\n}\n\n/// The text face. macOS's system face is variable, and iced draws no bold\n/// from it, so the client uses a face with a real bold.\n// ponytail: Helvetica Neue on macOS; other systems fall back to their own sans.\npub const FONT: Font = Font::with_name(\"Helvetica Neue\");\npub const BOLD: Font = Font {\n    weight: font::Weight::Bold,\n    ..FONT\n};\n\nfn rounded(radius: f32) -> Border {\n    Border {\n        radius: radius.into(),\n        ..Border::default()\n    }\n}\n\nfn lined(radius: f32) -> Border {\n    Border {\n        radius: radius.into(),\n        width: 1.0,\n        color: LINE,\n    }\n}\n\n/// The window behind every page.\npub fn page(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(BG)),\n        text_color: Some(INK),\n        ..container::Style::default()\n    }\n}\n\n/// The sidebar: the panel color, a line on its right.\npub fn sidebar(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(PANEL)),\n        border: Border {\n            width: 1.0,\n            color: LINE,\n            ..Border::default()\n        },\n        ..container::Style::default()\n    }\n}\n\n/// A section or a row: the panel color in a rounded, lined box.\npub fn panel(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(PANEL)),\n        border: lined(12.0),\n        ..container::Style::default()\n    }\n}\n\n/// The dark veil behind a dialog.\npub fn veil(_: &Theme) -> container::Style {\n    container::Style {\n        background: Some(Background::Color(Color {\n            a: 0.6,\n            ..Color::BLACK\n        })),\n        ..container::Style::default()\n    }\n}\n\n/// A sidebar entry: purple when its page is shown, a line on hover.\npub fn nav(here: bool) -> impl Fn(&Theme, button::Status) -> button::Style {\n    move |_, status| {\n        let background = match (here, status) {\n            (true, _) => Some(Background::Color(PRIMARY)),\n            (false, button::Status::Hovered | button::Status::Pressed) => {\n                Some(Background::Color(LINE))\n            }\n            _ => None,\n        };\n        let text_color = if here { Color::WHITE } else { INK };\n        button::Style {\n            background,\n            text_color,\n            border: rounded(8.0),\n            ..button::Style::default()\n        }\n    }\n}\n\n/// The main action: white on purple.\npub fn primary(_: &Theme, status: button::Status) -> button::Style {\n    let fill = match status {\n        button::Status::Hovered => PRIMARY_HOVER,\n        button::Status::Disabled => Color { a: 0.5, ..PRIMARY },\n        _ => PRIMARY,\n    };\n    button::Style {\n        background: Some(Background::Color(fill)),\n        text_color: Color::WHITE,\n        border: rounded(8.0),\n        ..button::Style::default()\n    }\n}\n\n/// Any other button: a lined box that fills on hover.\npub fn secondary(_: &Theme, status: button::Status) -> button::Style {\n    let background = (status == button::Status::Hovered).then_some(Background::Color(LINE));\n    // A button that cannot be pressed now reads faded, as `disabled:opacity-40` did.\n    let text_color = if status == button::Status::Disabled {\n        LINE\n    } else {\n        INK\n    };\n    button::Style {\n        background,\n        text_color,\n        border: lined(8.0),\n        ..button::Style::default()\n    }\n}\n\n/// A plain button with muted text, as Cancel.\npub fn quiet(_: &Theme, status: button::Status) -> button::Style {\n    let background = (status == button::Status::Hovered).then_some(Background::Color(LINE));\n    button::Style {\n        background,\n        text_color: MUTED,\n        border: rounded(8.0),\n        ..button::Style::default()\n    }\n}\n\npub fn select(_: &Theme, _: pick_list::Status) -> pick_list::Style {\n    pick_list::Style {\n        text_color: INK,\n        placeholder_color: MUTED,\n        handle_color: MUTED,\n        background: Background::Color(BG),\n        border: lined(4.0),\n    }\n}\n\npub fn field(_: &Theme, status: text_input::Status) -> text_input::Style {\n    let edge = if matches!(status, text_input::Status::Focused { .. }) {\n        PRIMARY\n    } else {\n        LINE\n    };\n    text_input::Style {\n        background: Background::Color(BG),\n        border: Border {\n            color: edge,\n            ..lined(4.0)\n        },\n        icon: MUTED,\n        placeholder: MUTED,\n        value: INK,\n        selection: PRIMARY,\n    }\n}\n\n/// A section that wants attention: a warning-colored edge.\npub fn accented(theme: &Theme) -> container::Style {\n    container::Style {\n        border: Border {\n            color: WARN,\n            ..lined(12.0)\n        },\n        ..panel(theme)\n    }\n}\n\n/// A 1 px line across a section.\npub fn rule<'a, M: 'a>() -> iced::Element<'a, M> {\n    container(iced::widget::space::horizontal())\n        .height(1)\n        .width(iced::Fill)\n        .style(|_| container::Style {\n            background: Some(Background::Color(LINE)),\n            ..container::Style::default()\n        })\n        .into()\n}\n\n/// A whole row that opens something: no fill until hovered.\npub fn row_button(_: &Theme, status: button::Status) -> button::Style {\n    let background = matches!(status, button::Status::Hovered | button::Status::Pressed)\n        .then_some(Background::Color(LINE));\n    button::Style {\n        background,\n        text_color: INK,\n        ..button::Style::default()\n    }\n}\n\n/// A small text button, muted until hovered, as \"← All jobs\".\npub fn link(_: &Theme, status: button::Status) -> button::Style {\n    let text_color = if status == button::Status::Hovered {\n        INK\n    } else {\n        MUTED\n    };\n    button::Style {\n        text_color,\n        ..button::Style::default()\n    }\n}\n\n/// A pill around a short label, as a job's stage.\npub fn chip(_: &Theme) -> container::Style {\n    container::Style {\n        text_color: Some(MUTED),\n        border: Border {\n            radius: 999.0.into(),\n            width: 1.0,\n            color: LINE,\n        },\n        ..container::Style::default()\n    }\n}\n\n/// A section that says something failed: a red edge.\npub fn alarmed(theme: &Theme) -> container::Style {\n    container::Style {\n        border: Border {\