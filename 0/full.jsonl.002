{","         let mut state = State {","-            jobs: vec![job(\"j1\", None, \"a\"), job(\"j2\", None, \"b\")],","+            jobs: vec![job(\"j1\", \"a\"), job(\"j2\", \"b\")],","             ..State::default()","         };","         state.jobs.push(ServerJob {","             server: \"team\".into(),","-            ..job(\"j3\", None, \"c\")","+            ..job(\"j3\", \"c\")","         });","         assert_eq!(state.places(), [EVERY, \"a\", \"b\", \"c\"]);","         assert_eq!(state.servers(), [EVERY_SERVER, \"local\", \"team\"]);"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/jobs.rs"]}},"serverClassifierContext":{"request":"5174fd3f-7a3e-4b7e-acdd-d49653a1ff22","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":11,"modified":51,"untracked":null,"untracked_normal":3},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","platform":"macos"}},"sourceToolAssistantUUID":"bfef048c-11ae-4ee2-8f3c-7693fb0a379a","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
