uch of a check's output goes into a brief or a note.","-const TAIL: usize = 3000;","-","-impl Factory {","-    /// Run baseline, verify or acceptance, and say how it went.","-    pub(super) async fn acceptance_step(&self, record: &Record, stage: Stage) -> Event {","-        let ran = async {","-            let sandbox = record.runtime.sandbox.as_deref().ok_or(\"no VM\")?;","-            let vm = Vm {","-                engine: &*self.engine,","-                sandbox,","-                spec: self.latest_spec(&record.job.id).await?,","-            };","-            let judged = match stage {","-                Stage::Baseline if record.job.falsify_tried => vm.judge_falsify().await,","-                Stage::Baseline => vm.baseline().await,","-                _ => vm.verify().await,","-            };","-            if stage == Stage::Baseline && judged == Ok(Event::StepPassed) {","-                let files = vm.spec.files();","-                self.set_runtime(&record.job.id, |r| r.approved = files.clone())","-                    .await?;","-                self.gate.protect(&record.job.id, files);","-            }","-            judged","-        };","-        ran.await","-            .unwrap_or_else(|detail: String| Event::StepStuck { detail })","-    }","-","-    /// The checks step: the workspace's own test command, in the VM. A","-    /// workspace with no command has nothing to run.","-    pub(super) async fn checks_step(&self, record: &Record) -> Event {","-        let ran = async {","-            let workspaces = self.store.workspaces().await?;","-            let command = workspaces","-                .into_iter()","-                .find(|w| w.name == record.job.workspace)","-                .map(|w| w.checks)","-                .unwrap_or_default();","-            if command.trim().is_empty() {","-                return Ok(Event::StepPassed);","-            }","-            let vm = Vm {","-                engine: &*self.engine,","-                sandbox: record.runtime.sandbox.as_deref().ok_or(\"no VM\")?,","-                spec: Spec { checks: Vec::new() },","-            };","-            Ok(acceptance::suite(&vm.run(\"checks\", &command).await?))","-        };","-        ran.await","-            .unwrap_or_else(|detail: String| Event::StepStuck { detail })","-    }","-","-    /// A workflow's command step (D35): its line in the repository.","-    /// A shell step (D40): its script runs in the job's VM, or in a VM of","-    /// its own with the network and its secrets, stopped after.","-    pub(super) async fn command_step(&self, record: &Record) -> Event {","-        let ran = async {","-            let step = record.job.step().ok_or(\"no script to run\")?;","-            let script = format!(\"{}\\n{}\", self.shell_env(record).await?, step.run);","-            let own = match step.reach.network {","-                true => Some(self.networked_vm(record, &step.reach).await?),","-                false => None,","-            };","-            let sandbox = own.as_deref().or(record.runtime.sandbox.as_deref());","-            let vm = Vm {","-                engine: &*self.engine,","-                sandbox: sandbox.ok_or(\"no VM\")?,","-                spec: Spec { checks: Vec::new() },","-            };","-            let ran = vm.run(&step.run, &script).await;","-            if let Some(own) = &own {","-                self.stop_vm(own).await;","-            }","-            Ok(acceptance::command(&ran?))","-        };","-        ran.await","-            .unwrap_or_else(|detail: String| Event::StepStuck { detail })","-    }","-","-    /// The spec the latest specify turn wrote.","-    async fn latest_spec(&self, job: &str) -> Result<Spec, String> {","-        let artifacts = self.store.artifacts(job).await?;","-        let reply = artifacts","-            .iter()","-            .rev()","-            .find(|a| a.stage == Stage::Specify)","-            .ok_or(\"no spec: specify has not run\")?;","-        spec::read(&reply.body)","-    }","-}","-","-/// One job's VM, with the spec whose checks run in it.","-struct Vm<'a> {","-    engine: &'a dyn Engine,","-    sandbox: &'a str,","-    spec: Spec,","-}","-","-impl Vm<'_> {","-    /// Before the build, every check must fail.","-    async fn baseline(&self) -> Result<Event, String> {","-        self.commit_spec().await?;","-        let absent = self.absent().await?;","-        let runs = self.run_checks().await?;","-        self.put_back_test_writes().await?;","-        self.approve(acceptance::baseline(&runs, &absent)).await","-    }","-","-    /// After falsify: the checks against the broken code, then the code put","-    /// back to the tag made before the turn, tests included.","-    async fn judge_falsify(&self) -> Result<Event, String> {","-        let broken = self.run_checks().await?;","-        let touched = self.changed_since(BEFORE_TURN).await?;","-        self.sh(&format!(","-            \"git reset -q --hard {BEFORE_TURN} && git clean -qfd\"","-        ))","-        .await?;","-        self.approve(acceptance::falsified(&broken, &touched)).await","-    }","-","-    /// After the build, every check passes on the tests the baseline approved.","-    async fn verify(&self) -> Result<Event, String> {","-        let changed = self.changed_since(SPEC_TAG).await?;","-        let runs = self.run_checks().await?;","-        Ok(acceptance::verified(&runs, &changed))","-    }","-","-    /// A baseline that passes marks the tree its checks were approved on.","-    async fn approve(&self, event: Event) -> Result<Event, String> {","-        if event == Event::StepPassed {","-            self.sh(&format!(\"git tag -f {SPEC_TAG}\")).await?;","-        }","-        Ok(event)","-    }","-","-    /// Commit the spec's files, if the specify turn left them uncommitted, so","-    /// they land with the change and a reset to a tag keeps them.","-    async fn commit_spec(&self) -> Result<(), String> {","-        let list = self.files();","-        self.sh(&format!(","-            \"git add -- {list} 2>/dev/null; git diff --cached --quiet || git commit -q -m 'Add the acceptance tests'\"","-        ))","-        .await","-        .map(|_| ())","-    }","-","-    /// The spec's files missing from the tree.","-    async fn absent(&self) -> Result<Vec<String>, String> {","-        let list = self.files();","-        let out = self","-            .sh(&format!(","-                \"for f in {list}; do [ -e \\\"$f\\\" ] || echo \\\"$f\\\"; done\"","-            ))","-            .await?;","-        Ok(lines(&out))","-    }","-","-    /// Of the spec's files, those that differ from `tag` in the tree.","-    async fn changed_since(&self, tag: &str) -> Result<Vec<String>, String> {","-        let list = self.files();","-        let out = self","-            .sh(&format!(\"git diff --name-only {tag} -- {list}\"))","-            .await?;","-        Ok(lines(&out))","-    }","-","-    /// Files the checks wrote that git tracks and the spec does not name go back.","-    // ponytail: untracked files a check leaves stay; wipp puts back tracked files only too.","-    async fn put_back_test_writes(&self) -> Result<(), String> {","-        let approved = self.spec.files();","-        let written = lines(&self.sh(\"git diff --name-only\").await?);","-        let stray: Vec<String> = written","-            .into_iter()","-            .filter(|f| !approved.contains(f))","-            .collect();","-        if !stray.is_empty() {","-            self.sh(&format!(\"git checkout -- {}\", quoted(&stray)))","-                .await?;","-        }","-        Ok(())","-    }","-","-    async fn run_checks(&self) -> Result<Vec<Ran>, String> {","-        let mut runs = Vec::new();","-        for check in &self.spec.checks {","-            runs.push(self.run(&check.criterion, &check.run).await?);","-        }","-        Ok(runs)","-    }","-","-    /// Run one command, whatever it exits with, and keep the end of its output.","-    async fn run(&self, name: &str, command: &str) -> Result<Ran, String> {","-        let out = self.exec(command, CHECK_SECS).await?;","-        Ok(Ran {","-            criterion: name.to_string(),","-            code: out[\"exit_code\"].as_i64().unwrap_or(-1),","-            output: tail(&format!(","-                \"{}{}\",","-                out[\"stdout\"].as_str().unwrap_or_default(),","-                out[\"stderr\"].as_str().unwrap_or_default()","-            )),","-        })","-    }","-","-    /// The spec's files as shell words.","-    fn files(&self) -> String {","-        quoted(&self.spec.files())","-    }","-","-    /// Run a shell line in the repository, and fail unless it exits 0.","-    async fn sh(&self, line: &str) -> Result<String, String> {","-        let out = self.exec(line, 120).await?;","-        match out[\"exit_code\"].as_i64() {","-            Some(0) | None => Ok(out[\"stdout\"].as_str().unwrap_or_default().to_string()),","-            Some(code) => Err(format!(\"{line} exited {code}: {}\", out[\"stderr\"])),","-        }","-    }","-","-    /// Run a shell line in the repository, whatever it exits with.","-    async fn exec(&self, line: &str, secs: u64) -> Result<Value, String> {","-        let argv = [\"sh\", \"-c\", &format!(\"cd {REPO} && {line}\")];","-        self.engine","-            .call_for(","-                DEFAULT_NAMESPACE,","-                \"sandbox::exec\",","-                json!({ \"sandbox_id\": self.sandbox, \"argv\": argv, \"timeout_ms\": secs * 1000 }),","-                secs * 1000 + 60_000,","-            )","-            .await","-    }","-}","-","-/// Paths as single-quoted shell words. A spec's paths are safe already","-/// (`spec::read`), so none holds a quote.","-fn quoted(paths: &[String]) -> String {","-    let words: Vec<String> = paths.iter().map(|p| format!(\"'{p}'\")).collect();","-    words.join(\" \")","-}","-","-fn lines(out: &str) -> Vec<String> {","-    out.lines()","-        .map(str::trim