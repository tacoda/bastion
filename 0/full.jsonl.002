\"approve\") => &[Stage::Plan],\n                    Some(\"review\") => &[Stage::Build, Stage::CodeReview],\n                    _ => &[],\n                };\n                for stage in judged {\n                    dials.set(*stage, dial);\n                }\n            }\n            Ok(dials)\n        })\n    }\n6:use bastion_core::{Dial, Dials, Stage};\n13:    fn dials(&self) -> Answer<'_, Dials>;\n111:    fn dials(&self) -> Answer<'_, Dials> {\n113:            let mut dials = Dials::default();\n235:        fn dials(&self) -> Answer<'_, Dials> {","is_error":false}]},"uuid":"be6ca9de-b7e9-4139-89cf-1f9a7fe9ca3d","timestamp":"2026-11-11T21:26:47.298Z","toolUseResult":{"stdout":"        })\n        .collect())\n}\n\n/// What the factory itself may do, as the settings set it.\npub async fn factory_capabilities(\n    cell: &FactoryCell,\n) -> Result<Vec<FactoryCapabilityView>, String> {\n    let s = crate::settings_store::current(&**factory(cell)?.store()).await?;\n    let row = |name: &str, rung: String, how: &str| FactoryCapabilityView {\n        name: name.into(),\n        rung,\n        how: how.into(),\n    };\n    let github = s.forge == bastion_core::settings::Forge::Github;\n    Ok(vec![\n        row(\n            \"Approve a plan\",\n            name(s.dials.at(bastion_core::Stage::Plan)),\n            \"The plan step's dial.\",\n        ),\n        row(\n            \"Approve a change\",\n            name(s.dials.at(bastion_core::Stage::Build)),\n            \"The build step's dial.\",\n        ),\n        if github {\n            row(\n                \"Push the job's branch and open a pull request\",\n                \"allowed\".into(),\n                \"After review, to the workspace's GitHub origin.\",\n            )\n        } else {\n            row(\n                \"Land on the workspace's branch\",\n                \"allowed\".into(),\n        prev: parse(row, \"prev\")?,\n        hash: parse(row, \"hash\")?,\n    })\n}\n\nimpl GovernStore f