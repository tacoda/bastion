{"parentUuid":"9cce73b8-842f-4dbe-ac70-3dc02cc37b6b","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PreToolUse:Read","toolUseID":"toolu_01WCfh6W3Huhy6Px4jweA3QD","hookEvent":"PreToolUse","content":"","stdout":"{}\n","stderr":"","exitCode":0,"command":"if [ -n \"${CMUX_CLAUDE_HOOK_SPOOL_DIR:-}\" ] && [ -x /bin/zsh ]; then exec /bin/zsh -fc 'LC_ALL=C␤export CMUX_CLAUDE_PID=${CMUX_CLAUDE_PID:-$PPID}␤export CMUX_AGENT_HOOK_INVOKER_PID=$PPID␤cmux_fallback() { { print -rn -- \"$cmux_p\"; /bin/cat; } | /bin/sh -c \"$1\" >&3; exit $?; }␤zmodload zsh/system zsh/datetime zsh/files 2>/dev/null || exec /bin/sh -c \"$1\" >&3␤cmux_p= cmux_c= cmux_e=0␤while (( ${#cmux_p} < 262144 )); do sysread -i 0 -s 65536 cmux_c || { cmux_e=$?; break; }; cmux_p+=$cmux_c; done␤[[ -n ${CMUX_SURFACE_ID:-} && ${CMUX_CLAUDE_HOOKS_DISABLED:-} != 1 ]] || { (( cmux_e == 5 )) || /bin/cat >/dev/null; print -r -- '\\''{}'\\'' >&3; exit 0; }␤cmux_d=$CMUX_CLAUDE_HOOK_SPOOL_DIR␤(( cmux_e == 5 )) && [[ -f $cmux_d/keys ]] || cmux_fallback \"$1\"␤cmux_r=\"cmux-agent-hook-v1\"$'\\''\\n'\\''\"claude\"$'\\''\\n'\\''\"$2\"$'\\''\\n'\\''␤for cmux_k in ${(f)\"$(<$cmux_d/keys)\"}; do (( ${+parameters[$cmux_k]} )) && cmux_r+=\"$cmux_k=${(P)cmux_k}\"$'\\''\\0'\\''; done␤cmux_r+=$'\\''\\0'\\''\"$cmux_p\"␤(( ${#cmux_r} <= 524288 )) || cmux_fallback \"$1\"␤umask 077␤cmux_n=$cmux_d/$epochtime[1].$epochtime[2]-$$␤{ print -rn -- \"$cmux_r\" >| $cmux_n.tmp && mv -f -- $cmux_n.tmp $cmux_n.rec; } 2>/dev/null || { rm -f -- $cmux_n.tmp 2>/dev/null; cmux_fallback \"$1\"; }␤if zsystem flock -t 0 -r -f cmux_l $cmux_d/forwarder.lock 2>/dev/null; then␤  zsystem flock -u $cmux_l␤  rm -- $cmux_n.rec 2>/dev/null && cmux_fallback \"$1\"␤fi␤print -r -- '\\''{}'\\'' >&3' cmux-hook 'cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' pre-tool-use 3>&1 1>&2; else cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi","durationMs":89},"type":"attachment","uuid":"4c03acec-9eb2-4dea-9a28-b6ef135882ef","timestamp":"2026-11-11T21:14:12.504Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"9cce73b8-842f-4dbe-ac70-3dc02cc37b6b","isSidechain":false,"promptId":"1d9ef2db-03d5-4a58-b720-e211c5a548e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WCfh6W3Huhy6Px4jweA3QD","type":"tool_result","content":"1\t//! The factory's rules (DECISIONS.md D18). Everything here is a pure\n2\t//! function: an event and the current job go in, the next job and the effects\n3\t//! to run come out. No I/O, no clock, no engine.\n4\t\n5\tpub mod acceptance;\n6\tpub mod audit;\n7\tmod brief;\n8\tpub mod charter;\n9\tpub mod escape;\n10\tpub mod eval;\n11\tpub mod gates;\n12\tpub mod govern;\n13\tpub mod media;\n14\tpub mod notice;\n15\tpub mod people;\n16\tmod pipeline;\n17\tpub mod publish;\n18\tpub mod request;\n19\tpub mod review;\n20\tpub mod settings;\n21\tpub mod workflow;\n22\t\n23\tuse std::collections::BTreeMap;\n24\t\n25\tuse serde::{Deserialize, Serialize};\n26\t\n27\tpub use brief::{\n28\t    BASE_TAG, Discovery, QUESTION_MARKER, brief, discovery, instructions, listed, outcome,\n29\t};\n30\tpub use pipeline::{Kind, Pipeline, folded};\n31\tpub use workflow::results;\n32\t\n33\t/// How many failed turns in a row a stage gets before the job fails (D16).\n34\tpub const MAX_TURN_FAILURES: u32 = 2;\n35\t/// The longest a turn may run before it counts as failed.\n36\t// ponytail: one cap for every stage; give each stage its own when a stage needs longer.\n37\tpub const TURN_CAP_SECS: u64 = 60 * 60;\n38\t\n39\t/// Every stage a pipeline has (`Pipeline::stages` gives the order).\n40\t#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]"}]},"uuid":"d51d3c84-5a0f-46c2-a8b2-43ba6a910305","timestamp":"2026-11-11T21:14:12.586Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","content":"//! The factory's rules (DECISIONS.md D18). Everything here is a pure\n//! function: an event and the current job go in, the next job and the effects\n//! to run come out. No I/O, no clock, no engine.\n\npub mod acceptance;\npub mod audit;\nmod brief;\npub mod charter;\npub mod escape;\npub mod eval;\npub mod gates;\npub mod govern;\npub mod media;\npub mod notice;\npub mod people;\nmod pipeline;\npub mod publish;\npub mod request;\npub mod review;\npub mod settings;\npub mod workflow;\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\npub use brief::{\n    BASE_TAG, Discovery, QUESTION_MARKER, brief, discovery, instructions, listed, outcome,\n};\npub use pipeline::{Kind, Pipeline, folded};\npub use workflow::results;\n\n/// How many failed turns in a row a stage gets before the job fails (D16).\npub const MAX_TURN_FAILURES: u32 = 2;\n/// The longest a turn may run before it counts as failed.\n// ponytail: one cap for every stage; give each stage its own when a stage needs longer.\npub const TURN_CAP_SECS: u64 = 60 * 60;\n\n/// Every stage a pipeline has (`Pipeline::stages` gives the order).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]","numLines":40,"startLine":1,"totalLines":1425}},"sourceToolAssistantUUID":"9cce73b8-842f-4dbe-ac70-3dc02cc37b6b","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"d51d3c84-5a0f-46c2-a8b2-43ba6a910305","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgwqDM8SMqmzrMtmWHtVm","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":782,"cache_read_input_tokens":811267,"output_tokens":10607,"output_tokens_details":{"thinking_tokens":73},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":782,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":10607,"cache_read_input_tokens":811267,"cache_creation_input_tokens":782,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":782},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"serverClassifierRequest":"a07d1cd2-90c5-4726-901f-72a830391290","apiBlockIndex":0,"requestId":"req_011CgwqDLbw3rsfTmKaENKaz","type":"assistant","uuid":"a1cc97b9-dea4-47f2-8854-4748fb5c63ce","timestamp":"2026-11-11T21:14:14.691Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"a1cc97b9-dea4-47f2-8854-4748fb5c63ce","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgwqDM8SMqmzrMtmWHtVm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WAeJ5ATiKjoivWca7mt2Nn","name":"Write","input":{"file_path":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","content":"//! The factory's rules (DECISIONS.md D18). Everything here is a pure\n//! function: an event and the current job go in, the next job and the effects\n//! to run come out. No I/O, no clock, no engine.\n//!\n//! A job runs its workflow's steps in order (D39): an agent's step runs a\n//! turn, a shell step runs a script, and past the last step the job finishes\n//! as its workspace says (D41).\n\npub mod audit;\nmod brief;\npub mod charter;\npub mod escape;\npub mod eval;\npub mod govern;\npub mod media;\npub mod notice;\npub mod people;\npub mod request;\npub mod review;\npub mod settings;\npub mod workflow;\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\npub use brief::{BASE_TAG, QUESTION_MARKER, brief, outcome};\npub use workflow::results;\n\n/// How many failed turns in a row a step gets before the job fails (D16).\npub const MAX_TURN_FAILURES: u32 = 2;\n/// The longest a turn may run before it counts as failed.\npub const TURN_CAP_SECS: u64 = 60 * 60;\n/// How many times one step may send the work back by itself, past which\n/// it waits on a person.\npub const MAX_REVISIONS: u32 = 2;\n\n/// What a workflow's step is (D39).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Stage {\n    /// An agent follows the workflow's instructions for the step.\n    Prompt,\n    /// An agent acts as one of the repository's agents, in `.claude/agents`.\n    Agent,\n    /// An agent follows a skill in the repository.\n    Skill,\n    /// An agent carries out one of the repository's commands, in\n    /// `.claude/commands`.\n    Command,\n    /// A shell script runs in the VM: a one-line CLI command, a script or a\n    /// task runner.\n    Shell,\n}\n\n/// Who runs a step: an agent's turn, or the factory itself.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Kind {\n    Turn,\n    Factory,\n}\n\nimpl Stage {\n    /// Every kind, for the store's checks.\n    pub const ALL: [Stage; 5] = [\n        Stage::Prompt,\n        Stage::Agent,\n        Stage::Skill,\n        Stage::Command,\n        Stage::Shell,\n    ];\n\n    pub fn kind(self) -> Kind {\n        match self {\n            Stage::Shell => Kind::Factory,\n            _ => Kind::Turn,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum State {\n    /// Waiting for a free sandbox.\n    Queued,\n    /// Getting its worktree and VM.\n    Provisioning,\n    /// A step runs, or the job finishes.\n    Running,\n    /// A step's result, or a question, waits on a person.\n    NeedsYou,\n    Landed,\n    Failed,\n    Stopped,\n}\n\nimpl State {\n    pub fn finished(self) -> bool {\n        matches!(self, State::Landed | State::Failed | State::Stopped)\n    }\n\n    /// Holds a sandbox VM.\n    pub fn holds_vm(self) -> bool {\n        !self.finished() && self != State::Queued\n    }\n}\n\n/// One request against one workspace, and where it is in its workflow.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Job {\n    pub id: String,\n    pub workspace: String,\n    pub request: String,\n    /// The current step's kind.\n    pub stage: Stage,\n    pub state: State,\n    /// What the owner must answer while `NeedsYou` holds for a question.\n    pub question: Option<String>,\n    /// The note that becomes the next turn's brief (D16).\n    pub feedback: Option<String>,\n    pub failures: u32,\n    /// Why the job failed, or why a step waits, when it did.\n    pub error: Option<String>,\n    pub updated_at: u64,\n    /// How many times each step has sent the work back, by step id.\n    pub revisions: BTreeMap<String, u32>,\n    /// The last failure that sent the work back. The same one again, word\n    /// for word, means the fix did not help, so the job waits on the owner.\n    pub last_refusal: Option<String>,\n    /// The steps of the workflow the job runs (D39), in order.\n    pub flow: Vec<workflow::Step>,\n    /// The step the job is at, by id.\n    pub node: Option<String>,\n    /// The results its steps gave, by name.\n    pub results: BTreeMap<String, String>,\n}\n\n/// Something that happened to a job.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\", tag = \"kind\")]\npub enum Event {\n    /// A sandbox is free for this queued job.\n    Admitted,\n    Provisioned,\n    ProvisionFailed {\n        error: String,\n    },\n    TurnFinished {\n        outcome: Outcome,\n    },\n    /// A person approved the step the job waits on.\n    Approved,\n    /// A person sent the step's result back with a note, or answered a question.\n    Commented {\n        text: String,\n    },\n    /// The job's branch merged, or was left, as its workspace says (D41).\n    Landed,\n    LandFailed {\n        error: String,\n    },\n    Stopped,\n    /// A shell step passed, with what it printed.\n    Ran {\n        output: String,\n    },\n    /// A shell step failed, with what it printed.\n    StepFailed {\n        detail: String,\n    },\n    /// A step found what only a person can settle; no fix is sent.\n    StepStuck {\n        detail: String,\n    },\n    /// The job's VM is gone, as after its stack restarted. Its commits are\n    /// in the worktree, so a new VM picks the job up where it was (revive).\n    VmLost,\n    /// A person asked to run a failed job, or a stuck step, again.\n    Retried,\n    /// A person gave the running turn its full cap again, from now.\n    Extended,\n}\n\n/// Whether a person oversees a step (D33). Stored `ask` and `hold` read as\n/// lights-on, and `auto` as dark.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Dial {\n    /// The step waits for a person to approve its result or send it back.\n    #[default]\n    #[serde(alias = \"ask\", alias = \"hold\")]\n    LightsOn,\n    /// The step goes on at once.\n    #[serde(alias = \"auto\")]\n    Dark,\n}\n\n/// How much of a workflow a person oversees, as its steps' dials make it:\n/// a gate at every step, at some, or at none.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Level {\n    LightsOn,\n    Dim,\n    Dark,\n}\n\n/// What bounds one job's run beyond its workflow.\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct Bounds {\n    /// An eval's run: every step goes on at once, and it stops before its\n    /// finish, so nothing lands.\n    pub trial: bool,\n    /// How many times in all the job's steps may send its work back by\n    /// themselves; past it, a failing step waits on the owner. It comes from\n    /// the job's workspace.\n    pub revision_budget: Option<u32>,\n}\n\n/// How an agent turn ended.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\", tag = \"kind\")]\npub enum Outcome {\n    /// The turn finished its step, with the text it reported.\n    Done { report: String },\n    /// The agent stopped with a question for the owner.\n    Asked { question: String },\n    /// The turn failed, or ran past the cap.\n    Failed { error: String },\n    /// The turn replied, but not with what its step asked for, such as a\n    /// result it must give.\n    Unusable { report: String, problem: String },\n}\n\n/// What the adapter must do after a step. Effects are data; the core never\n/// waits on one (§6.1).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\", tag = \"kind\")]\npub enum Effect {\n    /// Make the job's worktree and VM, and put its code in the VM.\n    Provision,\n    StartTurn {\n        stage: Stage,\n        brief: String,\n    },\n    /// Keep a step's report or output as its artifact.\n    RecordArtifact {\n        stage: Stage,\n        body: String,\n    },\n    /// Keep the change against its base as an artifact, and review it.\n    CaptureDiff,\n    /// Run a shell step, then send `Ran`, `StepFailed` or `StepStuck`.\n    RunStep {\n        stage: Stage,\n    },\n    /// The workflow's last step passed: bring the VM's commits back, then\n    /// merge them or leave the branch, as the workspace says (D41).\n    Finish,\n    /// Stop the VM and release the worktree.\n    Teardown,\n    /// A dark step went on with no person (D33): note it in the audit log.\n    DarkDecided {\n        stage: Stage,\n    },\n}\n\nimpl Job {\n    pub fn new(id: String, workspace: String, request: String, at: u64) -> Self {\n        Job {\n            id,\n            workspace,\n            request,\n            stage: Stage::Prompt,\n            state: State::Queued,\n            question: None,\n            feedback: None,\n            failures: 0,\n            error: None,\n            updated_at: at,\n            revisions: BTreeMap::new(),\n            last_refusal: None,\n            flow: Vec::new(),\n            node: None,\n            results: BTreeMap::new(),\n        }\n    }\n\n    /// The step the job is at.\n    pub fn step(&self) -> Option<&workflow::Step> {\n        let at = self.node.as_deref()?;\n        self.flow.iter().find(|s| s.id == at)\n    }\n\n    /// The job on a workflow's steps, at its first step.\n    pub fn running(mut self, flow: Vec<workflow::Step>) -> Self {\n        if let Some(first) = flow.first() {\n            self.stage = first.stage;\n            self.node = Some(first.id.clone());\n        }\n        self.flow = flow;\n        self\n    }\n\n    fn position(&self) -> Option<usize> {\n        let at = self.node.as_ref()?;\n        self.flow.iter().position(|s| &s.id == at)\n    }\n\n    /// Move to step `i` of the workflow.\n    fn go_to(&mut self, i: usize) {\n        let step = &self.flow[i];\n        (self.stage, self.node) = (step.stage, Some(step.id.clone()));\n        self.failures = 0;\n    }\n\n    /// The nearest agent's step at or before this one, which a failing or\n    /// sent-back step's work goes back to.\n    fn fixer(&self) -> Option<usize> {\n        let at = self.position()?;\n        (0..=at)\n            .rev()\n            .find(|&i| self.flow[i].stage.kind() == Kind::Turn && !self.flow[i].reach.reads_only)\n    }\n}\n\n/// Apply one event to one job. An event that does not fit the job's state\n/// changes nothing and returns no effects.\npub fn step(job: &Job, event: &Event, at: u64, bounds: &Bounds) -> (Job, Vec<Effect>) {\n    let mut next = job.clone();\n    next.updated_at = at;\n    let effects = match (job.state, event) {\n        (_, Event::Retried | Event::Extended) => match by_person(&mut next, event) {\n            Some(effects) => effects,\n            None => return (job.clone(), Vec::new()),\n        },\n        (state, _) if state.finished() => return (job.clone(), Vec::new()),\n        (_, Event::Stopped) => {\n            next.state = State::Stopped;\n            vec![Effect::Teardown]\n        }\n        (State::Queued, Event::Admitted) => {\n            next.state = State::Provisioning;\n            vec![Effect::Provision]\n        }\n        (State::Provisioning, Event::Provisioned) => start(&mut next),\n        (State::Provisioning, Event::ProvisionFailed { error }) => fail(&mut next, error),\n        (State::Running, Event::TurnFinished { outcome }) if job.stage.kind() == Kind::Turn => {\n            turn_finished(&mut next, outcome, bounds)\n        }\n        (State::NeedsYou, Event::Approved) if job.question.is_none() => {\n            approved(&mut next, bounds)\n        }\n        (State::NeedsYou, Event::Commented { text }) => commented(&mut next, text),\n        (State::Running, Event::VmLost) => revive(&mut next),\n        (State::Running, Event::Landed | Event::LandFailed { .. }) if job.finishing() => {\n            finished(&mut next, event)\n        }\n        (State::Running, Event::Ran { .. } | Event::StepFailed { .. } | Event::StepStuck { .. })\n            if job.stage == Stage::Shell =>\n        {\n            shell_ran(&mut next, event, bounds)\n        }\n        _ => return (job.clone(), Vec::new()),\n    };\n    (next, effects)\n}\n\nimpl Job {\n    /// Past its last step, waiting for its branch to merge or be left.\n    fn finishing(&self) -> bool {\n        self.position().is_some_and(|i| i + 1 == self.flow.len())\n    }\n}\n\n/// How many times in a row a job may lose its VM before it fails.\npub const MAX_REVIVES: u32 = 2;\n\n/// Give the job a new VM, which starts its step again once provisioned. A\n/// VM that keeps dying fails the job rather than looping.\nfn revive(job: &mut Job) -> Vec<Effect> {\n    job.failures += 1;\n    if job.failures > MAX_REVIVES {\n        return fail(job, \"the job's VM was lost again after a revive\");\n    }\n    job.state = State::Provisioning;\n    vec![Effect::Provision]\n}\n\n/// A person's retry or extend. `None` means it does not fit, and nothing\n/// changes.\nfn by_person(job: &mut Job, event: &Event) -> Option<Vec<Effect>> {\n    match event {\n        Event::Retried if job.state == State::Failed => {\n            job.state = State::Queued;\n            job.error = None;\n            job.failures = 0;\n            Some(Vec::new())\n        }\n        Event::Retried if retries(job) => {\n            job.error = None;\n            Some(start(job))\n        }\n        // The cap counts from `updated_at`, which `step` moved to now.\n        Event::Extended if extends(job) => Some(Vec::new()),\n        _ => None,\n    }\n}\n\n/// Whether the job runs a turn a person may give more time.\nfn extends(job: &Job) -> bool {\n    job.state == State::Running && job.stage.kind() == Kind::Turn\n}\n\n/// Whether a person may run the step the job waits on again: it failed, or\n/// it is stuck.\nfn retries(job: &Job) -> bool {\n    job.state == State::Failed\n        || (job.state == State::NeedsYou && job.error.is_some() && job.question.is_none())\n}\n\n/// Run the current step, once its entry criteria hold: every result\n/// linked into it exists (D35).\nfn start(job: &mut Job) -> Vec<Effect> {\n    job.question = None;\n    let needs = job.step().map(|s| s.needs.clone()).unwrap_or_default();\n    if let Some(missing) = needs.iter().find(|n| !job.results.contains_key(*n)) {\n        return stuck(\n            job,\n            &format!(\"This step needs the result {missing}, which no step gave.\"),\n        );\n    }\n    job.state = State::Running;\n    match job.stage {\n        Stage::Shell => vec![Effect::RunStep { stage: Stage::Shell }],\n        stage => vec![Effect::StartTurn {\n            stage,\n            brief: brief(job),\n        }],\n    }\n}\n\n/// Wait on a person under the step's dial, or go on at once when it is\n/// dark, or in a trial.\nfn wait(job: &mut Job, bounds: &Bounds) -> Vec<Effect> {\n    let dial = job.step().map_or(Dial::LightsOn, |s| s.dial);\n    if dial == Dial::LightsOn && !bounds.trial {\n        job.state = State::NeedsYou;\n        return Vec::new();\n    }\n    let decided = Effect::DarkDecided { stage: job.stage };\n    std::iter::once(decided)\n        .chain(approved(job, bounds))\n        .collect()\n}\n\n/// A shell step's result, kept as its artifact. Its output is each result\n/// it declares; a failure goes back to be fixed.\nfn shell_ran(job: &mut Job, event: &Event, bounds: &Bounds) -> Vec<Effect> {\n    let (body, effects) = match event {\n        Event::Ran { output } => {\n            for name in job.step().map(|s| s.gives.clone()).unwrap_or_default() {\n                job.results.insert(name, output.clone());\n            }\n            (output.clone(), wait(job, bounds))\n        }\n        Event::StepFailed { detail } => (detail.clone(), step_failed(job, detail, bounds)),\n        Event::StepStuck { detail } => (detail.clone(), stuck(job, detail)),\n        _ => return Vec::new(),\n    };\n    let kept = Effect::RecordArtifact {\n        stage: Stage::Shell,\n        body,\n    };\n    std::iter::once(kept).chain(effects).collect()\n}\n\n/// A failing shell step sends its output back to the nearest agent's step\n/// before it, to fix, up to its limit and the workspace's budget. Past\n/// them, or when the same failure comes back word for word, the job waits\n/// on a person.\nfn step_failed(job: &mut Job, detail: &str, bounds: &Bounds) -> Vec<Effect> {\n    let (Some(fixer), Some(at)) = (job.fixer(), job.node.clone()) else {\n        return stuck(job, detail);\n    };\n    if budget_spent(job, bounds) {\n        let budget = bounds.revision_budget.unwrap_or_default();\n        let spent = format!(\"The revision budget of {budget} is spent.\\n{detail}\");\n        return stuck(job, &spent);\n    }\n    let tries = job.revisions.entry(at).or_default();\n    if *tries >= MAX_REVISIONS || job.last_refusal.as_deref() == Some(detail) {\n        return stuck(job, detail);\n    }\n    *tries += 1;\n    job.last_refusal = Some(detail.into());\n    job.feedback = Some(format!(\n        \"A later step failed. Read its output, fix the cause, and commit.\\n<output>\\n{detail}\\n</output>\"\n    ));\n    job.go_to(fixer);\n    start(job)\n}\n\n/// Whether the job's steps have sent its work back as often as its\n/// workspace allows.\nfn budget_spent(job: &Job, bounds: &Bounds) -> bool {\n    let spent: u32 = job.revisions.values().sum();\n    bounds.revision_budget.is_some_and(|budget| spent >= budget)\n}\n\n/// The job waits on a person at a step that failed: approve goes on\n/// without it, a note sends it back to be fixed.\nfn stuck(job: &mut Job, error: &str) -> Vec<Effect> {\n    job.state = State::NeedsYou;\n    job.error = Some(error.into());\n    Vec::new()\n}\n\n/// A person approved, or the dial is dark: the job goes on.\nfn approved(job: &mut Job, bounds: &Bounds) -> Vec<Effect> {\n    job.feedback = None;\n    job.error = None;\n    advance(job, bounds)\n}\n\n/// The end of a workflow (D41): landed once its branch is merged or left,\n/// or waiting on a person when that failed; approving finishes again.\nfn finished(job: &mut Job, event: &Event) -> Vec<Effect> {\n    match event {\n        Event::LandFailed { error } => stuck(job, error),\n        _ => {\n            job.state = State::Landed;\n            vec![Effect::Teardown]\n        }\n    }\n}\n\n/// Move to the job's next step. Past the last one the job finishes, and a\n/// trial stops instead, so nothing lands.\nfn advance(job: &mut Job, bounds: &Bounds) -> Vec<Effect> {\n    job.last_refusal = None;\n    let next = job.position().map_or(0, |i| i + 1);\n    if next < job.flow.len() {\n        job.go_to(next);\n        return start(job);\n    }\n    if bounds.trial {\n        job.state = State::Stopped;\n        return vec![Effect::Teardown];\n    }\n    job.state = State::Running;\n    vec![Effect::Finish]\n}\n\nfn fail(job: &mut Job, error: &str) -> Vec<Effect> {\n    job.state = State::Failed;\n    job.error = Some(error.into());\n    vec![Effect::Teardown]\n}\n\n/// The results a step must give that `report` lacks (its exit criteria).\nfn missing_results(job: &Job, report: &str) -> Option<String> {\n    let given = results(report);\n    let gives = job.step().map(|s| s.gives.clone()).unwrap_or_default();\n    let missing: Vec<&String> = gives.iter().filter(|n| !given.contains_key(*n)).collect();\n    (!missing.is_empty()).then(|| {\n        let names: Vec<String> = missing.iter().map(|n| format!(\"RESULT {n}:\")).collect();\n        format!(\"End the reply with these results: {}\", names.join(\", \"))\n    })\n}\n\n/// Keep each result the step gives on the job.\nfn keep_results(job: &mut Job, report: &str) {\n    let gives = job.step().map(|s| s.gives.clone()).unwrap_or_default();\n    let mut given = results(report);\n    for name in gives {\n        if let Some(body) = given.remove(&name) {\n            job.results.insert(name, body);\n        }\n    }\n}\n\nfn turn_finished(job: &mut Job, outcome: &Outcome, bounds: &Bounds) -> Vec<Effect> {\n    match outcome {\n        Outcome::Done { report } => match missing_results(job, report) {\n            Some(problem) => {\n                let unusable = Outcome::Unusable {\n                    report: report.clone(),\n                    problem,\n                };\n                turn_finished(job, &unusable, bounds)\n            }\n            None => done(job, report, bounds),\n        },\n        Outcome::Unusable { report, problem } => {\n            job.failures = 0;\n            let kept = Effect::RecordArtifact {\n                stage: job.stage,\n                body: report.clone(),\n            };\n            std::iter::once(kept).chain(bad_reply(job, problem)).collect()\n        }\n        Outcome::Asked { question } => {\n            job.state = State::NeedsYou;\n            job.question = Some(question.clone());\n            Vec::new()\n        }\n        Outcome::Failed { error } => {\n            job.failures += 1;\n            if job.failures >= MAX_TURN_FAILURES {\n                return fail(job, error);\n            }\n            start(job)\n        }\n    }\n}\n\n/// A turn that did its step: its report kept, its change captured unless\n/// it only reads, its results kept, then the dial decides.\nfn done(job: &mut Job, report: &str, bounds: &Bounds) -> Vec<Effect> {\n    job.failures = 0;\n    let mut effects = vec![Effect::RecordArtifact {\n        stage: job.stage,\n        body: report.into(),\n    }];\n    if !job.step().is_some_and(|s| s.reach.reads_only) {\n        effects.push(Effect::CaptureDiff);\n    }\n    keep_results(job, report);\n    job.feedback = None;\n    effects.extend(wait(job, bounds));\n    effects\n}\n\n/// A reply the factory cannot use gets one more try with the reason, then\n/// the job waits on a person, as in wipp.\nfn bad_reply(job: &mut Job, problem: &str) -> Vec<Effect> {\n    let at = job.node.clone().unwrap_or_default();\n    let tries = job.revisions.entry(at).or_default();\n    if *tries >= 1 {\n        return stuck(job, problem);\n    }\n    *tries += 1;\n    job.feedback = Some(format!(\"Your last reply could not be used. {problem}\"));\n    start(job)\n}\n\n/// A note on a step's result sends the work back with it to the nearest\n/// agent's step, to run again from there. An answer goes to the step that\n/// asked.\nfn commented(job: &mut Job, text: &str) -> Vec<Effect> {\n    if let Some(question) = job.question.take() {\n        job.feedback = Some(format!(\"You asked: {question}\\nThe answer: {text}\"));\n        return start(job);\n    }\n    job.error = None;\n    job.feedback = Some(text.into());\n    if let Some(fixer) = job.fixer() {\n        job.go_to(fixer);\n    }\n    start(job)\n}\n\n/// Where one step of a job stands.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum StepState {\n    Done,\n    /// Waiting for a free VM.\n    Queued,\n    Running,\n    /// Waiting on a person.\n    Waiting,\n    Failed,\n    Stopped,\n    /// Not reached yet.\n    Pending,\n}\n\n/// Every step of the job's workflow, in order: its id, its kind and its\n/// state.\npub fn steps(job: &Job) -> Vec<(String, Stage, StepState)> {\n    let current = job.position().unwrap_or(0);\n    let state = |i: usize| match i.cmp(&current) {\n        std::cmp::Ordering::Less => StepState::Done,\n        std::cmp::Ordering::Greater => StepState::Pending,\n        std::cmp::Ordering::Equal => match job.state {\n            State::Queued => StepState::Queued,\n            State::Provisioning | State::Running => StepState::Running,\n            State::NeedsYou => StepState::Waiting,\n            State::Landed => StepState::Done,\n            State::Failed => StepState::Failed,\n            State::Stopped => StepState::Stopped,\n        },\n    };\n    let all = job.flow.iter().enumerate();\n    all.map(|(i, s)| (s.id.clone(), s.stage, state(i))).collect()\n}\n\n/// What a person may do with a job now. A client offers only these.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Action {\n    /// Approve the step the job waits on.\n    Approve,\n    /// A note on the step's result, which sends the work back.\n    Comment,\n    /// Answer the agent's question.\n    Answer,\n    /// Run the failed job, or the stuck step, again.\n    Retry,\n    /// Give the running turn its full cap again.\n    Extend,\n    Stop,\n}\n\npub fn actions(job: &Job) -> Vec<Action> {\n    let mut allowed = match (job.state, job.question.is_some()) {\n        (State::NeedsYou, true) => vec![Action::Answer],\n        (State::NeedsYou, false) => vec![Action::Approve, Action::Comment],\n        _ => Vec::new(),\n    };\n    if retries(job) {\n        allowed.push(Action::Retry);\n    }\n    if extends(job) {\n        allowed.push(Action::Extend);\n    }\n    if !job.state.finished() {\n        allowed.push(Action::Stop);\n    }\n    allowed\n}\n\n/// The queued jobs to admit, oldest first, so that at most `limit` jobs hold\n/// a VM at once, and at most `cap(workspace)` of them in one workspace when\n/// it has a cap.\npub fn admit(jobs: &[Job], limit: usize, cap: impl Fn(&str) -> Option<usize>) -> Vec<String> {\n    let holding: Vec<&Job> = jobs.iter().filter(|j| j.state.holds_vm()).collect();\n    let busy = |w: &str| holding.iter().filter(|j| j.workspace == w).count();\n    let mut free = limit.saturating_sub(holding.len());\n    let mut taken: BTreeMap<&str, usize> = BTreeMap::new();\n    let mut admitted = Vec::new();\n    let mut queued: Vec<&Job> = jobs.iter().filter(|j| j.state == State::Queued).collect();\n    queued.sort_by_key(|j| j.updated_at);\n    for j in queued {\n        let w = j.workspace.as_str();\n        let held = taken.entry(w).or_insert_with(|| busy(w));\n        if free == 0 || cap(w).is_some_and(|c| *held >= c) {\n            continue;\n        }\n        (free, *held) = (free - 1, *held + 1);\n        admitted.push(j.id.clone());\n    }\n    admitted\n}\n\n/// The effects that start a running job's current step again, as after a\n/// restart lost them. None when the job is not running, or when starting\n/// it would move it to another step.\npub fn restart(job: &Job) -> Vec<Effect> {\n    if job.state != State::Running {\n        return Vec::new();\n    }\n    if job.finishing() && job.step().is_some_and(|_| false) {\n        return Vec::new();\n    }\n    let mut again = job.clone();\n    let effects = start(&mut again);\n    match (again.node == job.node, again.state) {\n        (true, State::Running) => effects,\n        _ => Vec::new(),\n    }\n}\n\n#[cfg(test)]\nmod tests;\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":782,"cache_read_input_tokens":811267,"output_tokens":10607,"output_tokens_details":{"thinking_tokens":73},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":782,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":10607,"cache_read_input_tokens":811267,"cache_creation_input_tokens":782,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":782},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01WAeJ5ATiKjoivWca7mt2Nn":{"file_path":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","content":"//! The factory's rules (DECISIONS.md D18). Everything here is a pure\n//! function: an event and the current job go in, the next job and the effects\n//! to run come out. No I/O, no clock, no engine.\n//!\n//! A job runs its workflow's steps in order (D39): an agent's step runs a\n//! turn, a shell step runs a script, and past the last step the job finishes\n//! as its workspace says (D41).\n\npub mod audit;\nmod brief;\npub mod charter;\npub mod escape;\npub mod eval;\npub mod govern;\npub mod media;\npub mod notice;\npub mod people;\npub mod request;\npub mod review;\npub mod settings;\npub mod workflow;\n\nuse std::collections::BTreeMap;\n\nuse serde::{Deserialize, Serialize};\n\npub use brief::{BASE_TAG, QUESTION_MARKER, brief, outcome};\npub use workflow::results;\n\n/// How many failed turns in a row a step gets before the job fails (D16).\npub const MAX_TURN_FAILURES: u32 = 2;\n/// The longest a turn may run before it counts as failed.\npub const TURN_CAP_SECS: u64 = 60 * 60;\n/// How many times one step may send the work back by itself, past which\n/// it waits on a person.\npub const MAX_REVISIONS: u32 = 2;\n\n/// What a workflow's step is (D39).\n#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Stage {\n    /// An agent follows the workflow's instructions for the step.\n    Prompt,\n    /// An agent acts as one of the repository's agents, in `.claude/agents`.\n    Agent,\n    /// An agent follows a skill in the repository.\n    Skill,\n    /// An agent carries out one of the repository's commands, in\n    /// `.claude/commands`.\n    Command,\n    /// A shell script runs in the VM: a one-line CLI command, a script or a\n    /// task runner.\n    Shell,\n}\n\n/// Who runs a step: an agent's turn, or the factory itself.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Kind {\n    Turn,\n    Factory,\n}\n\nimpl Stage {\n    /// Every kind, for the store's checks.\n    pub const ALL: [Stage; 5] = [\n        Stage::Prompt,\n        Stage::Agent,\n        Stage::Skill,\n        Stage::Command,\n        Stage::Shell,\n    ];\n\n    pub fn kind(self) -> Kind {\n        match self {\n            Stage::Shell => Kind::Factory,\n            _ => Kind::Turn,\n        }\n    }\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum State {\n    /// Waiting for a free sandbox.\n    Queued,\n    /// Getting its worktree and VM.\n    Provisioning,\n    /// A step runs, or the job finishes.\n    Running,\n    /// A step's result, or a question, waits on a person.\n    NeedsYou,\n    Landed,\n    Failed,\n    Stopped,\n}\n\nimpl State {\n    pub fn finished(self) -> bool {\n        matches!(self, State::Landed | State::Failed | State::Stopped)\n    }\n\n    /// Holds a sandbox VM.\n    pub fn holds_vm(self) -> bool {\n        !self.finished() && self != State::Queued\n    }\n}\n\n/// One request against one workspace, and where it is in its workflow.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Job {\n    pub id: String,\n    pub workspace: String,\n    pub request: String,\n    /// The current step's kind.\n    pub stage: Stage,\n    pub state: State,\n    /// What the owner must answer while `NeedsYou` holds for a question.\n    pub question: Option<String>,\n    /// The note that becomes the next turn's brief (D16).\n    pub feedback: Option<String>,\n    pub failures: u32,\n    /// Why the job failed, or why a step waits, when it did.\n    pub error: Option<String>,\n    pub updated_at: u64,\n    /// How many times each step has sent the work back, by step id.\n    pub revisions: BTreeMap<String, u32>,\n    /// The last failure that sent the work back. The same one again, word\n    /// for word, means the fix did not help, so the job waits on the owner.\n    pub last_refusal: Option<String>,\n    /// The steps of the workflow the job runs (D39), in order.\n    pub flow: Vec<workflow::Step>,\n    /// The step the job is at, by id.\n    pub node: Option<String>,\n    /// The results its steps gave, by name.\n    pub results: BTreeMap<String, String>,\n}\n\n/// Something that happened to a job.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\", tag = \"kind\")]\npub enum Event {\n    /// A sandbox is free for this queued job.\n    Admitted,\n    Provisioned,\n    ProvisionFailed {\n        error: String,\n    },\n    TurnFinished {\n        outcome: Outcome,\n    },\n    /// A person approved the step the job waits on.\n    Approved,\n    /// A person sent the step's result back with a note, or answered a question.\n    Commented {\n        text: String,\n    },\n    /// The job's branch merged, or was left, as its workspace says (D41).\n    Landed,\n    LandFailed {\n        error: String,\n    },\n    Stopped,\n    /// A shell step passed, with what it printed.\n    Ran {\n        output: String,\n    },\n    /// A shell step failed, with what it printed.\n    StepFailed {\n        detail: String,\n    },\n    /// A step found what only a person can settle; no fix is sent.\n    StepStuck {\n        detail: String,\n    },\n    /// The job's VM is gone, as after its stack restarted. Its commits are\n    /// in the worktree, so a new VM picks the job up where it was (revive).\n    VmLost,\n    /// A person asked to run a failed job, or a stuck step, again.\n    Retried,\n    /// A person gave the running turn its full cap again, from now.\n    Extended,\n}\n\n/// Whether a person oversees a step (D33). Stored `ask` and `hold` read as\n/// lights-on, and `auto` as dark.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Dial {\n    /// The step waits for a person to approve its result or send it back.\n    #[default]\n    #[serde(alias = \"ask\", alias = \"hold\")]\n    LightsOn,\n    /// The step goes on at once.\n    #[serde(alias = \"auto\")]\n    Dark,\n}\n\n/// How much of a workflow a person oversees, as its steps' dials make it:\n/// a gate at every step, at some, or at none.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Level {\n    LightsOn,\n    Dim,\n    Dark,\n}\n\n/// What bounds one job's run beyond its workflow.\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct Bounds {\n    /// An eval's run: every step goes on at once, and it stops before its\n    /// finish, so nothing lands.\n    pub trial: bool,\n    /// How many times in all the job's steps may send its work back by\n    /// themselves; past it, a failing step waits on the owner. It comes from\n    /// the job's workspace.\n    pub revision_budget: Option<u32>,\n}\n\n/// How an agent turn ended.\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\", tag = \"kind\")]\npub enum Outcome {\n    /// The turn finished its step, with the text it reported.\n    Done { report: String },\n    /// The agent stopped with a question for the owner.\n    Asked { question: String },\n    /// The turn failed, or ran past the cap.\n    Failed { error: String },\n    /// The turn replied, but not with what its step asked for, such as a\n    /// result it must give.\n    Unusable { report: String, problem: String },\n}\n\n/// What the adapter must do after a step. Effects are data; the core never\n/// waits on one (§6.1).\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\", tag = \"kind\")]\npub enum Effect {\n    /// Make the job's worktree and VM, and put its code in the VM.\n    Provision,\n    StartTurn {\n        stage: Stage,\n        brief: String,\n    },\n    /// Keep a step's report or output as its artifact.\n    RecordArtifact {\n        stage: Stage,\n        body: String,\n    },\n    /// Keep the change against its base as an artifact, and review it.\n    CaptureDiff,\n    /// Run a shell step, then send `Ran`, `StepFailed` or `StepStuck`.\n    RunStep {\n        stage: Stage,\n    },\n    /// The workflow's last step passed: bring the VM's commits back, then\n    /// merge them or leave the branch, as the workspace says (D41).\n    Finish,\n    /// Stop the VM and release the worktree.\n    Teardown,\n    /// A dark step went on with no person (D33): note it in the audit log.\n    DarkDecided {\n        stage: Stage,\n    },\n}\n\nimpl Job {\n    pub fn new(id: String, workspace: String, request: String, at: u64) -> Self {\n        Job {\n            id,\n            workspace,\n            request,\n            stage: Stage::Prompt,\n            state: State::Queued,\n            question: None,\n            feedback: None,\n            failures: 0,\n            error: None,\n            updated_at: at,\n            revisions: BTreeMap::new(),\n            last_refusal: None,\n            flow: Vec::new(),\n            node: None,\n            results: BTreeMap::new(),\n        }\n    }\n\n    /// The step the job is at.\n    pub fn step(&self) -> Option<&workflow::Step> {\n        let at = self.node.as_deref()?;\n        self.flow.iter().find(|s| s.id == at)\n    }\n\n    /// The job on a workflow's steps, at its first step.\n    pub fn running(mut self, flow: Vec<workflow::Step>) -> Self {\n        if let Some(first) = flow.first() {\n            self.stage = first.stage;\n            self.node = Some(first.id.clone());\n        }\n        self.flow = flow;\n        self\n    }\n\n    fn position(&self) -> Option<usize> {\n        let at = self.node.as_ref()?;\n        self.flow.iter().position(|s| &s.id == at)\n    }\n\n    /// Move to step `i` of the workflow.\n    fn go_to(&mut self, i: usize) {\n        let step = &self.flow[i];\n        (self.stage, self.node) = (step.stage, Some(step.id.clone()));\n        self.failures = 0;\n    }\n\n    /// The nearest agent's step at or before this one, which a failing or\n    /// sent-back step's work goes back to.\n    fn fixer(&self) -> Option<usize> {\n        let at = self.position()?;\n        (0..=at)\n            .rev()\n            .find(|&i| self.flow[i].stage.kind() == Kind::Turn && !self.flow[i].reach.reads_only)\n    }\n}\n\n/// Apply one event to one job. An event that does not fit the job's state\n/// changes nothing and returns no effects.\npub fn step(job: &Job, event: &Event, at: u64, bounds: &Bounds) -> (Job, Vec<Effect>) {\n    let mut next = job.clone();\n    next.updated_at = at;\n    let effects = match (job.state, event) {\n        (_, Event::Retried | Event::Extended) => match by_person(&mut next, event) {\n            Some(effects) => effects,\n            None => return (job.clone(), Vec::new()),\n        },\n        (state, _) if state.finished() => return (job.clone(), Vec::new()),\n        (_, Event::Stopped) => {\n            next.state = State::Stopped;\n            vec![Effect::Teardown]\n        }\n        (State::Queued, Event::Admitted) => {\n            next.state = State::Provisioning;\n            vec![Effect::Provision]\n        }\n        (State::Provisioning, Event::Provisioned) => start(&mut next),\n        (State::Provisioning, Event::ProvisionFailed { error }) => fail(&mut next, error),\n        (State::Running, Event::TurnFinished { outcome }) if job.stage.kind() == Kind::Turn => {\n            turn_finished(&mut next, outcome, bounds)\n        }\n        (State::NeedsYou, Event::Approved) if job.question.is_none() => {\n            approved(&mut next, bounds)\n        }\n        (State::NeedsYou, Event::Commented { text }) => commented(&mut next, text),\n        (State::Running, Event::VmLost) => revive(&mut next),\n        (State::Running, Event::Landed | Event::LandFailed { .. }) if job.finishing() => {\n            finished(&mut next, event)\n        }\n        (State::Running, Event::Ran { .. } | Event::StepFailed { .. } | Event::StepStuck { .. })\n            if job.stage == Stage::Shell =>\n        {\n            shell_ran(&mut next, event, bounds)\n        }\n        _ => return (job.clone(), Vec::new()),\n    };\n    (next, effects)\n}\n\nimpl Job {\n    /// Past its last step, waiting for its branch to merge or be left.\n    fn finishing(&self) -> bool {\n        self.position().is_some_and(|i| i + 1 == self.flow.len())\n    }\n}\n\n/// How many times in a row a job may lose its VM before it fails.\npub const MAX_REVIVES: u32 = 2;\n\n/// Give the job a new VM, which starts its step again once provisioned. A\n/// VM that keeps dying fails the job rather than looping.\nfn revive(job: &mut Job) -> Vec<Effect> {\n    job.failures += 1;\n    if job.failures > MAX_REVIVES {\n        return fail(job, \"the job's VM was lost again after a revive\");\n    }\n    job.state = State::Provisioning;\n    vec![Effect::Provision]\n}\n\n/// A person's retry or extend. `None` means it does not fit, and nothing\n/// changes.\nfn by_person(job: &mut Job, event: &Event) -> Option<Vec<Effect>> {\n    match event {\n        Event::Retried if job.state == State::Failed => {\n            job.state = State::Queued;\n            job.error = None;\n            job.failures = 0;\n            Some(Vec::new())\n        }\n        Event::Retried if retries(job) => {\n            job.error = None;\n            Some(start(job))\n        }\n        // The cap counts from `updated_at`, which `step` moved to now.\n        Event::Extended if extends(job) => Some(Vec::new()),\n        _ => None,\n    }\n}\n\n/// Whether the job runs a turn a person may give more time.\nfn extends(job: &Job) -> bool {\n    job.state == State::Running && job.stage.kind() == Kind::Turn\n}\n\n/// Whether a person may run the step the job waits on again: it failed, or\n/// it is stuck.\nfn retries(job: &Job) -> bool {\n    job.state == State::Failed\n        || (job.state == State::NeedsYou && job.error.is_some() && job.question.is_none())\n}\n\n/// Run the current step, once its entry criteria hold: every result\n/// linked into it exists (D35).\nfn start(job: &mut Job) -> Vec<Effect> {\n    job.question = None;\n    let needs = job.step().map(|s| s.needs.clone()).unwrap_or_default();\n    if let Some(missing) = needs.iter().find(|n| !job.results.contains_key(*n)) {\n        return stuck(\n            job,\n            &format!(\"This step needs the result {missing}, which no step gave.\"),\n        );\n    }\n    job.state = State::Running;\n    match job.stage {\n        Stage::Shell => vec![Effect::RunStep { stage: Stage::Shell }],\n        stage => vec![Effect::StartTurn {\n            stage,\n            brief: brief(job),\n        }],\n    }\n}\n\n/// Wait on a person under the step's dial, or go on at once when it is\n/// dark, or in a trial.\nfn wait(job: &mut Job, bounds: &Bounds) -> Vec<Effect> {\n    let dial = job.step().map_or(Dial::LightsOn, |s| s.dial);\n    if dial == Dial::LightsOn && !bounds.trial {\n        job.state = State::NeedsYou;\n        return Vec::new();\n    }\n    let decided = Effect::DarkDecided { stage: job.stage };\n    std::iter::once(decided)\n        .chain(approved(job, bounds))\n        .collect()\n}\n\n/// A shell step's result, kept as its artifact. Its output is each result\n/// it declares; a failure goes back to be fixed.\nfn shell_ran(job: &mut Job, event: &Event, bounds: &Bounds) -> Vec<Effect> {\n    let (body, effects) = match event {\n        Event::Ran { output } => {\n            for name in job.step().map(|s| s.gives.clone()).unwrap_or_default() {\n                job.results.insert(name, output.clone());\n            }\n            (output.clone(), wait(job, bounds))\n        }\n        Event::StepFailed { detail } => (detail.clone(), step_failed(job, detail, bounds)),\n        Event::StepStuck { detail } => (detail.clone(), stuck(job, detail)),\n        _ => return Vec::new(),\n    };\n    let kept = Effect::RecordArtifact {\n        stage: Stage::Shell,\n        body,\n    };\n    std::iter::once(kept).chain(effects).collect()\n}\n\n/// A failing shell step sends its output back to the nearest agent's step\n/// before it, to fix, up to its limit and the workspace's budget. Past\n/// them, or when the same failure comes back word for word, the job waits\n/// on a person.\nfn step_failed(job: &mut Job, detail: &str, bounds: &Bounds) -> Vec<Effect> {\n    let (Some(fixer), Some(at)) = (job.fixer(), job.node.clone()) else {\n        return stuck(job, detail);\n    };\n    if budget_spent(job, bounds) {\n        let budget = bounds.revision_budget.unwrap_or_default();\n        let spent = format!(\"The revision budget of {budget} is spent.\\n{detail}\");\n        return stuck(job, &spent);\n    }\n    let tries = job.revisions.entry(at).or_default();\n    if *tries >= MAX_REVISIONS || job.last_refusal.as_deref() == Some(detail) {\n        return stuck(job, detail);\n    }\n    *tries += 1;\n    job.last_refusal = Some(detail.into());\n    job.feedback = Some(format!(\n        \"A later step failed. Read its output, fix the cause, and commit.\\n<output>\\n{detail}\\n</output>\"\n    ));\n    job.go_to(fixer);\n    start(job)\n}\n\n/// Whether the job's steps have sent its work back as often as its\n/// workspace allows.\nfn budget_spent(job: &Job, bounds: &Bounds) -> bool {\n    let spent: u32 = job.revisions.values().sum();\n    bounds.revision_budget.is_some_and(|budget| spent >= budget)\n}\n\n/// The job waits on a person at a step that failed: approve goes on\n/// without it, a note sends it back to be fixed.\nfn stuck(job: &mut Job, error: &str) -> Vec<Effect> {\n    job.state = State::NeedsYou;\n    job.error = Some(error.into());\n    Vec::new()\n}\n\n/// A person approved, or the dial is dark: the job goes on.\nfn approved(job: &mut Job, bounds: &Bounds) -> Vec<Effect> {\n    job.feedback = None;\n    job.error = None;\n    advance(job, bounds)\n}\n\n/// The end of a workflow (D41): landed once its branch is merged or left,\n/// or waiting on a person when that failed; approving finishes again.\nfn finished(job: &mut Job, event: &Event) -> Vec<Effect> {\n    match event {\n        Event::LandFailed { error } => stuck(job, error),\n        _ => {\n            job.state = State::Landed;\n            vec![Effect::Teardown]\n        }\n    }\n}\n\n/// Move to the job's next step. Past the last one the job finishes, and a\n/// trial stops instead, so nothing lands.\nfn advance(job: &mut Job, bounds: &Bounds) -> Vec<Effect> {\n    job.last_refusal = None;\n    let next = job.position().map_or(0, |i| i + 1);\n    if next < job.flow.len() {\n        job.go_to(next);\n        return start(job);\n    }\n    if bounds.trial {\n        job.state = State::Stopped;\n        return vec![Effect::Teardown];\n    }\n    job.state = State::Running;\n    vec![Effect::Finish]\n}\n\nfn fail(job: &mut Job, error: &str) -> Vec<Effect> {\n    job.state = State::Failed;\n    job.error = Some(error.into());\n    vec![Effect::Teardown]\n}\n\n/// The results a step must give that `report` lacks (its exit criteria).\nfn missing_results(job: &Job, report: &str) -> Option<String> {\n    let given = results(report);\n    let gives = job.step().map(|s| s.gives.clone()).unwrap_or_default();\n    let missing: Vec<&String> = gives.iter().filter(|n| !given.contains_key(*n)).collect();\n    (!missing.is_empty()).then(|| {\n        let names: Vec<String> = missing.iter().map(|n| format!(\"RESULT {n}:\")).collect();\n        format!(\"End the reply with these results: {}\", names.join(\", \"))\n    })\n}\n\n/// Keep each result the step gives on the job.\nfn keep_results(job: &mut Job, report: &str) {\n    let gives = job.step().map(|s| s.gives.clone()).unwrap_or_default();\n    let mut given = results(report);\n    for name in gives {\n        if let Some(body) = given.remove(&name) {\n            job.results.insert(name, body);\n        }\n    }\n}\n\nfn turn_finished(job: &mut Job, outcome: &Outcome, bounds: &Bounds) -> Vec<Effect> {\n    match outcome {\n        Outcome::Done { report } => match missing_results(job, report) {\n            Some(problem) => {\n                let unusable = Outcome::Unusable {\n                    report: report.clone(),\n                    problem,\n                };\n                turn_finished(job, &unusable, bounds)\n            }\n            None => done(job, report, bounds),\n        },\n        Outcome::Unusable { report, problem } => {\n            job.failures = 0;\n            let kept = Effect::RecordArtifact {\n                stage: job.stage,\n                body: report.clone(),\n            };\n            std::iter::once(kept).chain(bad_reply(job, problem)).collect()\n        }\n        Outcome::Asked { question } => {\n            job.state = State::NeedsYou;\n            job.question = Some(question.clone());\n            Vec::new()\n        }\n        Outcome::Failed { error } => {\n            job.failures += 1;\n            if job.failures >= MAX_TURN_FAILURES {\n                return fail(job, error);\n            }\n            start(job)\n        }\n    }\n}\n\n/// A turn that did its step: its report kept, its change captured unless\n/// it only reads, its results kept, then the dial decides.\nfn done(job: &mut Job, report: &str, bounds: &Bounds) -> Vec<Effect> {\n    job.failures = 0;\n    let mut effects = vec![Effect::RecordArtifact {\n        stage: job.stage,\n        body: report.into(),\n    }];\n    if !job.step().is_some_and(|s| s.reach.reads_only) {\n        effects.push(Effect::CaptureDiff);\n    }\n    keep_results(job, report);\n    job.feedback = None;\n    effects.extend(wait(job, bounds));\n    effects\n}\n\n/// A reply the factory cannot use gets one more try with the reason, then\n/// the job waits on a person, as in wipp.\nfn bad_reply(job: &mut Job, problem: &str) -> Vec<Effect> {\n    let at = job.node.clone().unwrap_or_default();\n    let tries = job.revisions.entry(at).or_default();\n    if *tries >= 1 {\n        return stuck(job, problem);\n    }\n    *tries += 1;\n    job.feedback = Some(format!(\"Your last reply could not be used. {problem}\"));\n    start(job)\n}\n\n/// A note on a step's result sends the work back with it to the nearest\n/// agent's step, to run again from there. An answer goes to the step that\n/// asked.\nfn commented(job: &mut Job, text: &str) -> Vec<Effect> {\n    if let Some(question) = job.question.take() {\n        job.feedback = Some(format!(\"You asked: {question}\\nThe answer: {text}\"));\n        return start(job);\n    }\n    job.error = None;\n    job.feedback = Some(text.into());\n    if let Some(fixer) = job.fixer() {\n        job.go_to(fixer);\n    }\n    start(job)\n}\n\n/// Where one step of a job stands.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum StepState {\n    Done,\n    /// Waiting for a free VM.\n    Queued,\n    Running,\n    /// Waiting on a person.\n    Waiting,\n    Failed,\n    Stopped,\n    /// Not reached yet.\n    Pending,\n}\n\n/// Every step of the job's workflow, in order: its id, its kind and its\n/// state.\npub fn steps(job: &Job) -> Vec<(String, Stage, StepState)> {\n    let current = job.position().unwrap_or(0);\n    let state = |i: usize| match i.cmp(&current) {\n        std::cmp::Ordering::Less => StepState::Done,\n        std::cmp::Ordering::Greater => StepState::Pending,\n        std::cmp::Ordering::Equal => match job.state {\n            State::Queued => StepState::Queued,\n            State::Provisioning | State::Running => StepState::Running,\n            State::NeedsYou => StepState::Waiting,\n            State::Landed => StepState::Done,\n            State::Failed => StepState::Failed,\n            State::Stopped => StepState::Stopped,\n        },\n    };\n    let all = job.flow.iter().enumerate();\n    all.map(|(i, s)| (s.id.clone(), s.stage, state(i))).collect()\n}\n\n/// What a person may do with a job now. A client offers only these.\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Action {\n    /// Approve the step the job waits on.\n    Approve,\n    /// A note on the step's result, which sends the work back.\n    Comment,\n    /// Answer the agent's question.\n    Answer,\n    /// Run the failed job, or the stuck step, again.\n    Retry,\n    /// Give the running turn its full cap again.\n    Extend,\n    Stop,\n}\n\npub fn actions(job: &Job) -> Vec<Action> {\n    let mut allowed = match (job.state, job.question.is_some()) {\n        (State::NeedsYou, true) => vec![Action::Answer],\n        (State::NeedsYou, false) => vec![Action::Approve, Action::Comment],\n        _ => Vec::new(),\n    };\n    if retries(job) {\n        allowed.push(Action::Retry);\n    }\n    if extends(job) {\n        allowed.push(Action::Extend);\n    }\n    if !job.state.finished() {\n        allowed.push(Action::Stop);\n    }\n    allowed\n}\n\n/// The queued jobs to admit, oldest first, so that at most `limit` jobs hold\n/// a VM at once, and at most `cap(workspace)` of them in one workspace when\n/// it has a cap.\npub fn admit(jobs: &[Job], limit: usize, cap: impl Fn(&str) -> Option<usize>) -> Vec<String> {\n    let holding: Vec<&Job> = jobs.iter().filter(|j| j.state.holds_vm()).collect();\n    let busy = |w: &str| holding.iter().filter(|j| j.workspace == w).count();\n    let mut free = limit.saturating_sub(holding.len());\n    let mut taken: BTreeMap<&str, usize> = BTreeMap::new();\n    let mut admitted = Vec::new();\n    let mut queued: Vec<&Job> = jobs.iter().filter(|j| j.state == State::Queued).collect();\n    queued.sort_by_key(|j| j.updated_at);\n    for j in queued {\n        let w = j.workspace.as_str();\n        let held = taken.entry(w).or_insert_with(|| busy(w));\n        if free == 0 || cap(w).is_some_and(|c| *held >= c) {\n            continue;\n        }\n        (free, *held) = (free - 1, *held + 1);\n        admitted.push(j.id.clone());\n    }\n    admitted\n}\n\n/// The effects that start a running job's current step again, as after a\n/// restart lost them. None when the job is not running, or when starting\n/// it would move it to another step.\npub fn restart(job: &Job) -> Vec<Effect> {\n    if job.state != State::Running {\n        return Vec::new();\n    }\n    if job.finishing() && job.step().is_some_and(|_| false) {\n        return Vec::new();\n    }\n    let mut again = job.clone();\n    let effects = start(&mut again);\n    match (again.node == job.node, again.state) {\n        (true, State::Running) => effects,\n        _ => Vec::new(),\n    }\n}\n\n#[cfg(test)]\nmod tests;\n"}},"serverClassifierRequest":"a07d1cd2-90c5-4726-901f-72a830391290","apiBlockIndex":1,"requestId":"req_011CgwqDLbw3rsfTmKaENKaz","type":"assistant","uuid":"378d9e5d-b987-40dd-8153-ae8407b21389","timestamp":"2026-11-11T21:15:23.396Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
