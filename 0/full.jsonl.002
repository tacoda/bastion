X_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' pre-tool-use 3>&1 1>&2; else cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi","durationMs":62},"type":"attachment","uuid":"29aafba4-c85e-4ba2-8920-a04f8af965c1","timestamp":"2026-11-11T03:41:39.330Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"ad7aeb2e-c537-4500-86f5-98039763ef27","isSidechain":false,"promptId":"7c304424-caf5-48fd-bfdc-5e1da322b9a0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Non46t7cEfpTAk6o2qjF5y","type":"tool_result","content":"<section>\n  <h1>A software factory with a built-in oversight dial.</h1>\n  <p class=\"lede\">Give Bastion a request. Agents work it through a pipeline in a sandbox, and you choose how closely to watch each step, merge included. It's early, and the full pipeline is still in progress.</p>\n  <p class=\"facts\">Rust · Tauri 2 + Leptos · on <a href=\"https://iii.dev\">iii</a> 0.25.0 · macOS and Linux</p>\n  <div class=\"cta\">\n    <a class=\"btn primary\" href=\"#start\">Get started</a>\n    <a class=\"btn\" href=\"https://github.com/tacoda/bastion\">Source</a>\n  </div>\n\n  <div class=\"kanban\" aria-label=\"Illustration of the Jobs page\">\n    <div class=\"col\">\n      <h3><span>Waiting for you</span><span>2</span></h3>\n      <div class=\"card blocked\"><span class=\"t\">divide: guard against zero</span><span class=\"badge b-needs\">plan</span><span class=\"m\">local · demo-a · plan ready</span></div>\n      <div class=\"card blocked\"><span class=\"t\">close issue #1</span><span class=\"badge b-needs\">land</span><span class=\"m\">local · ianparo/bastion · CI green</span></div>\n    </div>\n    <div class=\"col\">\n      <h3><span>In progress</span><span>2</span></h3>\n      <div class=\"card running\"><span class=\"t\">count lines with wc</span><span class=\"badge b-run\">build</span><span class=\"m\">two · demo-b · turn 3</span></div>\n      <div class=\"card running\"><span class=\"t\">subtract: add a docstring</span><span class=\"badge b-run\">review</span><span class=\"m\">local · demo-a · 2 line comments</span></div>\n    </div>\n    <div class=\"col\">\n      <h3><span>Finished</span><span>2</span></h3>\n      <div class=\"card\"><span class=\"t\">multiply</span><span class=\"badge b-fail\">stopped</span><span class=\"m\">local · demo-a · VM gone</span></div>\n      <div class=\"card\"><span class=\"t\">subtract</span><span class=\"badge b-done\">landed</span><span class=\"m\">local · demo-a · 0e30e2f</span></div>\n    </div>\n  </div>\n  <p class=\"caption\">An illustration of the Jobs page. The jobs that wait on you come first.</p>\n</section>\n\n<section id=\"problem\">\n  <h2>The problem</h2>\n  <p class=\"title\">Agents write code fast. Trusting what they wrote is the slow part.</p>\n  <div class=\"grid\">\n    <div class=\"panel bad\"><h3>The report isn't the work</h3><p>An agent can say it finished work that its commits don't hold. The gap shows up in the diff, if anyone reads it.</p></div>\n    <div class=\"panel bad\"><h3>Rules in a prompt drift</h3><p>A prompt can say \"keep the tests,\" but nothing measures whether the agent listened. So there's no way to tell if a stricter rule helps or only costs more.</p></div>\n    <div class=\"panel bad\"><h3>The agent holds your keys</h3><p>An agent that can push and merge has your credentials in its run. And a run that has seen a credential can't be trusted again.</p></div>\n    <div class=\"panel bad\"><h3>Sessions don't add up</h3><p>Five agents in five terminals is five things to watch, and nothing says which one is waiting.</p></div>\n  </div>\n</section>\n\n<section>\n  <h2>The solution</h2>\n  <p class=\"title\">Treat each request as a job, and keep every decision that matters with you.</p>\n  <div class=\"grid\">\n    <div class=\"panel ok\"><h3>One board for every job</h3><p>Each request becomes a job with its own worktree and sandbox VM. The Jobs page shows them all, with the ones waiting on you first.</p></div>\n    <div class=\"panel ok\"><h3>You judge artifacts, not claims</h3><p>Every stage leaves something you can check, such as a plan, a test result, or a diff. A comment on one goes to the agent as its next brief.</p></div>\n    <div class=\"panel ok\"><h3>Rules you can measure</h3><p>Every rule is a hook decision with a level: told, checked, or enforced. Run an eval to see what a stricter level does before you commit to it.</p></div>\n    <div class=\"panel ok\"><h3>Keys stay out of the sandbox</h3><p>Agents run in sandbox VMs that never see a credential. Pushes and pull requests happen on the host, and a tamper-evident log records every decision.</p></div>\n  </div>\n</section>\n\n<section id=\"oversight\">\n  <h2>The oversight dial</h2>\n  <p class=\"title\">Start with the lights on. Turn them off one step at a time.</p>\n  <p>A new factory waits after every step for you to approve its result or send it back with a note. Each step has its own dial, so as you trust a step more, you turn that one dark and leave the rest alone. A dark step goes on at once. Nothing waits on a timer, and every result and decision goes in the log whatever the dial says.</p>\n  <div class=\"dials\" aria-label=\"Illustration of step dials\">\n    <div class=\"dial\"><div class=\"who\">plan<span>trusted after many plans</span></div><div class=\"lvl\"><span>lights-on</span><span class=\"on\">dark</span></div></div>\n    <div class=\"dial\"><div class=\"who\">define<span>your checks, mostly trusted</span></div><div class=\"lvl\"><span>lights-on</span><span class=\"on\">dark</span></div></div>\n    <div class=\"dial\"><div class=\"who\">build<span>still reading every diff</span></div><div class=\"lvl\"><span class=\"on light\">lights-on</span><span>dark</span></div></div>\n    <div class=\"dial\"><div class=\"who\">merge<span>still deciding every merge</span></div><div class=\"lvl\"><span class=\"on light\">lights-on</span><span>dark</span></div></div>\n    <div class=\"level\">workflow level: <b>dim</b> · at least one step up to the merge waits for a person</div>\n  </div>\n  <p class=\"caption\">An illustration. Three presets set every dial at once: lights-on (every step), dim (only the steps that act outside the job), and dark (no step).</p>\n</section>\n\n<section id=\"ladder\">\n  <h2>The ladder</h2>\n  <p class=\"title\">Tighten a rule one rung at a time, and keep the record.</p>\n  <p>Every rule sits on a ladder. A constraint says what a turn must or must not do. A capability says which function a turn may call. Promote one and a hook holds the agent to more; demote it and the hook holds less. Each move is one rung, and the audit log records it, along with the eval you acted on.</p>\n  <div class=\"dials\" aria-label=\"Illustration of a constraint and a capability on their ladders\">\n    <div class=\"dial\"><div class=\"who\">constraint · tests-kept<span>told: in the brief · checked: a hook records the breach · enforced: a hook refuses</span></div><div class=\"lvl\"><span>told</span><span>checked</span><span class=\"on\">enforced</span></div></div>\n    <div class=\"dial\"><div class=\"who\">capability · write at plan<span>ask: the call waits for you to allow it once, send feedback, or stop the job</span></div><div class=\"lvl\"><span>denied</span><span class=\"on light\">ask</span><span>allowed</span></div></div>\n  </div>\n  <p class=\"caption\">From a recorded run: with <code>tests-kept</code> enforced, a build that dropped <code>test_add</code> went back to build with the rule. At checked, the same finding waited for a person.</p>\n</section>\n\n<section id=\"evals\">\n  <h2>A/B evals</h2>\n  <p class=\"title\">Try a stricter rule on real requests before you keep it.</p>\n  <p>An eval runs the same requests twice against the same workspace snapshot: arm A with your current rules and arm B with one change. Each trial stops at review with its diff, so nothing lands. A judge grades every result, and the Evals page shows the difference per request, with a link to each hook decision behind it.</p>\n  <p>If B wins, Apply B moves the rule to B's rung. The audit log records the move and the eval you acted on.</p>\n  <table aria-label=\"A recorded eval\">\n    <tr><th></th><th>A · no-wc told</th><th>B · no-wc enforced</th></tr>\n    <tr><td>refused calls</td><td>0</td><td class=\"b\">5</td></tr>\n    <tr><td>review findings</td><td>2</td><td class=\"b\">0</td></tr>\n    <tr><td>turns</td><td>39</td><td class=\"b\">28</td></tr>\n    <tr><td>tool calls</td><td>33</td><td class=\"b\">17</td></tr>\n    <tr><td>cost</td><td>$0.0344</td><td class=\"b\">$0.0207</td></tr>\n    <tr><td>grade</td><td>7</td><td>7</td></tr>\n  </table>\n  <p class=\"caption\">A recorded eval of three requests that each ask for a <code>wc</code> count. Three requests is a small run, so read it as one result, not a benchmark. Today an arm changes rule rungs. Changing the model per step or the workflow is planned.</p>\n</section>\n\n<section id=\"workflows\">\n  <h2>Custom workflows</h2>\n  <p class=\"title\">Run the pipeline your team already uses.</p>\n  <p>A workflow is a graph of steps. Each step is a skill, a prompt, a command, or a built-in Bastion stage. Skills come first: a skill step is an agent turn that follows <code>.claude/skills/&lt;name&gt;/SKILL.md</code> from your repository. A command step runs one shell line in the job's VM, such as <code>make test</code>, with no agent, and exit 0 passes.</p>\n  <p>Links carry results, not conditions. A step declares what it gives, such as <code>design-notes</code>, and the next step gets it in its brief. If a result is missing, a code check holds the step: the agent gets one more try with the reason, then the job waits for a person. Every step keeps its own dial.</p>\n  <div class=\"wf\" aria-label=\"Illustration of a custom workflow\">\n    <div class=\"step\"><span>skill</span>plan</div><span class=\"link res\">design-notes →</span>\n    <div class=\"step\"><span>skill</span>build</div><span class=\"link\">→</span>\n    <div class=\"step\"><span>command</span>make test</div><span class=\"link\">→</span>\n    <div class=\"step\"><span>stage</span>code review</div><span class=\"link\">→</span>\n    <div class=\"step\"><span>stage</span>merge</div>\n  </div>\n  <p class=\"caption\">An illustration. Bastion ships three workflows (short, full, and full without acceptance tests). Copy one to make your own, and each job keeps the version it started on. An admin edits workflows, and everyone else picks one per request. The workflow model and its API are built; the canvas for editing them is in progress.</p>\n</section>\n\n<section id=\"use-cases\">\n  <h2>Use cases</h2>\n  <p class=\"title\">What you'd hand to Bastion this week.</p>\n  <div class=\"cases\">\n    <div class=\"case\">\n      <div><span class=\"k\">Issue to pull request</span><h3>Clear small tickets from your backlog</h3><p>Start a job from a GitHub issue. Bastion opens the pull request and links it back. If CI fails, Bastion sends the agent one more turn with the failing log. When you approve the merge, the issue closes.</p></div>\n      <div class=\"flow\"><span class=\"step done\">issue #1</span><span class=\"step done\">plan</span><span class=\"step done\">build</span><span class=\"step done\">PR #2</span><span class=\"step lit\">CI fix</span><span class=\"step\">merge</span></div>\n    </div>\n    <div class=\"case\">\n      <div><span class=\"k\">Review by diff</span><h3>Steer the work with line comments</h3><p>Read the proposed diff and leave a comment on a line. The agent gets it word for word, and the next diff answers it, with no chat window.</p></div>\n      <pre><span class=\"dl hunk\">calc.py:5 · \"raise on zero\"</span><span class=\"dl del\">-    return a / b</span><span class=\"dl add\">+    if b == 0:</span><span class=\"dl add\">+        raise ZeroDivisionError(\"b is zero\")</span><span class=\"dl add\">+    return a / b</span></pre>\n    </div>\n    <div class=\"case\">\n      <div><span class=\"k\">Your rules, enforced</span><h3>Hold agents to your repository's charter</h3><p>Bastion reads the rules and hooks your repository already has in <code>.claude/settings.json</code>. So a hook that refuses <code>rm</code> refuses it inside the sandbox too.</p></div>\n      <div class=\"note\"><b>refused</b> · <code>rm -f /work/repo/notes.txt</code><br><span>PreToolUse hook · exit 2</span></div>\n    </div>\n  </div>\n  <p class=\"caption\">The diff is an illustration. The refused call comes from a recorded run.</p>\n</section>","is_error":false}]},"uuid":"7ba8876a-5261-4142-b8d9-b6c27d1034c7","timestamp":"2026-11-11T03:41:39.462Z","toolUseResult":{"stdout":"<section>\n  <h1>A software factory with a built-in oversight dial.</h1>\n  <p class=\"lede\">Give Bastion a request. Agents work it through a pipeline in a sandbox, and you choose how closely to watch each step, merge included. It's early, and the full pipeline is still in progress.</p>\n  <p class=\"facts\">Rust · Tauri 2 + Leptos · on <a href=\"https://iii.dev\">iii</a> 0.25.0 · macOS and Linux</p>\n  <div class=\"cta\">\n    <a class=\"btn primary\" href=\"#start\">Get started</a>\n    <a class=\"btn\" href=\"https://github.com/tacoda/bastion\">Source</a>\n  </div>\n\n  <div class=\"kanban\" aria-label=\"Illustration of the Jobs page\">\n    <div class=\"col\">\n      <h3><span>Waiting for you</span><span>2</span></h3>\n      <div class=\"card blocked\"><span class=\"t\">divide: guard against zero</span><span class=\"badge b-needs\">plan</span><span class=\"m\">local · demo-a · plan ready</span></div>\n      <div class=\"card blocked\"><span class=\"t\">close issue #1</span><span class=\"badge b-needs\">land</span><span class=\"m\">local · ianparo/bastion · CI green</span></div>\n    </div>\n    <div class=\"col\">\n      <h3><span>In progress</span><span>2</span></h3>\n      <div class=\"card running\"><span class=\"t\">count lines with wc</span><span class=\"badge b-run\">build</span><span class=\"m\">two · demo-b · turn 3</span></div>\n      <div class=\"card running\"><span class=\"t\">subtract: add a docstring</span><span class=\"badge b-run\">review</span><span class=\"m\">local · demo-a · 2 line comments</span></div>\n    </div>\n    <div class=\"col\">\n      <h3><span>Finished</span><span>2</span></h3>\n      <div class=\"card\"><span class=\"t\">multiply</span><span class=\"badge b-fail\">stopped</span><span class=\"m\">local · demo-a · VM gone</span></div>\n      <div class=\"card\"><span class=\"t\">subtract</span><span class=\"badge b-done\">landed</span><span class=\"m\">local · demo-a · 0e30e2f</span></div>\n    </div>\n  </div>\n  <p class=\"caption\">An illustration of the Jobs page. The jobs that wait on you come first.</p>\n</section>\n\n<section id=\"problem\">\n  <h2>The problem</h2>\n  <p class=\"title\">Agents write code fast. Trusting what they wrote is the slow part.</p>\n  <div class=\"grid\">\n    <div class=\"panel bad\"><h3>The report isn't the work</h3><p>An agent can say it finished work that its commits don't hold. The gap shows up in the diff, if anyone reads it.</p></div>\n    <div class=\"panel bad\"><h3>Rules in a prompt drift</h3><p>A prompt can say \"keep the tests,\" but nothing measures whether the agent listened. So there's no way to tell if a stricter rule helps or only costs more.</p></div>\n    <div class=\"panel bad\"><h3>The agent holds your keys</h3><p>An agent that can push and merge has your credentials in its run. And a run that has seen a credential can't be trusted again.</p></div>\n    <div class=\"panel bad\"><h3>Sessions don't add up</h3><p>Five agents in five terminals is five things to watch, and nothing says which one is waiting.</p></div>\n  </div>\n</section>\n\n<section>\n  <h2>The solution</h2>\n  <p class=\"title\">Treat each request as a job, and keep every decision that matters with you.</p>\n  <div class=\"grid\">\n    <div class=\"panel ok\"><h3>One board for every job</h3><p>Each request becomes a job with its own worktree and sandbox VM. The Jobs page shows them all, with the ones waiting on you first.</p></div>\n    <div class=\"panel ok\"><h3>You judge artifacts, not claims</h3><p>Every stage leaves something you can check, such as a plan, a test result, or a diff. A comment on one goes to the agent as its next brief.</p></div>\n    <div class=\"panel ok\"><h3>Rules you can measure</h3><p>Every rule is a hook decision with a level: told, checked, or enforced. Run an eval to see what a stricter level does before you commit to it.</p></div>\n    <div class=\"panel ok\"><h3>Keys stay out of the sandbox</h3><p>Agents run in sandbox VMs that never see a credential. Pushes and pull requests happen on the host, and a tamper-evident log records every decision.</p></div>\n  </div>\n</section>\n\n<section id=\"oversight\">\n  <h2>The oversight dial</h2>\n  <p class=\"title\">Start with the lights on. Turn them off one step at a time.</p>\n  <p>A new factory waits after every step for you to approve its result or send it back with a note. Each step has its own dial, so as you trust a step more, you turn that one dark and leave the rest alone. A dark step goes on at once. Nothing waits on a timer, and every result and decision goes in the log whatever the dial says.</p>\n  <div class=\"dials\" aria-label=\"Illustration of step dials\">\n    <div class=\"dial\"><div class=\"who\">plan<span>trusted after many plans</span></div><div class=\"lvl\"><span>lights-on</span><span class=\"on\">dark</span></div></div>\n    <div class=\"dial\"><div class=\"who\">define<span>your checks, mostly trusted</span></div><div class=\"lvl\"><span>lights-on</span><span class=\"on\">dark</span></div></div>\n    <div class=\"dial\"><div class=\"who\">build<span>still reading every diff</span></div><div class=\"lvl\"><span class=\"on light\">lights-on</span><span>dark</span></div></div>\n    <div class=\"dial\"><div class=\"who\">merge<span>still deciding every merge</span></div><div class=\"lvl\"><span class=\"on light\">lights-on</span><span>dark</span></div></div>\n    <div class=\"level\">workflow level: <b>dim</b> · at least one step up to the merge waits for a person</div>\n  </div>\n  <p class=\"caption\">An illustration. Three presets set every dial at once: lights-on (every step), dim (only the steps that act outside the job), and dark (no step).</p>\n</section>\n\n<section id=\"ladder\">\n  <h2>The ladder</h2>\n  <p class=\"title\">Tighten a rule one rung at a time, and keep the record.</p>\n  <p>Every rule sits on a ladder. A constraint says what a turn must or must not do. A capability says which function a turn may call. Promote one and a hook holds the agent to more; demote it and the hook holds less. Each move is one rung, and the audit log records it, along with the eval you acted on.</p>\n  <div class=\"dials\" aria-label=\"Illustration of a constraint and a capability on their ladders\">\n    <div class=\"dial\"><div class=\"who\">constraint · tests-kept<span>told: in the brief · checked: a hook records the breach · enforced: a hook refuses</span></div><div class=\"lvl\"><span>told</span><span>checked</span><span class=\"on\">enforced</span></div></div>\n    <div class=\"dial\"><div class=\"who\">capability · write at plan<span>ask: the call waits for you to allow it once, send feedback, or stop the job</span></div><div class=\"lvl\"><span>denied</span><span class=\"on light\">ask</span><span>allowed</span></div></div>\n  </div>\n  <p class=\"caption\">From a recorded run: with <code>tests-kept</code> enforced, a build that dropped <code>test_add</code> went back to build with the rule. At checked, the same finding waited for a person.</p>\n</section>\n\n<section id=\"evals\">\n  <h2>A/B evals</h2>\n  <p class=\"title\">Try a stricter rule on real requests before you keep it.</p>\n  <p>An eval runs the same requests twice against the same workspace snapshot: arm A with your current rules and arm B with one change. Each trial stops at review with its diff, so nothing lands. A judge grades every result, and the Evals page shows the difference per request, with a link to each hook decision behind it.</p>\n  <p>If B wins, Apply B moves the rule to B's rung. The audit log records the move and the eval you acted on.</p>\n  <table aria-label=\"A recorded eval\">\n    <tr><th></th><th>A · no-wc told</th><th>B · no-wc enforced</th></tr>\n    <tr><td>refused calls</td><td>0</td><td class=\"b\">5</td></tr>\n    <tr><td>review findings</td><td>2</td><td class=\"b\">0</td></tr>\n    <tr><td>turns</td><td>39</td><td class=\"b\">28</td></tr>\n    <tr><td>tool calls</td><td>33</td><td class=\"b\">17</td></tr>\n    <tr><td>cost</td><td>$0.0344</td><td class=\"b\">$0.0207</td></tr>\n    <tr><td>grade</td><td>7</td><td>7</td></tr>\n  </table>\n  <p class=\"caption\">A recorded eval of three requests that each ask for a <code>wc</code> count. Three requests is a small run, so read it as one result, not a benchmark. Today an arm changes rule rungs. Changing the model per step or the workflow is planned.</p>\n</section>\n\n<section id=\"workflows\">\n  <h2>Custom workflows</h2>\n  <p class=\"title\">Run the pipeline your team already uses.</p>\n  <p>A workflow is a graph of steps. Each step is a skill, a prompt, a command, or a built-in Bastion stage. Skills come first: a skill step is an agent turn that follows <code>.claude/skills/&lt;name&gt;/SKILL.md</code> from your repository. A command step runs one shell line in the job's VM, such as <code>make test</code>, with no agent, and exit 0 passes.</p>\n  <p>Links carry results, not conditions. A step declares what it gives, such as <code>design-notes</code>, and the next step gets it in its brief. If a result is missing, a code check holds the step: the agent gets one more try with the reason, then the job waits for a person. Every step keeps its own dial.</p>\n  <div class=\"wf\" aria-label=\"Illustration of a custom workflow\">\n    <div class=\"step\"><span>skill</span>plan</div><span class=\"link res\">design-notes →</span>\n    <div class=\"step\"><span>skill</span>build</div><span class=\"link\">→</span>\n    <div class=\"step\"><span>command</span>make test</div><span class=\"link\">→</span>\n    <div class=\"step\"><span>stage</span>code review</div><span class=\"link\">→</span>\n    <div class=\"step\"><span>stage</span>merge</div>\n  </div>\n  <p class=\"caption\">An illustration. Bastion ships three workflows (short, full, and full without acceptance tests). Copy one to make your own, and each job keeps the version it started on. An admin edits workflows, and everyone else picks one per request. The workflow model and its API are built; the canvas for editing them is in progress.</p>\n</section>\n\n<section id=\"use-cases\">\n  <h2>Use cases</h2>\n  <p class=\"title\">What you'd hand to Bastion this week.</p>\n  <div class=\"cases\">\n    <div class=\"case\">\n      <div><span class=\"k\">Issue to pull request</span><h3>Clear small tickets from your backlog</h3><p>Start a job from a GitHub issue. Bastion opens the pull request and links it back. If CI fails, Bastion sends the agent one more turn with the failing log. When you approve the merge, the issue closes.</p></div>\n      <div class=\"flow\"><span class=\"step done\">issue #1</span><span class=\"step done\">plan</span><span class=\"step done\">build</span><span class=\"step done\">PR #2</span><span class=\"step lit\">CI fix</span><span class=\"step\">merge</span></div>\n    </div>\n    <div class=\"case\">\n      <div><span class=\"k\">Review by diff</span><h3>Steer the work with line comments</h3><p>Read the proposed diff and leave a comment on a line. The agent gets it word for word, and the next diff answers it, with no chat window.</p></div>\n      <pre><span class=\"dl hunk\">calc.py:5 · \"raise on zero\"</span><span class=\"dl del\">-    return a / b</span><span class=\"dl add\">+    if b == 0:</span><span class=\"dl add\">+        raise ZeroDivisionError(\"b is zero\")</span><span class=\"dl add\">+    return a / b</span></pre>\n    </div>\n    <div class=\"case\">\n      <div><span class=\"k\">Your rules, enforced</span><h3>Hold agents to your repository's charter</h3><p>Bastion reads the rules and hooks your repository already has in <code>.claude/settings.json</code>. So a hook that refuses <code>rm</code> refuses it inside the sandbox too.</p></div>\n      <div class=\"note\"><b>refused</b> · <code>rm -f /work/repo/notes.txt</code><br><span>PreToolUse hook · exit 2</span></div>\n    </div>\n  </div>\n  <p class=\"caption\">The diff is an illustration. The refused call comes from a recorded run.</p>\n</section>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"be243dec-ae41-4eb4-94dc-6fd5fc32c74b","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"ad7aeb2e-c537-4500-86f5-98039763ef27","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
