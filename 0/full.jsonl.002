":36,"lines":["     }"," }"," ","-/// What a workflow's own agent step is told first (D35): a skill's file","-/// to follow, or the workflow's instructions, which `workflow_step` adds.","+/// What a workflow's step is told first (D35): an agent's, skill's or","+/// command's file to follow, the workflow's instructions, which","+/// `workflow_step` adds, or a stage's instructions as the workflow rewrote","+/// them."," fn custom_intro(job: &Job) -> Option<String> {","     let lead = \"You are carrying out one step of a workflow in the repository in /work/repo.\";","     let tail = \"Commit what you change with git, then reply with what you did.\";","-    match (job.stage, job.step()) {","-        (Stage::Skill, Some(step)) => Some(format!(","-            \"{lead}\\nRead /work/repo/.claude/skills/{}/SKILL.md and follow it for the request below.\\n{tail}\",","-            step.run","-        )),","+    let follow = |file: String, how: &str| {","+        Some(format!(","+            \"{lead}\\nRead /work/repo/.claude/{file} and {how} for the request below.\\n{tail}\"","+        ))","+    };","+    let step = job.step();","+    match (job.stage, step) {","+        (Stage::Agent, Some(step)) => follow(format!(\"agents/{}.md\", step.run), \"act as that agent\"),","+        (Stage::Skill, Some(step)) => follow(format!(\"skills/{}/SKILL.md\", step.run), \"follow it\"),","+        (Stage::Command, Some(step)) => follow(format!(\"commands/{}.md\", step.run), \"carry it out\"),","         (Stage::Prompt, _) => Some(format!(","             \"{lead}\\nDo what the workflow says about this step, for the request below.\\n{tail}\"","         )),","+        (stage, Some(step)) if rewritten(stage, &step.note) => Some(step.note.trim().to_string()),","         _ => None,","     }"," }"," ","+/// Whether a step's note stands in for its stage's built-in instructions.","+fn rewritten(stage: Stage, note: &str) -> bool {","+    instructions(stage).is_some() && !note.trim().is_empty()","+}","+"," /// The brief for the job's current agent stage."," pub fn brief(job: &Job) -> String {","     let mut parts = vec!["]},{"oldStart":283,"oldLines":7,"newStart":303,"newLines":7,"lines":["         return Vec::new();","     };","     let mut parts = Vec::new();","-    if !step.note.trim().is_empty() {","+    if !step.note.trim().is_empty() && !rewritten(job.stage, &step.note) {","         parts.push(format!(","             \"The workflow says about this step:\\n{}\",","             step.note.trim()"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/brief.rs"]}},"serverClassifierContext":{"request":"b1f78b41-c912-402e-8c6c-23203aeb5377","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":5,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"e21e8712-ffcd-4712-8ac2-3e1ab9af1501","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
