sandbox::exec\",","+            json!({ \"argv\": [\"pytest\"] }),","+        ));","+        assert_eq!(answer[\"decision\"], \"hold\");","+        settle();","+        let calls = r.engine.calls.lock().unwrap().clone();","+        let execs: Vec<_> = calls.iter().filter(|c| c.1 == \"sandbox::exec\").collect();","+        assert_eq!(execs.len(), 1, \"only the hook ran\");","+        assert_eq!(","+            execs[0].2[\"env\"][\"BASTION_HOOK_INPUT\"]","+                .as_str()","+                .unwrap()","+                .contains(\"\\\"command\\\":\\\"pytest\\\"\"),","+            true","+        );","+        let resolved = calls","+            .iter()","+            .find(|c| c.1 == \"harness::function::resolve\")","+            .unwrap();","+        assert_eq!(resolved.2[\"is_error\"], true);","+        assert!(","+            resolved.2[\"content\"][0][\"text\"]","+                .as_str()","+                .unwrap()","+                .contains(\"tests first\")","+        );","+        assert!(r.gate.hook_runs(\"j1\")[0].contains(\"exit 2\"));","+    }","+","+    #[test]","+    fn a_hook_that_passes_lets_the_call_run_in_the_vm() {","+        let r = hooked(0);","+        r.gate.judge(&envelope(","+            \"build\",","+            \"sandbox::exec\",","+            json!({ \"argv\": [\"pytest\"] }),","+        ));","+        settle();","+        let calls = r.engine.calls.lock().unwrap().clone();","+        let execs: Vec<_> = calls.iter().filter(|c| c.1 == \"sandbox::exec\").collect();","+        assert_eq!(execs.len(), 2, \"the hook, then the call\");","+        assert_eq!(execs[1].2[\"sandbox_id\"], \"vm1\");","+        let resolved = calls","+            .iter()","+            .find(|c| c.1 == \"harness::function::resolve\")","+            .unwrap();","+        assert_eq!(resolved.2[\"is_error\"], false);","+    }","+","     #[test]","     fn the_brief_names_every_rule() {","-        let rules = rig().gate.rules();","+        let rules = rig().gate.rules(\"j1\");","         for c in govern::default_constraints() {","             assert!(rules.contains(&c.rule), \"{rules}\");","         }"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/src-tauri/src/gate.rs"]}},"serverClassifierContext":{"request":"0f4da47b-ab10-4ba7-8cf9-f06fe7b2b701","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"119a1d65-b5d6-46ed-b12b-6ab4acebe8ad","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
