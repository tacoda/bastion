,"         };","-        let g = Graph::chain(&[Plan, Build, Land], dark_build);","-        assert_eq!(g.check(), Ok(()));","-        assert_eq!(g.nodes[1].dial, Dial::Dark);","-        assert_eq!(ids(&g), [\"plan\", \"build\", \"land\"]);","+        assert_eq!(g.level(), Ok(Level::LightsOn));","+        g.nodes[1].dial = Dial::Dark;","         assert_eq!(g.level(), Ok(Level::Dim));","+        g.nodes[0].dial = Dial::Dark;","+        assert_eq!(g.level(), Ok(Level::Dark));","     }"," ","     #[test]"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/workflow.rs"]}},"serverClassifierContext":{"request":"52e2b8a8-9cc3-42f3-bc2a-5375966698ee","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":6,"modified":9,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"fa7c9534-be38-411c-871e-b45799e55180","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
