straint],\n174-    grants: &[Capability],\n175-) -> Verdict {\n176-    let broken = || {\n177-        constraints\n178-            .iter()\n179-            .filter(|c| matches(&c.function, &call.function) && binds(c, call))\n180-    };\n181-    let flagged = broken()\n182-        .filter(|c| c.rung == Enforcement::Checked)\n183-        .map(|c| c.id.clone())\n184-        .collect();\n185-    let charter = (call.function == WRITE).then(|| crate::charter::guards(&call.text));\n186-    let decision = if let Some(reason) = charter.flatten() {\n187-        Decision::Deny { reason }\n188-    } else if let Some(c) = broken().find(|c| c.rung == Enforcement::Enforced) {\n189-        Decision::Deny {\n190-            reason: format!(\"Refused by constraint {}: {}\", c.id, c.rule),\n191-        }\n192-    } else {\n193-        let grant = grants\n194-            .iter()\n195-            .filter(|g| g.stage == stage && matches(&g.function, &call.function))\n196-            .max_by_key(|g| (!g.function.ends_with('*'), g.function.len()));\n197-        match grant.map(|g| g.rung) {\n198-            Some(Access::Allowed) => Decision::Continue,\n199-            Some(Access::Ask) => Decision::Hold {\n200-                reason: format!(\"{} at {stage:?} waits for the owner.\", call.function),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"af7163b6-5f09-440c-ba1e-87ae9533ac80","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"73669b18-7f2d-4483-9502-2ea019384274","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"ex