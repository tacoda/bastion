Lines":29,"lines":["             .unwrap_or_default()","     }"," ","-    /// The owner's constraints and the job's charter's, together.","+    /// Judge a trial job under its arm's rungs from now on.","+    pub fn set_overrides(&self, job: &str, overrides: Vec<Override>) {","+        let detail = overrides.iter().map(|o| format!(\"{o:?}\")).collect::<Vec<_>>().join(\"; \");","+        self.note(\"arm\", job, detail);","+        self.overrides.lock().unwrap().insert(job.into(), overrides);","+    }","+","+    /// Record an eval's creation or the arm the owner applied.","+    pub fn note_eval(&self, eval: &str, detail: String) {","+        self.note(\"eval\", eval, detail);","+    }","+","+    /// The owner's grants, with the job's arm's rungs set.","+    fn grants(&self, job: &str) -> Vec<Capability> {","+        let mut grants: Vec<Capability> = self.policy.read().unwrap().iter().flat_map(|p| p.grants.clone()).collect();","+        if let Some(o) = self.overrides.lock().unwrap().get(job) {","+            bastion_core::eval::apply(&mut [], &mut grants, o);","+        }","+        grants","+    }","+","+    /// The owner's constraints and the job's charter's, together, with the","+    /// job's arm's rungs set.","     pub fn constraints(&self, job: &str) -> Vec<Constraint> {","         let mut all: Vec<Constraint> = self","             .policy"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/src-tauri/src/factory.rs","/Users/tacoda/tacoda/bastion/src-tauri/src/gate.rs"]}},"serverClassifierContext":{"request":"52e29c6b-1e64-42a9-a89d-91d29d77ace1","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":8,"untracked":null,"untracked_normal":6},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":