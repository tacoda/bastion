 links with it. Refused when the","+/// name is empty or another step has it.","+pub fn rename_step(w: &mut WorkflowView, id: &str, to: &str) -> Result<(), String> {","+    let to = to.trim();","+    if to.is_empty() || w.nodes.iter().any(|n| n.id == to && n.id != id) {","+        return Err(format!(\"{to:?} is empty or another step's name\"));","+    }","+    for n in w.nodes.iter_mut().filter(|n| n.id == id) {","+        n.id = to.into();","+    }","+    for l in &mut w.links {","+        for end in [&mut l.from, &mut l.to] {","+            if end == id {","+                *end = to.into();","+            }","+        }","+    }","+    Ok(())","+}","+"," pub fn add_link(w: &mut WorkflowView, from: &str, to: &str) {","     let exists = w.links.iter().any(|l| l.from == from && l.to == to);","     if from != to && !exists {"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/job.rs","hunks":[{"oldStart":300,"oldLines":14,"newStart":300,"newLines":9,"lines":["     }"," }"," ","-/// A step's name: a workflow's own step's node id, else its stage.","+/// A step's name, which the workflow gives it."," fn step_name(step: &StepView) -> String {","-    match step.stage.as_str() {","-        \"prompt\" | \"agent\" | \"skill\" | \"command\" | \"shell\" => {","-            format!(\"{} · {}\", step.stage, step.id)","-        }","-        _ => step.stage.replace('_', \" \"),","-    }","+    step.id.replace('_', \" \")"," }"," "," /// A report, an artifact or an error: monospace on the page color, scrolled"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/drawing.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/edit.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/job.rs"]}},"serverClassifierContext":{"request":"dbb7434f-3f72-4e11-bf72-65fc52534c84","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","defa