{"parentUuid":"65a4a658-974f-4948-8f1a-2f69b6376300","isSidechain":false,"promptId":"1d9ef2db-03d5-4a58-b720-e211c5a548e5","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rrn6Qu5a9cUz6ymiDB7RXp","type":"tool_result","content":"500\t            workspace,\n501\t            request,\n502\t            stage: Stage::Plan,\n503\t            state: State::Queued,\n504\t            question: None,\n505\t            feedback: None,\n506\t            plan: None,\n507\t            failures: 0,\n508\t            error: None,\n509\t            pr: None,\n510\t            ci_fixes: 0,\n511\t            updated_at: at,\n512\t            pipeline: Pipeline::Short,\n513\t            back_to: None,\n514\t            revisions: BTreeMap::new(),\n515\t            last_refusal: None,\n516\t            tasks: Vec::new(),\n517\t            done_tasks: 0,\n518\t            criteria: None,\n519\t            falsify_tried: false,\n520\t            flow: Vec::new(),\n521\t            node: None,\n522\t            results: BTreeMap::new(),\n523\t            parent: None,\n524\t            after: None,\n525\t            part: None,\n526\t        }\n527\t    }\n528\t\n529\t    /// The stages this job runs, in order.\n530\t    pub fn stages(&self) -> Vec<Stage> {\n531\t        if self.flow.is_empty() {\n532\t            self.pipeline.stages()\n533\t        } else {\n534\t            self.flow.iter().map(|s| s.stage).collect()\n535\t        }\n536\t    }\n537\t\n538\t    /// Each step's node id, in the order of `stages()`.\n539\t    pub fn step_ids(&self) -> Vec<String> {\n540\t        if self.flow.is_empty() {\n541\t            self.stages().into_iter().map(workflow::chain_id).collect()\n542\t        } else {\n543\t            self.flow.iter().map(|s| s.id.clone()).collect()\n544\t        }\n545\t    }\n546\t\n547\t    /// The workflow step the job is at. None while a fix loop runs another\n548\t    /// stage for it, or on a pipeline.\n549\t    /// A workflow of steps only, at its last step: nothing in it lands, so\n550\t    /// the job finishes as its workspace says (D41).\n551\t    pub fn finishes(&self) -> bool {\n552\t        let steps_only = self.flow.iter().all(|s| workflow::custom(s.stage));\n553\t        !self.flow.is_empty() && steps_only && self.next().is_none()\n554\t    }\n555\t\n556\t    pub fn step(&self) -> Option<&workflow::Step> {\n557\t        let at = self.node.as_deref()?;\n558\t        self.flow\n559\t            .iter()\n560\t            .find(|s| s.id == at && s.stage == self.stage)\n561\t    }\n562\t\n563\t    /// The job on a workflow's steps, at its first step.\n564\t    pub fn running(mut self, flow: Vec<workflow::Step>) -> Self {\n565\t        if let Some(first) = flow.first() {\n566\t            self.stage = first.stage;\n567\t            self.node = Some(first.id.clone());\n568\t        }\n569\t        self.flow = flow;\n570\t        self\n571\t    }\n572\t\n573\t    /// The step after this one: the next node of its workflow, or the next\n574\t    /// stage of its pipeline.\n575\t    fn next(&self) -> Option<(Stage, Option<String>)> {\n576\t        if self.flow.is_empty() {\n577\t            return pipeline::next_listed(&self.stages(), self.stage).map(|s| (s, None));\n578\t        }\n579\t        let at = self\n580\t            .flow\n581\t            .iter()\n582\t            .position(|s| Some(&s.id) == self.node.as_ref());\n583\t        let next = self.flow.get(at.map_or(0, |i| i + 1))?;\n584\t        Some((next.stage, Some(next.id.clone())))\n585\t    }\n586\t\n587\t    /// The job on another pipeline, at that pipeline's first stage.\n588\t    pub fn on(mut self, pipeline: Pipeline) -> Self {\n589\t        self.stage = pipeline.stages()[0];\n590\t        self.pipeline = pipeline;\n591\t        self\n592\t    }\n593\t}\n594\t\n595\t/// Apply one event to one job. An event that does not fit the job's state\n596\t/// changes nothing and returns no effects.\n597\tpub fn step(job: &Job, event: &Event, at: u64, dials: &Dials) -> (Job, Vec<Effect>) {\n598\t    let mut next = job.clone();\n599\t    next.updated_at = at;\n600\t    let effects = match (job.state, event) {\n601\t        (_, Event::Retried | Event::Extended | Event::PartsSet { .. }) => {\n602\t            match by_person(&mut next, event, dials) {\n603\t                Some(effects) => effects,\n604\t                None => return (job.clone(), Vec::new()),\n605\t            }\n606\t        }\n607\t        (state, _) if state.finished() => return (job.clone(), Vec::new()),\n608\t        (_, Event::Stopped) => {\n609\t            next.state = State::Stopped;\n610\t            vec![Effect::Teardown]\n611\t        }\n612\t        (State::Queued, Event::Admitted) => {\n613\t            next.state = State::Provisioning;\n614\t            vec![Effect::Provision]\n615\t        }\n616\t        (State::Provisioning, Event::Provisioned) => enter(&mut next, dials),\n617\t        (State::Provisioning, Event::ProvisionFailed { error }) => fail(&mut next, error),\n618\t        // A turn's result counts only at a step that runs a turn.\n619\t        (State::Running, Event::TurnFinished { outcome }) if job.stage.kind() == Kind::Turn => {\n620\t            turn_finished(&mut next, outcome, dials)\n621\t        }\n622\t        (State::Queued, Event::Abandoned { error }) => fail(&mut next, error),\n623\t        (State::NeedsYou, event) if decides(&next, event) => approved(&mut next, dials),\n624\t        (State::NeedsYou, Event::Commented { text }) => commented(&mut next, text, dials),\n625\t        (State::Running, Event::VmLost) => revive(&mut next),\n626\t        (State::Running, event) if kept(job, event).is_some() => {\n627\t            let Some(effects) = after_step(&mut next, event, dials) else {\n628\t                return (job.clone(), Vec::new());\n629\t            };\n630\t            kept(job, event).into_iter().chain(effects).collect()\n631\t        }\n632\t        _ => return (job.clone(), Vec::new()),\n633\t    };\n634\t    (next, effects)\n635\t}\n636\t\n637\t/// A step the factory runs reported: its land, CI or own result. `None`\n638\t/// means the event does not fit, and nothing changes.\n639\tfn after_step(job: &mut Job, event: &Event, dials: &Dials) -> Option<Vec<Effect>> {\n640\t    let finish = matches!(event, Event::Landed | Event::LandFailed { .. });\n641\t    if finish && job.finishes() {\n642\t        Some(finished(job, event))\n643\t    } else if job.stage == Stage::Land {\n644\t        land(job, event, dials)\n645\t    } else {\n646\t        factory(job, event, dials)\n647\t    }\n648\t}\n649\t\n650\t/// The result a step the factory runs reported, kept as its artifact\n651\t/// whatever the dial (D33).\n652\tfn kept(job: &Job, event: &Event) -> Option<Effect> {\n653\t    let body = match event {\n654\t        Event::StepPassed | Event::CiPassed => \"Passed.\".into(),\n655\t        Event::Landed => \"Landed.\".into(),\n656\t        Event::ChecksGreen => \"Every check passed before anything was built.\".into(),\n657\t        Event::PrOpened { url } => format!(\"Opened {url}\"),\n658\t        Event::StepFailed { detail } | Event::StepStuck { detail } => detail.clone(),\n659\t        Event::Ran { output } => output.clone(),\n660\t        Event::CiFailed { log } => log.clone(),\n661\t        Event::LandFailed { error } => error.clone(),\n662\t        _ => return None,\n663\t    };\n664\t    Some(Effect::RecordArtifact {\n665\t        stage: job.stage,\n666\t        body,\n667\t    })\n668\t}\n669\t\n670\t/// Whether the event decides the step the job waits on: a person approved\n671\t/// it. A question waits for its answer instead.\n672\tfn decides(job: &Job, event: &Event) -> bool {\n673\t    *event == Event::Approved && job.question.is_none()\n674\t}\n675\t\n676\t/// How many times in a row a job may lose its VM before it fails.\n677\tpub const MAX_REVIVES: u32 = 2;\n678\t\n679\t/// Give the job a new VM, which re-enters its stage once provisioned. A VM\n680\t/// that keeps dying fails the job rather than looping.\n681\tfn revive(job: &mut Job) -> Vec<Effect> {\n682\t    job.failures += 1;\n683\t    if job.failures > MAX_REVIVES {\n684\t        return fail(job, \"the job's VM was lost again after a revive\");\n685\t    }\n686\t    job.state = State::Provisioning;\n687\t    vec![Effect::Provision]\n688\t}\n689\t\n690\t/// A person's retry or extend. `None` means it does not fit, and nothing\n691\t/// changes.\n692\tfn by_person(job: &mut Job, event: &Event, dials: &Dials) -> Option<Vec<Effect>> {\n693\t    match event {\n694\t        Event::Retried if job.state == State::Failed => Some(requeue(job)),\n695\t        Event::Retried if retries(job) => {\n696\t            job.error = None;\n697\t            Some(start(job, dials))\n698\t        }\n699\t        // The cap counts from `updated_at`, which `step` moved to now.\n700\t        Event::Extended if extends(job) => Some(Vec::new()),\n701\t        Event::PartsSet { parts } if (job.stage, job.state) == (Stage::Scope, State::NeedsYou) => {\n702\t            propose(job, parts);\n703\t            Some(Vec::new())\n704\t        }\n705\t        _ => None,\n706\t    }\n707\t}\n708\t\n709\t/// Whether the job runs a turn a person may give more time.\n710\tfn extends(job: &Job) -> bool {\n711\t    job.state == State::Running && job.stage.kind() == Kind::Turn\n712\t}\n713\t\n714\t/// A failed job goes back to the queue at the step it failed at. Its\n715\t/// worktree kept its commits, so a new VM picks the work up there.\n716\tfn requeue(job: &mut Job) -> Vec<Effect> {\n717\t    job.state = State::Queued;\n718\t    job.error = None;\n719\t    job.failures = 0;\n720\t    Vec::new()\n721\t}\n722\t\n723\t/// Whether a person may run the step the job waits on again: it failed or\n724\t/// is stuck. A land or merge retries on approve instead.\n725\tfn retries(job: &Job) -> bool {\n726\t    job.state == State::Failed\n727\t        || (job.state == State::NeedsYou\n728\t            && job.error.is_some()\n729\t            && job.question.is_none()\n730\t            && !matches!(job.stage, Stage::Land | Stage::Merge))\n731\t}\n732\t\n733\t/// Enter the current stage. A step that acts outside the job waits first.\n734\tfn enter(job: &mut Job, dials: &Dials) -> Vec<Effect> {\n735\t    job.question = None;\n736\t    if job.stage.acts() {\n737\t        return wait(job, dials);\n738\t    }\n739\t    start(job, dials)\n740\t}\n741\t\n742\t/// Run the current stage, once its entry criteria hold: every result\n743\t/// linked into it exists (D35).\n744\tfn start(job: &mut Job, dials: &Dials) -> Vec<Effect> {\n745\t    let needs = job.step().map(|s| s.needs.clone()).unwrap_or_default();\n746\t    if let Some(missing) = needs.iter().find(|n| !job.results.contains_key(*n)) {\n747\t        return stuck(\n748\t            job,\n749\t            &format!(\"This step needs the result {missing}, which no step gave.\"),\n750\t        );\n751\t    }\n752\t    job.state = State::Running;\n753\t    match job.stage {\n754\t        Stage::Land => return vec![Effect::Land],\n755\t        Stage::Merge => return vec![Effect::Merge],\n756\t        // With no pull request (a local forge) there is no CI to watch.\n757\t        Stage::Ci if job.pr.is_none() => return advance(job, dials),\n758\t        Stage::Ci => return vec![Effect::WatchCi],\n759\t        stage if stage.kind() == Kind::Factory => return vec![Effect::RunStep { stage }],\n760\t        _ => {}\n761\t    }\n762\t    vec![Effect::StartTurn {\n763\t        stage: job.stage,\n764\t        brief: brief(job),\n765\t    }]\n766\t}\n767\t\n768\t/// Wait on a person under the step's dial: after a step, on its result;\n769\t/// before a step that acts, on whether it should. A trial stops after its\n770\t/// build, at review, with its diff.\n771\tfn wait(job: &mut Job, dials: &Dials) -> Vec<Effect> {\n772\t    if dials.trial && job.stage == Stage::Build {\n773\t        job.stage = Stage::Review;\n774\t        job.state = State::Stopped;\n775\t        return vec![Effect::Teardown];\n776\t    }\n777\t    // The requester signs off a UAT script, so it waits whatever its dial.\n778\t    let dial = match job.stage {\n779\t        Stage::Uat => Dial::LightsOn,\n780\t        _ => job.step().map_or_else(|| dials.at(job.stage), |s| s.dial),\n781\t    };\n782\t    match dial {\n783\t        Dial::LightsOn => {\n784\t            job.state = State::NeedsYou;\n785\t            Vec::new()\n786\t        }\n787\t        Dial::Dark => {\n788\t            let decided = Effect::DarkDecided { stage: job.stage };\n789\t            std::iter::once(decided)\n790\t                .chain(approved(job, dials))\n791\t                .collect()\n792\t        }\n793\t    }\n794\t}\n795\t\n796\t/// An event at the land stage: a local land, or a pull request's CI and\n797\t/// merge. `None` means the event does not fit, and nothing changes.\n798\tfn land(job: &mut Job, event: &Event, dials: &Dials) -> Option<Vec<Effect>> {\n799\t    Some(match (job.state, event) {"}]},"uuid":"8d5087cc-db43-4c37-a788-2ac47b4867dc","timestamp":"2026-11-11T21:13:10.715Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","content":"            workspace,\n            request,\n            stage: Stage::Plan,\n            state: State::Queued,\n            question: None,\n            feedback: None,\n            plan: None,\n            failures: 0,\n            error: None,\n            pr: None,\n            ci_fixes: 0,\n            updated_at: at,\n            pipeline: Pipeline::Short,\n            back_to: None,\n            revisions: BTreeMap::new(),\n            last_refusal: None,\n            tasks: Vec::new(),\n            done_tasks: 0,\n            criteria: None,\n            falsify_tried: false,\n            flow: Vec::new(),\n            node: None,\n            results: BTreeMap::new(),\n            parent: None,\n            after: None,\n            part: None,\n        }\n    }\n\n    /// The stages this job runs, in order.\n    pub fn stages(&self) -> Vec<Stage> {\n        if self.flow.is_empty() {\n            self.pipeline.stages()\n        } else {\n            self.flow.iter().map(|s| s.stage).collect()\n        }\n    }\n\n    /// Each step's node id, in the order of `stages()`.\n    pub fn step_ids(&self) -> Vec<String> {\n        if self.flow.is_empty() {\n            self.stages().into_iter().map(workflow::chain_id).collect()\n        } else {\n            self.flow.iter().map(|s| s.id.clone()).collect()\n        }\n    }\n\n    /// The workflow step the job is at. None while a fix loop runs another\n    /// stage for it, or on a pipeline.\n    /// A workflow of steps only, at its last step: nothing in it lands, so\n    /// the job finishes as its workspace says (D41).\n    pub fn finishes(&self) -> bool {\n        let steps_only = self.flow.iter().all(|s| workflow::custom(s.stage));\n        !self.flow.is_empty() && steps_only && self.next().is_none()\n    }\n\n    pub fn step(&self) -> Option<&workflow::Step> {\n        let at = self.node.as_deref()?;\n        self.flow\n            .iter()\n            .find(|s| s.id == at && s.stage == self.stage)\n    }\n\n    /// The job on a workflow's steps, at its first step.\n    pub fn running(mut self, flow: Vec<workflow::Step>) -> Self {\n        if let Some(first) = flow.first() {\n            self.stage = first.stage;\n            self.node = Some(first.id.clone());\n        }\n        self.flow = flow;\n        self\n    }\n\n    /// The step after this one: the next node of its workflow, or the next\n    /// stage of its pipeline.\n    fn next(&self) -> Option<(Stage, Option<String>)> {\n        if self.flow.is_empty() {\n            return pipeline::next_listed(&self.stages(), self.stage).map(|s| (s, None));\n        }\n        let at = self\n            .flow\n            .iter()\n            .position(|s| Some(&s.id) == self.node.as_ref());\n        let next = self.flow.get(at.map_or(0, |i| i + 1))?;\n        Some((next.stage, Some(next.id.clone())))\n    }\n\n    /// The job on another pipeline, at that pipeline's first stage.\n    pub fn on(mut self, pipeline: Pipeline) -> Self {\n        self.stage = pipeline.stages()[0];\n        self.pipeline = pipeline;\n        self\n    }\n}\n\n/// Apply one event to one job. An event that does not fit the job's state\n/// changes nothing and returns no effects.\npub fn step(job: &Job, event: &Event, at: u64, dials: &Dials) -> (Job, Vec<Effect>) {\n    let mut next = job.clone();\n    next.updated_at = at;\n    let effects = match (job.state, event) {\n        (_, Event::Retried | Event::Extended | Event::PartsSet { .. }) => {\n            match by_person(&mut next, event, dials) {\n                Some(effects) => effects,\n                None => return (job.clone(), Vec::new()),\n            }\n        }\n        (state, _) if state.finished() => return (job.clone(), Vec::new()),\n        (_, Event::Stopped) => {\n            next.state = State::Stopped;\n            vec![Effect::Teardown]\n        }\n        (State::Queued, Event::Admitted) => {\n            next.state = State::Provisioning;\n            vec![Effect::Provision]\n        }\n        (State::Provisioning, Event::Provisioned) => enter(&mut next, dials),\n        (State::Provisioning, Event::ProvisionFailed { error }) => fail(&mut next, error),\n        // A turn's result counts only at a step that runs a turn.\n        (State::Running, Event::TurnFinished { outcome }) if job.stage.kind() == Kind::Turn => {\n            turn_finished(&mut next, outcome, dials)\n        }\n        (State::Queued, Event::Abandoned { error }) => fail(&mut next, error),\n        (State::NeedsYou, event) if decides(&next, event) => approved(&mut next, dials),\n        (State::NeedsYou, Event::Commented { text }) => commented(&mut next, text, dials),\n        (State::Running, Event::VmLost) => revive(&mut next),\n        (State::Running, event) if kept(job, event).is_some() => {\n            let Some(effects) = after_step(&mut next, event, dials) else {\n                return (job.clone(), Vec::new());\n            };\n            kept(job, event).into_iter().chain(effects).collect()\n        }\n        _ => return (job.clone(), Vec::new()),\n    };\n    (next, effects)\n}\n\n/// A step the factory runs reported: its land, CI or own result. `None`\n/// means the event does not fit, and nothing changes.\nfn after_step(job: &mut Job, event: &Event, dials: &Dials) -> Option<Vec<Effect>> {\n    let finish = matches!(event, Event::Landed | Event::LandFailed { .. });\n    if finish && job.finishes() {\n        Some(finished(job, event))\n    } else if job.stage == Stage::Land {\n        land(job, event, dials)\n    } else {\n        factory(job, event, dials)\n    }\n}\n\n/// The result a step the factory runs reported, kept as its artifact\n/// whatever the dial (D33).\nfn kept(job: &Job, event: &Event) -> Option<Effect> {\n    let body = match event {\n        Event::StepPassed | Event::CiPassed => \"Passed.\".into(),\n        Event::Landed => \"Landed.\".into(),\n        Event::ChecksGreen => \"Every check passed before anything was built.\".into(),\n        Event::PrOpened { url } => format!(\"Opened {url}\"),\n        Event::StepFailed { detail } | Event::StepStuck { detail } => detail.clone(),\n        Event::Ran { output } => output.clone(),\n        Event::CiFailed { log } => log.clone(),\n        Event::LandFailed { error } => error.clone(),\n        _ => return None,\n    };\n    Some(Effect::RecordArtifact {\n        stage: job.stage,\n        body,\n    })\n}\n\n/// Whether the event decides the step the job waits on: a person approved\n/// it. A question waits for its answer instead.\nfn decides(job: &Job, event: &Event) -> bool {\n    *event == Event::Approved && job.question.is_none()\n}\n\n/// How many times in a row a job may lose its VM before it fails.\npub const MAX_REVIVES: u32 = 2;\n\n/// Give the job a new VM, which re-enters its stage once provisioned. A VM\n/// that keeps dying fails the job rather than looping.\nfn revive(job: &mut Job) -> Vec<Effect> {\n    job.failures += 1;\n    if job.failures > MAX_REVIVES {\n        return fail(job, \"the job's VM was lost again after a revive\");\n    }\n    job.state = State::Provisioning;\n    vec![Effect::Provision]\n}\n\n/// A person's retry or extend. `None` means it does not fit, and nothing\n/// changes.\nfn by_person(job: &mut Job, event: &Event, dials: &Dials) -> Option<Vec<Effect>> {\n    match event {\n        Event::Retried if job.state == State::Failed => Some(requeue(job)),\n        Event::Retried if retries(job) => {\n            job.error = None;\n            Some(start(job, dials))\n        }\n        // The cap counts from `updated_at`, which `step` moved to now.\n        Event::Extended if extends(job) => Some(Vec::new()),\n        Event::PartsSet { parts } if (job.stage, job.state) == (Stage::Scope, State::NeedsYou) => {\n            propose(job, parts);\n            Some(Vec::new())\n        }\n        _ => None,\n    }\n}\n\n/// Whether the job runs a turn a person may give more time.\nfn extends(job: &Job) -> bool {\n    job.state == State::Running && job.stage.kind() == Kind::Turn\n}\n\n/// A failed job goes back to the queue at the step it failed at. Its\n/// worktree kept its commits, so a new VM picks the work up there.\nfn requeue(job: &mut Job) -> Vec<Effect> {\n    job.state = State::Queued;\n    job.error = None;\n    job.failures = 0;\n    Vec::new()\n}\n\n/// Whether a person may run the step the job waits on again: it failed or\n/// is stuck. A land or merge retries on approve instead.\nfn retries(job: &Job) -> bool {\n    job.state == State::Failed\n        || (job.state == State::NeedsYou\n            && job.error.is_some()\n            && job.question.is_none()\n            && !matches!(job.stage, Stage::Land | Stage::Merge))\n}\n\n/// Enter the current stage. A step that acts outside the job waits first.\nfn enter(job: &mut Job, dials: &Dials) -> Vec<Effect> {\n    job.question = None;\n    if job.stage.acts() {\n        return wait(job, dials);\n    }\n    start(job, dials)\n}\n\n/// Run the current stage, once its entry criteria hold: every result\n/// linked into it exists (D35).\nfn start(job: &mut Job, dials: &Dials) -> Vec<Effect> {\n    let needs = job.step().map(|s| s.needs.clone()).unwrap_or_default();\n    if let Some(missing) = needs.iter().find(|n| !job.results.contains_key(*n)) {\n        return stuck(\n            job,\n            &format!(\"This step needs the result {missing}, which no step gave.\"),\n        );\n    }\n    job.state = State::Running;\n    match job.stage {\n        Stage::Land => return vec![Effect::Land],\n        Stage::Merge => return vec![Effect::Merge],\n        // With no pull request (a local forge) there is no CI to watch.\n        Stage::Ci if job.pr.is_none() => return advance(job, dials),\n        Stage::Ci => return vec![Effect::WatchCi],\n        stage if stage.kind() == Kind::Factory => return vec![Effect::RunStep { stage }],\n        _ => {}\n    }\n    vec![Effect::StartTurn {\n        stage: job.stage,\n        brief: brief(job),\n    }]\n}\n\n/// Wait on a person under the step's dial: after a step, on its result;\n/// before a step that acts, on whether it should. A trial stops after its\n/// build, at review, with its diff.\nfn wait(job: &mut Job, dials: &Dials) -> Vec<Effect> {\n    if dials.trial && job.stage == Stage::Build {\n        job.stage = Stage::Review;\n        job.state = State::Stopped;\n        return vec![Effect::Teardown];\n    }\n    // The requester signs off a UAT script, so it waits whatever its dial.\n    let dial = match job.stage {\n        Stage::Uat => Dial::LightsOn,\n        _ => job.step().map_or_else(|| dials.at(job.stage), |s| s.dial),\n    };\n    match dial {\n        Dial::LightsOn => {\n            job.state = State::NeedsYou;\n            Vec::new()\n        }\n        Dial::Dark => {\n            let decided = Effect::DarkDecided { stage: job.stage };\n            std::iter::once(decided)\n                .chain(approved(job, dials))\n                .collect()\n        }\n    }\n}\n\n/// An event at the land stage: a local land, or a pull request's CI and\n/// merge. `None` means the event does not fit, and nothing changes.\nfn land(job: &mut Job, event: &Event, dials: &Dials) -> Option<Vec<Effect>> {\n    Some(match (job.state, event) {","numLines":300,"startLine":500,"totalLines":1425}},"sourceToolAssistantUUID":"65a4a658-974f-4948-8f1a-2f69b6376300","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
