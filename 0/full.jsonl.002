The folder it unpacks into: `bastion-<v>` or `bastion-desktop-<v>`.","+    fn folder(&self, install: &Install) -> String {","+        let v = self.tag.trim_start_matches('v');","+        match install {","+            Install::Tarball { desktop: false, .. } => format!(\"bastion-{v}\"),","+            _ => format!(\"bastion-desktop-{v}\"),","+        }","+    }","+","+    /// Its file for an install like `install`.","+    fn asset(&self, install: &Install) -> String {","+        let base = format!(\"{}-{}\", self.folder(install), self.target);","+        match install {","+            Install::App(_) => format!(\"{base}.zip\"),","+            Install::Tarball { .. } => format!(\"{base}.tar.gz\"),","+        }","+    }","+","+    async fn fetch(&self, file: &str) -> Result<Vec<u8>, String> {","+        let url = format!(\"{REPO}/releases/download/{}/{file}\", self.tag);","+        let answer = reqwest::get(&url)","+            .await","+            .map_err(|e| format!(\"{file}: {e}\"))?;","+        if !answer.status().is_success() {","+            return Err(format!(\"{file}: {}\", answer.status()));","+        }","+        Ok(answer.bytes().await.map_err(|e| e.to_string())?.to_vec())","     }"," }"," "]},{"oldStart":96,"oldLines":29,"newStart":115,"newLines":32,"lines":["         .redirect(reqwest::redirect::Policy::none())","         .build()","         .map_err(|e| e.to_string())?;","-    let newest = newest(&http).await?;","-    if newest.trim_start_matches('v') == current {","+    let release = Release {","+        tag: newest(&http).await?,","+        target: env!(\"BASTION_TARGET\"),","+    };","+    if release.tag.trim_start_matches('v') == current {","         println!(\"Bastion {current} is the newest release\");","         return Ok(());","     }","-    let get = |file: String| fetch(newest.clone(), file);","-    let sums = get(\"SHA256SUMS\".into()).await?;","-    let signature = String::from_utf8_lossy(&get(\"SHA256SUMS.minisig\".into()).await?).to_strin