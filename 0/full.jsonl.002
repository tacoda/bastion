{"parentUuid":"eee4a45e-f14d-41ce-989a-2a7bb0da25ea","isSidechain":false,"attachment":{"type":"hook_success","hookName":"PreToolUse:mcp__cmux-cua__click","toolUseID":"toolu_01AKyXQgJb3bh3WUWP93nMgF","hookEvent":"PreToolUse","content":"","stdout":"{}\n","stderr":"","exitCode":0,"command":"if [ -n \"${CMUX_CLAUDE_HOOK_SPOOL_DIR:-}\" ] && [ -x /bin/zsh ]; then exec /bin/zsh -fc 'LC_ALL=C␤export CMUX_CLAUDE_PID=${CMUX_CLAUDE_PID:-$PPID}␤export CMUX_AGENT_HOOK_INVOKER_PID=$PPID␤cmux_fallback() { { print -rn -- \"$cmux_p\"; /bin/cat; } | /bin/sh -c \"$1\" >&3; exit $?; }␤zmodload zsh/system zsh/datetime zsh/files 2>/dev/null || exec /bin/sh -c \"$1\" >&3␤cmux_p= cmux_c= cmux_e=0␤while (( ${#cmux_p} < 262144 )); do sysread -i 0 -s 65536 cmux_c || { cmux_e=$?; break; }; cmux_p+=$cmux_c; done␤[[ -n ${CMUX_SURFACE_ID:-} && ${CMUX_CLAUDE_HOOKS_DISABLED:-} != 1 ]] || { (( cmux_e == 5 )) || /bin/cat >/dev/null; print -r -- '\\''{}'\\'' >&3; exit 0; }␤cmux_d=$CMUX_CLAUDE_HOOK_SPOOL_DIR␤(( cmux_e == 5 )) && [[ -f $cmux_d/keys ]] || cmux_fallback \"$1\"␤cmux_r=\"cmux-agent-hook-v1\"$'\\''\\n'\\''\"claude\"$'\\''\\n'\\''\"$2\"$'\\''\\n'\\''␤for cmux_k in ${(f)\"$(<$cmux_d/keys)\"}; do (( ${+parameters[$cmux_k]} )) && cmux_r+=\"$cmux_k=${(P)cmux_k}\"$'\\''\\0'\\''; done␤cmux_r+=$'\\''\\0'\\''\"$cmux_p\"␤(( ${#cmux_r} <= 524288 )) || cmux_fallback \"$1\"␤umask 077␤cmux_n=$cmux_d/$epochtime[1].$epochtime[2]-$$␤{ print -rn -- \"$cmux_r\" >| $cmux_n.tmp && mv -f -- $cmux_n.tmp $cmux_n.rec; } 2>/dev/null || { rm -f -- $cmux_n.tmp 2>/dev/null; cmux_fallback \"$1\"; }␤if zsystem flock -t 0 -r -f cmux_l $cmux_d/forwarder.lock 2>/dev/null; then␤  zsystem flock -u $cmux_l␤  rm -- $cmux_n.rec 2>/dev/null && cmux_fallback \"$1\"␤fi␤print -r -- '\\''{}'\\'' >&3' cmux-hook 'cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"