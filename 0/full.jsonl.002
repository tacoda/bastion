ipeline's (D39).\n235:            .or_else(|| workflow_store::id_of(how.pipeline).map(String::from));\n237:            let dials = settings_store::current(&*self.store).await?.dials;\n288:    async fn dials_for(&self, record: &Record) -> Result<Dials, String> {\n294:            None => settings_store::current(&*self.store).await?.dials,\n336:                let dials = self.dials_for(&record).await?;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"9b6fcb6a-1ec3-4fca-8d10-c139516feb9f","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":11,"modified":17,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"8f8dff6b-c338-4990-bfb1-ace86efc8432","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
