k sends one step's results to another, and carries no"," //! condition: a step's entry criteria are the results linked into it, and"," //! its exit criteria are the results it declares."," "]},{"oldStart":15,"oldLines":13,"newStart":15,"newLines":16,"lines":[" pub struct Node {","     /// Unique in its workflow; a built-in step's is its stage's name.","     pub id: String,","-    /// What runs: `skill`, `prompt`, `command`, or a Bastion stage.","+    /// What runs: `prompt`, `agent`, `skill`, `command`, `shell`, or a","+    /// Bastion stage.","     pub stage: Stage,","-    /// The skill's name, or the command line. Empty for anything else.","+    /// The agent's, skill's or command's name, or the shell script. Empty","+    /// for anything else.","     pub run: String,","     pub dial: Dial,","-    /// What the step should know, shown when the node is expanded. A","-    /// prompt's instructions; for any agent step, part of its brief.","+    /// The step's instructions. A prompt's whole brief; for a Bastion","+    /// stage's turn, its instructions in place of the built-in ones; for an","+    /// agent, skill or command, what to add to it. Empty keeps the built-in.","     pub note: String,","     /// The results it declares, by name, such as `design-notes`.","     pub results: Vec<String>,"]},{"oldStart":78,"oldLines":8,"newStart":81,"newLines":8,"lines":["     }"," }"," ","-/// A skill's name is a folder under `.claude/skills`: letters, digits,","-/// `-` and `_` only, so it cannot leave that folder.","+/// An agent's, skill's or command's name is a file or folder under","+/// `.claude`: letters, digits, `-` and `_` only, so it cannot leave it."," pub fn skill_name_ok(name: &str) -> bool {","     !name.is_empty()","         && name"]},{"oldStart":87,"oldLines":12,"newStart":90,"newLines":16,"lines":["             .all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')"," }"," ","-/// What a node lacks to run: a skill its folder's name, a command its","-/// line, a prompt its instructions.","+/// What a node lacks to run: an agent, skill or command its name, a shell","+/// step its script, a prompt its instructions."," fn missing_run(n: &Node) -> Option<&'static str> {","     match n.stage {","+        Stage::Agent if !skill_name_ok(&n.run) => Some(\"an agent needs its name in .claude/agents\"),","         Stage::Skill if !skill_name_ok(&n.run) => Some(\"a skill needs its folder's name\"),","-        Stage::Shell if n.run.trim().is_empty() => Some(\"a command needs its command line\"),","+        Stage::Command if !skill_name_ok(&n.run) => {","+            Some(\"a command needs its name in .claude/commands\")","+        }","+        Stage::Shell if n.run.trim().is_empty() => Some(\"a shell step needs its script\"),","         Stage::Prompt if n.note.trim().is_empty() => Some(\"a prompt needs its instructions\"),","         _ => None,","     }"]},{"oldStart":234,"oldLines":7,"newStart":241,"newLines":7,"lines":["         if !n.stage.dialed() {","             return Err(format!(\"{:?} is not a step\", n.stage));","         }","-        let custom = matches!(n.stage, Stage::Skill | Stage::Prompt | Stage::Shell);","+        let custom = n.stage.custom();","         if !custom && before.iter().any(|m| m.stage == n.stage) {","             return Err(format!(\"{:?} is in the workflow twice\", n.stage));","         }"]},{"oldStart":335,"oldLines":11,"newStart":342,"newLines":11,"lines":[" ","     #[test]","     fn skills_prompts_and_commands_may_repeat_and_each_needs_what_it_runs() {","-        let mut lint = node(\"lint\", Command, 0, &[\"lint-report\"]);","+        let mut lint = node(\"lint\", Shell, 0, &[\"lint-report\"]);","         lint.run = \"make lint\".into();","         let mut review = node(\"review\", Skill, 100, &[]);","         review.run = \"code-review\".into();","-        let mut tests = node(\"tests\", Command, 200, &[]);","+        let mut tests = node(\"tests\", Shell, 200, &[]);","         tests.run = \"npm test\".into();","         let g = Graph {","             nodes: vec![lint, review, tests, node(\"land\", Land, 300, &[])],"]},{"oldStart":351,"oldLines":10,"newStart":358,"newLines":22,"lines":["         assert!(bad.check().unwrap_err().contains(\"skill\"));","         let mut bad = g.clone();","         bad.nodes[2].run = \" \".into();","-        assert!(bad.check().unwrap_err().contains(\"command line\"));","-        let mut bad = g;","+        assert!(bad.check().unwrap_err().contains(\"script\"));","+        let mut bad = g.clone();","         bad.nodes.push(node(\"ask\", Prompt, 250, &[]));","         assert!(bad.check().unwrap_err().contains(\"instructions\"));","+        let mut bad = g;","+        let mut agent = node(\"security\", Agent, 250, &[]);","+        agent.run = \"reviewer\".into();","+        let mut command = node(\"ship-notes\", Command, 260, &[]);","+        command.run = \"release-notes\".into();","+        bad.nodes.extend([agent.clone(), agent]);","+        assert!(bad.check().unwrap_err().contains(\"taken\"), \"ids stay unique\");","+        bad.nodes.pop();","+        bad.nodes.push(command);","+        assert_eq!(bad.check(), Ok(()));","+        bad.nodes[5].run = \"../x\".into();","+        assert!(bad.check().unwrap_err().contains(\".claude/commands\"));","     }"," ","     #[test]"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/lib.rs","/Users/tacoda/tacoda/bastion/crates/bastion-core/src/workflow.rs"]}},"serverClassifierContext":{"request":"93306de4-38e7-47f3-9677-c69160116ae4","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":5,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}}