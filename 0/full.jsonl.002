 PartialEq)]","-enum Text {","-    /// The instructions, or for a stage, its instructions in place of the","-    /// built-in ones.","-    Note,","-    /// A shell step's script.","-    Script,","-    /// A step Bastion does itself, with nothing to write.","-    Nothing,","-}","-","-fn text_of(n: &bastion_protocol::NodeView) -> Text {","-    let custom = CUSTOM.iter().any(|(s, _)| *s == n.stage);","-    match n.stage.as_str() {","-        \"shell\" => Text::Script,","-        _ if custom || !n.builtin.is_empty() => Text::Note,","-        _ => Text::Nothing,","-    }","+/// Whether a step's one text box holds a script, not instructions.","+fn is_script(n: &bastion_protocol::NodeView) -> bool {","+    n.stage == \"shell\""," }"," ","-/// The text a step's box starts with: its script, its note, or a stage's","-/// built-in instructions while the note is empty.","+/// The text a step's box shows: its script or its instructions."," fn shown(n: &bastion_protocol::NodeView) -> String {","-    match text_of(n) {","-        Text::Script => n.run.clone(),","-        Text::Note if n.note.trim().is_empty() => n.builtin.clone(),","-        Text::Note => n.note.clone(),","-        Text::Nothing => String::new(),","+    match is_script(n) {","+        true => n.run.clone(),","+        false => n.note.clone(),","     }"," }"," ","-/// Keep what was typed: a script as the step's run, instructions as its","-/// note, and instructions left as built in as no note, so the step keeps","-/// following the built-in ones.","+/// Keep what was typed: a script as the step's run, instructions as its note."," fn keep_text(n: &mut bastion_protocol::NodeView, typed: String) {","-    match text_of(n) {","-        Text::Script => n.run = typed,","-        Text::Note if !n.builtin.is_empty() && typed.trim() == n.builtin.trim() => n.note.clear(),","-        Text::Note => n.note = typed,","-        Text::Nothing => {}","+    match is_script(n) {","+        true => n.run = typed,","+        false => n.note = typed,","     }"," }"," ","-/// A Bastion stage's built-in instructions, as any workflow shown has them.","-fn builtin_of(all: &[WorkflowView], stage: &str) -> String {","-    all.iter()","-        .flat_map(|w| &w.nodes)","-        .find(|n| n.stage == stage && !n.builtin.is_empty())","-        .map(|n| n.builtin.clone())","-        .unwrap_or_default()","-}","-"," fn on_pointer(state: &mut State, p: Pointer) {","     let editable = state.editable();","     let Some(w) = state.draft.as_mut() else {"]},{"oldStart":349,"oldLines":8,"newStart":317,"newLines":7,"lines":["         Msg::Field(f, v) => on_field(state, f, v),","         Msg::Kind(_) if !state.editable() => {}","         Msg::Kind(c) => {","-            let builtin = builtin_of(&state.all, &c.id);","-            state.step(|n| (n.stage, n.builtin) = (c.id, builtin));","+            state.step(|n| n.stage = c.id);","             state.pick(state.picked.clone());","         }","         Msg::Network(on) => state.step(|n| n.reach.network = on),"]},{"oldStart":397,"oldLines":12,"newStart":364,"newLines":12,"lines":["     Task::none()"," }"," ","-/// The shown workflow's facts: built in or not, its version and its level.","+/// The shown workflow's facts: shipped or not, its version and its level."," fn facts(w: &WorkflowView) -> String {","-    let kind = if w.built_in {","-        \"built in, copy it to change it\"","+    let kind = if w.ships {","+        \"ships with Bastion\"","     } else {","-        \"yours to change\"","+        \"yours\"","     };","     let level = w.level.replace('_', \" \").replace(\"lights on\", \"lights-on\");","     format!(\"{kind} · version {} · runs {level}\", w.version)"]},{"oldStart":430,"oldLines":13,"newStart":397,"newLines":12,"lines":["     row![pick, facts].spacing(12).align_y(iced::Center).into()"," }"," ","-/// What deleting the shown workflow does: a changed built-in resets to","-/// the original, one of the owner's goes, and an unchanged built-in stays.","-fn delete_label(w: &WorkflowView) -> Option<&'static str> {","-    match (w.ships, w.built_in) {","-        (true, true) => None,","-        (true, false) => Some(\"Reset to the original\"),","-        (false, _) => Some(\"Delete\"),","+/// What deleting the shown workflow does: a shipped one resets to the","+/// original, and one of the owner's goes.","+fn delete_label(w: &WorkflowView) -> &'static str {","+    match w.ships {","+        true => \"Reset to the original\",","+        false => \"Delete\",","     }"," }"," "]},{"oldStart":492,"oldLines":14,"newStart":458,"newLines":10,"lines":[" "," /// What the step's one text box is for."," fn text_label(n: &bastion_protocol::NodeView) -> &'static str {","-    match (text_of(n), n.stage.as_str()) {","-        (Text::Script, _) => \"Script, run by sh in the repository in the job's VM\",","-        (Text::Note, \"prompt\") => \"Instructions\",","-        (Text::Note, _) if !n.builtin.is_empty() => {","-            \"Instructions (Bastion's own until you change them; clear to restore)\"","-        }","-        (Text::Note, _) => \"Added instructions (optional)\",","-        (Text::Nothing, _) => \"Bastion does this step itself; it runs no agent and no script.\",","+    match n.stage.as_str() {","+        \"shell\" => \"Script, run by sh in the repository in the job's VM\",","+        \"prompt\" => \"Instructions\",","+        _ => \"Added instructions (optional)\",","     }"," }"," "]},{"oldStart":664,"oldLines":12,"newStart":626,"newLines":12,"lines":[" mod tests {","     use super::*;"," ","-    fn workflow(id: &str, version: u64, built_in: bool) -> WorkflowView {","+    fn workflow(id: &str, version: u64, ships: bool) -> WorkflowView {","         WorkflowView {","             id: id.into(),","             name: id.into(),","             version,","-            built_in,","+            ships,","             ..WorkflowView::default()","         }","     }"]},{"oldStart":699,"oldLines":7,"newStart":661,"newLines":7,"line