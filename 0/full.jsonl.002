 &Event::Ran { output: \"ok\".into() }, AT, &trial);","+    assert_eq!(stopped.state, State::Stopped, \"a trial lands nothing\");","+}","+","+#[test]","+fn a_failing_shell_step_goes_back_to_the_step_that_writes_then_waits() {","+    let mut j = job([Dial::Dark; 3]);","+    (j.node, j.stage) = (Some(\"tests\".into()), Stage::Shell);","+    j.results.insert(\"plan\".into(), \"1. Add x.\".into());","+    let (fixing, effects) = go(&j, Event::StepFailed { detail: \"1 failed\".into() });","+    assert_eq!(fixing.node.as_deref(), Some(\"build\"), \"plan only reads\");","+    assert_eq!(kinds(&effects), [\"artifact\", \"turn\"]);","+    assert!(fixing.feedback.as_deref().unwrap().contains(\"1 failed\"));","+    let mut again = fixing.clone();","+    (again.node, again.stage) = (Some(\"tests\".into()), Stage::Shell);","+    let (same, _) = go(&again, Event::StepFailed { detail: \"1 failed\".into() });","+    assert_eq!(same.state, State::NeedsYou, \"the same failure word for word waits\");","+    let spent = Bounds {","+        revision_budget: Some(1),","+        ..Bounds::default()","+    };","+    let (budget, _) = step(&again, &Event::StepFailed { detail: \"2 failed\".into() }, AT, &spent);","+    assert!(budget.error.unwrap().starts_with(\"The revision budget of 1 is spent.\"));","+}","+","+#[test]","+fn a_note_sends_the_work_back_and_an_answer_goes_to_the_step_that_asked() {","+    let mut j = job([Dial::LightsOn; 3]);","+    (j.node, j.stage, j.state) = (Some(\"tests\".into()), Stage::Shell, State::NeedsYou);","+    j.results.insert(\"plan\".into(), \"1. Add x.\".into());","+    let (back, effects) = go(&j, Event::Commented { text: \"Name it y.\".into() });","+    assert_eq!((back.node.as_deref(), kinds(&effects)), (Some(\"build\"), vec![\"turn\"]));","+    assert_eq!(back.feedback.as_deref(), Some(\"Name it y.\"));","+    let asked = Event::TurnFinished {","+        outcome: Outcome::Asked {","+            question: \"Which file?\".into(),","+        },","+    };","+    let (waits, _) = go(&job([Dial::Dark; 3]), asked);","+    assert_eq!(actions(&waits), [Action::Answer, Action::Stop]);","+    let (answered, _) = go(&waits, Event::Commented { text: \"calc.py\".into() });","+    assert_eq!(answered.node.as_deref(), Some(\"plan\"));","+    assert!(answered.feedback.unwrap().contains(\"The answer: calc.py\"));","+}","+","+#[test]","+fn a_reply_without_its_result_gets_one_more_try_then_waits() {","+    let j = job([Dial::Dark; 3]);","+    let (retry, effects) = go(&j, done(\"No plan here.\"));","+    assert_eq!((retry.state, kinds(&effects)), (State::Running, vec![\"artifact\", \"turn\"]));","+    assert!(retry.feedback.unwrap().contains(\"RESULT plan:\"));","+    let (j, _) = go(&j, done(\"No plan here.\"));","+    let (waits, _) = go(&j, done(\"Still none.\"));","+    assert_eq!(waits.state, State::NeedsYou);","+}","+","+#[test]","+fn a_step_shows_where_it_stands_and_a_queue_admits_by_its_limits() {","+    let mut j = job([Dial::Dark; 3]);","+    j.node = Some(\"build\".into());","+    let shown: Vec<StepState> = steps(&j).into_iter().map(|s| s.2).collect();","+    assert_eq!(shown, [StepState::Done, StepState::Running, StepState::Pending]);","+    let queued = |id: &str, w: &str| Job::new(id.into(), w.into(), \"r\".into(), AT);","+    let jobs = [queued(\"a\", \"w\"), queued(\"b\", \"w\"), queued(\"c\", \"v\")];","+    assert_eq!(admit(&jobs, 2, |w| (w == \"w\").then_some(1)), [\"a\", \"c\"]);","+}"]}],"originalFile":"//! The job state machine on workflows of steps (D39).\n","userModified":false},"sourceToolAssistantUUID":"51b07cc0-61ab-4243-89f6-21418c6485a8","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
