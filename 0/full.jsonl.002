n_step = d.steps.iter().rev().find(agent).map(|s| s.stage.as_str());''','''    let agent = |s: &&StepView| s.stage != \"shell\" && s.state != \"pending\";\n    let turn_step = d.steps.iter().rev().find(agent).map(|s| s.id.as_str());''')\n# tests\nrep('''            stage: \"build\".into(),\n            body: \"**What I changed**''','''            stage: \"prompt\".into(),\n            step: \"build\".into(),\n            body: \"**What I changed**''')\ncut('    #[test]\\n    fn parts_are_the_lines_typed','    #[test]\\n    fn a_shift_click')\ni=s.index('    #[test]\\n    fn approve_says_what_it_does_at_a_release_step')\ns=s[:i]+'''    #[test]\n    fn a_wait_judges_its_steps_report_and_the_latest_change() {\n        let art = |step: &str, body: &str| ArtifactView {\n            stage: \"prompt\".into(),\n            step: step.into(),\n            body: body.into(),\n            created_at: 0,\n        };\n        let mut d = JobDetail::default();\n        d.job.node = Some(\"review\".into());\n        d.artifacts = vec![\n            art(\"build\", \"Built.\"),\n            art(\"build\", \"diff --git a/x b/x\"),\n            art(\"review\", \"Looks right.\"),\n        ];\n        assert_eq!(\n            judged(&d),\n            (Some(\"Looks right.\".into()), Some(\"diff --git a/x b/x\".into()))\n        );\n        assert!(what_approve_does(&d).starts_with(\"Approve this step's\"));\n        (d.job.node, d.job.error) = (None, Some(\"conflict\".into()));\n        assert_eq!(what_approve_does(&d), \"Approve tries the finish again.\");\n        assert_eq!(judged(&d).0, None, \"the finish has no report of its own\");\n        let custom = StepView {\n            id: \"research\".into(),\n            stage: \"skill\".into(),\n            state: \"done\".into(),\n        };\n        assert_eq!(step_name(&custom), \"research\", \"a step goes by its name\");\n    }\n}\n'''\nopen(p,'w').write(s)\nEOF\ncd /Users/tacoda/tacoda/bastion && CARGO_INCREMENTAL=0 cargo build -p b