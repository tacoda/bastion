mut Job, dials: &Dials) -> Vec<Effect> {","     job.question = None;","+    if dials.trial && job.stage == Stage::Review {","+        job.state = State::Stopped;","+        return vec![Effect::Teardown];","+    }","     if job.stage.is_checkpoint() {","         job.state = State::NeedsYou;","         return match dials.at(job.stage) {"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/tests.rs","hunks":[{"oldStart":467,"oldLines":3,"newStart":467,"newLines":31,"lines":["         (State::Running, None, vec![Effect::Land])","     );"," }","+","+#[test]","+fn a_trial_approves_its_plan_and_stops_at_review_with_its_diff() {","+    let trial = Dials {","+        trial: true,","+        ..Dials::default()","+    };","+    let mut j = job();","+    for (i, e) in [Event::Admitted, Event::Provisioned, done(\"1. plan\")]","+        .iter()","+        .enumerate()","+    {","+        j = step(&j, e, AT + i as u64, &trial).0;","+    }","+    assert_eq!(","+        (j.stage, j.state),","+        (Stage::Build, State::Running),","+        \"the plan approved itself\"","+    );","+    let (j, effects) = step(&j, &done(\"built\"), AT + 9, &trial);","+    assert_eq!((j.stage, j.state), (Stage::Review, State::Stopped));","+    let diff = effects","+        .iter()","+        .position(|e| *e == Effect::CaptureDiff)","+        .unwrap();","+    let teardown = effects.iter().position(|e| *e == Effect::Teardown).unwrap();","+    assert!(diff < teardown, \"the diff is taken before the VM goes\");","+}"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-spikes/examples/fns.rs","hunks":[{"oldStart":4,"oldLines":9,"newStart":4,"newLines":25,"lines":[" async fn main() {","     let prefix = std::env::args().nth(1).unwrap_or_default();","     let iii = connect(\"spike-fns\");","-    let all = call_default(&iii, \"engine::functions::list\", json!({}), 10_000).await.expect(\"list\");","-    for f in all[\"functions\"].as_array().into_iter().flatten().filter(|f| f[\"f