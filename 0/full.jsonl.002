;","     let m1 = &fresh[1];","     assert_eq!(m1.first().unwrap(), \"PRAGMA defer_foreign_keys = ON\");","     assert_eq!(m1.last().unwrap(), \"PRAGMA user_version = 1\");"]},{"oldStart":156,"oldLines":7,"newStart":156,"newLines":13,"lines":["         m3.iter()","             .any(|s| s.starts_with(\"INSERT INTO jobs\") && s.contains(\"workflow_version, node\"))","     );","-    assert_eq!(transactions_at(3).len(), 1, \"nothing left to migrate\");","+    let m4 = &transactions_at(3)[1];","+    assert!(m4.iter().any(|s| s.contains(\"'shell'\") && s.starts_with(\"CREATE TABLE\")));","+    for table in [\"jobs\", \"artifacts\", \"turns\", \"workflow_nodes\"] {","+        let renamed = format!(\"UPDATE {table} SET stage = 'shell' WHERE stage = 'command'\");","+        assert!(m4.contains(&renamed), \"{table}\");","+    }","+    assert_eq!(transactions_at(4).len(), 1, \"nothing left to migrate\");"," }"," "," #[test]"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/seed/governance.sql","hunks":[{"oldStart":47,"oldLines":7,"newStart":47,"newLines":9,"lines":["   ('ci_fix', 'sandbox::*', 'allowed'),","   ('falsify', 'sandbox::*', 'allowed'),","   ('skill', 'sandbox::*', 'allowed'),","-  ('prompt', 'sandbox::*', 'allowed');","+  ('prompt', 'sandbox::*', 'allowed'),","+  ('agent', 'sandbox::*', 'allowed'),","+  ('command', 'sandbox::*', 'allowed');"," "," -- Workflows (D35): starting points for engineers, managers, and platform"," -- and SRE teams. Each lands a reviewed change, a document under docs/ or code, and"]},{"oldStart":70,"oldLines":7,"newStart":72,"newLines":7,"lines":[" WHERE NOT EXISTS (SELECT 1 FROM workflow_nodes WHERE workflow = column1);"," "," INSERT OR IGNORE INTO workflow_nodes (workflow, version, id, stage, run, dial, note, x, y) VALUES","-  ('incident-response', 1, 'recent-changes', 'command', 'git log --since=\"3 days ago\" --no-merges --stat --date=iso --pretty=format:\"%h %an %ad %s\"', 'dark', 'The changes that could have caused the incident.', 0, 0),","+  ('incident-response', 1, 'recent-changes', 'shell', 'git log --since=\"3 days ago\" --no-merges --stat --date=iso --pretty=format:\"%h %an %ad %s\"', 'dark', 'The changes that could have caused the incident.', 0, 0),","   ('incident-response', 1, 'plan', 'plan', '', 'dark', 'Triage the incident in the request: its symptoms, when it started and what it hits. Match it against the recent changes, the code and the config. Name the most likely cause with its evidence, and plan the smallest change that stops the impact.', 220, 0),","   ('incident-response', 1, 'build', 'build', '', 'dark', 'Make the smallest change that stops the impact: a revert, a feature flag turned off, or a config rollback. Write what you changed, why, and how to check that the impact stopped into docs/incidents/, named for the date and the incident.', 440, 0),","   ('incident-response', 1, 'land', 'land', '', 'lights_on', '', 660, 0),"]},{"oldStart":86,"oldLines":7,"newStart":88,"newLines":7,"lines":["   ('test-coverage', 1, 'plan', 'plan', '', 'dark', 'Find the code paths the request names, or the riskiest untested ones. For each, say why it matters and which test would cover it.', 0, 0),","   ('test-coverage', 1, 'build', 'build', '', 'dark', 'Add a test for each gap. Change no product code. If a test finds a bug, mark the test as expected to fail and say so.', 220, 0),","   ('test-coverage', 1, 'land', 'land', '', 'lights_on', '', 440, 0),","-  ('weekly-status', 1, 'changes', 'command', 'git log --since=\"7 days ago\" --no-merges --stat --pretty=format:\"%h %an %s\"', 'dark', 'What changed in the last week.', 0, 0),","+  ('weekly-status', 1, 'changes', 'shell', 'git log --since=\"7 days ago\" --no-merges --stat --pretty=format:\"%h %an %s\"', 'dark', 'What changed in the last week.', 0, 0),","   ('weekly-status', 1, 'status', 'prompt', '', 'dark', 'Write a status update for stakeholders from the changes: what shipped, what is in progress, and the risks or blockers. Group by theme, not by commit, in plain words.', 220, 0),","   ('weekly-status', 1, 'build', 'build', '', 'dark', 'Write the status update into docs/status/, named for today. Change no other file.', 440, 0),","   ('weekly-status', 1, 'land', 'land', '', 'lights_on', '', 660, 0),"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-server/src/store/tests.rs","/Users/tacoda/tacoda/bastion/seed/governance.sql"]}},"serverClassifierContext":{"request":"a4e53e77-5185-42bc-a30a-427fd06df50c","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":10,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"8f171bef-c9fe-4a4c-9aca-1a1dd592bc21","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
