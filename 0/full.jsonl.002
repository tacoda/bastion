 Result<String, String> {\n    let image = match typed.trim() {\n        \"\" => \"python\",\n        named => named,\n    };\n    match IMAGES.contains(&image) {\n        true => Ok(image.into()),\n        false => Err(format!(\"{image:?} is not an image: {}\", IMAGES.join(\", \"))),\n    }\n}\n\n/// A branch prefix, trimmed, or why git would refuse a branch named with it.\nfn prefix(machine: &Arc<dyn Machine>, typed: &str) -> Result<String, String> {\n    let prefix = typed.trim();","is_error":false}]},"uuid":"46dae0e3-3945-485f-afb8-27d66fd20168","timestamp":"2026-11-11T18:50:16.543Z","toolUseResult":{"stdout":"7\n    };\n    let settings = WorkspaceSettings {\n        branch: w.branch,\n        checks: w.checks,\n        max_jobs: w.max_jobs,\n        revision_budget: w.revision_budget,\n        branch_prefix: w.branch_prefix,\n        setup: w.setup,\n        cleanup: w.cleanup,\n        env: w.env,\n        gates: w.gates,\n        autofix: w.autofix,\n        image: w.image,\n    };\n    settle(machine, &mut row, settings)?;\n    factory(cell)?.store().add_workspace(&row).await\n}\n\n/// What a person may change in a workspace.\n#[derive(Deserialize)]\npub struct WorkspaceSettings {\n    pub branch: String,\n    pub checks: String,\n    pub max_jobs: Option<u32>,\n    pub revision_budget: Option<u32>,\n    pub branch_prefix: String,\n    pub setup: String,\n    pub cleanup: String,\n    pub env: String,\n    pub gates: String,\n    pub autofix: String,\n    /// `python`, `node` or `browser`; empty keeps `python`.\n    #[serde(default)]\n    pub image: String,\n}\n\n/// The images a workspace's VMs may boot: the sandbox's presets, and the\n/// browser image the stack registers.\nconst IMAGES: [&str; 3] = [\"python\", \"node\", \"browser\"];\n\n/// Change a workspace's settings. Its name and its path stay.\n    row.env = s.env.trim().into();\n    row.env_vars()?;\n    row.checks = s.checks.trim().into();\n    row.max_jobs = s.max_jobs.filter(|n| *n > 0);\n    r