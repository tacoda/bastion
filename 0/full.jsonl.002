{","-        self.gate_change(record).await?;","-        self.verdict(record).await?;","-        let (path, target) = self.bring_back(record).await?;","-        self.keep_commits(record, &path, &target).await;","-        Ok(match self.forge_for(&path).await? {","-            Forge::Github => Event::PrOpened {","-                url: self.pull_request(record, &path, &target).await?,","-            },","-            Forge::Local => Event::StepPassed,","-        })","-    }","-","-    /// The server's forge, except that a repository with no `origin`","-    /// remote has nowhere to push, so its change lands here.","-    async fn forge_for(&self, path: &Path) -> Result<Forge, String> {","-        let forge = settings_store::current(&*self.store).await?.forge;","-        match forge::has_origin(&*self.machine, path) {","-            true => Ok(forge),","-            false => Ok(Forge::Local),","-        }","-    }","-","     /// Bring the VM's commits back to the job's worktree. Returns the","     /// worktree's path and the workspace branch the change goes into.","     pub(super) async fn bring_back(&self, record: &Record) -> Result<(PathBuf, String), String> {"]},{"oldStart":132,"oldLines":34,"newStart":85,"newLines":6,"lines":["         Ok((path, self.workspace(record).await?.branch))","     }"," ","-    /// Push the job's branch and open its pull request, or reuse the one a","-    /// fix turn pushes to. Returns the pull request's URL.","-    pub(super) async fn pull_request(","-        &self,","-        record: &Record,","-        path: &Path,","-        base: &str,","-    ) -> Result<String, String> {","-        let job = &record.job;","-        let slug = forge::slug(&*self.machine, path)?;","-        // ponytail: a prefix changed while the PR is open sends a fix to a new branch; keep the pushed branch on the job if that bites.","-        // The branch a job's change goes up on: its workspace's prefix, then its id.","-        let pr = self.pr_text(record, base).aw