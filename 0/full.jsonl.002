\n157\t    j.results.insert(\"plan\".into(), \"1. Add x.\".into());\n158\t    let (fixing, effects) = go(\n159\t        &j,\n160\t        Event::StepFailed {\n161\t            detail: \"1 failed\".into(),\n162\t        },\n163\t    );\n164\t    assert_eq!(fixing.node.as_deref(), Some(\"build\"), \"plan only reads\");\n165\t    assert_eq!(kinds(&effects), [\"artifact\", \"turn\"]);\n166\t    assert!(fixing.feedback.as_deref().unwrap().contains(\"1 failed\"));\n167\t    let mut again = fixing.clone();\n168\t    (again.node, again.stage) = (Some(\"tests\".into()), Stage::Shell);\n169\t    let (same, _) = go(\n170\t        &again,\n171\t        Event::StepFailed {\n172\t            detail: \"1 failed\".into(),\n173\t        },\n174\t    );\n175\t    assert_eq!(\n176\t        same.state,\n177\t        State::NeedsYou,\n178\t        \"the same failure word for word waits\"\n179\t    );\n180\t    let spent = Bounds {\n181\t        revision_budget: Some(1),\n182\t        ..Bounds::default()\n183\t    };\n184\t    let (budget, _) = step(\n185\t        &again,\n186\t        &Event::StepFailed {\n187\t            detail: \"2 failed\".into(),\n188\t        },\n189\t        AT,\n190\t        &spent,\n191\t    );\n192\t    assert!(\n193\t        budget\n194\t            .error\n195\t            .unwrap()\n196\t            .starts_with(\"The revision budget of 1 is spent.\")\n197\t    );\n198\t}\n199\t\n200\t#[test]\n201\tfn a_note_sends_the_work_back_and_an_answer_goes_to_the_step_that_asked() {\n202\t    let mut j = job([Dial::LightsOn; 3]);\n203\t    (j.node, j.stage, j.state) = (Some(\"tests\".into()), Stage::Shell, State::NeedsYou);\n204\t    j.results.insert(\"plan\".into(), \"1. Add x.\".into());\n205\t    let (back, effects) = go(\n206\t        &j,\n207\t        Event::Commented {\n208\t            text: \"Name it y.\".into(),\n209\t        },\n210\t    );\n211\t    assert_eq!(\n212\t        (back.node.as_deref(), kinds(&effects)),\n213\t        (Some(\"build\"), vec![\"turn\"])\n214\t    );\n215\t    assert_eq!(back.feedback.as_deref(), Some(\"Name it y.\"));\n216\t    let asked = Event::TurnFinished {\n217\t        outcome: Outcome::Asked {\n218\t            question: \"Which file?\".into(),\n219\t        },\n220\t    };\n221\t    let (waits, _) = go(&job([Dial::Dark; 3]), asked);\n222\t    assert_eq!(actions(&waits), [Action::Answer, Action::Stop]);\n223\t    let (answered, _) = go(\n224\t        &waits,\n225\t        Event::Commented {\n226\t            text: \"calc.py\".into(),\n227\t        },\n228\t    );\n229\t    assert_eq!(answered.node.as_deref(), Some(\"plan\"));\n230\t    assert!(answered.feedback.unwrap().contains(\"The answer: calc.py\"));\n231\t}\n232\t\n233\t#[test]\n234\tfn a_reply_without_its_result_gets_one_more_try_then_waits() {\n235\t    let j = job([Dial::Dark; 3]);\n236\t    let (retry, effects) = go(&j, done(\"No plan here.\"));\n237\t    assert_eq!(\n238\t        (retry.state, kinds(&effects)),\n239\t        (State::Running, vec![\"artifact\", \"turn\"])\n240\t    );\n241\t    assert!(retry.feedback.unwrap().contains(\"RESULT plan:\"));\n242\t    let (j, _) = go(&j, done(\"No plan here.\"));\n243\t    let (waits, _) = go(&j, done(\"Still none.\"));\n244\t    assert_eq!(waits.state, State::NeedsYou);\n245\t}\n246\t\n247\t#[test]\n248\tfn a_step_shows_where_it_stands_and_a_queue_admits_by_its_limits() {\n249\t    let mut j = job([Dial::Dark; 3]);\n250\t    j.node = Some(\"build\".into());\n251\t    let shown: Vec<StepState> = steps(&j).into_iter().map(|s| s.2).collect();\n252\t    assert_eq!(\n253\t        shown,\n254\t        [StepState::Done, StepState::Running, StepState::Pending]\n255\t    );\n256\t    let queued = |id: &str, w: &str| Job::new(id.into(), w.into(), \"r\".into(), AT);\n257\t    let jobs = [queued(\"a\", \"w\"), queued(\"b\", \"w\"), queued(\"c\", \"v\")];\n258\t    assert_eq!(admit(&jobs, 2, |w| (w == \"w\").then_some(1)), [\"a\", \"c\"]);\n259\t}\n260\t\n</system-reminder>"}],"renderedRole":"system","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"cf3b8df3-9a0b-4619-b443-bbc3edb8c388","isSidechain":false,"attachment":{"type":"file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/settings.rs","content":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/settings.rs","content":"//! The owner's settings (DECISIONS.md D23): the models turns run on, the\n//! tracker requests may come from, and whether intake is open. They are kept\n//! as versions of key/value pairs, so any version can be restored. A step's\n//! dial is its workflow's, not a setting (D39).\n\nuse serde::{Deserialize, Serialize};\n\n#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\npub struct Model {\n    pub provider: String,\n    pub model: String,\n}\n\nimpl Model {\n    /// A model written as `provider/model`.\n    pub fn named(text: &str) -> Option<Model> {\n        let (provider, model) = text.trim().split_once('/')?;\n        let (provider, model) = (provider.trim(), model.trim());\n        (!provider.is_empty() && !model.is_empty()).then(|| Model {\n            provider: provider.into(),\n            model: model.into(),\n        })\n    }\n}\n\nimpl Default for Model {\n    fn default() -> Self {\n        Model {\n            provider: \"openai\".into(),\n            model: \"gpt-5-mini\".into(),\n        }\n    }\n}\n\n/// Where requests may come from besides the app.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\n#[serde(rename_all = \"snake_case\")]\npub enum Tracker {\n    #[default]\n    None,\n    GithubIssues,\n}\n\n#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]\npub struct Settings {\n    /// The model a step that only reads runs on, such as a plan.\n    pub plan_model: Model,\n    /// The model every other agent's step runs on.\n    pub build_model: Model,\n    pub tracker: Tracker,\n    pub intake_paused: bool,\n}\n\nfn intake(paused: bool) -> &'static str {\n    match paused {\n        true => \"paused\",\n        false => \"open\",\n    }\n}\n\nconst TRACKERS: [(Tracker, &str); 2] = [\n    (Tracker::None, \"none\"),\n    (Tracker::GithubIssues, \"github_issues\"),\n];\n\nimpl Settings {\n    /// The model a turn runs on: the job's own when it named one, else the\n    /// plan model for a step that only reads and the build model for the rest.\n    pub fn model_for(&self, reads_only: bool, job_model: Option<&str>) -> Model {\n        let kept = match reads_only {\n            true => &self.plan_model,\n            false => &self.build_model,\n        };\n        job_model\n            .and_then(Model::named)\n            .unwrap_or_else(|| kept.clone())\n    }\n\n    /// The settings as the key/value pairs a version keeps, in a fixed order.\n    pub fn to_pairs(&self) -> Vec<(String, String)> {\n        let tracker = TRACKERS.iter().find(|(t, _)| *t == self.tracker);\n        [\n            (\"model.plan.provider\", self.plan_model.provider.clone()),\n            (\"model.plan.model\", self.plan_model.model.clone()),\n            (\"model.build.provider\", self.build_model.provider.clone()),\n            (\"model.build.model\", self.build_model.model.clone()),\n            (\"tracker\", tracker.map_or(\"\", |(_, w)| w).to_string()),\n            (\"intake\", intake(self.intake_paused).into()),\n        ]\n        .map(|(k, v)| (k.to_string(), v))\n        .into()\n    }\n\n    pub fn from_pairs(pairs: &[(String, String)]) -> Settings {\n        let get = |key: &str| {\n            pairs\n                .iter()\n                .find(|(k, _)| k == key)\n                .map(|(_, v)| v.as_str())\n        };\n        let mut s = Settings::default();\n        let text = |key: &str, into: &mut String| {\n            if let Some(v) = get(key).filter(|v| !v.trim().is_empty()) {\n                *into = v.trim().into();\n            }\n        };\n        text(\"model.plan.provider\", &mut s.plan_model.provider);\n        text(\"model.plan.model\", &mut s.plan_model.model);\n        text(\"model.build.provider\", &mut s.build_model.provider);\n        text(\"model.build.model\", &mut s.build_model.model);\n        s.tracker = get(\"tracker\")\n            .and_then(|w| TRACKERS.iter().find(|(_, t)| *t == w).map(|(v, _)| *v))\n            .unwrap_or_default();\n        s.intake_paused = get(\"intake\") == Some(intake(true));\n        s\n    }\n\n    pub fn changes(&self, before: &Settings) -> Vec<String> {\n        let (now, was) = (self.to_pairs(), before.to_pairs());\n        now.iter()\n            .zip(&was)\n            .filter(|(n, w)| n.1 != w.1)\n            .map(|(n, w)| format!(\"{}: {} -> {}\", n.0, w.1, n.1))\n            .collect()\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_turn_runs_on_the_jobs_model_or_the_one_for_what_it_does() {\n        let s = Settings {\n            plan_model: Model::named(\"anthropic/claude-sonnet-5-5\").unwrap(),\n            ..Settings::default()\n        };\n        let own = s.model_for(false, Some(\"deepseek/deepseek-flash\"));\n        assert_eq!(\n            (own.provider.as_str(), own.model.as_str()),\n            (\"deepseek\", \"deepseek-flash\")\n        );\n        assert_eq!(s.model_for(true, None), s.plan_model);\n        assert_eq!(s.model_for(false, None), s.build_model);\n        assert_eq!(Model::named(\"no-slash\"), None);\n        assert_eq!(Model::named(\"openai/ \"), None);\n    }\n\n    #[test]\n    fn settings_round_trip_through_their_pairs_and_name_what_moved() {\n        let s = Settings {\n            plan_model: Model::named(\"anthropic/claude-sonnet-5-5\").unwrap(),\n            build_model: Model::default(),\n            tracker: Tracker::GithubIssues,\n            intake_paused: true,\n        };\n        assert_eq!(Settings::from_pairs(&s.to_pairs()), s);\n        let open = Settings::default();\n        assert!(open.to_pairs().contains(&(\"intake\".into(), \"open\".into())));\n        assert_eq!(\n            s.changes(&open)[0],\n            \"model.plan.provider: openai -> anthropic\"\n        );\n        let old = [\n            (\"step.plan\", \"dark\"),\n            (\"forge\", \"github\"),\n            (\"tracker\", \"jira\"),\n        ]\n        .map(|(k, v)| (k.to_string(), v.to_string()));\n        assert_eq!(\n            Settings::from_pairs(&old),\n            Settings::default(),\n            \"old keys are ignored\"\n        );\n    }\n}\n","numLines":177,"startLine":1,"totalLines":177}},"displayPath":"crates/bastion-core/src/settings.rs"},"type":"attachment","uuid":"30fae46a-16a6-4f18-a5c9-67e1dc981576","timestamp":"2026-11-11T21:30:14.584Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/settings.rs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t//! The owner's settings (DECISIONS.md D23): the models turns run on, the\n2\t//! tracker requests may come from, and whether intake is open. They are kept\n3\t//! as versions of key/value pairs, so any version can be restored. A step's\n4\t//! dial is its workflow's, not a setting (D39).\n5\t\n6\tuse serde::{Deserialize, Serialize};\n7\t\n8\t#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]\n9\tpub struct Model {\n10\t    pub provider: String,\n11\t    pub model: String,\n12\t}\n13\t\n14\timpl Model {\n15\t    /// A model written as `provider/model`.\n16\t    pub fn named(text: &str) -> Option<Model> {\n17\t        let (provider, model) = text.trim().split_once('/')?;\n18\t        let (provider, model) = (provider.trim(), model.trim());\n19\t        (!provider.is_empty() && !model.is_empty()).then(|| Model {\n20\t            provider: provider.into(),\n21\t            model: model.into(),\n22\t        })\n23\t    }\n24\t}\n25\t\n26\timpl Default for Model {\n27\t    fn default() -> Self {\n28\t        Model {\n29\t            provider: \"openai\"