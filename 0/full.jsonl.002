     feedback: BTreeMap::new(),","             toggled: BTreeSet::new(),","             turn_open: false,","+            pick: None,","             marks: BTreeMap::new(),","             docs: BTreeMap::new(),","         }"]},{"oldStart":69,"oldLines":7,"newStart":72,"newLines":8,"lines":["     Read(Result<Box<JobDetail>, String>),","     Edit(text_editor::Action),","     EditParts(text_editor::Action),","-    CommentAt(String),","+    /// A click on a diff line: its file and its line.","+    CommentAt(String, u32),","     Act(Action),","     Acted(Result<(), String>),","     Feedback(String, String),"]},{"oldStart":129,"oldLines":6,"newStart":133,"newLines":40,"lines":["     note.perform(text_editor::Action::Move(text_editor::Motion::DocumentEnd));"," }"," ","+/// A click on a diff line names it in the note. A shift-click on a line of","+/// the same file widens what the last click named into a range instead.","+fn comment_at(state: &mut State, path: String, n: u32, shift: bool) {","+    let before = state.pick.take();","+    let widened = before","+        .as_ref()","+        .filter(|_| shift)","+        .and_then(|p| p.to(&path, n));","+    let pick = match (widened, before) {","+        (Some(wide), Some(before)) => {","+            rename(&mut state.note, &before.reference(), &wide.reference());","+            wide","+        }","+        _ => {","+            let one = diff::Pick::line(path, n);","+            append(&mut state.note, &one.reference());","+            one","+        }","+    };","+    state.pick = Some(pick);","+}","+","+/// Put `new` where the note last says `old`; append it if the note no","+/// longer says `old`.","+fn rename(note: &mut text_editor::Content, old: &str, new: &str) {","+    let t = note.text();","+    let Some(at) = t.rfind(old) else {","+        return append(note, new);","+    };","+    let renamed = format!(\"{}{new}{}\", &t[..at], &t[at + old.len()..]);","+    *note = text_editor::Content::with_text(&renamed);","+    note.perform(text_editor::Action::Move(text_editor::Motion::DocumentEnd));","+}","+"," /// Approve, send back or answer with the note, or stop."," fn act(state: &State, ctx: &Ctx, action: Action) -> Task<Message> {","     let id = state.id.clone();"]},{"oldStart":181,"oldLines":11,"newStart":219,"newLines":12,"lines":["             state.parts_edited |= action.is_edit();","             state.parts.perform(action);","         }","-        Msg::CommentAt(at) => append(&mut state.note, &at),","+        Msg::CommentAt(path, n) => comment_at(state, path, n, ctx.shift),","         Msg::Act(action) => return act(state, ctx, action),","         Msg::Acted(Ok(_)) => {","             state.parts_edited = false;","             state.note = text_editor::Content::new();","+            state.pick = None;","             state.error.clear();","         }","         Msg::Feedback(call, text) => {"]},{"oldStart":517,"oldLines":12,"newStart":556,"newLines":15,"lines":["         body = body.extend(report.map(|r| doc(state, r)));","         if let Some(change) = change {","             body = body.push(","-                text(\"The change (click a line to comment on it)\")","-                    .size(13)","-                    .font(theme::BOLD)","-                    .color(theme::MUTED),","+                text(","+                    \"The change (click a line to comment on it; shift-click to take in more lines)\",","+                )","+                .size(13)","+                .font(theme::BOLD)","+                .color(theme::MUTED),","             );","-            body = body.push(diff::view(&change, |at| Message::Job(Msg::CommentAt(at))));","+            let comment = |path, n| Message::Job(Msg::CommentAt(path, n));","+            body = body.push(diff::view(&change, comment, state.pick.as_ref()));","         }","     }","     body = body.extend(parts(state));"]},{"oldStart":844,"oldLines":6,"newStart":886,"newLines":24,"lines":["         assert!(lines(\"\").is_empty());","     }"," ","+    #[test]","+    fn a_shift_click_widens_the_last_line_named_to_a_range() {","+        let mut state = State::new(\"j1\".into());","+        state.note = text_editor::Content::with_text(\"Fix this\");","+        comment_at(&mut state, \"calc.py\".into(), 12, false);","+        comment_at(&mut state, \"calc.py\".into(), 15, true);","+        assert_eq!(state.note.text(), \"Fix this\\ncalc.py:12-15: \");","+        comment_at(&mut state, \"calc.py\".into(), 9, true);","+        assert_eq!(state.note.text(), \"Fix this\\ncalc.py:9-15: \");","+        // Another file, or no shift, starts a new line of the note.","+        comment_at(&mut state, \"main.py\".into(), 3, true);","+        comment_at(&mut state, \"main.py\".into(), 4, false);","+        assert_eq!(","+            state.note.text(),","+            \"Fix this\\ncalc.py:9-15: \\nmain.py:3: \\nmain.py:4: \"","+        );","+    }","+","     #[test]","     fn a_click_on_a_line_starts_a_comment_on_its_own_line() {","         let mut note = text_editor::Content::with_text(\"Fix this\");"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/jobs.rs","hunks":[{"oldStart":187,"oldLines":8,"newStart":187,"newLines":7,"lines":[" }"," "," fn job_row<'a>(sj: ServerJob, down: bool) -> Element<'a, Message> {","-    let mut about =","-        column![text(title(&sj.job.request)).size(15).font(theme::MEDIUM)].spacing(3);","+    let mut about = column![text(title(&sj.job.request)).size(15).font(theme::MEDIUM)].spacing(3);","     if let Some(p) = &sj.job.part {","         about = about.push(text(format!(\"Part: {p}\")).size(13));","     }"]},{"oldStart":393,"oldLines":7,"newStart":392,"newLines":10,"lines":[" ","     #[test]","     fn a_long_request_is_cut_at_a_word_for_its_row() {","-        assert_eq!(title(\"Add shout(x) to calc.py.\"), \"Add shout(x) to calc.py.\");","+        assert_eq!(","+            title(\"Add shout(x) to calc.py.\"),","+            \"Add shout(x) to calc.py.\"