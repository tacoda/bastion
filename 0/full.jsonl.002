ql, json!([id]), eval_of).await?;","+            found","+                .into_iter()","+                .next()","+                .ok_or_else(|| format!(\"no eval {id}\"))","+        })","+    }","+","+    fn arm<'a>(&'a self, eval: &'a str, arm: &'a str) -> Answer<'a, Vec<Override>> {","+        Box::pin(async move {","+            let sql = \"SELECT kind, target, stage, rung FROM eval_arms WHERE eval = ? AND arm = ? ORDER BY rowid\";","+            self.rows(sql, json!([eval, arm]), override_of).await","+        })","+    }","+","+    fn add_eval_run<'a>(&'a self, r: &'a EvalRun) -> Answer<'a, ()> {","+        Box::pin(async move {","+            let sql = format!(\"INSERT INTO eval_runs ({RUN_COLUMNS}) VALUES (?, ?, ?, ?, ?, ?)\");","+            self.execute(","+                &sql,","+                json!([r.eval, r.arm, r.idx, r.request, r.job, r.grade]),","+            )","+            .await","+            .map(|_| ())","+        })","+    }","+","+    fn eval_runs<'a>(&'a self, eval: &'a str) -> Answer<'a, Vec<EvalRun>> {","+        Box::pin(async move {","+            let sql =","+                format!(\"SELECT {RUN_COLUMNS} FROM eval_runs WHERE eval = ? ORDER BY idx, arm\");","+            self.rows(&sql, json!([eval]), run_of).await","+        })","+    }","+","+    fn eval_run_of<'a>(&'a self, job: &'a str) -> Answer<'a, Option<EvalRun>> {","+        Box::pin(async move {","+            let sql = format!(\"SELECT {RUN_COLUMNS} FROM eval_runs WHERE job = ?\");","+            Ok(self","+                .rows(&sql, json!([job]), run_of)","+                .await?","+                .into_iter()","+                .next())","+        })","+    }","+","+    fn set_grade<'a>(&'a self, job: &'a str, grade: u8) -> Answer<'a, ()> {","+        Box::pin(async move {","+            self.execute(","+                \"UPDATE eval_runs SET grade = ? WHERE job = ?\",","+                json!([grade, job]),","+            )","+            .await","+            .map(|_| ())","+        })","+    }","+}","+","+#[cfg(test)]","+pub mod fake {","+    use std::sync::Mutex;","+","+    use super::*;","+    use crate::store::fake::FakeStore;","+","+    /// The eval rows the fake store keeps.","+    #[derive(Default)]","+    pub struct EvalRows {","+        pub turns: Mutex<Vec<Turn>>,","+        pub evals: Mutex<Vec<(Eval, Vec<Override>, Vec<Override>)>>,","+        pub runs: Mutex<Vec<EvalRun>>,","+    }","+","+    fn ready<T: Send + 'static>(value: Result<T, String>) -> Answer<'static, T> {","+        Box::pin(async move { value })","+    }","+","+    impl EvalStore for FakeStore {","+        fn add_turn<'a>(&'a self, t: &'a Turn) -> Answer<'a, ()> {","+            self.eval_rows.turns.lock().unwrap().push(t.clone());","+            ready(Ok(()))","+        }","+","+        fn turns<'a>(&'a self, job: &'a str) -> Answer<'a, Vec<Turn>> {","+            let found = self","+                .eval_rows","+                .turns","+                .lock()","+                .unwrap()","+                .iter()","+                .filter(|t| t.job == job)","+                .cloned()","+                .collect();","+            ready(Ok(found))","+        }","+","+        fn add_eval<'a>(","+            &'a self,","+            e: &'a Eval,","+            a: &'a [Override],","+            b: &'a [Override],","+        ) -> Answer<'a, ()> {","+            self.eval_rows","+                .evals","+                .lock()","+                .unwrap()","+                .push((e.clone(), a.to_vec(), b.to_vec()));","+            ready(Ok(()))","+        }","+","+        fn evals(&self) -> Answer<'_, Vec<Eval>> {","+            let all = self","+                .eval_rows","+                .evals","+                .lock()","+                .unwrap()","+                .iter()","+                .rev()","+                .map(|(e, ..)| e.clone())","+                .collect();","+            ready(Ok(all))","+        }","+","+        fn eval<'a>(&'a self, id: &'a str) -> Answer<'a, Eval> {","+            let found = self","+                .eval_rows","+                .evals","+                .lock()","+                .unwrap()","+                .iter()","+                .find(|(e, ..)| e.id == id)","+                .map(|(e, ..)| e.clone());","+            ready(found.ok_or_else(|| format!(\"no eval {id}\")))","+        }","+","+        fn arm<'a>(&'a self, eval: &'a str, arm: &'a str) -> Answer<'a, Vec<Override>> {","+            let evals = self.eval_rows.evals.lock().unwrap();","+            let found = evals","+                .iter()","+                .find(|(e, ..)| e.id == eval)","+                .map(|(_, a, b)| if arm == \"a\" { a.clone() } else { b.clone() });","+            ready(Ok(found.unwrap_or_default()))","+        }","+","+        fn add_eval_run<'a>(&'a self, r: &'a EvalRun) -> Answer<'a, ()> {","+            self.eval_rows.runs.lock().unwrap().push(r.clone());","+            ready(Ok(()))","+        }","+","+        fn eval_runs<'a>(&'a self, eval: &'a str) -> Answer<'a, Vec<EvalRun>> {","+            let found = self","+                .eval_rows","+                .runs","+                .lock()","+                .unwrap()","+                .iter()","+                .filter(|r| r.eval == eval)","+                .cloned()","+                .collect();","+            ready(Ok(found))","+        }","+","+        fn eval_run_of<'a>(&'a self, job: &'a str) -> Answer<'a, Option<EvalRun>> {","+            let found = self","+                .eval_rows","+                .runs","+                .lock()","+                .unwrap()","+                .iter()","+                .find(|r| r.job == job)","+                .cloned();","+            ready(Ok(found))","+        }","+","+        fn set_grade<'a>(&'a self, job: &'a str, grade: u8) -> Answer<'a, ()> {","+            for r in self","+                .eval_rows","+                .runs","+                .lock()","+                .unwrap()","+                .iter_mut()","+                .filter(|r| r.job == job)","+            {","+                r.grade = Some(grade);","+            }","+            ready(Ok(()))","+        }","+    }","+}","+","+#[cfg(test)]","+mod tests {","+    use super::*;","+    use bastion_core::govern::{Access, Enforcement};","+","+    #[test]","+    fn overrides_read_back_from_their_rows() {","+        let overrides = [","+            Override::Constraint {","+                id: \"keep-tests\".into(),","+                rung: Enforcement::Enforced,","+            },","+            Override::Capability {","+                stage: Stage::Plan,","+                function: \"sandbox::fs::write\".into(),","+                rung: Access::Allowed,","+            },","+        ];","+        for o in overrides {","+            let (kind, target, stage, rung) = override_row(&o);","+            let row = json!({ \"kind\": kind, \"target\": target, \"stage\": stage, \"rung\": rung });","+            assert_eq!(override_of(&row).unwrap(), o);","+        }","+    }","+","+    #[test]","+    fn a_run_row_reads_back_with_or_without_a_grade() {","+        let row =","+            json!({ \"eval\": \"e1\", \"arm\": \"b\", \"idx\": 2, \"request\": \"r\", \"job\": \"j1\", \"grade\": 7 });","+        assert_eq!(run_of(&row).unwrap().grade, Some(7));","+        let ungraded = json!({ \"eval\": \"e1\", \"arm\": \"b\", \"idx\": 2, \"request\": \"r\", \"job\": \"j1\", \"grade\": null });","+        assert_eq!(run_of(&ungraded).unwrap().grade, None);","     }"," }"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/src-tauri/src/lib.rs","hunks":[{"oldStart":7,"oldLines":6,"newStart":7,"newLines":7,"lines":[" mod console;"," mod doctor;"," mod engine;","+mod eval_store;"," mod factory;"," mod gate;"," mod machine;"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/src-tauri/src/store.rs","hunks":[{"oldStart":14,"oldLines":6,"newStart":14,"newLines":7,"lines":[" use serde_json::{V