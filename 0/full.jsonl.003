View, look: (bool, bool)) {\n    let (picked, failure) = look;\n    let [start, c1, c2, end] = curve(from, to);\n    let color = match (picked, failure) {\n        (true, _) => theme::PRIMARY,\n        (false, true) => theme::BAD,\n        (false, false) => theme::MUTED,\n    };\n    let line = Path::new(|p| {\n        p.move_to(start);\n        p.bezier_curve_to(c1, c2, end);\n    });\n    let mut stroke = Stroke::default().with_width(2.0).with_color(color);\n    if failure {\n        stroke.line_dash = LineDash {\n            segments: &[6.0, 4.0],\n            offset: 0,\n        };\n    }\n    frame.stroke(&line, stroke);'''),\n('''                link(\n                    &mut frame,\n                    from,\n                    to,\n                    *self.picked == Pick::Link(l.from.clone(), l.to.clone()),\n                );''','''                let picked = *self.picked == Pick::Link(l.from.clone(), l.to.clone());\n                link(&mut frame, from, to, (picked, l.failure));'''),\n])\nedit('bastion-desktop/src/pages/workflows.rs',[\n('''    RemoveLink,''','''    RemoveLink,\n    /// Make the picked link a failure link, or a success link again.\n    FailureLink(bool),'''),\n('''        Msg::RemoveLink => {''','''        Msg::FailureLink(on) => {\n            if let (Pick::Link(from, to), Some(w)) = (&state.picked, state.draft.as_mut()) {\n                let picked = w.links.iter_mut().find(|l| &l.from == from && &l.to == to);\n                picked.into_iter().for_each(|l| l.failure = on);\n            }\n        }\n        Msg::RemoveLink => {'''),\n('''            let body = column![\n                text(format!(\"The link from {from} to {to}\")),\n                small(\"Remove link\", Some(wrap(Msg::RemoveLink)))\n            ]\n            .spacing(8);''','''            let failure = state\n                .draft\n                .as_ref()\n                .and_then(|w| w.links.iter().find(|l| &l.from == from && &l.to == to))\n             