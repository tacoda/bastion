n-core/src/lib.rs:220:    pub revision_budget: Option<u32>,\nbastion-core/src/lib.rs:288:            revisions: BTreeMap::new(),\nbastion-core/src/lib.rs:331:    fn fixer(&self) -> Option<usize> {\nbastion-core/src/lib.rs:497:fn step_failed(job: &mut Job, detail: &str, bounds: &Bounds) -> Vec<Effect> {\nbastion-core/src/lib.rs:502:        let budget = bounds.revision_budget.unwrap_or_default();\nbastion-core/src/lib.rs:506:    let tries = job.revisions.entry(at).or_default();\nbastion-core/src/lib.rs:507:    if *tries >= MAX_REVISIONS || job.last_refusal.as_deref() == Some(detail) {\nbastion-core/src/lib.rs:522:    let spent: u32 = job.revisions.values().sum();\nbastion-core/src/lib.rs:523:    bounds.revision_budget.is_some_and(|budget| spent >= budget)\nbastion-core/src/lib.rs:528:fn stuck(job: &mut Job, error: &str) -> Vec<Effect> {\nbastion-core/src/lib.rs:660:fn bad_reply(job: &mut Job, problem: &str) -> Vec<Effect> {\nbastion-core/src/lib.rs:662:    let tries = job.revisions.entry(at).or_default();\nbastion-server/src/factory.rs:704:        let model = settings.model_for(reads_only, record.runtime.model.as_deref());\nbastion-server/src/factory/onboard.rs:100:        let model = settings.model_for(true, None);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"b9c34069-ff8a-4f4e-98d5-4bcfefe31bbd","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"b05fbf37-4918-48ca-ae96-4b7187d85070","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion