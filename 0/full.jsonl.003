ch repository; the harness binds an agent's turn; the factory binds the pipeline.\"\n        </p>\n        <CharterRules />\n        <ConstraintsList layer=\"harness\" title=\"Harness: rules on an agent's calls\" constraints=g.constraints audit=g.audit step=step />\n        <ConstraintsList layer=\"factory\" title=\"Factory: rules on the pipeline, checked at review\" constraints=g.constraints audit=g.audit step=step />\n        <AddConstraint added=move |r| g.done(r) />\"\"\")\nrep(\"\"\"        {heading(\"Capabilities\", g)}\n        <GrantsList grants=g.grants step=step />\"\"\",\"\"\"        {heading(\"Capabilities\", g)}\n        <CharterAllows />\n        <GrantsList grants=g.grants step=step />\n        <FactoryCapabilities />\"\"\")\nrep(\"\"\"        <h2 class=\"m-0 border-b border-line px-3 py-2 text-sm font-semibold text-muted\">\n            \"Capabilities: denied, then ask (held for you), then allowed, per stage\"\n        </h2>\"\"\",\"\"\"        <h2 class=\"m-0 border-b border-line px-3 py-2 text-sm font-semibold text-muted\">\n            \"Harness: what an agent's calls may do per stage: denied, then ask (held for you), then allowed\"\n        </h2>\"\"\")\ns=s.rstrip(\"\\n\")+'''\n\nconst SECTION: &str = \"mb-4 rounded-xl border border-line bg-panel\";\nconst SECTION_TITLE: &str = \"m-0 border-b border-line px-3 py-2 text-sm font-semibold text-muted\";\n\n/// Read a list command once and on every push.\nfn listed<T: serde::de::DeserializeOwned + Send + Sync + 'static>(cmd: &'static str) -> ReadSignal<Vec<T>> {\n    let (all, set_all) = signal(Vec::<T>::new());\n    let load = move || {\n        spawn_local(async move {\n            if let Ok(v) = ipc::call::<Vec<T>, String>(cmd, None {}).await {\n                set_all.set(v);\n            }\n        });\n    };\n    ipc::listen(event::JOB_CHANGED, move |_: String| load());\n    load();\n    all\n}\n\n/// Lines under a label, or nothing when there are none.\nfn lines(label: &'static str, items: Ve