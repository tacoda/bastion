259,"newLines":17,"lines":[" #[cfg(test)]"," mod tests {","     use super::*;","+","+    #[test]","+    fn a_reviewer_s_last_verdict_line_decides() {","+        let fail = verdict(\"security\", \"Leaks a key.\\nVERDICT: fail\");","+        assert!(matches!(fail, Some(Verdict::Fail { detail }) if detail.contains(\"Leaks a key\")));","+        assert_eq!(","+            verdict(\"security\", \"Fine.\\nVERDICT: Pass\"),","+            Some(Verdict::Pass)","+        );","+        assert_eq!(verdict(\"security\", \"Looks fine.\"), None, \"no verdict\");","+    }","     use crate::Stage;","     use crate::govern::{Call, default_capabilities, default_constraints, gate};"," "]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/tests.rs","hunks":[{"oldStart":66,"oldLines":6,"newStart":66,"newLines":7,"lines":["             Effect::Finish => \"finish\",","             Effect::Teardown => \"teardown\",","             Effect::DarkDecided { .. } => \"dark\",","+            Effect::Review { .. } => \"review\",","         })","         .collect()"," }"]},{"oldStart":409,"oldLines":3,"newStart":410,"newLines":57,"lines":["         \"one revision, then a person decides\"","     );"," }","+","+/// The build step of a dark job, with `reviewers` on it.","+fn reviewed_build() -> (Job, Bounds) {","+    let mut j = job([Dial::Dark; 3]);","+    (j.node, j.stage) = (Some(\"build\".into()), Stage::Prompt);","+    let bounds = Bounds {","+        reviewers: vec![\"security\".into()],","+        ..Bounds::default()","+    };","+    (j, bounds)","+}","+","+#[test]","+fn a_step_with_a_reviewer_waits_for_its_verdict() {","+    let (j, bounds) = reviewed_build();","+    let (waiting, effects) = step(&j, &done(\"Added x.\"), AT, &bounds);","+    assert_eq!(kinds(&effects), [\"artifact\", \"diff\", \"review\"]);","+    assert_eq!(","+        waiting.node.as_deref(),","+        Some(\"build\"),","+        \"it waits at the step\"","+    );","+    let pass = Event::Reviewed {","+        verdict: review::Verdict::Pass,","+    };","+    let (on, _) = step(&waiting, &pass, AT, &bounds);","+    assert_eq!(on.node.as_deref(), Some(\"tests\"), \"a pass goes on\");","+}","+","+#[test]","+fn a_failed_review_sends_the_change_back_and_a_broken_one_waits() {","+    let (j, bounds) = reviewed_build();","+    let (waiting, _) = step(&j, &done(\"Added x.\"), AT, &bounds);","+    let fail = |detail: &str| Event::Reviewed {","+        verdict: review::Verdict::Fail {","+            detail: detail.into(),","+        },","+    };","+    let (back, effects) = step(&waiting, &fail(\"No test.\"), AT, &bounds);","+    assert_eq!(kinds(&effects), [\"turn\"], \"the build goes again\");","+    assert!(","+        back.feedback","+            .as_deref()","+            .unwrap()","+            .contains(\"failed its review\")","+    );","+    let broken = Event::Reviewed {","+        verdict: review::Verdict::Broken {","+            error: \"no agent file\".into(),","+        },","+    };","+    let (held, _) = step(&waiting, &broken, AT, &bounds);","+    assert_eq!(held.state, State::NeedsYou);","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/review.rs","/Users/tacoda/tacoda/bastion/crates/bastion-core/src/tests.rs"]}},"serverClassifierContext":{"request":"df1b7064-a7c5-4dfd-ab1d-72db55f2646d","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":10,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"d92b0179-260d-4ff5-8be0-d90f05e20920","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d