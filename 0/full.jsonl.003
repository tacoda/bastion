),\n        rule: format!(\"Do not change {file}: it is an approved acceptance test.\"),\n        function: \"sandbox::fs::write\".into(),\n        contains: format!(\"/work/repo/{file}\"),\n        rung: bastion_core::govern::Enforcement::Enforced,\n        source: bastion_core::govern::Source::Owner,\n        steps: Vec::new(),\n    }\n}\n\n/// What the rules read from a call: its command line in any of the shapes\n/// `sandbox::exec` takes (`argv`, or `cmd` with `args`), else its path, and\n/// what a write writes.\npub(crate) fn call_of(call: &Value) -> Call {\n    let arguments = &call[\"arguments\"];\n    let words = |v: &Value| -> Vec<String> {\n        v.as_array()\n            .into_iter()\n            .flatten()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"8ec788b6-6ec2-49bb-a018-d97c05097b37","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"79356cba-fae5-4157-a993-3c263b0b8dcb","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
