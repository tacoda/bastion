            }\n            _ => Verdict {\n                decision: Decision::Deny {\n                    reason: \"The gate cannot judge this call: it has no policy or no stage.\".into(),\n                },\n                flagged: vec![],\n            },\n        };\n        let verdict = reads_only(envelope, &call, verdict);\n        self.note(\"gate\", &job, bastion_core::eval::describe(&call, &verdict));\n        let hooks: Vec<String> = self\n            .charter(&job)\n            .iter()\n            .flat_map(|c| c.before.iter())\n            .filter(|h| h.functions.contains(&call.function.as_str()))\n            .map(|h| h.command.clone())\n            .collect();\n        let held = || HeldCall {\n            id: envelope[\"call\"][\"id\"].as_str().unwrap_or_default().into(),\n            job: job.clone(),\n            session: envelope[\"session_id\"].as_str().unwrap_or_default().into(),\n            turn: envelope[\"turn_id\"].as_str().unwrap_or_default().into(),\n            call: call.clone(),\n            arguments: envelope[\"call\"][\"arguments\"].clone(),\n            at: now(),\n        };\n        match verdict.decision {\n            // The repository's hooks run first, in the VM, so the call waits on them.\n            Decision::Continue if !hooks.is_empty() => {\n                let (gate, held) = (self.clone(), held());\n                crate::rt::spawn(async move { gate.before(held, hooks).await });\n                json!({ \"decision\": \"hold\", \"reason\": \"The repository's hooks run first.\" })\n            }\n            Decision::Continue => {\n                let mut arguments = envelope[\"call\"][\"arguments\"].clone();\n                arguments[\"sandbox_id\"] = envelope[\"metadata\"][\"sandbox_id\"].clone();\n                json!({ \"decision\": \"continue\", \"mutations\": { \"arguments\": arguments } })\n            }\n            Decision::Deny { reason } => json!({ \"decision\": \"deny\", \"reason\": reason }),\n            Decision::Hold { reason } => {\n                self.keep(held());\n                json!({ \"decision\": \"hold\", \"reason\": reason })\n            }\n        }\n    }\n\n    /// Save a held call for the job page, off the hook's path.\n    fn keep(&self, held: HeldCall) {\n        let (store, on_change) = (self.store.clone(), self.on_change.clone());\n        crate::rt::spawn(async move {\n            match store.hold(&held).await {\n                Ok(()) => on_change(Change::Job {\n                    id: held.job.clone(),\n                }),\n                Err(e) => eprintln!(\"job {}: the held call was not saved: {e}\", held.job),\n            }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"5da59099-c12b-4fe4-acb5-7ba55f7bfc57","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates","platform":"macos"}},"sourceToolAssistantUUID":"a2f4af0e-5b80-4586-b0d1-006bb2171ce3","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
