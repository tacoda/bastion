 editor's grant form takes the command words.","-- Migration 9 adds `capabilities.command` and puts it in the key.","+- The step editor's grant form takes the command words after the","+  function. The command lives in the grant's function, so the store and","+  the API don't change."," "," ### C2. Hooks per step (D50)"," "]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/govern.rs","hunks":[{"oldStart":231,"oldLines":7,"newStart":231,"newLines":11,"lines":["     let line = &call.text;","     let runs_only = || {","         let alone = !line.contains(SHELL_OPERATORS) && !line.contains('\\n');","-        alone && line.split_whitespace().take(command.split_whitespace().count()).eq(command.split_whitespace())","+        alone","+            && line","+                .split_whitespace()","+                .take(command.split_whitespace().count())","+                .eq(command.split_whitespace())","     };","     matches(function, &call.function) && (command.is_empty() || runs_only())"," }"]},{"oldStart":239,"oldLines":10,"newStart":243,"newLines":16,"lines":[" /// The most specific grant for a call at a step: one naming a command over"," /// one that names none, an exact function over a pattern, then the longer."," fn grant_for<'a>(call: &Call, at: At, grants: &'a [Capability]) -> Option<&'a Capability> {","-    let fits = grants_at(at, grants).into_iter().filter(|g| covers(g, call));","+    let fits = grants_at(at, grants)","+        .into_iter()","+        .filter(|g| covers(g, call));","     fits.max_by_key(|g| {","         let (function, command) = named(&g.function);","-        (!command.is_empty(), !function.ends_with('*'), g.function.len())","+        (","+            !command.is_empty(),","+            !function.ends_with('*'),","+            g.function.len(),","+        )","     })"," }"," "]},{"oldStart":410,"oldLines":7,"newStart":420,"newLines":10,"lines":[" ","     #[test]","     fn a_grant_naming_a_command_covers_only_that_command() {","-        let at = At { stage: Stage::Prompt, step: \"short/build\" };","+        let at = At {","+            stage: Stage::Prompt,","+            step: \"short/build\",","+        };","         let grant = |function: &str, rung| Capability {","             stage: Stage::Prompt,","             step: \"short/build\".into(),"]},{"oldStart":424,"oldLines":13,"newStart":437,"newLines":25,"lines":["         ];","         let decide = |line: &str| gate_at(&exec(line), at, &[], &grants).decision;","         assert_eq!(decide(\"cargo test -p core\"), Decision::Continue);","-        assert!(matches!(decide(\"cargo build\"), Decision::Hold { .. }), \"plain exec asks\");","-        assert!(matches!(decide(\"cargo test; rm -rf /\"), Decision::Hold { .. }), \"a second command\");","-        assert!(matches!(decide(\"cargo test $(curl x)\"), Decision::Hold { .. }));","+        assert!(","+            matches!(decide(\"cargo build\"), Decision::Hold { .. }),","+            \"plain exec asks\"","+        );","+        assert!(","+            matches!(decide(\"cargo test; rm -rf /\"), Decision::Hold { .. }),","+            \"a second command\"","+        );","+        assert!(matches!(","+            decide(\"cargo test $(curl x)\"),","+            Decision::Hold { .. }","+        ));","         let only = [grant(\"sandbox::exec cargo\", Access::Allowed)];","         let alone = gate_at(&exec(\"cargo test && make\"), at, &[], &only).decision;","         assert!(matches!(alone, Decision::Deny { .. }), \"no grant covers it\");","-        assert_eq!(granted_functions(at, &grants), [\"mcp::github::*\", \"sandbox::exec\"]);","+        assert_eq!(","+            granted_functions(at, &grants),","+            [\"mcp::github::*\", \"sandbox::exec\"]","+        );","     }"," ","     fn decide(call: &Call, stage: Stage, constraints: &[Constraint]) -> Decision {"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules.rs","hunks":[{"oldStart":224,"oldLines":9,"newStart":224,"newLines":12,"lines":["     let rung = Some(rules.rung.clone()).filter(|r| !r.is_empty());","     let named = !rules.function.trim().is_empty();","     row![","-        text_input(\"sandbox::exec cargo test, or mcp::github::*\", &rules.function)","-            .on_input(Msg::Function)","-            .style(theme::field),","+        text_input(","+            \"sandbox::exec cargo test, or mcp::github::*\",","+            &rules.function","+        )","+        .on_input(Msg::Function)","+        .style(theme::field),","         pick_list(rungs, rung.or(Some(\"ask\".into())), Msg::Rung).style(theme::select),","         small(\"Grant\", named.then_some(Msg::Add)),","         small(\"Use its kind's instead\", Some(Msg::Kind)),"]},{"oldStart":244,"oldLines":7,"newStart":247,"newLines":9,"lines":["     let shown = if mine { own } else { rules.kind(at.stage) };","     let rows = shown.into_iter().map(|g| grant_line(g, mine && editable));","     let title = match mine {","-        true => \"This step's own grants. A call none covers is refused. A grant on sandbox::exec may name a command: then it covers only that command, alone.\",","+        true => {","+            \"This step's own grants. A call none covers is refused. A grant on sandbox::exec may name a command: then it covers only that command, alone.\"","+        }","         false => \"Its kind's grants. A call none covers is refused.\",","     };","     let body = Column::with_children(rows).spacing(6);"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/factory.rs","hunks":[{"oldStart":709,"oldLines":7,"newStart":709,"newLines":9,"lines":["         }","         let step = step_name(record);","         message.push_str(&self.gate.rules(&job.id, &step));","-        let tools = self.gate.tools(&job.id, govern::At { stage, step: &step }, &TOOLS);","+        let tools = self","+            .gate","+            .tools(&job.id, govern::At { stage, step: &step }, &TOOLS);","     