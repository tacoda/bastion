lines":[" /// Whose grants decide the step's calls, and the way to the other."," fn whose<'a>(mine: bool, at: &At, editable: bool) -> Element<'a, Msg> {","     let (said, action, msg) = match mine {","-        true => (\"This step has its own grants. A call none covers is refused.\", \"Use its kind's instead\", Msg::Kind),","-        false => (\"This step uses the grants of every step of its kind. A call none covers is refused.\", \"Give it its own\", Msg::Own),","+        true => (","+            \"This step has its own grants. A call none covers is refused.\",","+            \"Use its kind's instead\",","+            Msg::Kind,","+        ),","+        false => (","+            \"This step uses the grants of every step of its kind. A call none covers is refused.\",","+            \"Give it its own\",","+            Msg::Own,","+        ),","     };","     let said = format!(\"{said} Kind: {}.\", at.stage);","-    row![text(said).size(12).color(theme::MUTED).width(Fill), small(action, editable.then_some(msg))]","-        .spacing(8)","-        .align_y(iced::Center)","-        .into()","+    row![","+        text(said).size(12).color(theme::MUTED).width(Fill),","+        small(action, editable.then_some(msg))","+    ]","+    .spacing(8)","+    .align_y(iced::Center)","+    .into()"," }"," "," pub fn view<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {","     let mine = !rules.own(at.step).is_empty();","-    let rows = rules.deciding(at).into_iter().map(|g| line(g, &rules.catalog, mine && editable));","-    let mut body = Column::new().spacing(8).push(whose(mine, at, editable)).extend(rows);","+    let rows = rules","+        .deciding(at)","+        .into_iter()","+        .map(|g| line(g, &rules.catalog, mine && editable));","+    let mut body = Column::new()","+        .spacing(8)","+        .push(whose(mine, at, editable))","+        .extend(rows);","     if mine && editable {","         body = body.push(granting(rules));","     }"]},{"oldSt