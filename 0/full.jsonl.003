,"+fn a_failure_goes_along_its_link_and_a_step_only_a_failure_reaches_is_skipped() {","+    let mut j = job([Dial::Dark; 3]);","+    // plan, build, tests, then notify, which only a failure of tests reaches.","+    j.flow.push(shell(\"notify\", Dial::Dark));","+    j.flow[2].on_failure = Some(\"notify\".into());","+    j.flow[3].failure_only = true;","+    (j.node, j.stage) = (Some(\"tests\".into()), Stage::Shell);","+    j.results.insert(\"plan\".into(), \"1. Add x.\".into());","+    let (branched, effects) = go(","+        &j,","+        Event::StepFailed {","+            detail: \"1 failed\".into(),","+        },","+    );","+    assert_eq!(","+        (branched.node.as_deref(), kinds(&effects)),","+        (Some(\"notify\"), vec![\"artifact\", \"run\"]),","+        \"past build, which would otherwise fix it\"","+    );","+    assert!(","+        branched","+            .feedback","+            .unwrap()","+            .starts_with(\"The step tests failed, and its workflow sends the failure here.\")","+    );","+    let (passed, _) = go(","+        &j,","+        Event::Ran {","+            output: \"3 passed\".into(),","+        },","+    );","+    assert_eq!(","+        (passed.node, passed.finishing()),","+        (None, true),","+        \"a pass skips notify and finishes\"","+    );","+}","+","+#[test]","+fn a_failure_link_back_loops_until_the_step_runs_out_of_revisions() {","+    let mut j = job([Dial::Dark; 3]);","+    j.flow[2].on_failure = Some(\"plan\".into());","+    j.flow[2].options.revisions = Some(1);","+    (j.node, j.stage) = (Some(\"tests\".into()), Stage::Shell);","+    j.results.insert(\"plan\".into(), \"1. Add x.\".into());","+    let failed = |detail: &str| Event::StepFailed {","+        detail: detail.into(),","+    };","+    let (back, _) = go(&j, failed(\"1 failed\"));","+    assert_eq!(","+        back.node.as_deref(),","+        Some(\"plan\"),","+        \"back to plan, not build\"","+    );","+    let mut again = back.clone();","+    (again.node, again.stage, again.state) = (Some(\"tests\".into()), Stage::Shell, State::Running);","+    let (waits, _) = go(&again, failed(\"2 failed\"));","+    assert_eq!(","+        (waits.state, waits.node.as_deref()),","+        (State::NeedsYou, Some(\"tests\")),","+        \"one revision, then a person decides\"","+    );","+}"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/workflow.rs","hunks":[{"oldStart":250,"oldLines":7,"newStart":250,"newLines":11,"lines":["             .find(|n| waiting[n.id.as_str()] == 0 && !order.iter().any(|o| o.id == n.id))","         {","             order.push(next);","-            for l in self.links.iter().filter(|l| l.from == next.id && !l.failure) {","+            for l in self","+                .links","+                .iter()","+                .filter(|l| l.from == next.id && !l.failure)","+            {","                 *waiting.get_mut(l.to.as_str()).expect(\"checked above\") -= 1;","             }","         }"]},{"oldStart":554,"oldLines":4,"newStart":558,"newLines":49,"lines":["         let steps = g.steps().unwrap();","         assert_eq!(steps[0].options.spend_micros, Some(5), \"a job keeps it\");","     }","+","+    #[test]","+    fn a_failure_link_orders_nothing_and_a_step_has_at_most_one() {","+        let fail = |from: &str, to: &str| Link {","+            failure: true,","+            ..link(from, to)","+        };","+        let mut tests = node(\"tests\", Shell, 200, &[]);","+        tests.run = \"make test\".into();","+        let mut g = Graph {","+            nodes: vec![","+                prompt(\"plan\", 0, &[\"plan\"]),","+                prompt(\"build\", 100, &[]),","+                tests,","+            ],","+            links: vec![","+                link(\"plan\", \"build\"),","+                link(\"build\", \"tests\"),","+                fail(\"tests\", \"plan\"),","+            ],","+        };","+        assert_eq!(g.check(), Ok(()), \"a failure link back is no ci