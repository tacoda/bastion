aint>,\n32-    /// `PreToolUse` hooks: they run before a matching call, and exit 2 refuses it.\n33-    pub before: Vec<Hook>,\n34-    /// `Stop` hooks: they run when a build turn ends, and their results are kept.\n35-    pub stop: Vec<String>,\n36-}\n--\n59:            found.constraints = charter::constraints(&list(\"deny\"), &list(\"ask\"));\n60-            found.before = hooks(&settings, \"PreToolUse\");\n61-            found.stop = hooks(&settings, \"Stop\")\n62-                .into_iter()\n63-                .map(|h| h.command)\n64-                .collect();\n65-        }\n66-        Err(e) => found\n67-            .files","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"dcf0f9a7-4d9d-474e-bc18-6df1be1f29ae","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"05178fc0-02ad-4d63-a9d1-2ab1d1fdef4c","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
