= words.font(theme::MONO);","     }","     if editable {","         words = words.on_action(|a| wrap(Msg::Text(a)));","     }","-    body = body.push(labeled(text_label(&n), words));","-    if is_script(&n) {","-        body = body.push(reach_fields(state, &n, editable));","-    } else {","-        let reads = iced::widget::checkbox(n.reach.reads_only)","+    column![labeled(\"Name\", name), how_row(n, editable), labeled(text_label(n), words)]","+        .spacing(12)","+        .into()","+}","+","+/// How far the step reaches, its model and budget, and the results it gives.","+fn options_tab<'a>(state: &'a State, n: &bastion_protocol::NodeView, editable: bool) -> Element<'a, Message> {","+    let reach: Element<'a, Message> = match is_script(n) {","+        true => reach_fields(state, n, editable),","+        false => iced::widget::checkbox(n.reach.reads_only)","             .label(\"Only reads: the agent may not write a file\")","-            .on_toggle_maybe(editable.then_some(|on| wrap(Msg::ReadsOnly(on))));","-        body = body.push(reads);","-    }","-    body = body.push(options_row(state, &n, editable));","-    let results = text_input(\"\", &state.results)","+            .on_toggle_maybe(editable.then_some(|on| wrap(Msg::ReadsOnly(on))))","+            .into(),","+    };","+    let results = text_input(\"plan, notes\", &state.results)","         .on_input_maybe(editable.then_some(|v| wrap(Msg::Field(StepField::Results, v))))","         .style(theme::field);","-    body = body.push(labeled(\"Results it gives, comma-separated\", results));","-    // A shell step runs no agent, so no rule on an agent's calls binds it.","-    if let (false, Some((step, stage))) = (is_script(&n), state.picked_step()) {","-        let at = super::step_rules::At {","-            step: &step,","-            stage: &stage,","-        };","-        let sections = super::step_rules::view(&state.rules, &at, editable);","-        body = body.extend(sections.into_iter().map(|e| e.map(|m| wrap(Msg::Rules(m)))));","+    column![","+        reach,","+        options_row(state, n, editable),","+        labeled(\"Results it gives, comma-separated\", results)","+    ]","+    .spacing(12)","+    .into()","+}","+","+/// The tabs of the picked step's panel. A shell step runs no agent, so no","+/// rule on an agent's calls binds it, and it has no rules tabs.","+fn tabs<'a>(state: &State, n: &bastion_protocol::NodeView) -> Element<'a, Message> {","+    let tab = |label: String, t: StepTab| {","+        button(text(label).size(13))","+            .padding([5, 12])","+            .style(theme::nav(state.tab == t))","+            .on_press(wrap(Msg::Tab(t)))","+            .into()","+    };","+    let mut all: Vec<Element<'a, Message>> =","+        vec![tab(\"Step\".into(), StepTab::Step), tab(\"Options\".into(), StepTab::Options)];","+    if let (false, Some((step, stage))) = (is_script(n), state.picked_step()) {","+        let at = super::step_rules::At { step: &step, stage: &stage };","+        let (constraints, grants) = super::step_rules::counts(&state.rules, &at);","+        all.push(tab(format!(\"Constraints · {constraints}\"), StepTab::Constraints));","+        all.push(tab(format!(\"Capabilities · {grants}\"), StepTab::Capabilities));","     }","-    body = body.push(small(\"Remove step\", on(Msg::RemoveStep)));","+    iced::widget::Row::with_children(all).spacing(6).into()","+}","+","+/// The step's name and kind, and its removal.","+fn step_head<'a>(n: &bastion_protocol::NodeView, editable: bool) -> Element<'a, Message> {","+    let names = column![","+        text(drawing::title(n)).size(18).font(theme::BOLD),","+        text(drawing::kind_line(n)).size(12).color(theme::MUTED),","+    ]","+    .spacing(2)","+    .width(Fill);","+    row![names, small(\"Remove step\", editable.then_some(wrap(Msg::RemoveStep)))]","+        .align_y(iced::Center)","+        .into()","+}","+","+/// The picked step's constraints or capabilities.","+fn rules_tab<'a>(state: &'a State, editable: bool) -> Option<Element<'a, Message>> {","+    let (step, stage) = state.picked_step()?;","+    let at = super::step_rules::At { step: &step, stage: &stage };","+    let view = match state.tab {","+        StepTab::Constraints => super::step_rules::constraints(&state.rules, &at, editable),","+        _ => super::step_rules::capabilities(&state.rules, &at, editable),","+    };","+    let said = super::step_rules::said(&state.rules);","+    let body = column![view].extend(said).spacing(8);","+    Some(Element::from(body).map(|m| wrap(Msg::Rules(m))))","+}","+","+fn step_detail<'a>(state: &'a State, id: &str, editable: bool) -> Option<Element<'a, Message>> {","+    let n = state","+        .draft","+        .as_ref()","+        .and_then(|w| edit::node(w, id))?","+        .clone();","+    let rules = matches!(state.tab, StepTab::Constraints | StepTab::Capabilities);","+    let shown = match state.tab {","+        StepTab::Options => options_tab(state, &n, editable),","+        _ if rules && !is_script(&n) => rules_tab(state, editable)?,","+        _ => step_tab(state, &n, editable),","+    };","+    let body = column![step_head(&n, editable), tabs(state, &n), shown].spacing(14);","     Some(","-        container(body.spacing(12))","+        container(body)","             .padding(16)","             .width(Fill)","             .style(theme::panel)"]}]}],"moreFiles":1,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/old.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/workflows.rs"]}},"serverClassifierContext":{"request":"9199e2c5-28fa-406c-b065-8a8327e466da","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":1,"modified":1,"untracked":null,"untracked_normal":3},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"