d));\n    }''','''fn what_runs(n: &Node) -> Result<(), String> {\n    if let Some(why) = missing_run(n) {\n        return Err(format!(\"{}: {why}\", n.id));\n    }\n    let model = n.options.model.trim();\n    if !model.is_empty() && crate::settings::Model::named(model).is_none() {\n        return Err(format!(\"{}: the model {model:?} is not provider/model\", n.id));\n    }\n    if n.stage == Stage::Shell && !model.is_empty() {\n        return Err(format!(\"{}: a shell step runs no model\", n.id));\n    }'''),\n('''                gives: n.results.clone(),\n                reach: n.reach.clone(),\n            })''','''                gives: n.results.clone(),\n                reach: n.reach.clone(),\n                options: n.options.clone(),\n            })'''),\n('''            results: results.iter().map(|r| r.to_string()).collect(),\n            reach: Reach::default(),\n            x,''','''            results: results.iter().map(|r| r.to_string()).collect(),\n            reach: Reach::default(),\n            options: Options::default(),\n            x,'''),\n])\nedit('tests.rs',[('''        gives: Vec::new(),\n        reach: Reach::default(),\n    }''','''        gives: Vec::new(),\n        reach: Reach::default(),\n        options: Options::default(),\n    }'''),('use crate::workflow::{Reach, Step};','use crate::workflow::{Options, Reach, Step};')])\nedit('lib.rs',[\n('''    /// the job's workspace.\n    pub revision_budget: Option<u32>,\n}''','''    /// the job's workspace.\n    pub revision_budget: Option<u32>,\n    /// What each step's turns have cost so far, by step id, in millionths of\n    /// a US dollar, for the steps' own budgets (D43).\n    pub spent: BTreeMap<String, u64>,\n}'''),\n('''    let tries = job.revisions.entry(at).or_default();\n    if *tries >= MAX_REVISIONS || job.last_refusal.as_deref() == Some(detail) {\n        return stuck(job, detail);\n    }\n    *tries += 1;''','''    let limit = job\n        .step()\n        .and_then(|s| s.op