 crate::charter::read(machine.inner().as_ref(), std::path::Path::new(&w.path));\n            let before = c.before.iter().map(|h| format!(\"before {}: {}\", h.functions.join(\", \"), h.command));\n            let stop = c.stop.iter().map(|h| format!(\"when a build ends: {h}\"));\n            WorkspaceCharterView {\n                workspace: w.name,\n                files: c.files.clone(),\n                rules: c.constraints.iter().map(|r| r.rule.clone()).collect(),\n                hooks: before.chain(stop).collect(),\n                allow: c.allow.clone(),\n            }\n        })\n        .collect())\n}\n\n/// What the factory itself may do, as the settings set it.\n#[tauri::command]\npub async fn factory_capabilities(cell: State<'_, FactoryCell>) -> Result<Vec<FactoryCapabilityView>, String> {\n    let s = crate::settings_store::current(&**factory(&cell)?.store()).await?;\n    let row = |name: &str, rung: String, how: &str| FactoryCapabilityView { name: name.into(), rung, how: how.into() };\n    let github = s.forge == bastion_core::settings::Forge::Github;\n    Ok(vec![\n        row(\"Approve a plan\", name(s.dials.approve), \"The approve checkpoint's dial.\"),\n        row(\"Approve a change\", name(s.dials.at(bastion_core::Stage::Review)), \"The review checkpoint's dial; never below hold.\"),\n        if github {\n            row(\"Push the job's branch and open a pull request\", \"allowed\".into(), \"After review, to the workspace's GitHub origin.\")\n        } else {\n            row(\"Land on the workspace's branch\", \"allowed\".into(), \"After review, merged here.\")\n        },\n        row(\"Merge a pull request\", if github { \"ask\".into() } else { \"denied\".into() }, \"Approve at land, once CI passes.\"),\n        row(\"Start a fix turn when CI fails\", if github { \"allowed\".into() } else { \"denied\".into() }, \"At most 2 per job, with the failing log.\"),\n    ])\n}\n'''\nopen(p,'w').write(s)\np='src-tauri/src/lib.rs'; s=open(p).read()\ns=s.replace(\"            commands::govern::capabilities,\",\"            commands::govern::capabilities,\\n            commands::govern::charters,\\n            commands::govern::factory_capabilities,\",1)\nopen(p,'w').write(s)\nEOF\ncargo +1.97.0 fmt --all; cargo +1.97.0 build -p bastion 2>&1 | grep -E \"^error\" -A8 | head -20","description":"Add the charters and factory commands","timeout":600000}},"wireIngestContext":{"toolu_014u6kxi24M95Bb7tgeGC56u":{"cwd":"/Users/tacoda/tacoda/bastion"}},"serverClassifierRequest":"81ec1bf2-ece2-4ef6-b229-8b6d9c482d11","apiBlockIndex":1,"requestId":"req_011CgajuHgQbfUtfgkAinvVn","type":"assistant","uuid":"4d74f776-2ba9-443e-ae07-5e573c0a7954","timestamp":"2026-10-31T17:52:17.096Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
