crates/bastion-core/src/review.rs","hunks":[{"oldStart":30,"oldLines":6,"newStart":30,"newLines":49,"lines":["     \"xit(\","," ];"," ","+/// What a step's reviewers said of its change (D51).","+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]","+#[serde(rename_all = \"snake_case\", tag = \"kind\")]","+pub enum Verdict {","+    Pass,","+    Fail { detail: String },","+    /// A reviewer could not run, or gave no verdict: a person decides.","+    Broken { error: String },","+}","+","+/// The agents that must pass a change at `step`: the reviewers of the","+/// constraints that apply there and are more than told.","+pub fn reviewers_at(constraints: &[Constraint], step: &str) -> Vec<String> {","+    let mut all: Vec<String> = constraints","+        .iter()","+        .filter(|c| !c.reviewer.is_empty() && c.rung != Enforcement::Told)","+        .filter(|c| crate::govern::applies(c, step))","+        .map(|c| c.reviewer.clone())","+        .collect();","+    all.dedup();","+    all","+}","+","+/// What a reviewer reads: its own instructions, the request, and the change.","+pub fn reviewer_brief(agent: &str, request: &str, change: &str) -> String {","+    format!(","+        \"{agent}\\n\\nYou review one step's change for this request:\\n<request>\\n{request}\\n</request>\\n\\nThe change:\\n<change>\\n{change}\\n</change>\\n\\nSay what is wrong with it, if anything. End with one line: `VERDICT: pass` or `VERDICT: fail`.\"","+    )","+}","+","+/// A reviewer's verdict from its reply: its last `VERDICT:` line, with the","+/// reply as the reason for a fail. None when it gave no verdict.","+pub fn verdict(reviewer: &str, reply: &str) -> Option<Verdict> {","+    let last = reply.lines().rev().find_map(|l| l.trim().strip_prefix(\"VERDICT:\"))?;","+    match last.trim().to_ascii_lowercase().as_str() {","+        \"pass\" => Some(Verdict::Pass),","+        \"fail\" => Some(Verdict::Fail {","+            detail: format!(\"The reviewer {reviewer} failed it:\\n{}\", reply.trim()),","+        }),","+        _ => None,","+    }","+}","+"," /// What one diff constraint found at review."," #[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]"," pub struct Finding {"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/govern.rs","hunks":[{"oldStart":173,"oldLines":6,"newStart":173,"newLines":7,"lines":["         layer: String::new(),","         steps: Vec::new(),","         hook: String::new(),","+        reviewer: String::new(),","     })"," }"," "]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-protocol/src/lib.rs","hunks":[{"oldStart":599,"oldLines":6,"newStart":599,"newLines":10,"lines":["     /// exit 2 refuses the call (D50). Empty for a rule.","     #[serde(default, skip_serializing_if = \"String::is_empty\")]","     pub hook: String,","+    /// An agent in `.agents/agents/` that must pass the change of each step","+    /// it applies at (D51). Empty for a rule.","+    #[serde(default, skip_serializing_if = \"String::is_empty\")]","+    pub reviewer: String,"," }"," "," /// A grant on its ladder (DECISIONS.md D20): `denied`, `ask` or `allowed`."]}]}],"moreFiles":4,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-core/src/charter.rs","/Users/tacoda/tacoda/bastion/crates/bastion-core/src/govern.rs","/Users/tacoda/tacoda/bastion/crates/bastion-core/src/review.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/govern.rs","/Users/tacoda/tacoda/bastion/crates/bastion-protocol/src/lib.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/govern.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/gate.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/govern_store.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/store/schema.rs"]}},"serverClassifierContext":{"request":"a18f4b1b-0282-4bd2-a3e5-bc3f6a091299","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","