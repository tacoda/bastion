kes::{call, connect};","+use serde_json::json;","+#[tokio::main]","+async fn main() {","+    let s = std::env::args().nth(1).expect(\"session\");","+    let iii = connect(\"spike-first\");","+    let out = call(&iii, \"session::messages\", json!({ \"session_id\": s })).await.expect(\"messages\");","+    let first = out[\"messages\"].as_array().into_iter().flatten().find(|m| m[\"message\"][\"role\"] == \"user\");","+    let text: Vec<&str> = first.map(|m| m[\"message\"][\"content\"].as_array().into_iter().flatten().filter_map(|p| p[\"text\"].as_str()).collect()).unwrap_or_default();","+    println!(\"{}\", text.join(\"\\n\"));","+    std::process::exit(0);","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-spikes/examples/first_message.rs"]}},"serverClassifierContext":{"request":"a7d4f0d7-5d53-4a36-bf80-e0d90eb69314","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"c37f9e9e-d287-422d-82c8-248014d25580","session_id":"135a2369-1f42-433b-aacc-5c1b0ce18b48","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"135a2369-1f42-433b-aacc-5c1b0ce18b48","version":"2.1.285","gitBranch":"main","slug":"pure-pondering-goose"}
