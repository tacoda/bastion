,'''            // An escape belongs to the server that landed its commit.\n            let Some(server) = landed_on(&state.landed, &state.commit) else {\n                state.error = format!(\"No job landed a commit that starts {}.\", state.commit.trim());\n                return Task::none();\n            };\n            let send = ctx.task(server, api::EscapeAdd(report), Msg::Reported);\n            return send.map(Message::Verification);''')\nrep('''            if let Some(l) = state.landed.iter_mut().find(|l| l.job == escape.job) {''','''            if let Some((_, l)) = state.landed.iter_mut().find(|(_, l)| l.job == escape.job) {''')\nrep('''/// Per workspace: how many jobs landed, and how many of them escaped.\nfn rates(landed: &[LandedView]) -> BTreeMap<&str, (u32, u32)> {\n    let mut all: BTreeMap<&str, (u32, u32)> = BTreeMap::new();\n    for l in landed {\n        let rate = all.entry(&l.workspace).or_default();''','''/// Per workspace, named with its server when several show: how many jobs\n/// landed, and how many of them escaped.\nfn rates(landed: &[(String, LandedView)], many: bool) -> BTreeMap<String, (u32, u32)> {\n    let mut all: BTreeMap<String, (u32, u32)> = BTreeMap::new();\n    for (server, l) in landed {\n        let key = match many {\n            true => format!(\"{server} · {}\", l.workspace),\n            false => l.workspace.clone(),\n        };\n        let rate = all.entry(key).or_default();''')\nrep('''fn rates_view(landed: &[LandedView]) -> Element<'static, Message> {\n    let all = rates(landed);''','''fn rates_view(landed: &[(String, LandedView)], many: bool) -> Element<'static, Message> {\n    let all = rates(landed, many);''')\nrep('''            text(ws.to_string()).size(13).width(Fill),''','''            text(ws).size(13).width(Fill),''')\nrep('''fn landed_view(l: &LandedView, ctx: &Ctx) -> Element<'static, Message> {\n    let open = Message::OpenJob {\n        server: ctx.current.clone(),\n        id: l.job.clone(),\n    };''','''fn landed_view(server: &str, l: &LandedView, many: bool) -> Element<'static, Message> {\n    let open = Message::OpenJob {\n        server: server.to_string(),\n        id: l.job.clone(),\n    };\n    let place = match many {\n        true => format!(\"{server} · {}\", l.workspace),\n        false => l.workspace.clone(),\n    };''')\nrep('''        text(format!(\"{} · {request}\", l.workspace)).width(Fill),''','''        text(format!(\"{place} · {request}\")).width(Fill),''')\nrep('''    let lede = format!(\n        \"Each job {} landed, with the decisions that let it through and its commits. Report a defect by its commit to trace it to its job.\",\n        ctx.current\n    );\n    let landed = state.landed.iter().map(|l| landed_view(l, ctx));''','''    let lede = format!(\n        \"Each job {} landed, with the decisions that let it through and its commits. Report a defect by its commit to trace it to its job.\",\n        super::on(ctx)\n    );\n    let many = ctx.all;\n    let landed = state.landed.iter().map(|(s, l)| landed_view(s, l, many));''')\nrep('''            section(\"Escape rate\".into(), rates_view(&state.landed), false),''','''            section(\"Escape rate\".into(), rates_view(&state.landed, many), false),''')\nopen(p,'w').write(s)\nEOF\ngrep -n \"mod tests\" -A40 verification.rs | head -50","description":"Verification across servers"}},"serverClassifierRequest":"ada60280-26b2-4b5e-bdbe-6a95061c4f6f","apiBlockIndex":2,"requestId":"req_011CgwvFByQiNUXourWJg4od","type":"assistant","uuid":"df36ce00-3b01-4dde-8061-8dfbbc5137b9","timestamp":"2026-11-11T22:20:30.082Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":"medium","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
