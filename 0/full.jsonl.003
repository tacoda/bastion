        shown: (shown(a), shown(b)),","+            less_is_better: false,","+        },","+        chart::Pair {","+            name: \"Cost\".into(),","+            a: a.cost_micros as f64,","+            b: b.cost_micros as f64,","+            shown: (dollars(a.cost_micros), dollars(b.cost_micros)),","+            less_is_better: true,","+        },","+        count(\"Seconds\", a.seconds, b.seconds, true),","+        count(\"Turns\", a.turns.into(), b.turns.into(), true),","+        count(\"Calls\", a.passed.into(), b.passed.into(), true),","+        count(\"Refused\", a.refused.into(), b.refused.into(), true),","+        count(\"Held\", a.held.into(), b.held.into(), true),","+        count(\"Flagged\", a.flagged.into(), b.flagged.into(), true),","+    ]","+}","+","+/// Each request's grade under A and under B, where both runs were graded.","+fn grade_pairs(rows: &[EvalRow]) -> Vec<chart::Pair> {","+    rows.iter()","+        .filter_map(|r| {","+            let (a, b) = (r.a.as_ref()?.grade?, r.b.as_ref()?.grade?);","+            Some(chart::Pair {","+                name: format!(\"Request {}\", r.idx + 1),","+                a: a.into(),","+                b: b.into(),","+                shown: (a.to_string(), b.to_string()),","+                less_is_better: false,","+            })","+        })","+        .collect()","+}","+"," /// A run's measures, by name."," fn measures(r: &RunView) -> [(&'static str, String); 9] {","     let outcome = match (r.job.is_empty(), r.reviewed) {"]},{"oldStart":536,"oldLines":6,"newStart":588,"newLines":15,"lines":["                     .width(Fill)","                     .style(theme::panel),","             )","+            .push(chart::compare(","+                \"A and B in total\",","+                total_pairs(&v.total_a, &v.total_b),","+            ))","+            .extend(","+                Some(grade_pairs(&v.rows))","+                    .filter(|p| p.len() > 1)","+                    .map(|p| chart::compare(\"G