change);\n            let reply = evals::one_turn(&*self.engine, &*self.store, &session, &brief).await?;\n            evals::meter(&*self.engine, &*self.store, job, &session).await;\n            let kept = Artifact {\n                stage: job.stage,\n                step: step.into(),\n                body: format!(\"Review by {name}:\\n{reply}\"),\n                created_at: now(),\n            };\n            self.store.add_artifact(&job.id, &kept).await?;\n            match review::verdict(name, &reply) {\n                Some(Verdict::Pass) => continue,\n                Some(v) => return Ok(v),\n                None => return Err(format!(\"The reviewer {name} gave no verdict.\")),\n            }\n        }\n        Ok(Verdict::Pass)\n    }\n\n    /// The step's change: its diff, or its reply when it only reads.\n    async fn change_at(&self, job: &str, step: &str) -> Result<String, String> {\n        let artifacts = self.store.artifacts(job).await?;\n        let at: Vec<&Artifact> = artifacts.iter().filter(|a| a.step == step).collect();\n        let diff = at.iter().rev().find(|a| is_diff(&a.body));\n        let last = diff.or(at.last()).ok_or(format!(\"the step {step} kept nothing to review\"))?;\n        Ok(last.body.clone())\n    }\n}\nEOF\npython3 - <<'EOF'\np='crates/bastion-server/src/factory.rs'; s=open(p).read()\ndef r(old,new):\n    global s\n    assert s.count(old)==1, old[:70]\n    s=s.replace(old,new)\nr('''            Effect::Teardown => {\n                self.grade_trial(&record);''','''            Effect::Review { step, reviewers } => {\n                self.review_step(&record, step, reviewers);\n                None\n            }\n            Effect::Teardown => {\n                self.grade_trial(&record);''')\nr('''        Ok(Bounds {\n            trial: self.store.eval_run_of(id).await?.is_some(),''','''        let step = step_name(record);\n        let reviewers = bastion_core::review::reviewers_at(&self.gate.constraints(id), &step);\n 