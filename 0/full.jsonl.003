ill if !skill_name_ok(&n.run) => Some(\"a skill needs its folder's name\"),\n        Stage::Command if !skill_name_ok(&n.run) => {\n            Some(\"a command needs its name in .claude/commands\")\n        }\n        Stage::Shell if n.run.trim().is_empty() => Some(\"a shell step needs its script\"),\n        Stage::Prompt if n.note.trim().is_empty() => Some(\"a prompt needs its instructions\"),\n        _ => None,\n    }\n}\n\n/// A node has what it runs, and gives results only if an agent or a\n-- step may use the whole sandbox; a step marked as reading only may not\n-- write a file (D42), whatever its kind allows.\nINSERT OR IGNORE INTO capabilities (stage, function, rung) VALUES\n  ('prompt', 'sandbox::*', 'allowed'),\n  ('agent', 'sandbox::*', 'allowed'),\n  ('skill', 'sandbox::*', 'allowed'),\n  ('command', 'sandbox::*', 'allowed');\n\n-- Workflows (D35): starting points for engineers, managers, and platform\n-- and SRE teams. Each lands a reviewed change, a document under docs/ or code, and\n-- waits for a person at land. A workflow's row is written only while none of\n-- its steps are stored, so one the owner deleted stays deleted, and the\n-- owner's later versions are kept.\nINSERT OR IGNORE INTO workflows (id, name, version, updated_at)\nSELECT column1, column2, 1, 0 FROM (VALUES\n  ('research', 'Research'),\n  ('bug-fix', 'Bug fix'),\n  ('dependency-upgrade', 'Dependency upgrade'),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"74abf635-8bd8-40bf-bcd4-f1a2eb17b023","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceTo