let legend = row![","+        container(text(\"\")).width(10).height(10).style(swatch(a)),","+        text(\"A\").size(12).color(theme::MUTED),","+        container(text(\"\")).width(10).height(10).style(swatch(b)),","+        text(\"B\").size(12).color(theme::MUTED)","+    ]","+    .spacing(6)","+    .align_y(iced::Center);","+    let head = row![","+        text(title.to_string()).size(13).font(theme::BOLD).color(theme::MUTED).width(Fill),","+        legend","+    ];","+    container(column![head, Column::with_children(rows).spacing(10)].spacing(10))","+        .padding([12, 16])","+        .width(Fill)","+        .style(theme::panel)","+        .into()","+}","+"," /// A day, `YYYY-MM-DD` in UTC, from seconds since the epoch."," pub fn day(secs: u64) -> String {","     // Howard Hinnant's days-to-civil."]},{"oldStart":244,"oldLines":6,"newStart":331,"newLines":22,"lines":["         );","     }"," ","+    #[test]","+    fn b_is_compared_to_a_and_marked_better_by_the_measure() {","+        let pair = |a, b, less_is_better| Pair {","+            name: \"x\".into(),","+            a,","+            b,","+            shown: (String::new(), String::new()),","+            less_is_better,","+        };","+        assert_eq!(change(&pair(10.0, 8.0, true)), Some((\"B -20%\".into(), true)));","+        assert_eq!(change(&pair(9.0, 10.0, false)), Some((\"B +11%\".into(), true)));","+        assert_eq!(change(&pair(9.0, 10.0, true)), Some((\"B +11%\".into(), false)));","+        assert_eq!(change(&pair(3.0, 3.0, true)), None);","+        assert_eq!(change(&pair(0.0, 3.0, true)), None, \"no percentage of zero\");","+    }","+","     #[test]","     fn a_hovered_bar_names_its_day_and_each_part() {","         let bars = Bars {"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/chart.rs"]}},"serverClassifierContext":{"request":"f1c98be4-446f-4d91-9e16-be37376c1b6c","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bas