","-        Msg::Read(Ok(landed)) => (state.landed, state.error) = (landed, String::new()),","-        Msg::Read(Err(e)) | Msg::Reported(Err(e)) => state.error = e,","+        Msg::Read(read) => {","+            let (read, failed) = *read;","+            state.landed = read","+                .into_iter()","+                .flat_map(|(server, all)| all.into_iter().map(move |l| (server.clone(), l)))","+                .collect();","+            state.landed.sort_by_key(|(_, l)| std::cmp::Reverse(l.landed_at));","+            state.error = failed.join(\" \");","+        }","+        Msg::Reported(Err(e)) => state.error = e,","         Msg::Commit(c) => state.commit = c,","         Msg::What(w) => state.what = w,","         Msg::Report => {"]},{"oldStart":46,"oldLines":12,"newStart":65,"newLines":17,"lines":["                 commit: state.commit.clone(),","                 what: state.what.clone(),","             };","-            let send = ctx.task(&ctx.current, api::EscapeAdd(report), Msg::Reported);","+            // An escape belongs to the server that landed its commit.","+            let Some(server) = landed_on(&state.landed, &state.commit) else {","+                state.error = format!(\"No job landed a commit that starts {}.\", state.commit.trim());","+                return Task::none();","+            };","+            let send = ctx.task(server, api::EscapeAdd(report), Msg::Reported);","             return send.map(Message::Verification);","         }","         // The audit keeps the escape a moment later, so add it here.","         Msg::Reported(Ok(escape)) => {","-            if let Some(l) = state.landed.iter_mut().find(|l| l.job == escape.job) {","+            if let Some((_, l)) = state.landed.iter_mut().find(|(_, l)| l.job == escape.job) {","                 l.escapes.push(escape);","             }","             (state.commit, state.what, state.error) = Default::default();"]},{"oldStart":60,"oldLines":19,"newStart":84,"newLines":24,"lines":["   