{"parentUuid":"f04c1cce-b92a-462d-829d-cfff8b0c2e35","isSidechain":false,"promptId":"6cbe2f9d-8896-4784-9bb3-3b66f1bc9361","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DG7zT7ffLGowu13VbSgNwC","type":"tool_result","content":"//! Bastion's worker for OpenAI-compatible hosts: Together,\n//! Fireworks, Qwen through DashScope, a local Ollama. Each host the admin\n//! lists is one llm-router provider; its key, if it needs one, is set like\n//! any provider's (D34).\n\nmod host;\nmod wire;\n\nuse std::collections::{BTreeMap, BTreeSet, HashSet};\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse host::{Ctx, Live, WORKER};\nuse iii_sdk::iii::WorkerMetadata;\nuse iii_sdk::{Error, InitOptions, RegisterFunction, register_worker};\nuse serde_json::{Value, json};\nuse tokio::signal::unix::{SignalKind, signal};\n\nconst HOSTS: &str = \"hosts\";\n/// Ids of removed hosts. The router still lists them, so the server lets\n/// them be added again.\nconst RETIRED: &str = \"retired\";\n\nfn valid_id(id: &str) -> bool {\n    let allowed = |c: char| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-' || c == '_';\n    (1..=64).contains(&id.len()) && id.chars().all(allowed)\n}\n\nfn checked_host(h: &Value, seen: &mut HashSet<String>) -> Result<Value, String> {\n    let id = h[\"id\"].as_str().unwrap_or_default().trim();\n    let name = h[\"name\"].as_str().unwrap_or_default().trim();\n    let url = h[\"api_url\"].as_str().unwrap_or_default().trim();\n    if !valid_id(id) {\n        return Err(format!(\n            \"a host id is 1 to 64 of a-z, 0-9, - and _, not {id:?}\"\n        ));\n    }\n    if !(url.starts_with(\"http://\") || url.starts_with(\"https://\")) {\n        return Err(format!(\"{id}: the URL must start with http:// or https://\"));\n    }\n    if !seen.insert(id.to_string()) {\n        return Err(format!(\"{id} is listed twice\"));\n    }\n    let name = if name.is_empty() { id } else { name };\n    Ok(json!({ \"id\": id, \"name\": name, \"api_url\": url }))\n}\n\n/// The hosts as given, trimmed, or why they cannot be kept.\nfn checked(hosts: &Value) -> Result<Vec<Value>, String> {\n    let mut seen = HashSet::new();\n    let given = hosts.as_array().ok_or(\"hosts must be a list\")?;\n    given.iter().map(|h| checked_host(h, &mut seen)).collect()\n}\n\ntype Registry = Mutex<BTreeMap<String, Live>>;\n\n/// Make the registered hosts match `hosts`: drop every host, retire the\n/// ones no longer listed, register each.\nfn apply(ctx: &Arc<Ctx>, live: &Registry, hosts: &[Value]) {\n    let mut live = live.lock().unwrap();\n    for (id, was) in std::mem::take(&mut *live) {\n        was.unregister();\n        if !hosts.iter().any(|h| h[\"id\"] == id.as_str()) {\n            tokio::spawn(host::retire(ctx.clone(), was.host));\n        }\n    }\n    for h in hosts {\n        let id = h[\"id\"].as_str().unwrap_or_default().to_string();\n        live.insert(id, host::register(ctx, h));\n    }\n}\n\nfn ids(list: &Value, field: Option<&str>) -> BTreeSet<String> {\n    let items = list.as_array().into_iter().flatten();\n    let id = |v: &Value| field.map_or(v, |f| &v[f]).as_str().map(String::from);\n    items.filter_map(id).collect()\n}\n\n/// Every id that was a host and is not one now.\nfn retired(was_retired: &Value, was: &Value, hosts: &[Value]) -> Vec<String> {\n    let now = ids(&json!(hosts), Some(\"id\"));\n    let mut all = ids(was_retired, None);\n    all.extend(ids(was, Some(\"id\")));\n    all.retain(|id| !now.contains(id));\n    all.into_iter().collect()\n}\n\nasync fn set(ctx: Arc<Ctx>, live: Arc<Registry>, input: Value) -> Result<Value, Error> {\n    let hosts = checked(&input[HOSTS]).map_err(Error::Handler)?;\n    let gone = retired(&ctx.kept(RETIRED).await, &ctx.kept(HOSTS).await, &hosts);\n    ctx.keep(RETIRED, json!(gone))\n        .await\n        .map_err(Error::Handler)?;\n    ctx.keep(HOSTS, json!(hosts))\n        .await\n        .map_err(Error::Handler)?;\n    apply(&ctx, &live, &hosts);\n    Ok(json!({ HOSTS: hosts }))\n}\n\nfn connect() -> iii_sdk::IIIClient {\n    let url = std::env::var(\"III_URL\").unwrap_or_else(|_| \"ws://127.0.0.1:49160\".into());\n    let metadata = WorkerMetadata {\n        name: WORKER.into(),\n        ..WorkerMetadata::default()\n    };\n    let options = InitOptions {\n        metadata: Some(metadata),\n        namespace: Some(\"bastion\".into()),\n        ..InitOptions::default()\n    };\n    register_worker(&url, options)\n}\n\n/// The kept hosts, read again until the state worker answers, as it may\n/// register a little after this worker starts.\nasync fn hosts_at_start(ctx: &Ctx) -> Value {\n    let mut wait = Duration::from_millis(500);\n    for _ in 0..30 {\n        match ctx.read(HOSTS).await {\n            Ok(hosts) => return hosts,\n            Err(e) => eprintln!(\"could not read the hosts ({e}); trying again in {wait:?}\"),\n        }\n        tokio::time::sleep(wait).await;\n        wait = (wait * 2).min(Duration::from_secs(10));\n    }\n    Value::Null\n}\n\n#[tokio::main]\nasync fn main() {\n    let ctx = Ctx::new(connect());\n    let live: Arc<Registry> = Arc::default();\n    let (c, l) = (ctx.clone(), live.clone());\n    ctx.iii.register_function(\n        \"bastion::openai_compat::hosts::set\",\n        RegisterFunction::new_async(move |input: Value| set(c.clone(), l.clone(), input)),\n    );\n    let c = ctx.clone();\n    ctx.iii.register_function(\n        \"bastion::openai_compat::hosts::list\",\n        RegisterFunction::new_async(move |_: Value| {\n            let c = c.clone();\n            async move {\n                let (hosts, retired) = (c.kept(HOSTS).await, c.kept(RETIRED).await);\n                Ok::<_, Error>(json!({ HOSTS: hosts, RETIRED: retired }))\n            }\n        }),\n    );\n    let kept = checked(&hosts_at_start(&ctx).await).unwrap_or_default();\n    apply(&ctx, &live, &kept);\n    signal(SignalKind::terminate())\n        .expect(\"a SIGTERM handler\")\n        .recv()\n        .await;\n    ctx.iii.shutdown();\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn hosts_are_trimmed_named_and_refused_when_they_cannot_be_providers() {\n        let given =\n            json!([{ \"id\": \" ollama \", \"api_url\": \"http://localhost:11434/v1/chat/completions\" }]);\n        let hosts = checked(&given).unwrap();\n        assert_eq!(hosts[0][\"id\"], \"ollama\");\n        assert_eq!(hosts[0][\"name\"], \"ollama\");\n        let bad_id = json!([{ \"id\": \"Ollama::x\", \"api_url\": \"http://h\" }]);\n        assert!(checked(&bad_id).is_err());\n        let bad_url = json!([{ \"id\": \"h\", \"api_url\": \"ftp://h\" }]);\n        assert!(checked(&bad_url).is_err());\n        let twice =\n            json!([{ \"id\": \"h\", \"api_url\": \"http://a\" }, { \"id\": \"h\", \"api_url\": \"http://b\" }]);\n        assert!(checked(&twice).is_err());\n        assert!(checked(&Value::Null).is_err());\n    }\n\n    #[test]\n    fn a_removed_host_is_retired_until_it_is_added_again() {\n        let was = json!([{ \"id\": \"a\" }, { \"id\": \"b\" }]);\n        assert_eq!(\n            retired(&json!([\"c\"]), &was, &[json!({ \"id\": \"a\" })]),\n            [\"b\", \"c\"]\n        );\n        assert_eq!(\n            retired(&json!([\"b\"]), &json!(null), &[json!({ \"id\": \"b\" })]),\n            Vec::<String>::new()\n        );\n    }\n}\n//! One llm-router provider per host: its four functions, its declaration\n//! to the router, its catalog, and its turns.\n\nuse std::collections::HashMap;\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse iii_sdk::channel::{ChannelWriter, StreamChannelRef};\nuse iii_sdk::protocol::{RegisterTriggerInput, TriggerRequest};\nuse iii_sdk::runtime::FunctionRef;\nuse iii_sdk::trigger::Trigger;\nuse iii_sdk::{Error, IIIClient, RegisterFunction};\nuse serde_json::{Value, json};\nuse tokio::task::AbortHandle;\n\nuse crate::wire;\n\npub const WORKER: &str = \"bastion-openai-compat\";\nconst NAMESPACE: &str = \"bastion\";\n/// The router's idle timeout is 120 s; a ping keeps a slow host's turn alive.\nconst PING: Duration = Duration::from_secs(25);\n\n/// What every host's functions share.\npub struct Ctx {\n    pub iii: IIIClient,\n    pub http: reqwest::Client,\n    aborts: Mutex<HashMap<String, AbortHandle>>,\n}\n\n/// One host's live registration, dropped when the admin removes it.\npub struct Live {\n    pub host: Value,\n    functions: Vec<FunctionRef>,\n    ready: Option<Trigger>,\n}\n\nimpl Live {\n    pub fn unregister(&self) {\n        self.functions.iter().for_each(FunctionRef::unregister);\n        if let Some(t) = &self.ready {\n            t.unregister();\n        }\n    }\n}\n\nimpl Ctx {\n    pub fn new(iii: IIIClient) -> Arc<Self> {\n        let http = reqwest::Client::builder()\n            .connect_timeout(Duration::from_secs(10))\n            // A host silent this long is gone, as the router's idle timeout says.\n            .read_timeout(Duration::from_secs(120))\n            .build()\n            .expect(\"an HTTP client\");\n        Arc::new(Self {\n            iii,\n            http,\n            aborts: Mutex::new(HashMap::new()),\n        })\n    }\n\n    handle.iter().for_each(AbortHandle::abort);\n    json!({ \"aborted\": handle.is_some() })\n}\n\n/// Register host `host`'s four functions and declare it to the router.\n// `router::ready` is a trigger type, and `observe` only watches functions, so\n// this binds it the deprecated way, as the server's engine does.\n#[allow(deprecated)]\npub fn register(ctx: &Arc<Ctx>, host: &Value) -> Live {\n    let id = host[\"id\"].as_str().unwrap_or_default().to_string();\n    let function = |name: &str| format!(\"provider::{id}::{name}\");\n    let internal = json!({ \"internal\": true });\n    let (c, i) = (ctx.clone(), id.clone());\n    let on_stream =\n        RegisterFunction::new_async(move |input: Value| stream(c.clone(), i.clone(), input));\n    let c = ctx.clone();\n    let on_abort = RegisterFunction::new_async(move |input: Value| {\n        let answer = abort(&c, &input);\n        async move { Ok::<_, Error>(answer) }\n    });\n    let (c, i) = (ctx.clone(), id.clone());\n    let on_refresh = RegisterFunction::new_async(move |_: Value| {\n        let (c, i) = (c.clone(), i.clone());\n        async move {\n            let count = refresh(&c, &i).await.map_err(Error::Handler)?;\n            Ok::<_, Error>(json!({ \"ok\": true, \"count\": count }))\n        }\n    });\n    let (c, h) = (ctx.clone(), host.clone());\n    let on_ready = RegisterFunction::new_async(move |_: Value| {\n        tokio::spawn(declare_and_refresh(c.clone(), h.clone()));\n        async { Ok::<_, Error>(json!({ \"ok\": true })) }\n    });\n    let functions = vec![\n        ctx.iii.register_function(function(\"stream\"), on_stream),\n        ctx.iii\n            .register_function(function(\"abort\"), on_abort.metadata(internal.clone())),\n        ctx.iii\n            .register_function(function(\"refresh_models\"), on_refresh),\n        ctx.iii\n            .register_function(function(\"on_router_ready\"), on_ready.metadata(internal)),\n    ];\n    let bind = RegisterTriggerInput::new(\"router::ready\", function(\"on_router_ready\"), json!({}));\n    let ready = ctx.iii.register_trigger(bind).ok();\n    tokio::spawn(declare_and_refresh(ctx.clone(), host.clone()));\n    Live {\n        host: host.clone(),\n        functions,\n        ready,\n    }\n}","is_error":false}]},"uuid":"6948c409-4c8a-438c-953e-6d22dede0e41","timestamp":"2026-11-12T01:32:44.179Z","toolUseResult":{"stdout":"//! Bastion's worker for OpenAI-compatible hosts: Together,\n//! Fireworks, Qwen through DashScope, a local Ollama. Each host the admin\n//! lists is one llm-router provider; its key, if it needs one, is set like\n//! any provider's (D34).\n\nmod host;\nmod wire;\n\nuse std::collections::{BTreeMap, BTreeSet, HashSet};\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse host::{Ctx, Live, WORKER};\nuse iii_sdk::iii::WorkerMetadata;\nuse iii_sdk::{Error, InitOptions, RegisterFunction, register_worker};\nuse serde_json::{Value, json};\nuse tokio::signal::unix::{SignalKind, signal};\n\nconst HOSTS: &str = \"hosts\";\n/// Ids of removed hosts. The router still lists them, so the server lets\n/// them be added again.\nconst RETIRED: &str = \"retired\";\n\nfn valid_id(id: &str) -> bool {\n    let allowed = |c: char| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '-' || c == '_';\n    (1..=64).contains(&id.len()) && id.chars().all(allowed)\n}\n\nfn checked_host(h: &Value, seen: &mut HashSet<String>) -> Result<Value, String> {\n    let id = h[\"id\"].as_str().unwrap_or_default().trim();\n    let name = h[\"name\"].as_str().unwrap_or_default().trim();\n    let url = h[\"api_url\"].as_str().unwrap_or_default().trim();\n    if !valid_id(id) {\n        return Err(format!(\n            \"a host id is 1 to 64 of a-z, 0-9, - and _, not {id:?}\"\n        ));\n    }\n    if !(url.starts_with(\"http://\") || url.starts_with(\"https://\")) {\n        return Err(format!(\"{id}: the URL must start with http:// or https://\"));\n    }\n    if !seen.insert(id.to_string()) {\n        return Err(format!(\"{id} is listed twice\"));\n    }\n    let name = if name.is_empty() { id } else { name };\n    Ok(json!({ \"id\": id, \"name\": name, \"api_url\": url }))\n}\n\n/// The hosts as given, trimmed, or why they cannot be kept.\nfn checked(hosts: &Value) -> Result<Vec<Value>, String> {\n    let mut seen = HashSet::new();\n    let given = hosts.as_array().ok_or(\"hosts must be a list\")?;\n    given.iter().map(|h| checked_host(h, &mut seen)).collect()\n}\n\ntype Registry = Mutex<BTreeMap<String, Live>>;\n\n/// Make the registered hosts match `hosts`: drop every host, retire the\n/// ones no longer listed, register each.\nfn apply(ctx: &Arc<Ctx>, live: &Registry, hosts: &[Value]) {\n    let mut live = live.lock().unwrap();\n    for (id, was) in std::mem::take(&mut *live) {\n        was.unregister();\n        if !hosts.iter().any(|h| h[\"id\"] == id.as_str()) {\n            tokio::spawn(host::retire(ctx.clone(), was.host));\n        }\n    }\n    for h in hosts {\n        let id = h[\"id\"].as_str().unwrap_or_default().to_string();\n        live.insert(id, host::register(ctx, h));\n    }\n}\n\nfn ids(list: &Value, field: Option<&str>) -> BTreeSet<String> {\n    let items = list.as_array().into_iter().flatten();\n    let id = |v: &Value| field.map_or(v, |f| &v[f]).as_str().map(String::from);\n    items.filter_map(id).collect()\n}\n\n/// Every id that was a host and is not one now.\nfn retired(was_retired: &Value, was: &Value, hosts: &[Value]) -> Vec<String> {\n    let now = ids(&json!(hosts), Some(\"id\"));\n    let mut all = ids(was_retired, None);\n    all.extend(ids(was, Some(\"id\")));\n    all.retain(|id| !now.contains(id));\n    all.into_iter().collect()\n}\n\nasync fn set(ctx: Arc<Ctx>, live: Arc<Registry>, input: Value) -> Result<Value, Error> {\n    let hosts = checked(&input[HOSTS]).map_err(Error::Handler)?;\n    let gone = retired(&ctx.kept(RETIRED).await, &ctx.kept(HOSTS).await, &hosts);\n    ctx.keep(RETIRED, json!(gone))\n        .await\n        .map_err(Error::Handler)?;\n    ctx.keep(HOSTS, json!(hosts))\n        .await\n        .map_err(Error::Handler)?;\n    apply(&ctx, &live, &hosts);\n    Ok(json!({ HOSTS: hosts }))\n}\n\nfn connect() -> iii_sdk::IIIClient {\n    let url = std::env::var(\"III_URL\").unwrap_or_else(|_| \"ws://127.0.0.1:49160\".into());\n    let metadata = WorkerMetadata {\n        name: WORKER.into(),\n        ..WorkerMetadata::default()\n    };\n    let options = InitOptions {\n        metadata: Some(metadata),\n        namespace: Some(\"bastion\".into()),\n        ..InitOptions::default()\n    };\n    register_worker(&url, options)\n}\n\n/// The kept hosts, read again until the state worker answers, as it may\n/// register a little after this worker starts.\nasync fn hosts_at_start(ctx: &Ctx) -> Value {\n    let mut wait = Duration::from_millis(500);\n    for _ in 0..30 {\n        match ctx.read(HOSTS).await {\n            Ok(hosts) => return hosts,\n            Err(e) => eprintln!(\"could not read the hosts ({e}); trying again in {wait:?}\"),\n        }\n        tokio::time::sleep(wait).await;\n        wait = (wait * 2).min(Duration::from_secs(10));\n    }\n    Value::Null\n}\n\n#[tokio::main]\nasync fn main() {\n    let ctx = Ctx::new(connect());\n    let live: Arc<Registry> = Arc::default();\n    let (c, l) = (ctx.clone(), live.clone());\n    ctx.iii.register_function(\n        \"bastion::openai_compat::hosts::set\",\n        RegisterFunction::new_async(move |input: Value| set(c.clone(), l.clone(), input)),\n    );\n    let c = ctx.clone();\n    ctx.iii.register_function(\n        \"bastion::openai_compat::hosts::list\",\n        RegisterFunction::new_async(move |_: Value| {\n            let c = c.clone();\n            async move {\n                let (hosts, retired) = (c.kept(HOSTS).await, c.kept(RETIRED).await);\n                Ok::<_, Error>(json!({ HOSTS: hosts, RETIRED: retired }))\n            }\n        }),\n    );\n    let kept = checked(&hosts_at_start(&ctx).await).unwrap_or_default();\n    apply(&ctx, &live, &kept);\n    signal(SignalKind::terminate())\n        .expect(\"a SIGTERM handler\")\n        .recv()\n        .await;\n    ctx.iii.shutdown();\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn hosts_are_trimmed_named_and_refused_when_they_cannot_be_providers() {\n        let given =\n            json!([{ \"id\": \" ollama \", \"api_url\": \"http://localhost:11434/v1/chat/completions\" }]);\n        let hosts = checked(&given).unwrap();\n        assert_eq!(hosts[0][\"id\"], \"ollama\");\n        assert_eq!(hosts[0][\"name\"], \"ollama\");\n        let bad_id = json!([{ \"id\": \"Ollama::x\", \"api_url\": \"http://h\" }]);\n        assert!(checked(&bad_id).is_err());\n        let bad_url = json!([{ \"id\": \"h\", \"api_url\": \"ftp://h\" }]);\n        assert!(checked(&bad_url).is_err());\n        let twice =\n            json!([{ \"id\": \"h\", \"api_url\": \"http://a\" }, { \"id\": \"h\", \"api_url\": \"http://b\" }]);\n        assert!(checked(&twice).is_err());\n        assert!(checked(&Value::Null).is_err());\n    }\n\n    #[test]\n    fn a_removed_host_is_retired_until_it_is_added_again() {\n        let was = json!([{ \"id\": \"a\" }, { \"id\": \"b\" }]);\n        assert_eq!(\n            retired(&json!([\"c\"]), &was, &[json!({ \"id\": \"a\" })]),\n            [\"b\", \"c\"]\n        );\n        assert_eq!(\n            retired(&json!([\"b\"]), &json!(null), &[json!({ \"id\": \"b\" })]),\n            Vec::<String>::new()\n        );\n    }\n}\n//! One llm-router provider per host: its four functions, its declaration\n//! to the router, its catalog, and its turns.\n\nuse std::collections::HashMap;\nuse std::sync::{Arc, Mutex};\nuse std::time::Duration;\n\nuse iii_sdk::channel::{ChannelWriter, StreamChannelRef};\nuse iii_sdk::protocol::{RegisterTriggerInput, TriggerRequest};\nuse iii_sdk::runtime::FunctionRef;\nuse iii_sdk::trigger::Trigger;\nuse iii_sdk::{Error, IIIClient, RegisterFunction};\nuse serde_json::{Value, json};\nuse tokio::task::AbortHandle;\n\nuse crate::wire;\n\npub const WORKER: &str = \"bastion-openai-compat\";\nconst NAMESPACE: &str = \"bastion\";\n/// The router's idle timeout is 120 s; a ping keeps a slow host's turn alive.\nconst PING: Duration = Duration::from_secs(25);\n\n/// What every host's functions share.\npub struct Ctx {\n    pub iii: IIIClient,\n    pub http: reqwest::Client,\n    aborts: Mutex<HashMap<String, AbortHandle>>,\n}\n\n/// One host's live registration, dropped when the admin removes it.\npub struct Live {\n    pub host: Value,\n    functions: Vec<FunctionRef>,\n    ready: Option<Trigger>,\n}\n\nimpl Live {\n    pub fn unregister(&self) {\n        self.functions.iter().for_each(FunctionRef::unregister);\n        if let Some(t) = &self.ready {\n            t.unregister();\n        }\n    }\n}\n\nimpl Ctx {\n    pub fn new(iii: IIIClient) -> Arc<Self> {\n        let http = reqwest::Client::builder()\n            .connect_timeout(Duration::from_secs(10))\n            // A host silent this long is gone, as the router's idle timeout says.\n            .read_timeout(Duration::from_secs(120))\n            .build()\n            .expect(\"an HTTP client\");\n        Arc::new(Self {\n            iii,\n            http,\n            aborts: Mutex::new(HashMap::new()),\n        })\n    }\n\n    handle.iter().for_each(AbortHandle::abort);\n    json!({ \"aborted\": handle.is_some() })\n}\n\n/// Register host `host`'s four functions and declare it to the router.\n// `router::ready` is a trigger type, and `observe` only watches functions, so\n// this binds it the deprecated way, as the server's engine does.\n#[allow(deprecated)]\npub fn register(ctx: &Arc<Ctx>, host: &Value) -> Live {\n    let id = host[\"id\"].as_str().unwrap_or_default().to_string();\n    let function = |name: &str| format!(\"provider::{id}::{name}\");\n    let internal = json!({ \"internal\": true });\n    let (c, i) = (ctx.clone(), id.clone());\n    let on_stream =\n        RegisterFunction::new_async(move |input: Value| stream(c.clone(), i.clone(), input));\n    let c = ctx.clone();\n    let on_abort = RegisterFunction::new_async(move |input: Value| {\n        let answer = abort(&c, &input);\n        async move { Ok::<_, Error>(answer) }\n    });\n    let (c, i) = (ctx.clone(), id.clone());\n    let on_refresh = RegisterFunction::new_async(move |_: Value| {\n        let (c, i) = (c.clone(), i.clone());\n        async move {\n            let count = refresh(&c, &i).await.map_err(Error::Handler)?;\n            Ok::<_, Error>(json!({ \"ok\": true, \"count\": count }))\n        }\n    });\n    let (c, h) = (ctx.clone(), host.clone());\n    let on_ready = RegisterFunction::new_async(move |_: Value| {\n        tokio::spawn(declare_and_refresh(c.clone(), h.clone()));\n        async { Ok::<_, Error>(json!({ \"ok\": true })) }\n    });\n    let functions = vec![\n        ctx.iii.register_function(function(\"stream\"), on_stream),\n        ctx.iii\n            .register_function(function(\"abort\"), on_abort.metadata(internal.clone())),\n        ctx.iii\n            .register_function(function(\"refresh_models\"), on_refresh),\n        ctx.iii\n            .register_function(function(\"on_router_ready\"), on_ready.metadata(internal)),\n    ];\n    let bind = RegisterTriggerInput::new(\"router::ready\", function(\"on_router_ready\"), json!({}));\n    let ready = ctx.iii.register_trigger(bind).ok();\n    tokio::spawn(declare_and_refresh(ctx.clone(), host.clone()));\n    Live {\n        host: host.clone(),\n        functions,\n        ready,\n    }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"270cdf40-370e-4095-ac1c-ce943c6b9304","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"f04c1cce-b92a-462d-829d-cfff8b0c2e35","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
