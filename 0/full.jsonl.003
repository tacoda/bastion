er>>>,\n42-    /// Each job's repository hook runs, latest last.\n43-    hook_runs: Mutex<HashMap<String, Vec<String>>>,\n44-    /// What each job's latest review diff broke, by constraint.\n45-    findings: Mutex<HashMap<String, Vec<String>>>,\n46-    /// The rungs an eval's arm sets for each of its trial jobs.\n47-    overrides: Mutex<HashMap<String, Vec<Override>>>,\n460:            Effect::DarkDecided { stage } => {\n461:                self.dark_decided(&id, stage);\n471:            Effect::StartTurn { stage, brief } => {\n472:                let started = self.start_turn(&record, stage, &brief).await;\n479:            Effect::RecordArtifact { stage, step, body } => {\n            self.engine.unbind(&binding);\n        }\n    }\n\n    async fn start_turn(\n        self: &Arc<Self>,\n        record: &Record,\n        stage: Stage,\n        brief: &str,\n    ) -> Result<(), String> {\n        let job = &record.job;\n        let sandbox = record.runtime.sandbox.clone().ok_or(\"no VM\")?;\n        // A VM can go while the job waits, as when the stack restarts; a\n        // turn on it would have no shell and no files. \"sandbox not found\"\n        // here sends the job for a new VM.\n        self.vm_exec(&sandbox, &[\"true\"]).await?;\n        let turn = turn::Turn::start(job);\n        let session = turn.session.clone();\n        self.set_runtime(&job.id, |r| r.session = Some(session.clone()))\n            .await?;\n        self.listen_for_turn(&turn)?;","is_error":false}]},"uuid":"62dc0104-fb4d-4ba1-b2d6-55af812fe6e4","timestamp":"2026-11-12T00:59:37.125Z","toolUseResult":{"stdout":"326:    pub fn rules(&self, job: &str, step: &str) -> String {\n327-        let rules: Vec<String> = self\n328-            .constraints(job)\n329-            .iter()\n330-            .filter(|c| govern::applies(c, step))\n331-            .map(|c| format!(\"- {}\", c.rule))\n332-            .collect();\n333-        if rules.is_empty() {\n334-            return String::new();\n335-    