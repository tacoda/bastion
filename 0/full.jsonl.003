ailure link, and it goes to another step.","+    fn failure_links_fit(&self) -> Result<(), String> {","+        let failing: Vec<&Link> = self.links.iter().filter(|l| l.failure).collect();","+        for (i, l) in failing.iter().enumerate() {","+            if l.from == l.to {","+                return Err(format!(\"{}'s failure link goes back to itself\", l.from));","+            }","+            if failing[..i].iter().any(|m| m.from == l.from) {","+                return Err(format!(\"{} has two failure links\", l.from));","+            }","+        }","+        Ok(())","+    }","+","     /// The `i`th node: its id new, with what it runs and what it reaches.","     fn check_node(&self, i: usize, n: &Node) -> Result<(), String> {","         let before = &self.nodes[..i];"]},{"oldStart":283,"oldLines":6,"newStart":311,"newLines":12,"lines":["         what_runs(n)","     }"," ","+    /// Whether every link into `id` is a failure link, and one is.","+    fn failure_only(&self, id: &str) -> bool {","+        let mut into = self.links.iter().filter(|l| l.to == id).peekable();","+        into.peek().is_some() && into.all(|l| l.failure)","+    }","+","     /// The steps a job runs, in link order.","     pub fn steps(&self) -> Result<Vec<Step>, String> {","         let gives = |id: &str| self.node(id).map(|n| n.results.clone()).unwrap_or_default();"]},{"oldStart":298,"oldLines":12,"newStart":332,"newLines":18,"lines":["                 needs: self","                     .links","                     .iter()","-                    .filter(|l| l.to == n.id)","+                    .filter(|l| l.to == n.id && !l.failure)","                     .flat_map(|l| gives(&l.from))","                     .collect(),","                 gives: n.results.clone(),","                 reach: n.reach.clone(),","                 options: n.options.clone(),","+                on_failure: self","+                    .links","+                    .iter()","+                    .find(|l| l.from ==