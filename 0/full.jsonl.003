oldLines":7,"newStart":65,"newLines":9,"lines":["         // Best effort: a secret already deleted has no consumers to change.","         let _ = consume(engine, name, false).await;","     }","-    let servers = wanted.iter().map(|s| json!({ \"id\": s.id, \"url\": s.url, \"secret\": s.secret }));","+    let servers = wanted","+        .iter()","+        .map(|s| json!({ \"id\": s.id, \"url\": s.url, \"secret\": s.secret }));","     let set = json!({ \"servers\": servers.collect::<Vec<_>>() });","     engine.call(NS, SET, set).await.map(|_| ())"," }"]},{"oldStart":93,"oldLines":8,"newStart":98,"newLines":15,"lines":["         };","         crate::rt::block_on(mcp_servers_set(&engine, vec![docs])).unwrap();","         let calls = engine.calls.lock().unwrap().clone();","-        let access: Vec<&Value> = calls.iter().filter(|c| c.1 == \"secrets::access\").map(|c| &c.2).collect();","-        assert_eq!(access[0][\"consumers\"], json!([\"bastion-server\", \"bastion-mcp\"]));","+        let access: Vec<&Value> = calls","+            .iter()","+            .filter(|c| c.1 == \"secrets::access\")","+            .map(|c| &c.2)","+            .collect();","+        assert_eq!(","+            access[0][\"consumers\"],","+            json!([\"bastion-server\", \"bastion-mcp\"])","+        );","         assert_eq!(access[1][\"name\"], \"OLD\");","         assert_eq!(access[1][\"consumers\"], json!([\"bastion-server\"]));","     }"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/http.rs","hunks":[{"oldStart":15,"oldLines":7,"newStart":15,"newLines":7,"lines":[" use bastion_core::Event as JobEvent;"," use bastion_protocol::{","     CapabilityView, Change, ConstraintView, EscapeReport, HeldCallRef, HostView, LogRequest,","-    NewEval, NotifySet, NotifyView, SettingsView, Workspace,","+    McpServerView, NewEval, NotifySet, NotifyView, SettingsView, Workspace,"," };"," use futures_util::{Stream, stream};"," use serde::{Deserialize, Serialize};"]}]}],"moreFil