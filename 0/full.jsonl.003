{"type":"ai-title","aiTitle":"Picking up where we left off","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e"}
{"type":"mode","mode":"normal","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e"}
{"type":"permission-mode","permissionMode":"auto","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e"}
