ep;","+    let msg = |m: Msg| editable.then_some(m);","+    match (c.steps.is_empty(), !c.hook.is_empty() && only_here) {","+        (true, _) => chip(\"every step\".into()),","+        (false, true) => small(\"Remove\", msg(Msg::Remove(c.id.clone()))),","+        (false, false) => small(\"Not here\", msg(Msg::Scope(c.id.clone(), false))),","+    }","+}","+"," /// The constraints that apply at the step, and a picker for one that"," /// applies at other steps to apply here too."," fn constraints<'a>(rules: &Rules, at: &At, editable: bool) -> Element<'a, Msg> {"]},{"oldStart":202,"oldLines":13,"newStart":217,"newLines":7,"lines":["         .iter()","         .filter(|c| c.steps.is_empty() || c.steps.iter().any(|s| s == at.step));","     let rows = here.map(|c| {","-        let scope = match c.steps.is_empty() {","-            true => chip(\"every step\".into()),","-            false => small(","-                \"Not here\",","-                editable.then(|| Msg::Scope(c.id.clone(), false)),","-            ),","-        };","+        let scope = scope(c, at, editable);","         row![","             chip(c.rung.clone()),","             text(c.rule.clone()).size(13).width(Fill),"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/gate.rs","hunks":[{"oldStart":718,"oldLines":7,"newStart":718,"newLines":9,"lines":["         let c = constraints.iter().find(|c| c.id == id);","         let c = c.ok_or(format!(\"no constraint {id}\"))?;","         if c.source != govern::Source::Owner {","-            return Err(format!(\"{id} comes from the charter; change it in the repository\"));","+            return Err(format!(","+                \"{id} comes from the charter; change it in the repository\"","+            ));","         }","         self.store.remove_constraint(id).await?;","         self.reload().await?;"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules.rs","/Users/tacoda/tacoda/bastion/