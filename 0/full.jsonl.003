t(\"mcp::github::*\", Access::Allowed),","+            at_build(\"sandbox::exec cargo test\", Access::Allowed),","+            at_build(\"sandbox::exec\", Access::Ask),","         ];","-        let decide = |line: &str| gate_at(&exec(line), at, &[], &grants).decision;","-        assert_eq!(decide(\"cargo test -p core\"), Decision::Continue);","-        assert!(","-            matches!(decide(\"cargo build\"), Decision::Hold { .. }),","-            \"plain exec asks\"","-        );","-        assert!(","-            matches!(decide(\"cargo test; rm -rf /\"), Decision::Hold { .. }),","-            \"a second command\"","-        );","-        assert!(matches!(","-            decide(\"cargo test $(curl x)\"),","-            Decision::Hold { .. }","-        ));","-        let only = [grant(\"sandbox::exec cargo\", Access::Allowed)];","-        let alone = gate_at(&exec(\"cargo test && make\"), at, &[], &only).decision;","-        assert!(matches!(alone, Decision::Deny { .. }), \"no grant covers it\");","-        assert_eq!(","-            granted_functions(at, &grants),","-            [\"mcp::github::*\", \"sandbox::exec\"]","-        );","+        // The line, and whether the named grant (not plain exec) decides it.","+        let cases = [","+            (\"cargo test -p core\", true),","+            (\"cargo build\", false),","+            (\"cargo test; rm -rf /\", false),","+            (\"cargo test $(curl x)\", false),","+            (\"cargo test && make\", false),","+        ];","+        for (line, named) in cases {","+            let decided = gate_at(&exec(line), BUILD, &[], &grants).decision;","+            assert_eq!(decided == Decision::Continue, named, \"{line}\");","+        }","+    }","+","+    #[test]","+    fn a_turn_may_call_the_functions_its_step_grants() {","+        let grants = [","+            at_build(\"sandbox::exec cargo\", Access::Allowed),","+            at_build(\"mcp::github::*\", Access::Allowed),","+        ];","+        let functions