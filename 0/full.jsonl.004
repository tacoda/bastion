n the server, each on for every workflow, or on at the workflows\n3\t//! and steps you pick.\n4\t\n5\tuse bastion_protocol::PersonView;\n6\tuse bastion_protocol::api;\n7\tuse iced::widget::{column, row, text};\n8\tuse iced::{Element, Task};\n9\t\n10\tuse super::step_rules::{self, Which, choice};\n11\tuse super::{Ctx, scrolled};\n12\tuse crate::app::Message;\n13\tuse crate::theme;\n14\t\n15\tpub struct State {\n16\t    pub which: Which,\n17\t    /// The Global view, or the Workflows view.\n18\t    global: bool,\n19\t    admin: bool,\n...\n55\t        }\n56\t    }\n57\t    Task::none()\n58\t}\n59\t\n60\tpub fn view<'a>(state: &'a State, title: &'a str) -> Element<'a, Message> {\n61\t    let pick = |label: &str, global: bool| {\n62\t        choice(\n63\t            label,\n64\t            state.global == global,\n65\t            Some(Message::Rules(Msg::Global(global))),\n66\t        )\n67\t    };\n68\t    let views = row![pick(\"Global\", true), pick(\"Workflows\", false)].spacing(6);\n69\t    let body = step_rules::page(&state.rules, state.which, state.global, state.admin)\n70\t        .map(|m| Message::Rules(Msg::Rules(m)));\n71\t    scrolled(column![text(title).size(24).font(theme::BOLD), views, body].spacing(12))\n72\t}\n</system-reminder>"}],"renderedRole":"system","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
