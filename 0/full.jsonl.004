llRef) -> Result<(), String> {","     factory(cell)?"]},{"oldStart":95,"oldLines":6,"newStart":95,"newLines":27,"lines":["     factory(cell)?.gate().remove_constraint(&id).await"," }"," ","+/// Give a constraint its deterministic form, and move it to a rung (D55).","+pub async fn constraint_form(","+    cell: &FactoryCell,","+    id: String,","+    f: ConstraintForm,","+) -> Result<(), String> {","+    let rung = match &f.rung {","+        Some(r) => Some(","+            serde_json::from_value(json!(r))","+                .map_err(|_| format!(\"{r:?} is not told, checked or enforced\"))?,","+        ),","+        None => None,","+    };","+    let form = Form {","+        function: f.function,","+        contains: f.contains,","+        hook: f.hook,","+    };","+    factory(cell)?.gate().set_form(&id, form, rung).await","+}","+"," /// Set a constraint's rung: told, checked or enforced."," pub async fn constraint_rung(cell: &FactoryCell, id: String, rung: String) -> Result<(), String> {","     let rung = serde_json::from_value(json!(rung))"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/gate.rs","hunks":[{"oldStart":1393,"oldLines":6,"newStart":1393,"newLines":54,"lines":["         });","     }"," ","+    #[test]","+    fn a_told_rule_gets_its_deterministic_form_before_it_is_enforced() {","+        use govern::Enforcement::{Enforced, Told};","+        let r = rig();","+        let told = Constraint {","+            id: \"rule-every-1\".into(),","+            rule: \"Lint before a commit.\".into(),","+            ..Constraint::default()","+        };","+        let read = || {","+            let all = r.store.constraints.lock().unwrap().clone();","+            all.into_iter().find(|c| c.id == \"rule-every-1\").unwrap()","+        };","+        crate::rt::block_on(async {","+            r.gate.add_constraint(told).await.unwrap();","+            let bare = r","+                .gate","+                .set_form(\"rule-every-1\", Form::default()