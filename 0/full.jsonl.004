UX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '\\''{}'\\''; }; fi; else cat >/dev/null; echo '\\''{}'\\''; fi' pre-tool-use 3>&1 1>&2; else cmux_cli=\"${CMUX_CLAUDE_HOOK_CMUX_BIN:-${CMUX_BUNDLED_CLI_PATH:-}}\"; if [ -z \"$cmux_cli\" ] || [ ! -x \"$cmux_cli\" ]; then cmux_cli=\"$(command -v cmux 2>/dev/null || true)\"; fi; agent_pid=\"${CMUX_CLAUDE_PID:-${PPID:-}}\"; if [ -n \"$CMUX_SURFACE_ID\" ] && [ \"$CMUX_CLAUDE_HOOKS_DISABLED\" != \"1\" ] && [ -n \"$cmux_cli\" ]; then if [ -n \"${CMUX_SOCKET_PATH:-}\" ]; then CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" --socket \"$CMUX_SOCKET_PATH\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; else CMUX_CLAUDE_PID=\"$agent_pid\" CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.5 \"$cmux_cli\" hooks enqueue claude pre-tool-use 2>/dev/null || { cat >/dev/null; echo '{}'; }; fi; else cat >/dev/null; echo '{}'; fi; fi","durationMs":77},"type":"attachment","uuid":"22dfdcac-70cb-4efc-a592-7ecfd9792d9b","timestamp":"2026-11-12T17:06:42.567Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"8599f354-30ec-4402-9162-76b21d47bcd5","isSidechain":false,"promptId":"b9900b6a-4bcb-43a2-b19b-738de97bb619","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U7AqRBBwJWYhqQJZSZKEHT","type":"tool_result","content":"The file /Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/mod.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"b1f6a259-d526-4062-8fb1-d108885316c8","timestamp":"2026-11-12T17:06:42.642Z","toolUseResult":{"type":"update","filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/mod.rs","content":"//! The rules on the workflows page, at a level (D53, D54): every workflow,\n//! one workflow, or one step. Each constraint and grant is one item that a\n//! level turns on, off, or leaves to inherit; the most specific setting\n//! wins. A rung belongs to the item, so it reads the same at every level.\n\nmod capabilities;\nmod constraints;\nmod layers;\nmod scope;\n\nuse bastion_protocol::api::{self, Request, ScopeSet};\nuse bastion_protocol::{\n    CapabilityView, Console, ConstraintView, FactoryCapabilityView, McpServerView, Registered,\n    WorkspaceCharterView,\n};\nuse iced::widget::{button, text};\nuse iced::{Element, Task};\n\nuse super::Ctx;\nuse crate::theme;\n\npub use layers::view;\npub use scope::EVERY;\n\n/// The form shown to add an item: one at a time.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub enum Adding {\n    #[default]\n    Grant,\n    Rule,\n    Hook,\n    Reviewer,\n}\n\n/// A field of a new rule's form.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum RuleField {\n    /// What the agent is told.\n    Text,\n    /// The calls it binds: a function pattern, and words a call holds.\n    Function,\n    Contains,\n    Rung,\n}\n\n/// A new rule, as typed.\n#[derive(Default)]\nstruct RuleDraft {\n    text: String,\n    function: String,\n    contains: String,\n    rung: String,\n}\n\n/// The form shown to add a grant: one at a time.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub enum Granting {\n    #[default]\n    Function,\n    Command,\n    Mcp,\n}\n\n/// An item a level turns on or off: a constraint by id, or a grant by its\n/// kind and function.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub enum Item {\n    Constraint(String),\n    Grant(String, String),\n}\n\n#[derive(Default)]\npub struct Rules {\n    constraints: Vec<ConstraintView>,\n    grants: Vec<CapabilityView>,\n    /// Each workspace's charter, read from its repository, and what the\n    /// factory itself may do.\n    charters: Vec<WorkspaceCharterView>,\n    factory: Vec<FactoryCapabilityView>,\n    /// The kind a grant added above a step is for: prompt, agent or skill.\n    for_kind: String,\n    /// The engine's functions, for the search, and the server's MCP servers.\n    catalog: Vec<Registered>,\n    mcp: Vec<McpServerView>,\n    adding: Adding,\n    granting: Granting,\n    /// What the list is narrowed to, and the function search.\n    filter: String,\n    search: String,\n    /// A new command grant's words, a hook's calls and command, and a\n    /// reviewer agent, as typed.\n    command: String,\n    hook_function: String,\n    hook: String,\n    reviewer: String,\n    rule: RuleDraft,\n    said: String,\n}\n\n#[derive(Clone, Debug)]\npub enum Msg {\n    Constraints(Result<Vec<ConstraintView>, String>),\n    Grants(Result<Vec<CapabilityView>, String>),\n    Catalog(Result<Console, String>),\n    Mcp(Result<Vec<McpServerView>, String>),\n    Charters(Result<Vec<WorkspaceCharterView>, String>),\n    Factory(Result<Vec<FactoryCapabilityView>, String>),\n    /// The kind a new grant above a step is for.\n    ForKind(String),\n    /// Set an item `on`, `off` or `inherit` at the level shown.\n    SetScope(Item, String),\n    /// Set a constraint's rung: told, checked or enforced.\n    SetRung(String, String),\n    /// Set a grant's rung: ask or allowed.\n    GrantRung(CapabilityView, String),\n    /// Remove a grant everywhere.\n    Ungrant(CapabilityView),\n    /// Grant `function` on at the level shown, as `ask` or `allowed`.\n    Grant(String, String),\n    Adding(Adding),\n    Granting(Granting),\n    Filter(String),\n    Search(String),\n    Command(String),\n    HookFunction(String),\n    Hook(String),\n    AddHook,\n    Reviewer(String),\n    AddReviewer,\n    Rule(RuleField, String),\n    AddRule,\n    /// Remove a constraint made in the app, everywhere.\n    Remove(String),\n    Done(Result<(), String>),\n}\n\n/// The level a page shows rules for: its scope, `*`, a workflow, or\n/// `workflow/step`, and at a step, the step's kind.\npub struct At<'a> {\n    pub scope: &'a str,\n    pub stage: &'a str,\n}\n\nimpl At<'_> {\n    fn is_step(&self) -> bool {\n        self.scope.contains('/')\n    }\n\n    fn is_every(&self) -> bool {\n        self.scope == EVERY\n    }\n}\n\npub fn load(ctx: &Ctx) -> Task<Msg> {\n    Task::batch([\n        ctx.task(&ctx.current, api::Constraints, Msg::Constraints),\n        ctx.task(&ctx.current, api::Capabilities, Msg::Grants),\n        ctx.task(&ctx.current, api::Console, Msg::Catalog),\n        ctx.task(&ctx.current, api::McpServers, Msg::Mcp),\n        ctx.task(&ctx.current, api::Charters, Msg::Charters),\n        ctx.task(&ctx.current, api::FactoryCapabilities, Msg::Factory),\n    ])\n}\n\nfn send<R>(ctx: &Ctx, request: R) -> Task<Msg>\nwhere\n    R: Request<Answer = ()> + Send + Sync + 'static,\n{\n    ctx.task(&ctx.current, request, Msg::Done)\n}\n\nimpl Rules {\n    /// A kind's grants: one item per function.\n    fn kind(&self, stage: &str) -> Vec<&CapabilityView> {\n        let kind = self.grants.iter();\n        kind.filter(|g| g.step.is_empty() && g.stage == stage)\n            .collect()\n    }\n\n    /// The kind a grant made at `at` is for: the step's, or above a step,\n    /// the one the form picked, a prompt's by default.\n    fn kind_of<'a>(&'a self, at: &At<'a>) -> &'a str {\n        match (at.is_step(), self.for_kind.as_str()) {\n            (true, _) => at.stage,\n            (false, \"\") => \"prompt\",\n            (false, k) => k,\n        }\n    }\n}\n\n/// How many constraints and grants are on at a step, for its Rules tab.\npub fn count(rules: &Rules, at: &At) -> usize {\n    let on = |scopes: &[String]| scope::on(scopes, at.scope);\n    let constraints = rules.constraints.iter().filter(|c| on(&c.steps)).count();\n    constraints + rules.kind(at.stage).into_iter().filter(|g| on(&g.scopes)).count()\n}\n\n/// An enforced constraint made at `scope`, on there only, or everywhere at\n/// every workflow, with an id no constraint has yet, such as\n/// `hook-short-build-1` or `rule-every-1`.\nfn made_at(rules: &Rules, kind: &str, scope: &str, rule: String) -> ConstraintView {\n    let at = match scope {\n        EVERY => \"every\".to_string(),\n        s => s.replace('/', \"-\"),\n    };\n    let base = format!(\"{kind}-{at}\");\n    let taken = |id: &String| rules.constraints.iter().any(|c| &c.id == id);\n    let id = (1..).map(|n| format!(\"{base}-{n}\")).find(|id| !taken(id));\n    ConstraintView {\n        id: id.unwrap_or(base),\n        rule,\n        rung: \"enforced\".into(),\n        source: \"owner\".into(),\n        steps: (scope != EVERY)\n            .then(|| scope.to_string())\n            .into_iter()\n            .collect(),\n        ..ConstraintView::default()\n    }\n}\n\n/// A hook (D50): enforced, so its exit 2 refuses the call.\nfn new_hook(rules: &Rules, scope: &str) -> ConstraintView {\n    let function = Some(rules.hook_function.trim()).filter(|f| !f.is_empty());\n    let function = function.unwrap_or(\"sandbox::exec\");\n    let command = rules.hook.trim();\n    let rule = format!(\"Before each {function} call, `{command}` runs; exit 2 refuses it.\");\n    ConstraintView {\n        function: function.into(),\n        hook: command.into(),\n        ..made_at(rules, \"hook\", scope, rule)\n    }\n}\n\n/// A reviewer (D51): the agent must pass the step's change.\nfn new_reviewer(rules: &Rules, scope: &str) -> ConstraintView {\n    let agent = rules.reviewer.trim();\n    let rule = format!(\"The agent {agent} reviews the step's change, and it must pass.\");\n    ConstraintView {\n        reviewer: agent.into(),\n        ..made_at(rules, \"reviewer\", scope, rule)\n    }\n}\n\n/// A rule: told to the agent, and at checked or enforced it binds the calls\n/// to its function that hold its words. Told by default.\nfn new_rule(rules: &Rules, scope: &str) -> ConstraintView {\n    let d = &rules.rule;\n    let rung = Some(d.rung.as_str())\n        .filter(|r| !r.is_empty())\n        .unwrap_or(\"told\");\n    ConstraintView {\n        function: d.function.trim().into(),\n        contains: d.contains.trim().into(),\n        rung: rung.into(),\n        ..made_at(rules, \"rule\", scope, d.text.trim().into())\n    }\n}\n\n/// The rule, hook or reviewer a form made at `scope`, and the forms cleared.\nfn made(rules: &mut Rules, msg: &Msg, scope: &str) -> ConstraintView {\n    let made = match msg {\n        Msg::AddRule => new_rule(rules, scope),\n        Msg::AddHook => new_hook(rules, scope),\n        _ => new_reviewer(rules, scope),\n    };\n    rules.hook.clear();\n    rules.reviewer.clear();\n    rules.rule = RuleDraft::default();\n    made\n}\n\nfn rule_field(d: &mut RuleDraft, field: RuleField, value: String) {\n    match field {\n        RuleField::Text => d.text = value,\n        RuleField::Function => d.function = value,\n        RuleField::Contains => d.contains = value,\n        RuleField::Rung => d.rung = value,\n    }\n}\n\n/// An item set `on`, `off` or `inherit` at `scope`.\nfn scope_set(item: Item, setting: String, scope: &str) -> ScopeSet {\n    let (constraint, stage, function) = match item {\n        Item::Constraint(id) => (id, String::new(), String::new()),\n        Item::Grant(stage, function) => (String::new(), stage, function),\n    };\n    ScopeSet {\n        constraint,\n        stage,\n        function,\n        scope: scope.into(),\n        setting,\n    }\n}\n\n/// A grant's rung set to `rung`: one step up the ladder to allowed, or one\n/// down to ask.\nfn set_rung(g: CapabilityView, rung: String, ctx: &Ctx) -> Task<Msg> {\n    if g.rung == rung {\n        return Task::none();\n    }\n    let moved = api::CapabilityMove {\n        stage: g.stage,\n        step: g.step,\n        function: g.function,\n        up: rung == \"allowed\",\n    };\n    send(ctx, moved)\n}\n\n/// A grant of `function` for `stage`, on at `scope`, as `rung`. The server\n/// reads the view's step as the scope to turn it on at; none is every\n/// workflow.\nfn grant(function: &str, rung: String, stage: &str, scope: &str) -> CapabilityView {\n    let scope = if scope == EVERY { \"\" } else { scope };\n    CapabilityView {\n        stage: stage.into(),\n        step: scope.into(),\n        function: function.trim().into(),\n        rung,\n        ..CapabilityView::default()\n    }\n}\n\n/// What the forms hold as typed, and which form shows.\nfn typed(rules: &mut Rules, msg: Msg) {\n    match msg {\n        Msg::Adding(a) => rules.adding = a,\n        Msg::Granting(g) => rules.granting = g,\n        Msg::Filter(f) => rules.filter = f,\n        Msg::Search(s) => rules.search = s,\n        Msg::Command(c) => rules.command = c,\n        Msg::HookFunction(f) => rules.hook_function = f,\n        Msg::Hook(h) => rules.hook = h,\n        Msg::Reviewer(r) => rules.reviewer = r,\n        Msg::Rule(field, value) => rule_field(&mut rules.rule, field, value),\n        Msg::ForKind(k) => rules.for_kind = k,\n        _ => {}\n    }\n}\n\n/// What the server answered.\nfn read(rules: &mut Rules, msg: Msg) {\n    match msg {\n        Msg::Constraints(Ok(all)) => rules.constraints = all,\n        Msg::Grants(Ok(all)) => rules.grants = all,\n        Msg::Catalog(Ok(console)) => rules.catalog = console.functions,\n        Msg::Mcp(Ok(all)) => rules.mcp = all,\n        Msg::Charters(Ok(all)) => rules.charters = all,\n        Msg::Factory(Ok(all)) => rules.factory = all,\n        Msg::Constraints(Err(e)) | Msg::Grants(Err(e)) | Msg::Done(Err(e)) => rules.said = e,\n        // The search and the MCP shortcut are a help, not a need.\n        _ => {}\n    }\n}\n\npub fn update(rules: &mut Rules, msg: Msg, at: &At, ctx: &Ctx) -> Task<Msg> {\n    match msg {\n        Msg::Done(Ok(_)) => {\n            rules.said.clear();\n            load(ctx)\n        }\n        Msg::Remove(id) => send(ctx, api::ConstraintRemove { id }),\n        Msg::AddRule | Msg::AddReviewer | Msg::AddHook => {\n            send(ctx, api::ConstraintAdd(made(rules, &msg, at.scope)))\n        }\n        Msg::SetScope(item, setting) => send(ctx, api::Scope(scope_set(item, setting, at.scope))),\n        Msg::GrantRung(g, rung) => set_rung(g, rung, ctx),\n        Msg::Ungrant(g) => send(ctx, api::CapabilityRemove(g)),\n        Msg::SetRung(id, rung) => send(ctx, api::ConstraintRung { id, rung }),\n        Msg::Grant(function, rung) => {\n            (rules.search, rules.command) = Default::default();\n            let kind = rules.kind_of(at).to_string();\n            send(ctx, api::CapabilityAdd(grant(&function, rung, &kind, at.scope)))\n        }\n        m @ (Msg::Constraints(_)\n        | Msg::Grants(_)\n        | Msg::Catalog(_)\n        | Msg::Mcp(_)\n        | Msg::Charters(_)\n        | Msg::Factory(_)\n        | Msg::Done(_)) => {\n            read(rules, m);\n            Task::none()\n        }\n        m => {\n            typed(rules, m);\n            Task::none()\n        }\n    }\n}\n\n/// Why the last change failed, when one did.\npub fn said(rules: &Rules) -> Option<Element<'_, Msg>> {\n    let said = (!rules.said.is_empty()).then_some(&rules.said)?;\n    Some(text(said).size(13).color(theme::BAD).into())\n}\n\nfn small<'a>(label: impl Into<String>, msg: Option<Msg>) -> Element<'a, Msg> {\n    button(text(label.into()).size(12))\n        .padding([3, 10])\n        .style(theme::secondary)\n        .on_press_maybe(msg)\n        .into()\n}\n\n/// One choice of a switch, filled when it is the one chosen.\nfn choice<'a>(label: impl Into<String>, on: bool, msg: Option<Msg>) -> Element<'a, Msg> {\n    button(text(label.into()).size(12))\n        .padding([4, 10])\n        .style(theme::nav(on))\n        .on_press_maybe(msg)\n        .into()\n}\n\nfn chip<'a>(label: impl Into<String>) -> Element<'a, Msg> {\n    iced::widget::container(text(label.into()).size(11).color(theme::MUTED))\n        .padding([2, 8])\n        .style(theme::chip)\n        .into()\n}\n\n/// A line of muted help.\nfn help<'a>(words: impl Into<String>) -> Element<'a, Msg> {\n    text(words.into()).size(12).color(theme::MUTED).into()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_new_item_is_on_where_it_was_made() {\n        let mut rules = Rules {\n            hook: \" ./lint.sh \".into(),\n            ..Rules::default()\n        };\n        let first = new_hook(&rules, \"short/build\");\n        assert_eq!(\n            (first.id.as_str(), first.steps.as_slice()),\n            (\"hook-short-build-1\", &[\"short/build\".to_string()][..])\n        );\n        rules.constraints.push(first);\n        assert_eq!(new_hook(&rules, \"short/build\").id, \"hook-short-build-2\");\n        let every = new_hook(&rules, EVERY);\n        assert_eq!(every.id, \"hook-every-1\");\n        assert!(every.steps.is_empty(), \"no steps is every step\");\n        let at_workflow = grant(\"sandbox::fs::read\", \"ask\".into(), \"prompt\", \"short\");\n        assert_eq!(at_workflow.step, \"short\", \"on for the workflow\");\n        assert_eq!(grant(\"x\", \"ask\".into(), \"prompt\", EVERY).step, \"\");\n    }\n\n    #[test]\n    fn a_new_rule_is_told_unless_its_rung_says_more() {\n        let mut rules = Rules::default();\n        rule_field(&mut rules.rule, RuleField::Text, \" Keep diffs small. \".into());\n        let told = new_rule(&rules, \"short/build\");\n        assert_eq!((told.rule.as_str(), told.rung.as_str()), (\"Keep diffs small.\", \"told\"));\n        rule_field(&mut rules.rule, RuleField::Rung, \"enforced\".into());\n        rule_field(&mut rules.rule, RuleField::Function, \"sandbox::exec\".into());\n        let enforced = new_rule(&rules, \"short/build\");\n        assert_eq!(\n            (enforced.rung.as_str(), enforced.function.as_str()),\n            (\"enforced\", \"sandbox::exec\")\n        );\n    }\n\n    #[test]\n    fn a_step_counts_what_is_on_there() {\n        let grant = |scopes: &[&str]| CapabilityView {\n            stage: \"prompt\".into(),\n            function: \"sandbox::*\".into(),\n            rung: \"allowed\".into(),\n            scopes: scopes.iter().map(|s| s.to_string()).collect(),\n            ..CapabilityView::default()\n        };\n        let rules = Rules {\n            grants: vec![grant(&[]), grant(&[\"*\", \"!short\"])],\n            constraints: vec![ConstraintView::default()],\n            ..Rules::default()\n        };\n        let at = At { scope: \"short/review\", stage: \"prompt\" };\n        assert_eq!(count(&rules, &at), 2, \"the rule and the grant on everywhere\");\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":13,"newStart":1,"newLines":14,"lines":["-//! The rules at one workflow step, on the workflows page (D44, D48): the","-//! constraints that apply there, and the grants that decide what its","-//! agent's calls may do. A step uses its kind's grants until it has its own,","-//! which then take their place. Each is a tab of the step's panel.","+//! The rules on the workflows page, at a level (D53, D54): every workflow,","+//! one workflow, or one step. Each constraint and grant is one item that a","+//! level turns on, off, or leaves to inherit; the most specific setting","+//! wins. A rung belongs to the item, so it reads the same at every level."," "," mod capabilities;"," mod constraints;"," mod layers;","+mod scope;"," ","-use bastion_protocol::api::{self, Request};","+use bastion_protocol::api::{self, Request, ScopeSet};"," use bastion_protocol::{","     CapabilityView, Console, ConstraintView, FactoryCapabilityView, McpServerView, Registered,","     WorkspaceCharterView,"]},{"oldStart":18,"oldLines":9,"newStart":19,"newLines":10,"lines":[" use super::Ctx;"," use crate::theme;"," ","-pub use layers::{every_step, view};","+pub use layers::view;","+pub use scope::EVERY;"," ","-/// The form shown to add a constraint: one at a time.","+/// The form shown to add an item: one at a time."," #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]"," pub enum Adding {","     #[default]"]},{"oldStart":28,"oldLines":7,"newStart":30,"newLines":6,"lines":["     Rule,","     Hook,","     Reviewer,","-    Elsewhere,"," }"," "," /// A field of a new rule's form."]},{"oldStart":42,"oldLines":7,"newStart":43,"newLines":7,"lines":["     Rung,"," }"," ","-/// A new rule for the step, as typed.","+/// A new rule, as typed."," #[derive(Default)]"," struct RuleDraft {","     text: String,"]},{"oldStart":60,"oldLines":6,"newStart":61,"newLines":14,"lines":["     Mcp,"," }"," ","+/// An item a level turns on or off: a constraint by id, or a grant by its","+/// kind and function.","+#[derive(Clone, Debug, PartialEq, Eq)]","+pub enum Item {","+    Constraint(String),","+    Grant(String, String),","+}","+"," #[derive(Default)]"," pub struct Rules {","     constraints: Vec<ConstraintView>,"]},{"oldStart":68,"oldLines":14,"newStart":77,"newLines":14,"lines":["     /// factory itself may do.","     charters: Vec<WorkspaceCharterView>,","     factory: Vec<FactoryCapabilityView>,","-    /// The kind of step a grant for every step is for: prompt, agent or skill.","+    /// The kind a grant added above a step is for: prompt, agent or skill.","     for_kind: String,","     /// The engine's functions, for the search, and the server's MCP servers.","     catalog: Vec<Registered>,","     mcp: Vec<McpServerView>,","     adding: Adding,","     granting: Granting,","-    /// What the constraint list is narrowed to, and the function search.","+    /// What the list is narrowed to, and the function search.","     filter: String,","     search: String,","     /// A new command grant's words, a hook's calls and command, and a"]},{"oldStart":96,"oldLines":20,"newStart":105,"newLines":17,"lines":["     Mcp(Result<Vec<McpServerView>, String>),","     Charters(Result<Vec<WorkspaceCharterView>, String>),","     Factory(Result<Vec<FactoryCapabilityView>, String>),","-    /// The kind a new grant for every step is for.","+    /// The kind a new grant above a step is for.","     ForKind(String),","+    /// Set an item `on`, `off` or `inherit` at the level shown.","+    SetScope(Item, String),","     /// Set a constraint's rung: told, checked or enforced.","     SetRung(String, String),","-    /// Apply a constraint at the step too, or take it off the step.","-    Scope(String, bool),","-    /// Give the step its own grants, starting from its kind's.","-    Own,","-    /// Take the step's own grants back, so its kind's apply.","-    Kind,","-    /// Set a grant of the step's own to `ask` or `allowed`.","-    Rung(CapabilityView, String),","+    /// Set a grant's rung: ask or allowed.","+    GrantRung(CapabilityView, String),","+    /// Remove a grant everywhere.","     Ungrant(CapabilityView),","-    /// Grant `function` at the step, as `ask` or `allowed`.","+    /// Grant `function` on at the level shown, as `ask` or `allowed`.","     Grant(String, String),","     Adding(Adding),","     Granting(Granting),"]},{"oldStart":123,"oldLines":17,"newStart":129,"newLines":28,"lines":["     AddReviewer,","     Rule(RuleField, String),","     AddRule,","-    /// Remove a hook or a reviewer made for this step.","+    /// Remove a constraint made in the app, everywhere.","     Remove(String),","     Done(Result<(), String>),"," }"," ","-/// The step a page shows rules for: its name, `workflow/step`, a