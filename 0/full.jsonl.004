w not turned off.","+fn select_every(table: &str, list: &str) -> String {","+    format!(","+        \"UPDATE {table} SET {list} = TRIM('* ' || {list}) \\","+         WHERE (' ' || {list}) NOT GLOB '* [^!]*' AND (' ' || {list} || ' ') NOT LIKE '% !* %'\"","+    )","+}","+"," /// A command step as the prompt that does what it did: read the command's"," /// file and carry it out, then the step's own words."," const COMMANDS_AS_PROMPTS: &str = \"UPDATE workflow_nodes SET stage = 'prompt', \\"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/store/tests.rs","hunks":[{"oldStart":139,"oldLines":7,"newStart":139,"newLines":7,"lines":[" #[test]"," fn migration_1_rebuilds_the_staged_tables_once_with_deferred_keys() {","     let fresh = transactions_at(0);","-    assert_eq!(fresh.len(), 10, \"the schema, then migrations 1 to 9\");","+    assert_eq!(fresh.len(), 11, \"the schema, then migrations 1 to 10\");","     let m1 = &fresh[1];","     assert_eq!(m1.first().unwrap(), \"PRAGMA defer_foreign_keys = ON\");","     assert_eq!(m1.last().unwrap(), \"PRAGMA user_version = 1\");"]},{"oldStart":171,"oldLines":7,"newStart":171,"newLines":7,"lines":["         let renamed = format!(\"UPDATE {table} SET stage = 'shell' WHERE stage = 'command'\");","         assert!(m4.contains(&renamed), \"{table}\");","     }","-    assert_eq!(transactions_at(9).len(), 1, \"nothing left to migrate\");","+    assert_eq!(transactions_at(10).len(), 1, \"nothing left to migrate\");"," }"," "," #[test]"]},{"oldStart":217,"oldLines":8,"newStart":217,"newLines":8,"lines":["         m8.iter().any(|s| s.contains(\"WHERE rung = 'denied'\")),","         \"refusal is the default\"","     );","-    assert_eq!(transactions_at(4).len(), 6, \"migrations 5 to 9 are left\");","-    assert_eq!(transactions_at(9).len(), 1, \"nothing left to migrate\");","+    assert_eq!(transactions_at(4).len(), 7, \"migrations 5 to 10 are left\");","+    assert_eq!(transactions_at(10).len(), 1, \"nothing left to migrate\");"," }"," "," #[test]"]},{"oldStart":334,"oldLines":3,"newStart":334,"newLines":12,"lines":["     );","     assert_eq!(m9.last().unwrap(), \"PRAGMA user_version = 9\");"," }","+","+#[test]","+fn migration_10_selects_every_workflow_where_a_list_selected_nothing() {","+    let m10 = &transactions_at(0)[10];","+    for table in [\"UPDATE constraints SET steps\", \"UPDATE capabilities SET scopes\"] {","+        assert!(m10.iter().any(|s| s.starts_with(table)), \"{m10:#?}\");","+    }","+    assert_eq!(m10.last().unwrap(), \"PRAGMA user_version = 10\");","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-server/src/gate.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/store/schema.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/store/tests.rs"]}},"serverClassifierContext":{"request":"3ff2afb1-c2eb-4a3e-8f9f-705d1e3ec21b","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"d44d7100-8eb2-452a-bb90-f592aa5f7239","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
