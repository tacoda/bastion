:        Msg::Workflows(Err(e)) | Msg::Me(Err(e)) | Msg::Models(Err(e)) => state.said = e,\n    Message::Workflows(msg)\n}\n\npub fn load(ctx: &Ctx) -> Task<Message> {\n    let read = ctx.task(&ctx.current, api::Workflows, Msg::Workflows);\n    let me = ctx.task(&ctx.current, api::Me, Msg::Me);\n    let models = ctx.task(&ctx.current, api::Models, Msg::Models);\n    let rules = super::step_rules::load(ctx).map(Msg::Rules);\n    Task::batch([read, me, models, rules]).map(wrap)\n}\n\nfn act<R>(ctx: &Ctx, request: R, done: fn(R::Answer) -> Done) -> Task<Message>\nwhere\n//! One file per page. A page keeps its state here, reads from\n//! the servers through `Ctx`, and draws with the shared pieces below.\n\npub mod audit;\npub mod chart;\npub mod costs;\npub mod diff;\npub mod drawing;\npub mod edit;\npub mod engine;\npub mod evals;\npub mod job;\npub mod jobs;\npub mod new_request;\npub mod session;\npub mod settings;\npub mod spinner;\npub mod step_rules;\npub mod verification;\npub mod workflows;\n\nuse std::collections::BTreeSet;\nuse std::time::{SystemTime, UNIX_EPOCH};\n\nuse bastion_protocol::Server;\nuse bastion_protocol::api::Request;\nuse iced::widget::{column, container, text};\nuse iced::{Color, Element, Fill, Task};\n\nuse crate::app::Message;","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"4c064a00-91df-4207-a066-b7cf7aaf3660","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":5,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src","platform":"macos"}},"sourceToolAssistantUUID":"5229f2cf-ef04-427f-a36d-58b7b5f629fa","session_id":"4fe51ecd-d6cc-423f-a3