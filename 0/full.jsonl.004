ble)","+        scope_switch(item, &c.steps, at, editable && c.source != \"charter\"),","     ]","     .spacing(8)","-    .align_y(iced::Center)","-    .into()","+    .align_y(iced::Center);","+    if editable && removable(c, at) {","+        line = line.push(small(\"Remove\", Some(Msg::Remove(c.id.clone()))));","+    }","+    line.into()"," }"," ","-/// The form for a rule at the step: what the agent is told, its rung, and","-/// the calls it binds once it is more than told.","+/// The form for a rule: what the agent is told, its rung, and the calls it","+/// binds once it is more than told."," pub(super) fn rule_form<'a>(rules: &Rules) -> Element<'a, Msg> {","     let d = &rules.rule;","     let named = !d.text.trim().is_empty();","     let field = |hint: &'static str, value: &str, f: RuleField| {","-        text_input(hint, value)","-            .on_input(move |v| Msg::Rule(f, v))","-            .style(theme::field)","+        text_input(hint, value).on_input(move |v| Msg::Rule(f, v)).style(theme::field)","     };","     let rungs = vec![\"told\".to_string(), \"checked\".into(), \"enforced\".into()];","-    let rung = Some(d.rung.clone())","-        .filter(|r| !r.is_empty())","-        .or(Some(\"told\".into()));","+    let rung = Some(d.rung.clone()).filter(|r| !r.is_empty()).or(Some(\"told\".into()));","     let rung = pick_list(rungs, rung, |r| Msg::Rule(RuleField::Rung, r))","         .text_size(13)","         .style(theme::select);","-    let text = field(","-        \"What the agent is told, such as: Keep each commit under 200 lines.\",","-        &d.text,","-        RuleField::Text,","-    )","-    .on_submit_maybe(named.then_some(Msg::AddRule));","+    let text = field(\"What the agent is told, such as: Keep each commit under 200 lines.\", &d.text, RuleField::Text)","+        .on_submit_maybe(named.then_some(Msg::AddRule));","     let binds = row![","-        field(","-            \"Calls, such as sandbox::exec\",","-            &d.function,","-         