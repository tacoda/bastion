widget::button(text(label).size(13))","+            .padding([5, 12])","+            .style(theme::nav(&route == here))","+            .on_press(Message::Go(route))","+            .into()","+    });","+    iced::widget::Row::with_children(tabs).spacing(6).into()","+}","+"," /// The page the window shows, with its state."," pub enum Page {","     Jobs(jobs::State),"]},{"oldStart":297,"oldLines":6,"newStart":315,"newLines":7,"lines":["             Route::Eval(id) => Page::Eval(Box::new(evals::One::new(id.clone()))),","             Route::Settings => Page::Settings(Box::default()),","             Route::Workflows => Page::Workflows(Box::default()),","+            Route::Workspaces => Page::Settings(Box::new(settings::State::workspaces())),","             Route::Constraints => Page::rules(Which::Constraints),","             Route::Capabilities => Page::rules(Which::Capabilities),","             Route::Permissions => Page::rules(Which::Permissions),"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/rules_page.rs","hunks":[{"oldStart":68,"oldLines":5,"newStart":68,"newLines":6,"lines":["     let views = row![pick(\"All workflows\", true), pick(\"Workflows\", false)].spacing(6);","     let body = step_rules::page(&state.rules, state.which, state.global, state.admin)","         .map(|m| Message::Rules(Msg::Rules(m)));","-    scrolled(column![text(title).size(24).font(theme::BOLD), views, body].spacing(12))","+    let tabs = super::workflow_tabs(&state.which.route());","+    scrolled(column![text(title).size(24).font(theme::BOLD), tabs, views, body].spacing(12))"," }"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/workflows.rs","hunks":[{"oldStart":14,"oldLines":6,"newStart":14,"newLines":7,"lines":[" use super::edit::{self, Drag, Pick};"," use super::{Choice, Ctx, labeled, scrolled};"," use crate::app::Message;","+use crate::route::Route;"," use crate::theme;"," "," /// The ways a workflow's own step runs, each with its one text."]},{"oldStart":836,"oldLines":7,"newStart":837,"newLines":12,"lines":["         \"The series of steps a job on {} runs. Pick a step to read or change it, and its Rules tab for what applies there.\",","         ctx.current","     );","-    let mut body = column![super::head(\"Workflows\", about, vec![]), chooser(state)].spacing(12);","+    let mut body = column![","+        super::head(\"Workflows\", about, vec![]),","+        super::workflow_tabs(&Route::Workflows),","+        chooser(state)","+    ]","+    .spacing(12);","     if state.admin {","         body = body.push(manage_view(state));","     }"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/route.rs","hunks":[{"oldStart":15,"oldLines":6,"newStart":15,"newLines":7,"lines":["     Session(String),","     Engine,","     Workflows,","+    Workspaces,","     Constraints,","     Capabilities,","     Permissions,"]},{"oldStart":22,"oldLines":12,"newStart":23,"newLines":10,"lines":[" }"," "," /// The top bar's pages. A job and New request belong to Jobs.","-pub const PAGES: [(Route, &str, &str); 11] = [","+pub const PAGES: [(Route, &str, &str); 9] = [","     (Route::Jobs, \"Jobs\", icons::JOBS),","     (Route::Workflows, \"Workflows\", icons::WORKFLOWS),","-    (Route::Constraints, \"Constraints\", icons::CONSTRAINTS),","-    (Route::Capabilities, \"Capabilities\", icons::CAPABILITIES),","-    (Route::Permissions, \"Permissions\", icons::PERMISSIONS),","+    (Route::Workspaces, \"Workspaces\", icons::FOLDER),","     (Route::Audit, \"Audit Log\", icons::AUDIT),","     (Route::Evals, \"Evals\", icons::EVALS),","     (Route::Costs, \"Costs\", icons::COSTS),"]},{"oldStart":43,"oldLines":6,"newStart":42,"newLines":8,"lines":["             Route::NewRequest | Route::Job(_) => Route::Jobs,","             Route::Eval(_) => Route::Evals,","             Route::Session(_) => Route::Costs,","+            // The rules a workflow applies are its tabs (S2).","+            Route::Constrain