s in","+  the repository."," - **Settings:** its model providers, its people and their roles, its","   notifications, and its secrets."," - **Records:** its jobs, its audit log, its evals, its costs, and what"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/PLAN.md","/Users/tacoda/tacoda/bastion/VISION.md"]}},"serverClassifierContext":{"request":"9145d2e5-aed4-436b-b6dd-436b72654f0f","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":5,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"d044a035-feac-4c2f-9483-b98e86f74f0d","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
