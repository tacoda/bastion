ng.as_deref().map(mode).transpose()?;","     let form = Form {","         function: f.function,","         contains: f.contains,"]},{"oldStart":120,"oldLines":9,"newStart":113,"newLines":17,"lines":[" "," /// Set a constraint's rung: told, checked or enforced."," pub async fn constraint_rung(cell: &FactoryCell, id: String, rung: String) -> Result<(), String> {","-    let rung = serde_json::from_value(json!(rung))","-        .map_err(|_| format!(\"{rung:?} is not told, checked or enforced\"))?;","-    factory(cell)?.gate().set_constraint_rung(&id, rung).await","+    factory(cell)?.gate().set_constraint_rung(&id, mode(&rung)?).await","+}","+","+/// A constraint's mode (D56): feedforward, stored as told, or feedback,","+/// stored as enforced. Checked gave way and is refused.","+fn mode(word: &str) -> Result<Enforcement, String> {","+    match word {","+        \"told\" | \"feedforward\" => Ok(Enforcement::Told),","+        \"enforced\" | \"feedback\" => Ok(Enforcement::Enforced),","+        other => Err(format!(\"{other:?} is not feedforward or feedback\")),","+    }"," }"," "," pub async fn constraint_move(cell: &FactoryCell, id: String, up: bool) -> Result<(), String> {"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/govern.rs"]}},"serverClassifierContext":{"request":"bfddd214-2dea-489a-88ae-1dce1dd6a635","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":10,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"16c7281f-d5b3-4220-b6ea-2c8230d52972","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessi