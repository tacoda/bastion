s own.","+fn kind_grants<'a>(rules: &'a Rules, editable: bool) -> Vec<Element<'a, Msg>> {","+    KINDS","+        .iter()","+        .map(|(kind, name)| {","+            let head = text(format!(\"{name} steps\")).size(12).color(theme::MUTED);","+            let rows = rules.kind(kind).into_iter().map(|g| line(g, &rules.catalog, editable));","+            Column::new().spacing(6).push(head).extend(rows).into()","+        })","+        .collect()","+}","+","+/// What the factory itself may do, as its workspace and steps set it.","+fn factory_line<'a>(f: &FactoryCapabilityView) -> Element<'a, Msg> {","+    let what = column![text(f.name.clone()).size(13), help(f.how.clone())].spacing(2).width(Fill);","+    row![what, super::chip(f.rung.clone())].spacing(8).align_y(iced::Center).into()","+}","+","+/// The add bar for every step: a grant for one kind, a rule, a hook or a","+/// reviewer, each for every step.","+fn adding_every<'a>(rules: &'a Rules) -> Element<'a, Msg> {","+    let pick = |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));","+    let switch = row![","+        text(\"Add for every step\").size(13).color(theme::MUTED),","+        pick(\"A grant\", Adding::Grant),","+        pick(\"A rule\", Adding::Rule),","+        pick(\"A hook\", Adding::Hook),","+        pick(\"A reviewer\", Adding::Reviewer),","+    ]","+    .spacing(6)","+    .align_y(iced::Center);","+    let kind = rules.kind_of(&At { step: \"\", stage: \"\" });","+    let form = match rules.adding {","+        Adding::Hook => hook_form(rules),","+        Adding::Reviewer => reviewer_form(rules),","+        Adding::Grant | Adding::Elsewhere => {","+            let kinds = KINDS.iter().map(|(k, name)| choice(format!(\"{name} steps\"), kind == *k, Some(Msg::ForKind(k.to_string()))));","+            let kinds = row![text(\"For\").size(12).color(theme::MUTED)].extend(kinds).spacing(6).align_y(iced::Center);","+            column![kinds, granting(rules)].spacing(10).into()","+        }","+        Adding::Rule => rule_form(rules),","+    };","+    container(column![switch, form].spacing(10))","+        .padding(12)","+        .width(Fill)","+        .style(theme::panel)","+        .into()","+}","+","+/// What applies at every step of every workflow: each kind's grants, the","+/// rules and checks for every step, and the charters, by layer.","+pub fn every_step<'a>(rules: &'a Rules, server: &str, editable: bool) -> Element<'a, Msg> {","+    let at = At { step: \"\", stage: \"\" };","+    let here = rules.here(\"\");","+    let of = |name: &str| here.iter().copied().filter(|c| layer(c) == name && c.steps.is_empty()).collect::<Vec<_>>();","+    let mut harness = kind_grants(rules, editable);","+    harness.extend(rows(rules, of(\"harness\"), &at, editable));","+    let mut factory = rows(rules, of(\"factory\"), &at, editable);","+    factory.extend(rules.factory.iter().map(factory_line));","+    let head = column![","+        text(\"Every step\").size(18).font(theme::BOLD),","+        help(format!(\"What applies at every step of every workflow on {server}, unless a step has its own grants. Pick a step on the canvas for its own rules.\")),","+    ]","+    .spacing(2);","+    let mut body = Column::new()","+        .spacing(10)","+        .push(head)","+        .push(charter(rules, of(\"charter\"), &at))","+        .push(section(\"Harness\", \"The agent's calls: each kind's grants, and the rules and hooks on calls.\", harness))","+        .push(section(\"Factory\", \"The work around the calls: checks on the change, reviewers, and what the factory may do.\", factory));","+    if editable {","+        body = body.push(adding_every(rules));","+    }","+    container(body.extend(super::said(rules)))","+        .padding(16)","+        .width(Fill)","+        .style(theme::panel)","+        .into()","+}"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/capabilities.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/constraints.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/layers.rs"]}},"serverClassifierContext":{"request":"f3159efc-7b2c-4097-a23d-7106fa43d9e7","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"b7c16c13-3869-45b7-bc61-0f3e722d0c2d","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
