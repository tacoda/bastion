es) -> Option<Element<'_, Msg>> {\n55:    Workflows(pages::workflows::Msg),\n201:            | Message::Workflows(_)) => {\n//! The Audit Log: each server's chain, whether it verifies, and its entries,\n//! for the server the switcher shows or for every server, newest first.\n\nuse std::collections::BTreeMap;\n\nuse bastion_protocol::api;\nuse bastion_protocol::{AuditEntryView, AuditView};\nuse iced::widget::{Column, button, column, container, row, text};\nuse iced::{Color, Element, Fill, Task};\n\nuse super::chart::{self, Bars};\nuse super::{Ctx, Each, ago, scrolled};\nuse crate::app::Message;\nuse crate::theme;\n\n#[derive(Default)]\npub struct State {\n    /// Each server's chain, by its name.\n    read: Vec<(String, AuditView)>,\n    /// Why each server that did not answer did not.\n    failed: Vec<String>,\n    exported: String,\n}\n\n#[derive(Clone, Debug)]\npub enum Msg {\n    Read(Box<Each<AuditView>>),\n    Export,\n    Exported(Result<String, String>),\n}\n\npub fn load(ctx: &Ctx) -> Task<Message> {\n    let read = ctx.clone().each(api::Audit);\n    Task::perform(read, |r| Message::Audit(Msg::Read(Box::new(r))))\n}\n\npub fn update(state: &mut State, msg: Msg, ctx: &Ctx) -> Task<Message> {\n    match msg {\n        Msg::Read(r) => (state.read, state.failed) = *r,\n        Msg::Export => {\n            return ctx\n                .task(&ctx.current, api::AuditExport, Msg::Exported)\n                .map(Message::Audit);\n        }\n        Msg::Exported(answer) => {\n            state.exported = answer.map_or_else(|e| e, |path| format!(\"Written to {path}\"))\n        }\n    }\n    Task::none()\n}\n\n/// Whether the chain verifies, and whether its writer keeps up.\nfn audit_status(a: &AuditView) -> (String, Color, Option<(String, Color)>) {\n    let (status, color) = match a.broken_at {\n        None => (\n            format!(\n                \"Verified: all {} entries chain from the first.\",\n                a.entries.len()\n            ),\n            theme::OK,","is_error":false}]},"uuid":"b5a05ccc-11a0-483f-9207-c4d2c6a0d41b","timestamp":"2026-11-12T19:55:22.121Z","toolUseResult":{"stdout":"51:    rules: super::step_rules::Rules,\n86:    Rules(super::step_rules::Msg),\n135:    let rules = super::step_rules::load(ctx).map(Msg::Rules);\n478:            let at = super::step_rules::At {\n482:            return super::step_rules::update(&mut state.rules, m, &at, ctx)\n754:        let at = super::step_rules::At {\n758:        let count = super::step_rules::count(&state.rules, &at);\n783:    let at = super::step_rules::At {\n787:    let view = super::step_rules::view(&state.rules, &at, editable);\n893:    let at = super::step_rules::At {\n898:        super::step_rules::view(&state.rules, &at, state.admin).map(|m| wrap(Msg::Rules(m)));\npages/step_rules/pages.rs:21:pub enum Which {\npages/step_rules/pages.rs:223:pub fn page<'a>(rules: &'a Rules, which: Which, global: bool, editable: bool) -> Element<'a, Msg> {\npages/step_rules/pages.rs:244:pub fn level(global: bool) -> At<'static> {\npages/step_rules/mod.rs:24:pub use layers::view;\npages/step_rules/mod.rs:25:pub use pages::{Which, level, page};\npages/step_rules/mod.rs:26:pub use scope::EVERY;\npages/step_rules/mod.rs:30:pub enum Adding {\npages/step_rules/mod.rs:44:pub enum RuleField {\npages/step_rules/mod.rs:62:pub enum FormField {\npages/step_rules/mod.rs:81:pub enum Granting {\npages/step_rules/mod.rs:91:pub enum Item {\npages/step_rules/mod.rs:97:pub struct Rules {\npages/step_rules/mod.rs:131:pub enum Msg {\npages/step_rules/mod.rs:181:pub struct At<'a> {\npages/step_rules/mod.rs:196:pub fn load(ctx: &Ctx) -> Task<Msg> {\npages/step_rules/mod.rs:235:pub fn count(rules: &Rules, at: &At) -> usize {\npages/step_rules/mod.rs:473:pub fn update(rules: &mut Rules, msg: Msg, at: &At, ctx: &Ctx) -> Task<Msg> {\npages/step_rules/mod.rs:517:pub fn said(rules: &Rules) -> Option<Element<'_, Msg>> {\n55:    Workflows(pages::workflows::Msg),\n201:            | Message::Workfl