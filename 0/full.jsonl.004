ack before you decide. Setup runs with the network in a VM of its own, before the agent starts; the agent's VM stays offline. The environment is visible to the agent, so keep secrets out of it. Before a push, each gate runs over the change's files, where {files} names them; a failing gate gets the autofix once, then stops the push.\";","     let rows = state.workspaces.iter().map(|w| {"]},{"oldStart":467,"oldLines":9,"newStart":381,"newLines":16,"lines":["     card(\"Accounts\", Column::with_children(rows).spacing(4))"," }"," ","-/// The servers first, then the workspaces and accounts, as the page orders them.","-pub fn view<'a>(state: &'a State, ctx: &Ctx) -> (Element<'a, Message>, [Element<'a, Message>; 2]) {","-    (servers(state, ctx), [workspaces(state), accounts(state)])","+pub fn view<'a>(state: &'a State, ctx: &Ctx) -> Element<'a, Message> {","+    let about = format!(\"The repositories jobs on {} run against.\", ctx.current);","+    let body = column![","+        crate::pages::head(\"Workspaces\", about, vec![]),","+        workspaces(state),","+        accounts(state),","+        text(&state.note).size(13).color(theme::BAD)","+    ]","+    .spacing(16);","+    scrolled(body)"," }"," "," #[cfg(test)]"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/workspaces/mod.rs"]}},"serverClassifierContext":{"request":"1a2f2645-f819-4b2e-a343-764f3e84dbaa","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":1,"modified":9,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","platform":"macos"}},"sourceToolAssistantUUID":"4f80c5cd-0c90-4414-8c68-6c41a649c546","session_id":"4fe51e