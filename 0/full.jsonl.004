nto(),\n    }\n}''')\nr('''    shown.into_iter().map(|c| line(c, at, editable)).collect()''','''    shown.into_iter().map(|c| line(rules, c, at, editable)).collect()''')\nr('''        assert_eq!(layer(&reviewer), \"factory\", \"a reviewer reads the work\");''','''        assert_eq!(layer(&reviewer), \"factory\", \"a reviewer reads the work\");\n        assert_eq!(judged_by(&hook), \"code\", \"an enforced hook\");\n        let told = ConstraintView { rung: \"told\".into(), ..hook.clone() };\n        assert_eq!(judged_by(&told), \"agent\", \"a told rule, form or not\");\n        assert!(has_form(&told), \"demoted, it keeps its hook\");''')\nopen(p,'w').write(s)\np='crates/bastion-desktop/src/pages/step_rules/mod.rs'; s=open(p).read()\ns=s.replace('struct FormDraft {','pub(super) struct FormDraft {',1)\nfor f in ['    id: String,\\n    function: String,\\n    contains: String,\\n    hook: String,\\n    rung: Option<String>,\\n}']:\n    pass\ns=s.replace('''pub(super) struct FormDraft {\n    id: String,\n    function: String,\n    contains: String,\n    hook: String,\n    rung: Option<String>,\n}''','''pub(super) struct FormDraft {\n    pub(super) id: String,\n    pub(super) function: String,\n    pub(super) contains: String,\n    pub(super) hook: String,\n    pub(super) rung: Option<String>,\n}''')\ns=s.replace('''    forming: Option<FormDraft>,''','''    pub(super) forming: Option<FormDraft>,''')\nopen(p,'w').write(s)\nEOF\nCARGO_INCREMENTAL=0 cargo fmt --all; CARGO_INCREMENTAL=0 sh -c 'cargo clippy -p bastion-desktop --all-targets -- -D warnings 2>&1 | grep -E \"^(error|warning: unused)\" -A10 | head -40; cargo test -p bastion-desktop 2>&1 | grep -E \"test result|panicked|left|right\" | head -4'","description":"Add the judged-by label, form editor and promote path","timeout":600000}},"wireIngestContext":{"toolu_01XcQghpPpnUeWbXhAksF9yT":{"cwd":"/Users/tacoda/tacoda/bastion"}},"serverClassifierRequest":"7827567b-32e1-48d4-a1be-34dade18abd1","apiBlockIndex":1,"requestI