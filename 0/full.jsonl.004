\")","+        );","         let check = new_check(&rules, \"short/build\");","-        assert_eq!((check.rung.as_str(), check.function.as_str()), (\"enforced\", \"sandbox::exec\"));","+        assert_eq!(","+            (check.rung.as_str(), check.function.as_str()),","+            (\"enforced\", \"sandbox::exec\")","+        );","         let note = new_note(&rules, \"short\");","         assert!(note.capability && note.rung == \"told\");","         assert_eq!(note.id, \"note-short-1\");"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/workflows.rs","hunks":[{"oldStart":51,"oldLines":9,"newStart":51,"newLines":6,"lines":["     rules: super::step_rules::Rules,","     /// The part of the picked step's panel shown.","     tab: StepTab,","-    /// Whether the page shows what applies at every workflow, above the","-    /// chosen one (D54).","-    every: bool,","     /// The picked step's name, as typed: it renames the step once no","     /// other step has it.","     name: String,"]},{"oldStart":87,"oldLines":8,"newStart":84,"newLines":8,"lines":["     Workflows(Result<Vec<WorkflowView>, String>),","     Models(Result<Vec<ModelOption>, String>),","     Rules(super::step_rules::Msg),","-    /// Show every workflow's level, or the chosen workflow's.","-    Level(bool),","+    /// Show the chosen workflow's level: every one of its steps.","+    Level,","     Tab(StepTab),","     /// The picked step's model; the default is empty.","     Model(Choice),"]},{"oldStart":205,"oldLines":11,"newStart":202,"newLines":7,"lines":["             .as_ref()","             .map(|w| w.id.clone())","             .unwrap_or_default();","-        match (self.every, self.picked_step()) {","-            (true, _) => (super::step_rules::EVERY.into(), String::new()),","-            (false, Some(step)) => step,","-            (false, None) => (workflow, String::new()),","-        }","+        self.picked_step().unwrap_or((workflow, String::new()))","     }"," ","  