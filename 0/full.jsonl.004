sync fn set_form(","+        &self,","+        id: &str,","+        form: Form,","+        rung: Option<govern::Enforcement>,","+    ) -> Result<(), String> {","+        let all = self.store.constraints().await?;","+        let mut c = all","+            .into_iter()","+            .find(|c| c.id == id)","+            .ok_or(format!(\"no constraint {id}\"))?;","+        if c.source != govern::Source::Owner {","+            return Err(format!(","+                \"{id} comes from the charter; change it in the repository\"","+            ));","+        }","+        let hook = form.hook.trim();","+        let binds = !form.function.trim().is_empty() || !hook.is_empty();","+        if rung.is_some_and(|r| r != govern::Enforcement::Told) && !binds {","+            return Err(","+                \"to check or enforce a rule, code needs calls to match or a hook to run\".into(),","+            );","+        }","+        c.function = match (form.function.trim(), hook) {","+            (\"\", \"\") => String::new(),","+            (\"\", _) => \"sandbox::exec\".into(),","+            (f, _) => f.into(),","+        };","+        c.contains = form.contains.trim().into();","+        c.hook = hook.into();","+        self.store.set_constraint(&c).await?;","+        self.reload().await?;","+        let how = match hook.is_empty() {","+            true => format!(\"binds {:?} with {:?}\", c.function, c.contains),","+            false => format!(\"hook {hook:?} before {}\", c.function),","+        };","+        self.note(\"form\", id, how);","+        match rung {","+            Some(r) => self.set_constraint_rung(id, r).await,","+            None => Ok(()),","+        }","+    }","+","     /// Move a constraint to `rung`, one rung at a time, so the audit keeps","     /// each promotion or demotion.","     pub async fn set_constraint_rung("]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-protocol/src/api.rs","/Users/tacoda/tacoda/bastion/crates/bastion