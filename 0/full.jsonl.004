{"parentUuid":"24bc176f-7e1f-4990-bede-fc652857e928","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/scope.rs","snippet":"23\t}\n24\t\n25\t/// What the level `key` sets itself, and what it would inherit without\n26\t/// that: from the workflow and every workflow above a step, and from every\n27\t/// workflow above a workflow. Every workflow inherits the list's default.\n28\tpub fn at(scopes: &[String], key: &str) -> (Option<bool>, bool) {\n29\t    let own = setting(scopes, key);\n30\t    let inherited = match key.split_once('/') {\n31\t        _ if key == EVERY => scopes\n32\t            .iter()\n33\t            .filter(|s| s.trim_start_matches('!') != EVERY)\n34\t            .all(|s| s.starts_with('!')),\n35\t        Some((workflow, _)) => setting(scopes, workflow).unwrap_or_else(|| every(scopes)),\n36\t        None => every(scopes),\n37\t    };\n38\t    (own, inherited)\n39\t}\n40\t\n41\t/// Whether the item is on at `key`, its own setting or what it inherits.\n42\tpub fn on(scopes: &[String], key: &str) -> bool {\n...\n44\t#[cfg(test)]\n45\tmod tests {\n46\t    use super::*;\n47\t\n48\t    #[test]\n49\t    fn a_level_shows_its_own_setting_and_what_it_inherits() {\n50\t        let list = |all: &[&str]| all.iter().map(|s| s.to_string()).collect::<Vec<_>>();\n51\t        let mixed = list(&[\"*\", \"!bug-fix\", \"bug-fix/build\"]);\n52\t        assert_eq!(at(&mixed, EVERY), (Some(true), false), \"it turns one step on\");\n53\t        assert_eq!(at(&mixed, \"bug-fix\"), (Some(false), true));\n54\t        assert_eq!(at(&mixed, \"bug-fix/build\"), (Some(true), false));\n55\t        assert_eq!(at(&mixed, \"bug-fix/plan\"), (None, false));\n56\t        assert!(!on(&mixed, \"bug-fix/plan\") && on(&mixed, \"short/plan\"));\n57\t        assert!(on(&[], \"short/plan\"), \"no setting: every step\");\n58\t        assert!(!on(&list(&[\"short/plan\"]), \"bug-fix/build\"), \"only the steps it names\");\n59\t    }\n60\t}"},"type":"attachment","uuid":"c9f6ad27-8064-43b8-bd45-0b01b048a51e","timestamp":"2026-11-12T17:05:51.819Z","rendered":[{"content":"<system-reminder>\nNote: /Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/scope.rs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n23\t}\n24\t\n25\t/// What the level `key` sets itself, and what it would inherit without\n26\t/// that: from the workflow and every workflow above a step, and from every\n27\t/// workflow above a workflow. Every workflow inherits the list's default.\n28\tpub fn at(scopes: &[String], key: &str) -> (Option<bool>, bool) {\n29\t    let own = setting(scopes, key);\n30\t    let inherited = match key.split_once('/') {\n31\t        _ if key == EVERY => scopes\n32\t            .iter()\n33\t            .filter(|s| s.trim_start_matches('!') != EVERY)\n34\t            .all(|s| s.starts_with('!')),\n35\t        Some((workflow, _)) => setting(scopes, workflow).unwrap_or_else(|| every(scopes)),\n36\t        None => every(scopes),\n37\t    };\n38\t    (own, inherited)\n39\t}\n40\t\n41\t/// Whether the item is on at `key`, its own setting or what it inherits.\n42\tpub fn on(scopes: &[String], key: &str) -> bool {\n...\n44\t#[cfg(test)]\n45\tmod tests {\n46\t    use super::*;\n47\t\n48\t    #[test]\n49\t    fn a_level_shows_its_own_setting_and_what_it_inherits() {\n50\t        let list = |all: &[&str]| all.iter().map(|s| s.to_string()).collect::<Vec<_>>();\n51\t        let mixed = list(&[\"*\", \"!bug-fix\", \"bug-fix/build\"]);\n52\t        assert_eq!(at(&mixed, EVERY), (Some(true), false), \"it turns one step on\");\n53\t        assert_eq!(at(&mixed, \"bug-fix\"), (Some(false), true));\n54\t        assert_eq!(at(&mixed, \"bug-fix/build\"), (Some(true), false));\n55\t        assert_eq!(at(&mixed, \"bug-fix/plan\"), (None, false));\n56\t        assert!(!on(&mixed, \"bug-fix/plan\") && on(&mixed, \"short/plan\"));\n57\t        assert!(on(&[], \"short/plan\"), \"no setting: every step\");\n58\t        assert!(!on(&list(&[\"short/plan\"]), \"bug-fix/build\"), \"only the steps it names\");\n59\t    }\n60\t}\n</system-reminder>"}],"renderedRole":"system","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
