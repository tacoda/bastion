(),","+        capability: false,","     }"," }"," "]},{"oldStart":343,"oldLines":16,"newStart":344,"newLines":21,"lines":[" ","     /// Every rule, for the brief. The agent is told each rule at every rung.","     pub fn rules(&self, job: &str, step: &str) -> String {","-        let rules: Vec<String> = self","-            .constraints(job)","-            .iter()","-            .filter(|c| govern::applies(c, step))","-            .map(|c| format!(\"- {}\", c.rule))","-            .collect();","-        if rules.is_empty() {","-            return String::new();","-        }","-        format!(\"Rules for this job:\\n{}\\n\\n\", rules.join(\"\\n\"))","+        let all = self.constraints(job);","+        let on: Vec<&Constraint> = all.iter().filter(|c| govern::applies(c, step)).collect();","+        // What the agent may do (D56), then what it must keep.","+        let list = |may: bool, head: &str| {","+            let lines: Vec<String> = on","+                .iter()","+                .filter(|c| c.capability == may)","+                .map(|c| format!(\"- {}\", c.rule))","+                .collect();","+            match lines.is_empty() {","+                true => String::new(),","+                false => format!(\"{head}\\n{}\\n\\n\", lines.join(\"\\n\")),","+            }","+        };","+        list(true, \"You may:\") + &list(false, \"Rules for this job:\")","     }"," ","     /// The functions a turn at `at` may call: `base`, and every function the"]},{"oldStart":1327,"oldLines":6,"newStart":1333,"newLines":7,"lines":["             steps: vec![\"short/build\".into()],","             hook: \"./lint.sh\".into(),","             reviewer: String::new(),","+            capability: false,","         };","         crate::rt::block_on(r.gate.add_constraint(hook)).unwrap();","         let at = |step: &str| {"]},{"oldStart":1470,"oldLines":6,"newStart":1477,"newLines":7,"lines":["             steps: Vec::new(),","             hook: String::new(),","             rev