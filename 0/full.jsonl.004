{"parentUuid":"34b1d885-7ec6-4ac2-91d0-f0aefb1f17a4","isSidechain":false,"promptId":"37211818-95a6-4835-b720-c9efefd2895a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0152bnCnsFHBGNFoHFHNWg5f","type":"tool_result","content":"The file /Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/layers.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"b0e542a0-eca6-4740-b921-ff3d13533026","timestamp":"2026-11-12T19:43:21.363Z","toolUseResult":{"type":"update","filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/layers.rs","content":"//! The rules at a level (D56): constraints, capabilities and permissions.\n//! Constraints and capabilities sort by mode: feedforward guides the agent\n//! before it acts, and feedback checks what it did. Each row says where it\n//! comes from: the workspace's repository, read-only here, or Bastion. The\n//! same view serves a workflow and one of its steps.\n\nuse bastion_protocol::{ConstraintView, FactoryCapabilityView, WorkspaceCharterView};\nuse iced::widget::{Column, column, container, row, text, text_input};\nuse iced::{Element, Fill};\n\nuse super::capabilities::{granting, line};\nuse super::constraints::{check_form, hook_form, mode, note_form, reviewer_form, rows, rule_form};\nuse super::{Adding, At, Msg, Rules, chip, choice, help};\nuse crate::theme;\n\n/// The kinds of step an agent runs, each with grants of its own.\nconst KINDS: [(&str, &str); 3] = [(\"prompt\", \"Prompt\"), (\"agent\", \"Agent\"), (\"skill\", \"Skill\")];\n\n/// The list narrows to a filter once a level has more constraints than this.\nconst FILTER_FROM: usize = 5;\n\n/// A section: its title, what it covers, and its rows.\nfn section<'a>(title: &'a str, about: &'a str, body: Vec<Element<'a, Msg>>) -> Element<'a, Msg> {\n    let head = row![\n        text(title).size(13).font(theme::BOLD).color(theme::INK),\n        text(about).size(12).color(theme::MUTED),\n    ]\n    .spacing(10)\n    .align_y(iced::Center);\n    let body = Column::with_children(body).spacing(8);\n    container(column![head, body].spacing(10))\n        .padding(12)\n        .width(Fill)\n        .style(theme::panel)\n        .into()\n}\n\n/// A mode's heading inside a section.\nfn heading<'a>(name: &'a str, about: &'a str) -> Element<'a, Msg> {\n    row![text(name).size(12).font(theme::BOLD).color(theme::MUTED), help(about)]\n        .spacing(8)\n        .into()\n}\n\n/// A line the workspace's repository brings: read-only, named for its\n/// workspace.\nfn from_workspace<'a>(workspace: &str, what: String) -> Element<'a, Msg> {\n    row![chip(format!(\"Workspace · {workspace}\")), text(what).size(13).width(Fill)]\n        .spacing(8)\n        .align_y(iced::Center)\n        .into()\n}\n\n/// The workspaces whose repository has a charter.\nfn charters(rules: &Rules) -> impl Iterator<Item = &WorkspaceCharterView> {\n    rules.charters.iter().filter(|c| !c.files.is_empty())\n}\n\n/// What each workspace brings, as `pick` reads it from its charter.\nfn workspace_lines<'a>(rules: &Rules, pick: impl Fn(&WorkspaceCharterView) -> Vec<String>) -> Vec<Element<'a, Msg>> {\n    let lines = charters(rules).flat_map(|c| pick(c).into_iter().map(|w| (c.workspace.clone(), w)).collect::<Vec<_>>());\n    lines.map(|(ws, what)| from_workspace(&ws, what)).collect()\n}\n\n/// Constraints: what the agent must keep, told before it acts or checked\n/// after.\nfn constraints<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {\n    let kept = rules.constraints.iter().filter(|c| !c.capability);\n    let (feedback, feedforward): (Vec<&ConstraintView>, Vec<&ConstraintView>) =\n        kept.partition(|c| mode(c) == \"Feedback\");\n    let agents_md = |c: &WorkspaceCharterView| {\n        let told = c.files.iter().any(|f| f == \"AGENTS.md\");\n        told.then(|| \"AGENTS.md is told to the agent.\".to_string()).into_iter().collect()\n    };\n    let mut body = vec![heading(\"Feedforward\", \"told to the agent before it acts; the agent judges it\")];\n    body.extend(workspace_lines(rules, agents_md));\n    body.extend(rows(rules, feedforward, at, editable));\n    body.push(heading(\"Feedback\", \"checks what the agent did; code or a reviewer judges it\"));\n    body.extend(workspace_lines(rules, |c| c.hooks.clone()));\n    body.extend(rows(rules, feedback, at, editable));\n    section(\"Constraints\", \"What the agent must keep.\", body)\n}\n\n/// Capabilities: what the agent may use, told to it before it acts.\nfn capabilities<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {\n    let notes: Vec<&ConstraintView> = rules.constraints.iter().filter(|c| c.capability).collect();\n    let skills = |c: &WorkspaceCharterView| {\n        let skills = c.skills.iter().map(|s| format!(\"The skill {s}, in .agents/skills\"));\n        skills.chain(c.agents.iter().map(|a| format!(\"The agent {a}, in .agents/agents\"))).collect()\n    };\n    let mut body = vec![heading(\"Feedforward\", \"told to the agent as what it may use\")];\n    body.extend(workspace_lines(rules, skills));\n    body.extend(rows(rules, notes, at, editable));\n    section(\"Capabilities\", \"What the agent may use.\", body)\n}\n\n/// The grants at the level: the step's kind's at a step, else each kind's.\nfn grants<'a>(rules: &'a Rules, at: &At, editable: bool) -> Vec<Element<'a, Msg>> {\n    let kinds = KINDS.iter().filter(|(k, _)| !at.is_step() || *k == at.stage);\n    kinds\n        .map(|(kind, name)| {\n            let head = help(format!(\"{name} steps' grants, from Bastion\"));\n            let rows = rules.kind(kind).into_iter().map(|g| line(g, rules, at, editable));\n            Column::new().spacing(6).push(head).extend(rows).into()\n        })\n        .collect()\n}\n\n/// What the factory itself may do, as its workspace and steps set it.\nfn factory_line<'a>(f: &FactoryCapabilityView) -> Element<'a, Msg> {\n    let what = column![text(f.name.clone()).size(13), help(f.how.clone())].spacing(2).width(Fill);\n    row![chip(\"Bastion · factory\"), what, chip(f.rung.clone())].spacing(8).align_y(iced::Center).into()\n}\n\n/// Permissions: what the gate lets a call do. Bastion's grants, ask or\n/// allowed; the repository's allow, ask and deny rules; and what the\n/// factory may do.\nfn permissions<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {\n    let mut body = grants(rules, at, editable);\n    body.extend(workspace_lines(rules, |c| c.allow.iter().map(|a| format!(\"allows {a}\")).collect()));\n    body.extend(workspace_lines(rules, |c| c.rules.clone()));\n    if !at.is_step() {\n        body.extend(rules.factory.iter().map(factory_line));\n    }\n    section(\"Permissions\", \"What the gate lets a call do. A call no grant covers is refused.\", body)\n}\n\n/// One form at a time to add something on at the level, behind a switch.\nfn adding<'a>(rules: &'a Rules, at: &At) -> Element<'a, Msg> {\n    let pick = |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));\n    let label = |words: &'a str| text(words).size(12).color(theme::MUTED);\n    let switch = row![\n        text(\"Add\").size(13).color(theme::MUTED),\n        label(\"constraint:\"),\n        pick(\"A rule\", Adding::Rule),\n        pick(\"A check\", Adding::Check),\n        pick(\"A hook\", Adding::Hook),\n        pick(\"A reviewer\", Adding::Reviewer),\n        label(\"capability:\"),\n        pick(\"A note\", Adding::Note),\n        label(\"permission:\"),\n        pick(\"A grant\", Adding::Grant),\n    ]\n    .spacing(6)\n    .align_y(iced::Center);\n    let form = match rules.adding {\n        Adding::Rule => rule_form(rules),\n        Adding::Note => note_form(rules),\n        Adding::Check => check_form(rules),\n        Adding::Hook => hook_form(rules),\n        Adding::Reviewer => reviewer_form(rules),\n        Adding::Grant if at.is_step() => granting(rules),\n        Adding::Grant => {\n            let kind = rules.kind_of(at);\n            let kinds = KINDS.iter().map(|(k, name)| {\n                choice(format!(\"{name} steps\"), kind == *k, Some(Msg::ForKind(k.to_string())))\n            });\n            let kinds = row![text(\"For\").size(12).color(theme::MUTED)].extend(kinds).spacing(6).align_y(iced::Center);\n            column![kinds, granting(rules)].spacing(10).into()\n        }\n    };\n    container(column![switch, help(\"What you add is on here, and inherited below.\"), form].spacing(10))\n        .padding(12)\n        .width(Fill)\n        .style(theme::panel)\n        .into()\n}\n\n/// The rules at the level `at`, and the Add bar.\npub fn view<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {\n    let mut body = Column::new().spacing(10);\n    if rules.constraints.len() > FILTER_FROM {\n        let filter = text_input(\"Filter by words or kind\", &rules.filter)\n            .on_input(Msg::Filter)\n            .style(theme::field);\n        body = body.push(filter);\n    }\n    body = body\n        .push(constraints(rules, at, editable))\n        .push(capabilities(rules, at, editable))\n        .push(permissions(rules, at, editable));\n    if editable {\n        body = body.push(adding(rules, at));\n    }\n    body.extend(super::said(rules)).into()\n}\n","structuredPatch":[{"oldStart":1,"oldLines":15,"newStart":1,"newLines":16,"lines":["-//! The rules at a level, by layer (D25, D54): the charter each repository","-//! brings, the harness on the agent's calls, and the factory around the","-//! work. The same view serves every workflow, one workflow, and one step;","-//! each item says whether it is on there and where that comes from.","+//! The rules at a level (D56): constraints, capabilities and permissions.","+//! Constraints and capabilities sort by mode: feedforward guides the agent","+//! before it acts, and feedback checks what it did. Each row says where it","+//! comes from: the workspace's repository, read-only here, or Bastion. The","+//! same view serves a workflow and one of its steps."," "," use bastion_protocol::{ConstraintView, FactoryCapabilityView, WorkspaceCharterView};"," use iced::widget::{Column, column, container, row, text, text_input};"," use iced::{Element, Fill};"," "," use super::capabilities::{granting, line};","-use super::constraints::{hook_form, layer, reviewer_form, rows, rule_form};","-use super::{Adding, At, Msg, Rules, choice, help};","+use super::constraints::{check_form, hook_form, mode, note_form, reviewer_form, rows, rule_form};","+use super::{Adding, At, Msg, Rules, chip, choice, help};"," use crate::theme;"," "," /// The kinds of step an agent runs, each with grants of its own."]},{"oldStart":18,"oldLines":10,"newStart":19,"newLines":10,"lines":[" /// The list narrows to a filter once a level has more constraints than this."," const FILTER_FROM: usize = 5;"," ","-/// A layer's section: its title, what it covers, and its rows.","+/// A section: its title, what it covers, and its rows."," fn section<'a>(title: &'a str, about: &'a str, body: Vec<Element<'a, Msg>>) -> Element<'a, Msg> {","     let head = row![","-        text(title).size(12).font(theme::BOLD).color(theme::INK),","+        text(title).size(13).font(theme::BOLD).color(theme::INK),","         text(about).size(12).color(theme::MUTED),","     ]","     .spacing(10)"]},{"oldStart":34,"oldLines":47,"newStart":35,"newLines":72,"lines":["         .into()"," }"," ","-/// One workspace's charter: what its repository brings, read-only here.","-fn charter_line<'a>(c: &WorkspaceCharterView) -> Element<'a, Msg> {","-    let counts = format!(\"{} rules, {} hooks\", c.rules.len(), c.hooks.len());","-    let head = row![text(c.workspace.clone()).size(13), help(counts)].spacing(8);","-    let items = c","-        .rules","-        .iter()","-        .chain(&c.hooks)","-        .map(|r| help(format!(\"  {r}\")));","-    Column::new().spacing(2).push(head).extend(items).into()","+/// A mode's heading inside a section.","+fn heading<'a>(name: &'a str, about: &'a str) -> Element<'a, Msg> {","+    row![text(name).size(12).font(theme::BOLD).color(theme::MUTED), help(about)]","+        .spacing(8)","+        .into()"," }"," ","-/// The charter: each workspace's, and any charter constraint the server keeps.","-fn charter<'a>(rules: &'a Rules, kept: Vec<&ConstraintView>, at: &At) -> Element<'a, Msg> {","-    let charters = rules.charters.iter().filter(|c| !c.files.is_empty());","-    let mut body: Vec<Element<'a, Msg>> = charters.map(charter_line).collect();","-    body.extend(rows(rules, kept, at, false));","-    if body.is_empty() {","-        body.push(help(","-            \"No workspace's repository has AGENTS.md or .agents/settings.json.\",","-        ));","-    }","-    section(","-        \"Charter\",","-        \"From each workspace's repository. Change it there.\",","-        body,","-    )","+/// A line the workspace's repository brings: read-only, named for its","+/// workspace.","+fn from_workspace<'a>(workspace: &str, what: String) -> Element<'a, Msg> {","+    row![chip(format!(\"Workspace · {workspace}\")), text(what).size(13).width(Fill)]","+        .spacing(8)","+        .align_y(iced::Center)","+        .into()"," }"," ","+/// The workspaces whose repository has a charter.","+fn charters(rules: &Rules) -> impl Iterator<Item = &WorkspaceCharterView> {","+    rules.charters.iter().filter(|c| !c.files.is_empty())","+}","+","+/// What each workspace brings, as `pick` reads it from its charter.","+fn workspace_lines<'a>(rules: &Rules, pick: impl Fn(&WorkspaceCharterView) -> Vec<String>) -> Vec<Element<'a, Msg>> {","+    let lines = charters(rules).flat_map(|c| pick(c).into_iter().map(|w| (c.workspace.clone(), w)).collect::<Vec<_>>());","+    lines.map(|(ws, what)| from_workspace(&ws, what)).collect()","+}","+","+/// Constraints: what the agent must keep, told before it acts or checked","+/// after.","+fn constraints<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {","+    let kept = rules.constraints.iter().filter(|c| !c.capability);","+    let (feedback, feedforward): (Vec<&ConstraintView>, Vec<&ConstraintView>) =","+        kept.partition(|c| mode(c) == \"Feedback\");","+    let agents_md = |c: &WorkspaceCharterView| {","+        let told = c.files.iter().any(|f| f == \"AGENTS.md\");","+        told.then(|| \"AGENTS.md is told to the agent.\".to_string()).into_iter().collect()","+    };","+    let mut body = vec![heading(\"Feedforward\", \"told to the agent before it acts; the agent judges it\")];","+    body.extend(workspace_lines(rules, agents_md));","+    body.extend(rows(rules, feedforward, at, editable));","+    body.push(heading(\"Feedback\", \"checks what the agent did; code or a reviewer judges it\"));","+    body.extend(workspace_lines(rules, |c| c.hooks.clone()));","+    body.extend(rows(rules, feedback, at, editable));","+    section(\"Constraints\", \"What the agent must keep.\", body)","+}","+","+/// Capabilities: what the agent may use, told to it before it acts.","+fn capabilities<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {","+    let notes: Vec<&ConstraintView> = rules.constraints.iter().filter(|c| c.capability).collect();","+    let skills = |c: &WorkspaceCharterView| {","+        let skills = c.skills.iter().map(|s| format!(\"The skill {s}, in .agents/skills\"));","+        skills.chain(c.agents.iter().map(|a| format!(\"The agent {a}, in .agents/agents\"))).collect()","+    };","+    let mut body = vec![heading(\"Feedforward\", \"told to the agent as what it may use\")];","+    body.extend(workspace_lines(rules, skills));","+    body.extend(rows(rules, notes, at, editable));","+    section(\"Capabilities\", \"What the agent may use.\", body)","+}","+"," /// The grants at the level: the step's kind's at a step, else each kind's."," fn grants<'a>(rules: &'a Rules, at: &At, editable: bool) -> Vec<Element<'a, Msg>> {","-    let kinds = KINDS","-        .iter()","-        .filter(|(k, _)| !at.is_step() || *k == at.stage);","+    let kinds = KINDS.iter().filter(|(k, _)| !at.is_step() || *k == at.stage);","     kinds","         .map(|(kind, name)| {","-            let head = help(format!(\"{name} steps' grants\"));","-            let rows = rules","-                .kind(kind)","-                .into_iter()","-                .map(|g| line(g, rules, at, editable));","+            let head = help(format!(\"{name} steps' grants, from Bastion\"));","+            let rows = rules.kind(kind).into_iter().map(|g| line(g, rules, at, editable));","             Column::new().spacing(6).push(head).extend(rows).into()","         })","         .collect()"]},{"oldStart":82,"oldLines":100,"newStart":108,"newLines":77,"lines":[" "," /// What the factory itself may do, as its workspace and steps set it."," fn factory_line<'a>(f: &FactoryCapabilityView) -> Element<'a, Msg> {","-    let what = column![text(f.name.clone()).size(13), help(f.how.clone())]","-        .spacing(2)","-        .width(Fill);","-    row![what, super::chip(f.rung.clone())]","-        .spacing(8)","-        .align_y(iced::Center)","-        .into()","+    let what = column![text(f.name.clone()).size(13), help(f.how.clone())].spacing(2).width(Fill);","+    row![chip(\"Bastion · factory\"), what, chip(f.rung.clone())].spacing(8).align_y(iced::Center).into()"," }"," ","-/// One form at a time to add an item on at the level, behind a switch.","+/// Permissions: what the gate lets a call do. Bastion's grants, ask or","+/// allowed; the repository's allow, ask and deny rules; and what the","+/// factory may do.","+fn permissions<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {","+    let mut body = grants(rules, at, editable);","+    body.extend(workspace_lines(rules, |c| c.allow.iter().map(|a| format!(\"allows {a}\")).collect()));","+    body.extend(workspace_lines(rules, |c| c.rules.clone()));","+    if !at.is_step() {","+        body.extend(rules.factory.iter().map(factory_line));","+    }","+    section(\"Permissions\", \"What the gate lets a call do. A call no grant covers is refused.\", body)","+}","+","+/// One form at a time to add something on at the level, behind a switch."," fn adding<'a>(rules: &'a Rules, at: &At) -> Element<'a, Msg> {","-    let pick =","-        |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));","+    let pick = |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));","+    let label = |words: &'a str| text(words).size(12).color(theme::MUTED);","     let switch = row![","         text(\"Add\").size(13).color(theme::MUTED),","-        pick(\"A grant\", Adding::Grant),","+        label(\"constraint:\"),","         pick(\"A rule\", Adding::Rule),","+        pick(\"A check\", Adding::Check),","         pick(\"A hook\", Adding::Hook),","         pick(\"A reviewer\", Adding::Reviewer),","+        label(\"capability:\"),","+        pick(\"A note\", Adding::Note),","+        label(\"permission:\"),","+        pick(\"A grant\", Adding::Grant),","     ]","     .spacing(6)","     .align_y(iced::Center);","     let form = match rules.adding {","+        Adding::Rule => rule_form(rules),","+        Adding::Note => note_form(rules),","+        Adding::Check => check_form(rules),","+        Adding::Hook => hook_form(rules),","+        Adding::Reviewer => reviewer_form(rules),","         Adding::Grant if at.is_step() => granting(rules),","         Adding::Grant => {","             let kind = rules.kind_of(at);","             let kinds = KINDS.iter().map(|(k, name)| {","-                choice(","-                    format!(\"{name} steps\"),","-                    kind == *k,","-                    Some(Msg::ForKind(k.to_string())),","-                )","+                choice(format!(\"{name} steps\"), kind == *k, Some(Msg::ForKind(k.to_string())))","             });","-            let kinds = row![text(\"For\").size(12).color(theme::MUTED)]","-                .extend(kinds)","-                .spacing(6)","-                .align_y(iced::Center);","+            let kinds = row![text(\"For\").size(12).color(theme::MUTED)].extend(kinds).spacing(6).align_y(iced::Center);","             column![kinds, granting(rules)].spacing(10).into()","         }","-        Adding::Rule => rule_form(rules),","-        Adding::Hook => hook_form(rules),","-        Adding::Reviewer => reviewer_form(rules),","     };","-    container(","-        column![","-            switch,","-            help(\"What you add is on here, and inherited below.\"),","-            form","-        ]","-        .spacing(10),","-    )","-    .padding(12)","-    .width(Fill)","-    .style(theme::panel)","-    .into()","+    container(column![switch, help(\"What you add is on here, and inherited below.\"), form].spacing(10))","+        .padding(12)","+        .width(Fill)","+        .style(theme::panel)","+        .into()"," }"," ","-/// The rules at the level `at`, by layer, and the Add bar.","+/// The rules at the level `at`, and the Add bar."," pub fn view<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {","-    let all: Vec<&ConstraintView> = rules.constraints.iter().collect();","-    let of = |name: &str| {","-        all.iter()","-            .copied()","-            .filter(|c| layer(c) == name)","-            .collect::<Vec<_>>()","-    };","     let mut body = Column::new().spacing(10);","-    if all.len() > FILTER_FROM {","-        let filter = text_input(","-            \"Filter the constraints by words, kind or rung\",","-            &rules.filter,","-        )","-        .on_input(Msg::Filter)","-        .style(theme::field);","+    if rules.constraints.len() > FILTER_FROM {","+        let filter = text_input(\"Filter by words or kind\", &rules.filter)","+            .on_input(Msg::Filter)","+            .style(theme::field);","         body = body.push(filter);","     }","-    let mut harness = grants(rules, at, editable);","-    harness.extend(rows(rules, of(\"harness\"), at, editable));","-    let mut factory = rows(rules, of(\"factory\"), at, editable);","-    if at.is_every() {","-        factory.extend(rules.factory.iter().map(factory_line));","-    }","     body = body","-        .push(charter(rules, of(\"charter\"), at))","-        .push(section(","-            \"Harness\",","-            \"The agent's calls: what it may call, and the rules and hooks on them.\",","-            harness,","-        ))","-        .push(section(","-            \"Factory\",","-            \"The work around the calls: checks on the change, and reviewers that must pass.\",","-            factory,","-        ));","+        .push(constraints(rules, at, editable))","+        .push(capabilities(rules, at, editable))","+        .push(permissions(rules, at, editable));","     if editable {","         body = body.push(adding(rules, at));","     }"]}],"originalFile":"//! The rules at a level, by layer (D25, D54): the charter each repository\n//! brings, the harness on the agent's calls, and the factory around the\n//! work. The same view serves every workflow, one workflow, and one step;\n//! each item says whether it is on there and where that comes from.\n\nuse bastion_protocol::{ConstraintView, FactoryCapabilityView, WorkspaceCharterView};\nuse iced::widget::{Column, column, container, row, text, text_input};\nuse iced::{Element, Fill};\n\nuse super::capabilities::{granting, line};\nuse super::constraints::{hook_form, layer, reviewer_form, rows, rule_form};\nuse super::{Adding, At, Msg, Rules, choice, help};\nuse crate::theme;\n\n/// The kinds of step an agent runs, each with grants of its own.\nconst KINDS: [(&str, &str); 3] = [(\"prompt\", \"Prompt\"), (\"agent\", \"Agent\"), (\"skill\", \"Skill\")];\n\n/// The list narrows to a filter once a level has more constraints than this.\nconst FILTER_FROM: usize = 5;\n\n/// A layer's section: its title, what it covers, and its rows.\nfn section<'a>(title: &'a str, about: &'a str, body: Vec<Element<'a, Msg>>) -> Element<'a, Msg> {\n    let head = row![\n        text(title).size(12).font(theme::BOLD).color(theme::INK),\n        text(about).size(12).color(theme::MUTED),\n    ]\n    .spacing(10)\n    .align_y(iced::Center);\n    let body = Column::with_children(body).spacing(8);\n    container(column![head, body].spacing(10))\n        .padding(12)\n        .width(Fill)\n        .style(theme::panel)\n        .into()\n}\n\n/// One workspace's charter: what its repository brings, read-only here.\nfn charter_line<'a>(c: &WorkspaceCharterView) -> Element<'a, Msg> {\n    let counts = format!(\"{} rules, {} hooks\", c.rules.len(), c.hooks.len());\n    let head = row![text(c.workspace.clone()).size(13), help(counts)].spacing(8);\n    let items = c\n        .rules\n        .iter()\n        .chain(&c.hooks)\n        .map(|r| help(format!(\"  {r}\")));\n    Column::new().spacing(2).push(head).extend(items).into()\n}\n\n/// The charter: each workspace's, and any charter constraint the server keeps.\nfn charter<'a>(rules: &'a Rules, kept: Vec<&ConstraintView>, at: &At) -> Element<'a, Msg> {\n    let charters = rules.charters.iter().filter(|c| !c.files.is_empty());\n    let mut body: Vec<Element<'a, Msg>> = charters.map(charter_line).collect();\n    body.extend(rows(rules, kept, at, false));\n    if body.is_empty() {\n        body.push(help(\n            \"No workspace's repository has AGENTS.md or .agents/settings.json.\",\n        ));\n    }\n    section(\n        \"Charter\",\n        \"From each workspace's repository. Change it there.\",\n        body,\n    )\n}\n\n/// The grants at the level: the step's kind's at a step, else each kind's.\nfn grants<'a>(rules: &'a Rules, at: &At, editable: bool) -> Vec<Element<'a, Msg>> {\n    let kinds = KINDS\n        .iter()\n        .filter(|(k, _)| !at.is_step() || *k == at.stage);\n    kinds\n        .map(|(kind, name)| {\n            let head = help(format!(\"{name} steps' grants\"));\n            let rows = rules\n                .kind(kind)\n                .into_iter()\n                .map(|g| line(g, rules, at, editable));\n            Column::new().spacing(6).push(head).extend(rows).into()\n        })\n        .collect()\n}\n\n/// What the factory itself may do, as its workspace and steps set it.\nfn factory_line<'a>(f: &FactoryCapabilityView) -> Element<'a, Msg> {\n    let what = column![text(f.name.clone()).size(13), help(f.how.clone())]\n        .spacing(2)\n        .width(Fill);\n    row![what, super::chip(f.rung.clone())]\n        .spacing(8)\n        .align_y(iced::Center)\n        .into()\n}\n\n/// One form at a time to add an item on at the level, behind a switch.\nfn adding<'a>(rules: &'a Rules, at: &At) -> Element<'a, Msg> {\n    let pick =\n        |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));\n    let switch = row![\n        text(\"Add\").size(13).color(theme::MUTED),\n        pick(\"A grant\", Adding::Grant),\n        pick(\"A rule\", Adding::Rule),\n        pick(\"A hook\", Adding::Hook),\n        pick(\"A reviewer\", Adding::Reviewer),\n    ]\n    .spacing(6)\n    .align_y(iced::Center);\n    let form = match rules.adding {\n        Adding::Grant if at.is_step() => granting(rules),\n        Adding::Grant => {\n            let kind = rules.kind_of(at);\n            let kinds = KINDS.iter().map(|(k, name)| {\n                choice(\n                    format!(\"{name} steps\"),\n                    kind == *k,\n                    Some(Msg::ForKind(k.to_string())),\n                )\n            });\n            let kinds = row![text(\"For\").size(12).color(theme::MUTED)]\n                .extend(kinds)\n                .spacing(6)\n                .align_y(iced::Center);\n            column![kinds, granting(rules)].spacing(10).into()\n        }\n        Adding::Rule => rule_form(rules),\n        Adding::Hook => hook_form(rules),\n        Adding::Reviewer => reviewer_form(rules),\n    };\n    container(\n        column![\n            switch,\n            help(\"What you add is on here, and inherited below.\"),\n            form\n        ]\n        .spacing(10),\n    )\n    .padding(12)\n    .width(Fill)\n    .style(theme::panel)\n    .into()\n}\n\n/// The rules at the level `at`, by layer, and the Add bar.\npub fn view<'a>(rules: &'a Rules, at: &At, editable: bool) -> Element<'a, Msg> {\n    let all: Vec<&ConstraintView> = rules.constraints.iter().collect();\n    let of = |name: &str| {\n        all.iter()\n            .copied()\n            .filter(|c| layer(c) == name)\n            .collect::<Vec<_>>()\n    };\n    let mut body = Column::new().spacing(10);\n    if all.len() > FILTER_FROM {\n        let filter = text_input(\n            \"Filter the constraints by words, kind or rung\",\n            &rules.filter,\n        )\n        .on_input(Msg::Filter)\n        .style(theme::field);\n        body = body.push(filter);\n    }\n    let mut harness = grants(rules, at, editable);\n    harness.extend(rows(rules, of(\"harness\"), at, editable));\n    let mut factory = rows(rules, of(\"factory\"), at, editable);\n    if at.is_every() {\n        factory.extend(rules.factory.iter().map(factory_line));\n    }\n    body = body\n        .push(charter(rules, of(\"charter\"), at))\n        .push(section(\n            \"Harness\",\n            \"The agent's calls: what it may call, and the rules and hooks on them.\",\n            harness,\n        ))\n        .push(section(\n            \"Factory\",\n            \"The work around the calls: checks on the change, and reviewers that must pass.\",\n            factory,\n        ));\n    if editable {\n        body = body.push(adding(rules, at));\n    }\n    body.extend(super::said(rules)).into()\n}\n","userModified":false},"sourceToolAssistantUUID":"34b1d885-7ec6-4ac2-91d0-f0aefb1f17a4","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
