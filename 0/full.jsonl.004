`: its kind's items that"," /// are on there (D54)."," pub fn grants_at<'a>(at: At, grants: &'a [Capability]) -> Vec<&'a Capability> {","-    let on = |g: &&Capability| g.step.is_empty() && g.stage == at.stage && on_at(&g.scopes, at.step);","+    let on =","+        |g: &&Capability| g.step.is_empty() && g.stage == at.stage && on_at(&g.scopes, at.step);","     grants.iter().filter(on).collect()"," }"," "]},{"oldStart":275,"oldLines":12,"newStart":276,"newLines":24,"lines":["     for g in &old {","         let mine = |i: &Capability| i.stage == g.stage && i.function == g.function;","         if !items.iter().any(mine) {","-            items.push(Capability { step: String::new(), scopes: Vec::new(), ..g.clone() });","+            items.push(Capability {","+                step: String::new(),","+                scopes: Vec::new(),","+                ..g.clone()","+            });","             set_scope(&mut items.last_mut().unwrap().scopes, EVERY, Some(false));","         }","-        let own: Vec<&str> = old.iter().filter(|o| o.step == g.step && o.stage == g.stage).map(|o| o.function.as_str()).collect();","+        let own: Vec<&str> = old","+            .iter()","+            .filter(|o| o.step == g.step && o.stage == g.stage)","+            .map(|o| o.function.as_str())","+            .collect();","         for i in items.iter_mut().filter(|i| i.stage == g.stage) {","-            set_scope(&mut i.scopes, &g.step, Some(own.contains(&i.function.as_str())));","+            set_scope(","+                &mut i.scopes,","+                &g.step,","+                Some(own.contains(&i.function.as_str())),","+            );","         }","     }","     (items, old)"]},{"oldStart":503,"oldLines":9,"newStart":516,"newLines":10,"lines":["     fn at_build(function: &str, rung: Access) -> Capability {","         Capability {","             stage: Stage::Prompt,","-            step: \"short/build\".into(),","+            step: String::new(),","             function: functio