    assert_eq!(at(&mixed, \"bug-fix/build\"), (Some(true), false));","         assert_eq!(at(&mixed, \"bug-fix/plan\"), (None, false));","         assert!(!on(&mixed, \"bug-fix/plan\") && on(&mixed, \"short/plan\"));","-        assert!(on(&[], \"short/plan\"), \"no setting: every step\");","+        assert!(!on(&[], \"short/plan\"), \"no selection: nowhere (D58)\");","         assert!(","             !on(&list(&[\"short/plan\"]), \"bug-fix/build\"),","             \"only the steps it names\""]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/scope.rs"]}},"serverClassifierContext":{"request":"00ae89c9-e5dd-4088-b3ff-e4824ef7e029","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":7,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"eb42a1ff-621b-45f6-8249-cc194b5720e6","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
