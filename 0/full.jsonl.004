"         .spacing(8)","         .align_y(iced::Center);","     let agent = w.nodes.iter().filter(|n| n.stage != \"shell\");","     let steps = agent.map(|n| {","         let key = format!(\"{}/{}\", w.id, n.id);","-        let at = At { scope: &key, stage: &n.stage };","-        let name = text(n.id.replace('_', \" \")).size(13).color(theme::MUTED).width(Fill);","+        let at = At {","+            scope: &key,","+            stage: &n.stage,","+        };","+        let name = text(n.id.replace('_', \" \"))","+            .size(13)","+            .color(theme::MUTED)","+            .width(Fill);","         row![name, scope_switch(item.clone(), scopes, &at, editable)]","             .spacing(8)","             .padding(iced::Padding::from([0, 0]).left(24))"]},{"oldStart":42,"oldLines":9,"newStart":58,"newLines":21,"lines":[" }"," "," /// The item's list: every workflow and its agent steps.","-pub(super) fn tree<'a>(rules: &Rules, item: &Item, scopes: &[String], editable: bool) -> Element<'a, Msg> {","-    let workflows = rules.workflows.iter().map(|w| workflow(item, scopes, w, editable));","+pub(super) fn tree<'a>(","+    rules: &Rules,","+    item: &Item,","+    scopes: &[String],","+    editable: bool,","+) -> Element<'a, Msg> {","+    let workflows = rules","+        .workflows","+        .iter()","+        .map(|w| workflow(item, scopes, w, editable));","     let why = \"A step's own setting wins, then its workflow's, then every workflow's.\";","     let body = Column::new().spacing(10).push(help(why)).extend(workflows);","-    container(body).padding(12).width(Fill).style(theme::panel).into()","+    container(body)","+        .padding(12)","+        .width(Fill)","+        .style(theme::panel)","+        .into()"," }"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/constraints.rs","hunks":[{"oldStart":87,"oldLines":7,"newStart":87,"newLines":7,"lines":[" }"," "," /// A fixed-width pill, so the rules line up.","-fn badge<'a>(label: &str, color: iced::Color) -> Element<'a, Msg> {","+pub(super) fn badge<'a>(label: &str, color: iced::Color) -> Element<'a, Msg> {","     container(text(label.to_string()).size(11).color(color))","         .padding([2, 0])","         .width(76)"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/layers.rs","hunks":[{"oldStart":14,"oldLines":13,"newStart":14,"newLines":18,"lines":[" use crate::theme;"," "," /// The kinds of step an agent runs, each with grants of its own.","-const KINDS: [(&str, &str); 3] = [(\"prompt\", \"Prompt\"), (\"agent\", \"Agent\"), (\"skill\", \"Skill\")];","+pub(super) const KINDS: [(&str, &str); 3] =","+    [(\"prompt\", \"Prompt\"), (\"agent\", \"Agent\"), (\"skill\", \"Skill\")];"," "," /// The list narrows to a filter once a level has more constraints than this."," const FILTER_FROM: usize = 5;"," "," /// A section: its title, what it covers, and its rows.","-fn section<'a>(title: &'a str, about: &'a str, body: Vec<Element<'a, Msg>>) -> Element<'a, Msg> {","+pub(super) fn section<'a>(","+    title: &'a str,","+    about: &'a str,","+    body: Vec<Element<'a, Msg>>,","+) -> Element<'a, Msg> {","     let head = row![","         text(title).size(13).font(theme::BOLD).color(theme::INK),","         text(about).size(12).color(theme::MUTED),"]},{"oldStart":36,"oldLines":7,"newStart":41,"newLines":7,"lines":[" }"," "," /// A mode's heading inside a section.","-fn heading<'a>(name: &'a str, about: &'a str) -> Element<'a, Msg> {","+pub(super) fn heading<'a>(name: &'a str, about: &'a str) -> Element<'a, Msg> {","     row![","         text(name).size(12).font(theme::BOLD).color(theme::MUTED),","         help(about)"]},{"oldStart":146,"oldLines":7,"newStart":151,"newLines":7,"lines":[" }"," "," /// What the factory itself may do, as its workspace and steps set it.","-fn factory_line<'a>(f: &FactoryCapabilityView) -> Element<'a, Msg> {","+pub(super) fn factory_line<'a>(f: &FactoryCapabilityView) -> Element<'a, Msg> {","     let what = column![text(f.name.clone()).size(13), help(f.how.clone())]","         .spacing(2)","         .width(Fill);"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/mod.rs","hunks":[{"oldStart":3,"oldLines":9,"newStart":3,"newLines":9,"lines":[" //! level turns on, off, or leaves to inherit; the most specific setting"," //! wins. A rung belongs to the item, so it reads the same at every level."," ","+mod applies;"," mod capabilities;"," mod constraints;","-mod applies;"," mod layers;"," mod pages;"," mod scope;"]},{"oldStart":22,"oldLines":7,"newStart":22,"newLines":7,"lines":[" use crate::theme;"," "," pub use layers::view;","-pub use pages::{Which, page};","+pub use pages::{Which, level, page};"," pub use scope::EVERY;"," "," /// The form shown to add an item: one at a time."]},{"oldStart":481,"oldLines":7,"newStart":481,"newLines":9,"lines":["         Msg::AddRule | Msg::AddCheck | Msg::AddNote | Msg::AddReviewer | Msg::AddHook => {","             send(ctx, api::ConstraintAdd(made(rules, &msg, at.scope)))","         }","-        Msg::SetScope(item, scope, setting) => send(ctx, api::Scope(scope_set(item, setting, &scope))),","+        Msg::SetScope(item, scope, setting) => {","+            send(ctx, api::Scope(scope_set(item, setting, &scope)))","+        }","         Msg::GrantRung(g, rung) => set_rung(g, rung, ctx),","         Msg::Ungrant(g) => send(ctx, api::CapabilityRemove(g)),","         Msg::SetRung(id, rung) => send(ctx, api::ConstraintRung { id, rung }),"]},{"oldStart":547,"oldLines":7,"newStart":549,"newLines":8,"lines":["     let (own, inherited) = scope::at(scopes, at.scope);","     let now = own.unwrap_or(inherited);","     let set = |label: String, chosen: bool, to: &str| {","-        let msg = (editable && !chosen).then(|| Msg::SetScope(item.clone(), at.scope.into(), to.into()));","+        let msg =","+            (editable && !chosen).then(|| Msg::SetScope(item.clone(), at.scope.into(), to.into()));","         choice(label, chosen, msg)","     };","     let word = if inherited { \"on\" } else { \"off\" };"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/pages.rs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":246,"lines":["+//! The rules pages (D57): Constraints, Capabilities and Permissions. Each","+//! has a Global view, where an item is on or off for every workflow, and a","+//! Workflows view, where an item's list picks the workflows and steps it","+//! applies to.","+","+use bastion_protocol::{CapabilityView, ConstraintView};","+use iced::widget::{Column, column, container, row, text, text_input};","+use iced::{Element, Fill};","+","+use super::applies::{steps_on, tree};","+use super::capabilities::{granting, line as grant_line};","+use super::constraints::{","+    badge, check_form, hook_form, kind, mode, note_form, reviewer_form, rows, rule_form,","+};","+use super::layers::{KINDS, factory_line, heading, section};","+use super::{Adding, At, EVERY, Item, Msg, Rules, choice, help, small};","+use crate::theme;","+","+/// Which rules a page holds.","+#[derive(Clone, Copy, Debug, PartialEq, Eq)]","+pub enum Which {","+    Constraints,","+    Capabilities,","+    Permissions,","+}","+","+/// Where a new item goes: on for every workflow in the Global view; off","+/// everywhere in the Workflows view, until its list picks steps.","+const OFF: &str = \"!*\";","+","+/// The level a page acts at.","+fn at(global: bool) -> At<'static> {","+    let scope = if global { EVERY } else { OFF };","+    At { scope, stage: \"\" }","+}","+","+/// An item's row in the Workflows view: what it is, how many steps it is","+/// on at, and its list when open.","+fn placed<'a>(","+    rules: &Rules,","+    item: Item,","+    head: Element<'a, Msg>,","+    scopes: &[String],","+    editable: bool,","+) -> Element<'a, Msg> {","+    let (on, all) = steps_on(rules, scopes);","+    let open = rules.open.as_ref() == Some(&item);","+    let label = if open { \"Close\" } else { \"Where\" };","+    let summary = help(format!(\"on at {on} of {all} steps\"));","+    let line = row![head, summary, small(label, Some(Msg::Open(item.clone())))]","+        .spacing(8)","+        .align_y(iced::Center);","+    match open {","+        true => column![line, tree(rules, &item, scopes, editable)]","+            .spacing(6)","+            .into(),","+        false => line.into(),","+    }","+}","+","+fn constraint_head<'a>(c: &ConstraintView) -> Element<'a, Msg> {","+    row![","+        badge(kind(c), theme::MUTED),","+        badge(mode(c), theme::MUTED),","+        text(c.rule.clone()).size(13).width(Fill)","+    ]","+    .spacing(8)","+    .align_y(iced::Center)","+    .into()","+}","+","+fn grant_head<'a>(g: &CapabilityView) -> Element<'a, Msg> {","+    let name = text(g.function.clone())","+        .size(13)","+        .font(theme::MONO)","+        .width(Fill);","+    row![","+        badge(&g.stage, theme::MUTED),","+        badge(&g.rung, theme::MUTED),","+        name","+    ]","+    .spacing(8)","+    .align_y(iced::Center)","+    .into()","+}","+","+/// Constraints as rows: at every workflow in the Global view, or with","+/// their lists in the Workflows view.","+fn constraint_rows<'a>(","+    rules: &'a Rules,","+    list: Vec<&ConstraintView>,","+    global: bool,","+    editable: bool,","+) -> Vec<Element<'a, Msg>> {","+    if global {","+        return rows(rules, list, &at(true), editable);","+    }","+    list.into_iter()","+        .map(|c| {","+            placed(","+                rules,","+                Item::Constraint(c.id.clone()),","+                constraint_head(c),","+                &c.steps,","+                editable,","+            )","+        })","+        .collect()","+}","+","+fn constraints<'a>(rules: &'a Rules, global: bool, editable: bool) -> Element<'a, Msg> {","+    let kept = rules","+        .constraints","+        .iter()","+        .filter(|c| !c.capability && c.layer != \"charter\");","+    let (feedback, feedforward): (Vec<&ConstraintView>, Vec<&ConstraintView>) =","+        kept.partition(|c| mode(c) == \"Feedback\");","+    let mut body = vec![heading(","+        \"Feedforward\",","+        \"told to the agent before it acts; the agent judges it\",","+    )];","+    body.extend(constraint_rows(rules, feedforward, global, editable));","+    body.push(heading(","+        \"Feedback\",","+        \"checks what the agent did; code or a reviewer judges it\",","+    ));","+    body.extend(constraint_rows(rules, feedback, global, editable));","+    section(\"Constraints\", \"What the agent must keep.\", body)","+}","+","+fn capabilities<'a>(rules: &'a Rules, global: bool, editable: bool) -> Element<'a, Msg> {","+    let notes: Vec<&ConstraintView> = rules.constraints.iter().filter(|c| c.capability).collect();","+    let mut body = vec![heading(","+        \"Feedforward\",","+        \"told to the agent as what it may use\",","+    )];","+    body.extend(constraint_rows(rules, notes, global, editable));","+    section(\"Capabilities\", \"What the agent may use.\", body)","+}","+","+fn permissions<'a>(rules: &'a Rules, global: bool, editable: bool) -> Element<'a, Msg> {","+    let grants = KINDS.iter().map(|(k, name)| {","+        let rows = rules.kind(k).into_iter().map(|g| match global {","+            true => grant_line(g, rules, &at(true), editable),","+            false => placed(","+                rules,","+                Item::Grant(g.stage.clone(), g.function.clone()),","+                grant_head(g),","+                &g.scopes,","+                editable,","+            ),","+        });","+        Column::new()","+            .spacing(6)","+            .push(help(format!(\"{name} steps' grants\")))","+            .extend(rows)","+            .into()","+    });","+    let mut body: Vec<Element<'a, Msg>> = grants.collect();","+    body.extend(rules.factory.iter().map(factory_line));","+    section(","+        \"Permissions\",","+        \"What the gate lets a call do. A call no grant covers is refused.\",","+        body,","+    )","+}","+","+/// The Add bar for the page's kind of item.","+fn adding<'a>(rules: &'a Rules, which: Which, global: bool) -> Element<'a, Msg> {","+    let pick =","+        |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));","+    let choices: Vec<Element<'a, Msg>> = match which {","+        Which::Constraints => vec![","+            pick(\"A rule\", Adding::Rule),","+            pick(\"A check\", Adding::Check),","+            pick(\"A hook\", Adding::Hook),","+            pick(\"A reviewer\", Adding::Reviewer),","+        ],","+        Which::Capabilities => vec![pick(\"A note\", Adding::Note)],","+        Which::Permissions => vec![pick(\"A grant\", Adding::Grant)],","+    };","+    let switch = row![text(\"Add\").size(13).color(theme::MUTED)]","+        .extend(choices)","+        .spacing(6)","+        .align_y(iced::Center);","+    let form = match (which, rules.adding) {","+        (Which::Capabilities, _) => note_form(rules),","+        (Which::Permissions, _) => grant_form(rules),","+        (_, Adding::Check) => check_form(rules),","+        (_, Adding::Hook) => hook_form(rules),","+        (_, Adding::Reviewer) => reviewer_form(rules),","+        _ => rule_form(rules),","+    };","+    let lands = match global {","+        true => \"What you add is on for every workflow.\",","+        false => \"What you add is off until you pick where it applies.\",","+    };","+    container(column![switch, help(lands), form].spacing(10))","+        .padding(12)","+        .width(Fill)","+        .style(theme::panel)","+        .into()","+}","+","+/// A grant for one kind, found by search, as a command, or an MCP server's.","+fn grant_form<'a>(rules: &'a Rules) -> Element<'a, Msg> {","+    let kind = rules.kind_of(&at(true));","+    let kinds = KINDS.iter().map(|(k, name)| {","+        choice(","+            format!(\"{name} steps\"),","+            kind == *k,","+            Some(Msg::ForKind(k.to_string())),","+        )","+    });","+    let kinds = row![text(\"For\").size(12).color(theme::MUTED)]","+        .extend(kinds)","+        .spacing(6)","+        .align_y(iced::Center);","+    column![kinds, granting(rules)].spacing(10).into()","+}","+","+/// One rules page: its items in the view picked, and its Add bar.","+pub fn page<'a>(rules: &'a Rules, which: Which, global: bool, editable: bool) -> Element<'a, Msg> {","+    let mut body = Column::new().spacing(10);","+    if which != Which::Permissions {","+        let filter = text_input(\"Filter by words or kind\", &rules.filter)","+            .on_input(Msg::Filter)","+            .style(theme::field);","+        body = body.push(filter);","+    }","+    let shown = match which {","+        Which::Constraints => constraints(rules, global, editable),","+        Which::Capabilities => capabilities(rules, global, editable),","+        Which::Permissions => permissions(rules, global, editable),","+    };","+    body = body.push(shown);","+    if editable {","+        body = body.push(adding(rules, which, global));","+    }","+    body.extend(super::said(rules)).into()","+}","+","+/// The level a page's Add acts at, for its update.","+pub fn level(global: bool) -> At<'static> {","+    at(global)","+}"]}],"created":true}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/applies.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/constraints.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/layers.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/mod.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/pages.rs"]}},"serverClassifierContext":{"request":"0634ea01-416a-4d88-b51e-b664c6c2f215","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"2bc45d99-4848-441d-a19d-361f53bbfc1c","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
