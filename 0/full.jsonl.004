collect()"]},{"oldStart":159,"oldLines":14,"newStart":162,"newLines":20,"lines":[" "," /// What the factory itself may do, as its workspace and steps set it."," fn factory_line<'a>(f: &FactoryCapabilityView) -> Element<'a, Msg> {","-    let what = column![text(f.name.clone()).size(13), help(f.how.clone())].spacing(2).width(Fill);","-    row![what, super::chip(f.rung.clone())].spacing(8).align_y(iced::Center).into()","+    let what = column![text(f.name.clone()).size(13), help(f.how.clone())]","+        .spacing(2)","+        .width(Fill);","+    row![what, super::chip(f.rung.clone())]","+        .spacing(8)","+        .align_y(iced::Center)","+        .into()"," }"," "," /// The add bar for every step: a grant for one kind, a rule, a hook or a"," /// reviewer, each for every step."," fn adding_every<'a>(rules: &'a Rules) -> Element<'a, Msg> {","-    let pick = |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));","+    let pick =","+        |label: &str, a: Adding| choice(label.to_string(), rules.adding == a, Some(Msg::Adding(a)));","     let switch = row![","         text(\"Add for every step\").size(13).color(theme::MUTED),","         pick(\"A grant\", Adding::Grant),"]},{"oldStart":176,"oldLines":13,"newStart":185,"newLines":25,"lines":["     ]","     .spacing(6)","     .align_y(iced::Center);","-    let kind = rules.kind_of(&At { step: \"\", stage: \"\" });","+    let kind = rules.kind_of(&At {","+        step: \"\",","+        stage: \"\",","+    });","     let form = match rules.adding {","         Adding::Hook => hook_form(rules),","         Adding::Reviewer => reviewer_form(rules),","         Adding::Grant | Adding::Elsewhere => {","-            let kinds = KINDS.iter().map(|(k, name)| choice(format!(\"{name} steps\"), kind == *k, Some(Msg::ForKind(k.to_string()))));","-            let kinds = row![text(\"For\").size(12).color(theme::MUTED)].extend(kinds).spacing(6).align_y(iced::Center);","+            let kinds = KINDS.iter().map(|(k, name)| {","+                choice(","+                    format!(\"{name} steps\"),","+                    kind == *k,","+                    Some(Msg::ForKind(k.to_string())),","+                )","+            });","+            let kinds = row![text(\"For\").size(12).color(theme::MUTED)]","+                .extend(kinds)","+                .spacing(6)","+                .align_y(iced::Center);","             column![kinds, granting(rules)].spacing(10).into()","         }","         Adding::Rule => rule_form(rules),"]},{"oldStart":197,"oldLines":9,"newStart":218,"newLines":17,"lines":[" /// What applies at every step of every workflow: each kind's grants, the"," /// rules and checks for every step, and the charters, by layer."," pub fn every_step<'a>(rules: &'a Rules, server: &str, editable: bool) -> Element<'a, Msg> {","-    let at = At { step: \"\", stage: \"\" };","+    let at = At {","+        step: \"\",","+        stage: \"\",","+    };","     let here = rules.here(\"\");","-    let of = |name: &str| here.iter().copied().filter(|c| layer(c) == name && c.steps.is_empty()).collect::<Vec<_>>();","+    let of = |name: &str| {","+        here.iter()","+            .copied()","+            .filter(|c| layer(c) == name && c.steps.is_empty())","+            .collect::<Vec<_>>()","+    };","     let mut harness = kind_grants(rules, editable);","     harness.extend(rows(rules, of(\"harness\"), &at, editable));","     let mut factory = rows(rules, of(\"factory\"), &at, editable);"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/mod.rs","hunks":[{"oldStart":211,"oldLines":7,"newStart":211,"newLines":10,"lines":["         rule,","         rung: \"enforced\".into(),","         source: \"owner\".into(),","-        steps: (!step.is_empty()).then(|| step.to_string()).into_iter().collect(),","+        steps: (!step.is_empty())","+            .then(|| step.to_string())","+            .into_iter()","+            .c