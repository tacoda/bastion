{"parentUuid":"7f612997-1dec-4e15-b436-3dd5c9e96410","isSidechain":false,"attachment":{"type":"deferred_tools_record","entries":[],"toolInputCopies":[{"id":"toolu_01RMM1Ma1DSaR6b89pV67aRS","copy":"wire"}]},"type":"attachment","uuid":"311a90df-2108-43d2-b645-5af73ca75174","timestamp":"2026-11-12T21:12:31.288Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
