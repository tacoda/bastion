marsh(frame: &mut Frame, at: Point) {","-    let pool = Path::circle(at, 1.0);","-    let _ = pool;","     let oval = Path::new(|p| {","         p.move_to(Point::new(at.x - 34.0, at.y));","         p.bezier_curve_to("]},{"oldStart":252,"oldLines":7,"newStart":279,"newLines":10,"lines":["     };","     frame.stroke(&oval, dots);","     for dx in [-18.0, -6.0, 8.0, 20.0] {","-        let reed = Path::line(Point::new(at.x + dx, at.y + 4.0), Point::new(at.x + dx + 2.0, at.y - 7.0));","+        let reed = Path::line(","+            Point::new(at.x + dx, at.y + 4.0),","+            Point::new(at.x + dx + 2.0, at.y - 7.0),","+        );","         frame.stroke(&reed, pen(1.0, theme::ink()));","     }","     cross(frame, at, theme::bad());"]},{"oldStart":261,"oldLines":8,"newStart":291,"newLines":20,"lines":[" /// An X where a trail ended."," pub fn cross(frame: &mut Frame, at: Point, color: Color) {","     let red = pen(3.0, color);","-    frame.stroke(&Path::line(Point::new(at.x - 8.0, at.y - 8.0), Point::new(at.x + 8.0, at.y + 8.0)), red);","-    frame.stroke(&Path::line(Point::new(at.x + 8.0, at.y - 8.0), Point::new(at.x - 8.0, at.y + 8.0)), red);","+    frame.stroke(","+        &Path::line(","+            Point::new(at.x - 8.0, at.y - 8.0),","+            Point::new(at.x + 8.0, at.y + 8.0),","+        ),","+        red,","+    );","+    frame.stroke(","+        &Path::line(","+            Point::new(at.x + 8.0, at.y - 8.0),","+            Point::new(at.x - 8.0, at.y + 8.0),","+        ),","+        red,","+    );"," }"," "," /// A compass rose: eight points around a ring."]},{"oldStart":282,"oldLines":7,"newStart":324,"newLines":11,"lines":["             p.line_to(b);","             p.close();","         });","-        let fill = if k % 2 == 0 { theme::ink() } else { theme::muted() };","+        let fill = if k % 2 == 0 {","+            theme::ink()","+        } else {","+            theme::muted()","+        };","         frame.fill(&point, fill);","     }","     fram