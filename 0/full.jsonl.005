(Route, &str, &str); 9] = [\n    (Route::Jobs, \"Jobs\", icons::JOBS),\n    (Route::Workflows, \"Workflows\", icons::WORKFLOWS),\n    (Route::Workspaces, \"Workspaces\", icons::FOLDER),\n    (Route::Audit, \"Audit Log\", icons::AUDIT),\n    (Route::Evals, \"Evals\", icons::EVALS),\n    (Route::Costs, \"Costs\", icons::COSTS),\n    (Route::Verification, \"Verification\", icons::VERIFICATION),\n    (Route::Engine, \"Engine\", icons::ENGINE),\n    (Route::Settings, \"Settings\", icons::SETTINGS),\n];''','''/// The top bar's pages (L2), in the order a person uses them. Insights\n/// opens on the Audit Log and holds the other records as tabs; Settings\n/// holds the server's health.\npub const PAGES: [(Route, &str, &str); 6] = [\n    (Route::Jobs, \"Jobs\", icons::JOBS),\n    (Route::Workflows, \"Workflows\", icons::WORKFLOWS),\n    (Route::Workspaces, \"Workspaces\", icons::FOLDER),\n    (Route::Harness, \"Harness\", icons::HARNESS),\n    (Route::Audit, \"Insights\", icons::INSIGHTS),\n    (Route::Settings, \"Settings\", icons::SETTINGS),\n];'''),\n('''            Route::Eval(_) => Route::Evals,\n            Route::Session(_) => Route::Costs,\n            // The rules a workflow applies are its tabs (S2).\n            Route::Constraints | Route::Capabilities | Route::Permissions => Route::Workflows,\n            other => other.clone(),\n        }\n    }''','''            Route::Eval(_) | Route::Evals | Route::Session(_) | Route::Costs | Route::Verification => {\n                Route::Audit\n            }\n            Route::Engine => Route::Settings,\n            other => other.clone(),\n        }\n    }\n\n    /// The top-bar entry whose tabs this page sits among.\n    pub fn tab_group(&self) -> Route {\n        self.section()\n    }\n\n    /// The tab this page lights: its own, or the list a record belongs to.\n    pub fn tab(&self) -> Route {\n        match self {\n            Route::Eval(_) => Route::Evals,\n            Route::Session(_) => Route::Costs,\n            other => other.clone(),\n        }\n    }'''),\n('''                | Route::Workspaces\n                | Route::Constraints\n                | Route::Capabilities\n                | Route::Permissions''','''                | Route::Workspaces\n                | Route::Harness'''),\n('''        assert_eq!(Route::Permissions.title(), \"Workflows\");''','''        assert_eq!(Route::Costs.title(), \"Insights\");\n        assert_eq!(Route::Engine.section(), Route::Settings);'''),\n('''        assert_eq!(Route::Eval(\"e1\".into()).title(), \"Evals\");''','''        assert_eq!(Route::Eval(\"e1\".into()).title(), \"Insights\");\n        assert_eq!(Route::Eval(\"e1\".into()).tab(), Route::Evals);'''),\n])\nedit('app.rs',[(\"    Rules(pages::rules_page::Msg),\",\"    Rules(pages::harness::Msg),\")])\nedit('pages/workflows.rs',[\n(\"            return Task::done(Message::Go(which.route()));\",\"            let _ = which;\\n            return Task::done(Message::Go(Route::Harness));\"),\n('''        super::head(\"Workflows\", about, vec![]),\n        super::workflow_tabs(&Route::Workflows),\n        chooser(state)''','''        super::head(\"Workflows\", about, vec![]),\n        chooser(state)'''),\n])\ns=open('icons.rs').read()\ns=s.replace('pub const AUDIT: &str','pub const HARNESS: &str = r#\"<path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/>\"#;\\npub const INSIGHTS: &str = r#\"<path d=\"M3 3v16a2 2 0 0 0 2 2h16\"/><path d=\"m19 9-5 5-4-4-3 3\"/>\"#;\\npub const AUDIT: &str',1)\nopen('icons.rs','w').write(s)\nEOF\ncd /Users/tacoda/tacoda/bastion && cargo fmt && CARGO_INCREMENTAL=0 cargo clippy -p bastion-desktop --all-targets -- -D warnings 2>&1 | grep -E \"^(error|warning)\" -A7 | head -60","description":"Routes, bar, sub-tabs, Harness wiring","timeout":600000}},"wireIngestContext":{"toolu_016K72TADJ9SEt8gobozo6gU":{"