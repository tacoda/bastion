.move_to(stops[0]);","+        for pair in stops.windows(2) {","+            let mid = Point::new(","+                (pair[0].x + pair[1].x) / 2.0,","+                pair[0].y.min(pair[1].y) - 12.0,","+            );","+            p.quadratic_curve_to(mid, pair[1]);","+        }","     });","     frame.stroke(&path, way.with_width(2.5).with_color(theme::link_color()));","     let steps = format!(\"{} steps\", w.nodes.len());"]},{"oldStart":200,"oldLines":10,"newStart":207,"newLines":17,"lines":["         );","         carto::coast(&mut frame, SHORE, size);","         towns(&mut frame, self.rules);","+        let all = places(self.rules, size.width);","         for (row, (w, _)) in routes(self.rules).into_iter().enumerate() {","-            route(&mut frame, w, row, size.width);","+            let prefix = format!(\"{}/\", w.id);","+            let mine: Vec<Point> = all","+                .iter()","+                .filter(|p| p.key.starts_with(&prefix))","+                .map(|p| p.at)","+                .collect();","+            route(&mut frame, w, row, size.width, &mine);","         }","-        for p in places(self.rules, size.width) {","+        for p in all {","             let lit = Some(p.key.as_str()) == self.picked || hovered.as_deref() == Some(&p.key);","             if p.stage == \"shell\" {","                 carto::castle(&mut frame, p.at, false);"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/map.rs"]}},"serverClassifierContext":{"request":"80db83fd-1a1d-45e3-b1c0-464e3a590654","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":5,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"