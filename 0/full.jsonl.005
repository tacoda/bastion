yers.rs:74:        Which::Capabilities => \"Capabilities\",\npages/step_rules/layers.rs:75:        Which::Permissions => \"Permissions\",\npages/step_rules/layers.rs:99:            Which::Constraints,\npages/step_rules/layers.rs:104:            Which::Capabilities,\npages/step_rules/layers.rs:109:            Which::Permissions,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/harness.rs","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":114,"lines":["+//! The Harness: what governs an agent, by kind, each item on for all","+//! workflows or at the workflows and steps you pick. On All servers each","+//! server has its section, and a change goes to that server (D58).","+","+use std::collections::BTreeMap;","+","+use bastion_protocol::PersonView;","+use bastion_protocol::api;","+use iced::widget::{Column, column, row, text};","+use iced::{Element, Task};","+","+use super::step_rules::{self, Which, choice};","+use super::{Ctx, scrolled};","+use crate::app::Message;","+use crate::theme;","+","+/// One server's rules, and whether its person may change them.","+#[derive(Default)]","+struct Server {","+    admin: bool,","+    rules: step_rules::Rules,","+}","+","+pub struct State {","+    /// The kind shown, or every kind.","+    kind: Option<Which>,","+    /// The All workflows view, or the Workflows view.","+    global: bool,","+    /// Each server shown, by its name.","+    servers: BTreeMap<String, Server>,","+}","+","+impl Default for State {","+    fn default() -> State {","+        State {","+            kind: None,","+            global: true,","+            servers: BTreeMap::new(),","+        }","+    }","+}","+","+#[derive(Clone, Debug)]","+pub enum Msg {","+    Kind(Option<Which>),","+    Global(bool),","+    Me(String, Result<PersonView, String>),","+    Rules(String, step_rules::Msg),","+}","+","+/// A server's rules message, as the window's.","+fn on(server: String) -> impl Fn(step_rules::Msg) -> Message + Clone {","+    move |m| Message::Rules(Msg::Rules(server.clone(), m))","+}","+","+pub fn load(ctx: &Ctx) -> Task<Message> {","+    let each = ctx.shown().into_iter().map(|name| {","+        let here = ctx.on(&name);","+        let who = name.clone();","+        let me = Task::perform(here.clone().get(name.clone(), api::Me), move |me| {","+            Message::Rules(Msg::Me(who.clone(), me))","+        });","+        Task::batch([me, step_rules::load(&here).map(on(name))])","+    });","+    Task::batch(each)","+}","+","+pub fn update(state: &mut State, msg: Msg, ctx: &Ctx) -> Task<Message> {","+    match msg {","+        Msg::Kind(kind) => state.kind = kind,","+        Msg::Global(global) => state.global = global,","+        Msg::Me(name, me) => {","+            state.servers.entry(name).or_default().admin = me.is_ok_and(|me| me.role == \"admin\")","+        }","+        Msg::Rules(name, m) => {","+            let at = step_rules::level(state.global);","+            let rules = &mut state.servers.entry(name.clone()).or_default().rules;","+            return step_rules::update(rules, m, &at, &ctx.on(&name)).map(on(name));","+        }","+    }","+    Task::none()","+}","+","+pub fn view<'a>(state: &'a State, ctx: &Ctx) -> Element<'a, Message> {","+    let pick = |label: &str, global: bool| {","+        choice(","+            label,","+            state.global == global,","+            Some(Message::Rules(Msg::Global(global))),","+        )","+    };","+    let views = row![pick(\"All workflows\", true), pick(\"Workflows\", false)].spacing(6);","+    let kind = |label: &str, k: Option<Which>| {","+        choice(label, state.kind == k, Some(Message::Rules(Msg::Kind(k))))","+    };","+    let kinds = Which::ALL.iter().map(|k| kind(k.label(), Some(*k)));","+    let kinds = row![kind(\"Everything\", None)].extend(kinds).spacing(6);","+    let shown_kinds: Vec<Which> = state.kind.map_or(Which::ALL.to_vec(), |k| vec![k]);","+    let shown = ctx.shown();","+    let named = shown.len() > 1;","+    let sections = shown.into_iter().filter_map(|name| {","+        let s = state.servers.get(&name)?;","+        let page = step_rules::page(&s.rules, &shown_kinds, state.global, s.admin);","+        let page = page.map(on(name.clone()));","+        let head = named.then(|| text(name).size(18).font(theme::BOLD));","+        let head = head.map(Element::from);","+        Some(Column::new().spacing(10).extend(head).push(page).into())","+    });","+    let about = \"What an agent is told, what checks its work, and what its calls may do.\";","+    let body = column![super::head(\"Harness\", about, vec![]), kinds, views]","+        .extend(sections)","+        .spacing(12);","+    scrolled(body)","+}"]}],"created":true},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/rules_page.rs","hunks":[{"oldStart":1,"oldLines":106,"newStart":0,"newLines":0,"lines":["-//! The Constraints, Capabilities and Permissions tabs of Workflows (D57):","-//! Bastion's rules, each on for all workflows, or on at the workflows and","-//! steps you pick. On All servers each server has its section, and a","-//! change goes to that server (D58).","-","-use std::collections::BTreeMap;","-","-use bastion_protocol::PersonView;","-use bastion_protocol::api;","-use iced::widget::{Column, column, row, text};","-use iced::{Element, Task};","-","-use super::step_rules::{self, Which, choice};","-use super::{Ctx, scrolled};","-use crate::app::Message;","-use crate::theme;","-","-/// One server's rules, and whether its person may change them.","-#[derive(Default)]","-struct Server {","-    admin: bool,","-    rules: step_rules::Rules,","-}","-","-pub struct State {","-    pub which: Which,","-    /// The All workflows view, or the Workflows view.","-    global: bool,","-    /// Each server shown, by its name.","-    servers: BTreeMap<String, Server>,","-}","-","-impl State {","-    p