"<path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/>\"#;"," pub const INSIGHTS: &str = r#\"<path d=\"M3 3v16a2 2 0 0 0 2 2h16\"/><path d=\"m19 9-5 5-4-4-3 3\"/>\"#;"," pub const SETTINGS: &str = r#\"<path d=\"M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>\"#;"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/mod.rs","hunks":[{"oldStart":215,"oldLines":6,"newStart":215,"newLines":16,"lines":[" }"," "," impl Rules {","+    /// The server's workflows, as the rules read them.","+    pub fn workflows(&self) -> &[WorkflowView] {","+        &self.workflows","+    }","+","+    /// Each workspace's charter.","+    pub fn charters(&self) -> &[WorkspaceCharterView] {","+        &self.charters","+    }","+","     /// A kind's grants: one item per function.","     fn kind(&self, stage: &str) -> Vec<&CapabilityView> {","         let kind = self.grants.iter();"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/icons.rs","/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/step_rules/mod.rs"]}},"serverClassifierContext":{"request":"b616364e-f47a-45cb-9f20-9a5e365b480e","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes