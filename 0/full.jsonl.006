bal: bool| {\n        choice(\n            label,\n            state.global == global,\n            Some(Message::Rules(Msg::Global(global))),\n        )\n    };\n    let views = row![pick(\"All trails\", true), pick(\"Trails\", false)].spacing(6);\n    let kind = |label: &str, k: Option<Which>| {\n        choice(label, state.kind == k, Some(Message::Rules(Msg::Kind(k))))\n    };\n    let kinds = Which::ALL.iter().map(|k| kind(k.label(), Some(*k)));","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"5d8c9271-5bf4-44d2-9c9c-fad245b6aa34","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"aa2a870b-3c43-4e35-adad-48a074d4c9e7","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
