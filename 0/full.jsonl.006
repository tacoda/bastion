// Whether `path`, relative to the repository, matches `glob`: `*` takes","-/// any characters but `/`, `**` any number of whole parts.","-pub fn matches(glob: &str, path: &str) -> bool {","-    let glob: Vec<&str> = glob.trim_start_matches(\"./\").split('/').collect();","-    let path: Vec<&str> = path.trim_start_matches(\"./\").split('/').collect();","-    parts(&glob, &path)","+impl RepoPath {","+    pub fn new(text: &str) -> RepoPath {","+        RepoPath(split(text))","+    }"," }"," ","-fn parts(glob: &[&str], path: &[&str]) -> bool {","-    match (glob.first(), path.first()) {","+fn parts(glob: &[String], path: &[String]) -> bool {","+    match (glob.first().map(String::as_str), path.first()) {","         (None, None) => true,","-        (Some(&\"**\"), _) => {","+        (Some(\"**\"), _) => {","             parts(&glob[1..], path) || (!path.is_empty() && parts(glob, &path[1..]))","         }","         (Some(g), Some(p)) => part(g, p) && parts(&glob[1..], &path[1..]),"]},{"oldStart":86,"oldLines":20,"newStart":70,"newLines":56,"lines":["     }"," }"," ","-/// A path a call opened, relative to the repository: the sandbox mounts","-/// it at `/work/repo`.","-pub fn in_repo(path: &str) -> &str {","-    path.strip_prefix(\"/work/repo/\").unwrap_or(path)","+/// A corpus file: its name in `.agents/corpus/` and its text.","+pub struct File<'a> {","+    pub name: &'a str,","+    pub text: &'a str,"," }"," ","+/// One corpus entry: its name, the globs it is relevant to, and its why.","+#[derive(Clone, Debug, PartialEq, Eq)]","+pub struct Entry {","+    pub name: String,","+    pub paths: Vec<Glob>,","+    pub text: String,","+}","+","+impl Entry {","+    /// Whether the entry is relevant to `path`.","+    pub fn covers(&self, path: &RepoPath) -> bool {","+        self.paths.iter().any(|g| g.matches(path))","+    }","+}","+","+/// An entry from its file. An entry with no `paths:` line is relevant","+/// nowhere, so it is never given.","+pub fn parse(file: File) -> Entry {","+    let (head, text) = front_matter(file.text);","+    let line = head.lines().find_map(|l| l.trim().strip_prefix(\"paths:\"));","+    let globs = line.into_iter().flat_map(|list| list.split(','));","+    let globs = globs.map(|g| g.trim().trim_matches(['\"', '\\'']));","+    Entry {","+        name: file.name.trim_end_matches(\".md\").into(),","+        paths: globs.filter(|g| !g.is_empty()).map(Glob::new).collect(),","+        text: text.trim().into(),","+    }","+}","+","+/// The front matter between two `---` lines at the top, and the rest.","+fn front_matter(file: &str) -> (&str, &str) {","+    let Some(rest) = file.trim_start().strip_prefix(\"---\") else {","+        return (\"\", file);","+    };","+    match rest.split_once(\"\\n---\") {","+        Some((head, body)) => (head, body.trim_start_matches('-')),","+        None => (\"\", file),","+    }","+}","+"," /// The entries relevant to `path` that `given` does not hold yet.","-pub fn relevant<'a>(entries: &'a [Entry], path: &str, given: &[String]) -> Vec<&'a Entry> {","-    let path = in_repo(path);","-    entries","-        .iter()","-        .filter(|e| !given.contains(&e.name))","-        .filter(|e| e.paths.iter().any(|g| matches(g, path)))","-        .collect()","+pub fn relevant<'a>(entries: &'a [Entry], path: &RepoPath, given: &[String]) -> Vec<&'a Entry> {","+    let fresh = entries.iter().filter(|e| !given.contains(&e.name));","+    fresh.filter(|e| e.covers(path)).collect()"," }"," "," /// The entries as an agent is given them, ahead of what its call returned."]},{"oldStart":114,"oldLines":32,"newStart":134,"newLines":46,"lines":[" mod tests {","     use super::*;"," ","+    fn hits(glob: &str, path: &str) -> bool {","+        Glob::new(glob).matches(&RepoPath::new(path))","+    }","+","     #[test]","     fn globs_match_whole_parts_and_stars_within_one() {","-        assert!(matches(\"src/billing/**\", \"src/billing/invoice.rs\"));","-        assert!(matches(\"src/billing/**\", \"src/billing/tax/vat.rs\"));","-        assert!(matches(\"src/**/mod.rs\", \"src/a/b/mod.rs\"));","-        assert!(matches(\"src/*.rs\", \"src/main.rs\"));","-        assert!(matches(\"docs/billing.md\", \"./docs/billing.md\"));","-        assert!(!matches(\"src/*.rs\", \"src/a/main.rs\"), \"* stays in one part\");","-        assert!(!matches(\"src/billing/**\", \"src/billingx/a.rs\"));","-        assert!(!matches(\"docs/billing.md\", \"docs/billing.mdx\"));","+        assert!(hits(\"src/billing/**\", \"src/billing/invoice.rs\"));","+        assert!(hits(\"src/billing/**\", \"/work/repo/src/billing/tax/vat.rs\"));","+        assert!(hits(\"src/**/mod.rs\", \"src/a/b/mod.rs\"));","+        assert!(hits(\"src/*.rs\", \"src/main.rs\"));","+        assert!(hits(\"docs/billing.md\", \"./docs/billing.md\"));","+        assert!(!hits(\"src/*.rs\", \"src/a/main.rs\"), \"* stays in one part\");","+        assert!(!hits(\"src/billing/**\", \"src/billingx/a.rs\"));","+        assert!(!hits(\"docs/billing.md\", \"docs/billing.mdx\"));","     }"," ","     #[test]","     fn an_entry_reads_its_paths_and_is_given_once_where_it_is_relevant() {","-        let file =","-            \"---\\npaths: src/billing/**, \\\"docs/billing.md\\\"\\n---\\nInvoices round half to even.\\n\";","-        let e = parse(\"rounding.md\", file);","+        let text = \"---\\npaths: src/billing/**, \\\"docs/billing.md\\\"\\n---\\nInvoices round half to even.\\n\";","+        let e = parse(File {","+            name: \"rounding.md\",","+            text,","+        });","         assert_eq!(e.name, \"rounding\");","-        assert_eq!(e.paths, [\"src/billing/**\", \"docs/billing.md\"]);","+        assert_eq!(","+            e.paths,","+            [Glob::new(\"src/billing/**\"), Glob::new(\"docs/billing.md\")]","+        );","         assert_eq!(e.text, \"Invoices round half to even.\");","         let all = [e];","-        let hit = relevant(&all, \"/work/repo/src/billing/a.rs\", &[]);","+        let billing = RepoPath::new(\"/work/repo/src/billing/a.rs\");","+        let hit = relevant(&all, &billing, &[]);","         assert_eq!(hit.len(), 1);","-        assert!(relevant(&all, \"/work/repo/src/main.rs\", &[]).is_empty());","-        assert!(relevant(&all, \"src/billing/a.rs\", &[\"rounding\".into()]).is_empty());","+        assert!(relevant(&all, &RepoPath::new(\"src/main.rs\"), &[]).is_empty());","+        assert!(relevant(&all, &billing, &[\"rounding\".into()]).is_empty());","         assert!(told(&hit).contains(\"<corpus name=\\\"rounding\\\">\"));","-        assert!(parse(\"loose.md\", \"No front matter.\").paths.is_empty());","+        let loose = File {","+            name: \"loose.md\",","+            text: \"No front matter.\",","+        };","+        assert!(parse(loose).paths.is_empty());","     }"," }"]}],"originalFile":"//! A region's corpus (D61): the why behind its code (why it is shaped this\n//! way, what surprised someone, which scenario it serves), each in\n//! `.agents/corpus/<name>.md`. A lesson says what to do; the corpus says\n//! why. An entry opens with\n//! the paths it is relevant to, and an agent is given it only when it opens\n//! one of them.\n//!\n//! ```text\n//! ---\n//! paths: src/billing/**, docs/billing.md\n//! ---\n//! Invoices round half to even; the ledger relies on it.\n//! ```\n\n/// Where a repository keeps its corpus.\npub const DIR: &str = \".agents/corpus\";\n\n/// One corpus entry: its name, the path globs it is relevant to, and its\n/// text.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Entry {\n    pub name: String,\n    pub paths: Vec<String>,\n    pub text: String,\n}\n\n/// An entry from its file's name and text. An entry with no `paths:` line\n/// is relevant nowhere, so it is never given.\npub fn parse(name: &str, file: &str) -> Entry {\n    let (head, text) = front_matter(file);\n    let paths = head\n        .lines()\n        .find_map(|l| l.trim().strip_prefix(\"paths:\"))\n        .map(|list| {\n            let globs = list.split(',').map(|g| g.trim().trim_matches(['\"', '\\'']));\n            globs.filter(|g| !g.is_empty()).map(String::from).collect()\n        })\n        .unwrap_or_default();\n    Entry {\n        name: name.trim_end_matches(\".md\").into(),\n        paths,\n        text: text.trim().into(),\n    }\n}\n\n/// The front matter between two `---` lines at the top, and the rest.\nfn front_matter(file: &str) -> (&str, &str) {\n    let Some(rest) = file.trim_start().strip_prefix(\"---\") else {\n        return (\"\", file);\n    };\n    match rest.split_once(\"\\n---\") {\n        Some((head, body)) => (head, body.trim_start_matches('-')),\n        None => (\"\", file),\n    }\n}\n\n/// Whether `path`, relative to the repository, matches `glob`: `*` takes\n/// any characters but `/`, `**` any number of whole parts.\npub fn matches(glob: &str, path: &str) -> bool {\n    let glob: Vec<&str> = glob.trim_start_matches(\"./\").split('/').collect();\n    let path: Vec<&str> = path.trim_start_matches(\"./\").split('/').collect();\n    parts(&glob, &path)\n}\n\nfn parts(glob: &[&str], path: &[&str]) -> bool {\n    match (glob.first(), path.first()) {\n        (None, None) => true,\n        (Some(&\"**\"), _) => {\n            parts(&glob[1..], path) || (!path.is_empty() && parts(glob, &path[1..]))\n        }\n        (Some(g), Some(p)) => part(g, p) && parts(&glob[1..], &path[1..]),\n        _ => false,\n    }\n}\n\n/// Whether one part of a path matches one part of a glob, `*` within it.\nfn part(glob: &str, name: &str) -> bool {\n    match glob.split_once('*') {\n        None => glob == name,\n        Some((head, tail)) => {\n            let Some(rest) = name.strip_prefix(head) else {\n                return false;\n            };\n            (0..=rest.len()).any(|i| rest.is_char_boundary(i) && part(tail, &rest[i..]))\n        }\n    }\n}\n\n/// A path a call opened, relative to the repository: the sandbox mounts\n/// it at `/work/repo`.\npub fn in_repo(path: &str) -> &str {\n    path.strip_prefix(\"/work/repo/\").unwrap_or(path)\n}\n\n/// The entries relevant to `path` that `given` does not hold yet.\npub fn relevant<'a>(entries: &'a [Entry], path: &str, given: &[String]) -> Vec<&'a Entry> {\n    let path = in_repo(path);\n    entries\n        .iter()\n        .filter(|e| !given.contains(&e.name))\n        .filter(|e| e.paths.iter().any(|g| matches(g, path)))\n        .collect()\n}\n\n/// The entries as an agent is given them, ahead of what its call returned.\npub fn told(entries: &[&Entry]) -> String {\n    let each = entries\n        .iter()\n        .map(|e| format!(\"<corpus name=\\\"{}\\\">\\n{}\\n</corpus>\", e.name, e.text));\n    each.collect::<Vec<_>>().join(\"\\n\")\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn globs_match_whole_parts_and_stars_within_one() {\n        assert!(matches(\"src/billing/**\", \"src/billing/invoice.rs\"));\n        assert!(matches(\"src/billing/**\", \"src/billing/tax/vat.rs\"));\n        assert!(matches(\"src/**/mod.rs\", \"src/a/b/mod.rs\"));\n        assert!(matches(\"src/*.rs\", \"src/main.rs\"));\n        assert!(matches(\"docs/billing.md\", \"./docs/billing.md\"));\n        assert!(!matches(\"src/*.rs\", \"src/a/main.rs\"), \"* stays in one part\");\n        assert!(!matches(\"src/billing/**\", \"src/billingx/a.rs\"));\n        assert!(!matches(\"docs/billing.md\", \"docs/billing.mdx\"));\n    }\n\n    #[test]\n    fn an_entry_reads_its_paths_and_is_given_once_where_it_is_relevant() {\n        let file =\n            \"---\\npaths: src/billing/**, \\\"docs/billing.md\\\"\\n---\\nInvoices round half to even.\\n\";\n        let e = parse(\"rounding.md\", file);\n        assert_eq!(e.name, \"rounding\");\n        assert_eq!(e.paths, [\"src/billing/**\", \"docs/billing.md\"]);\n        assert_eq!(e.text, \"Invoices round half to even.\");\n        let all = [e];\n        let hit = relevant(&all, \"/work/repo/src/billing/a.rs\", &[]);\n        assert_eq!(hit.len(), 1);\n        assert!(relevant(&all, \"/work/repo/src/main.rs\", &[]).is_empty());\n        assert!(relevant(&all, \"src/billing/a.rs\", &[\"rounding\".into()]).is_empty());\n        assert!(told(&hit).contains(\"<corpus name=\\\"rounding\\\">\"));\n        assert!(parse(\"loose.md\", \"No front matter.\").paths.is_empty());\n    }\n}\n","userModified":false},"sourceToolAssistantUUID":"2758da91-dec2-4728-b2fb-138eb9a9c96e","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
