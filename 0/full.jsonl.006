rails: &[WorkflowView]) -> [FactoryCapabilityView; 2] {","+fn region_lines(","+    w: &crate::store::Workspace,","+    trails: &[WorkflowView],","+) -> [FactoryCapabilityView; 2] {","     let land = match w.merges() {","         true => format!(\"Merges a finished journey's branch into {}.\", w.branch),","         false => format!("]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/govern.rs"]}},"serverClassifierContext":{"request":"773b5247-432a-492f-b45f-3578c399d57a","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"8dce2bbe-0459-4d88-9a7f-c0849e605906","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
