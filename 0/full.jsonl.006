dLines":16,"newStart":92,"newLines":30,"lines":["         let branches = ctx.clone().get(s.name.clone(), api::CharterBranches).await;","         let mine = branches.unwrap_or_default().into_iter();","         read.branches.extend(mine.map(|b| (s.name.clone(), b)));","+        read.setup","+            .push((s.name.clone(), setup_of(&ctx, &s.name).await));","     }","     read.jobs","         .sort_by_key(|j| std::cmp::Reverse(j.job.created_at));","     read"," }"," ","+/// How far server `name`'s first run has come. A server that cannot be","+/// read counts as set up, so it adds nothing to do.","+async fn setup_of(ctx: &Ctx, name: &str) -> Setup {","+    let providers = ctx.clone().get(name.to_string(), api::Providers).await;","+    let regions = ctx.clone().get(name.to_string(), api::Workspaces).await;","+    Setup {","+        model: providers.map_or(true, |all| all.iter().any(|p| p.ready)),","+        region: regions.map_or(true, |all| !all.is_empty()),","+    }","+}","+"," pub fn update(state: &mut State, msg: Msg) {","     match msg {","         Msg::Read(read) => {","-            (state.jobs, state.branches, state.errors) = (read.jobs, read.branches, read.errors)","+            (state.jobs, state.branches, state.errors) = (read.jobs, read.branches, read.errors);","+            state.setup = read.setup;","         }","         Msg::Place(p) => state.place = (p != EVERY).then_some(p),","         Msg::Search(s) => state.search = s,"]},{"oldStart":195,"oldLines":6,"newStart":219,"newLines":73,"lines":["     section(title, body.into(), true)"," }"," ","+/// One step of the first run: whether it is done, what it is, and where","+/// a person does it.","+struct FirstStep {","+    done: bool,","+    what: &'static str,","+    go: (&'static str, Route),","+}","+","+/// The first run's steps on `server`, or none once all are done.","+fn first_steps(setup: Setup, journeyed: bool) -> Option<[FirstStep; 3]> {","+    if setup.model && setup.region && journeyed {","+      