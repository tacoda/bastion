p))\n            .collect();\n        named.sort_unstable();\n        named.dedup();\n        if named.is_empty() {\n            return Ok(());\n        }\n        let home = self.plugins.as_ref().ok_or(\"this server keeps no plugins\")?;\n        let mut ran = Vec::new();\n        for p in named {\n            let dir = home.join(p);\n            let missing = |_| format!(\"the plugin {p} is not installed on this server\");\n            let commit = self.git(&dir, &[\"rev-parse\", \"HEAD\"]).map_err(missing)?;\n            let file = self.scratch.join(format!(\"{}-{p}.bundle\", job.id));\n            self.git(&dir, &[\"bundle\", \"create\", &file.display().to_string(), \"HEAD\"])?;\n            let at = format!(\"/work/plugins/{p}.bundle\");\n            self.put(vm, &at, self.machine.read_bytes(&file)?).await?;\n            let into = format!(\"/work/plugins/{p}\");\n            self.vm_exec(vm, &[\"git\", \"clone\", \"-q\", &at, &into]).await?;\n            ran.push(format!(\"{p}@{}\", commit.trim()));\n        }\n        let artifact = store::Artifact {\n            stage: job.stage,\n            step: String::new(),\n            body: format!(\"The plugins this journey runs with:\\\\n{}\", ran.join(\"\\\\n\")),\n            created_at: now(),\n        };\n        self.store.add_artifact(&job.id, &artifact).await\n    }\n\n    /// Where a request's screenshots are kept on the host: under the job''')\nEOF\nCARGO_INCREMENTAL=0 cargo clippy -q -p bastion-server --all-targets -- -D warnings 2>&1 | head -30","description":"Put named plugins into the VM at provisioning","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":887,"cache_read_input_tokens":397734,"output_tokens":2365,"output_tokens_details":{"thinking_tokens":906},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"e