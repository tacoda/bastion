(\"skills\")).into_iter();","     let skills = skills.filter(|s| machine.exists(&root.join(\"skills\").join(s).join(\"SKILL.md\")));"]},{"oldStart":96,"oldLines":8,"newStart":98,"newLines":12,"lines":["         let text = machine.read(&root.join(name)).unwrap_or_default();","         serde_json::from_str(&text).unwrap_or(Value::Null)","     };","-    all.extend(hooks(&json(\"hooks/hooks.json\")));","-    if let Some(servers) = json(\".mcp.json\")[\"mcpServers\"].as_object() {","+    let inline = |key: &str, file: &str| match manifest[key].is_object() {","+        true => serde_json::json!({ key: manifest[key].clone() }),","+        false => json(file),","+    };","+    all.extend(hooks(&inline(\"hooks\", \"hooks/hooks.json\")));","+    if let Some(servers) = inline(\"mcpServers\", \".mcp.json\")[\"mcpServers\"].as_object() {","         all.extend(","             servers","                 .keys()"]},{"oldStart":117,"oldLines":7,"newStart":123,"newLines":7,"lines":["         description: manifest[\"description\"].as_str().unwrap_or_default().into(),","         url: git(machine, root, &[\"remote\", \"get-url\", \"origin\"]).unwrap_or_default(),","         commit: git(machine, root, &[\"rev-parse\", \"HEAD\"])?,","-        parts: parts(machine, root),","+        parts: parts(machine, root, &manifest),","     })"," }"," "]},{"oldStart":260,"oldLines":6,"newStart":266,"newLines":20,"lines":["         assert_eq!(v.parts[2].detail, \"./guard.sh\");","     }"," ","+    #[test]","+    fn hooks_and_mcp_servers_may_sit_in_the_manifest() {","+        let manifest = serde_json::json!({","+            \"hooks\": {\"SessionStart\": [{\"hooks\": [{\"type\": \"command\", \"command\": \"node a.js\"}]}]},","+            \"mcpServers\": {\"docs\": {}}","+        });","+        let found = parts(&FakeMachine::new(), Path::new(\"/p\"), &manifest);","+        let kinds: Vec<(&str, &str)> = found","+            .iter()","+            .map(|p| (p.kind.as_str(), p.name.as_str()))","+        