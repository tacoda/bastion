 => w.replace('/', \" › \"),","+        _ if n.step.is_empty() => name.into(),","+        _ => format!(\"{name} › {}\", n.step),","     }"," }"," "]},{"oldStart":210,"oldLines":7,"newStart":213,"newLines":7,"lines":["     if !s.admin {","         return text(\"\").into();","     }","-    let at = waypoint_words(n);","+    let at = waypoint_words(n, s.rules.workflows());","     let press = |label: String, msg: Msg| {","         crate::lift::button(text(label).size(13))","             .style(theme::secondary)"]},{"oldStart":350,"oldLines":7,"newStart":353,"newLines":13,"lines":["             (told.rung.as_str(), told.steps.clone()),","             (\"told\", vec![\"bug-fix/plan\".to_string()])","         );","-        assert_eq!(waypoint_words(&note), \"bug-fix › plan\");","+        assert_eq!(waypoint_words(&note, &[]), \"bug-fix › plan\");","+        let named = WorkflowView {","+            id: \"bug-fix\".into(),","+            name: \"Bug fix\".into(),","+            ..WorkflowView::default()","+        };","+        assert_eq!(waypoint_words(&note, &[named]), \"Bug fix › plan\");","         let d = Draft {","             note: note.clone(),","             function: \" sandbox::exec \".into(),"]},{"oldStart":376,"oldLines":6,"newStart":385,"newLines":6,"lines":["             workflow: String::new(),","             ..note","         };","-        assert_eq!(waypoint_words(&none), \"every trail\");","+        assert_eq!(waypoint_words(&none, &[]), \"every trail\");","     }"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/harness.rs"]}},"serverClassifierContext":{"request":"9dcb4d04-bbbb-4cd4-b7a2-736e26b8a49a","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":5,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push