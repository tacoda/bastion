re what it taught is kept as","+//! lessons and facts (D61). Pressing a landmark opens its step; pressing","+//! the charter opens the field notes."," "," use bastion_protocol::StepView;"," use iced::widget::canvas::{self, Canvas, Frame, Geometry, LineDash, Path, Stroke, Text};"]},{"oldStart":64,"oldLines":7,"newStart":65,"newLines":7,"lines":["     Point::new(SHORE + 150.0, HEIGHT * 0.68)"," }"," ","-/// The atlas, low by the outpost, where the way home ends.","+/// The charter's hall, low by the outpost, where the way home ends."," fn atlas_at() -> Point {","     Point::new(SHORE + 70.0, HEIGHT * 0.93)"," }"]},{"oldStart":246,"oldLines":7,"newStart":247,"newLines":7,"lines":["     }"," }"," ","-/// The way home, from the summit or the marsh, to the atlas (D59).","+/// The way home, from the summit or the marsh, to the charter (D61)."," fn homeward(frame: &mut Frame, width: f32, job: &str, lit: bool) {","     let from = match job {","         \"landed\" => Point::new(summit(width).x - 30.0, summit(width).y + 70.0),"]},{"oldStart":259,"oldLines":14,"newStart":260,"newLines":14,"lines":["     );","     carto::atlas(frame, atlas_at(), lit);","     let note = if lit {","-        \"press to read and write field notes\"","+        \"press to sign what this journey taught\"","     } else {","-        \"the way home, with field notes\"","+        \"the way home: lessons and facts\"","     };","     carto::name(","         frame,","         Point::new(atlas_at().x + 120.0, atlas_at().y - 30.0),","-        \"the atlas\",","+        \"the charter\",","         note,","     );"," }"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/trail.rs"]}},"serverClassifierContext":{"request":"48d1f6eb-3e00-4d82-b314-6acd10e95e33","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":1,"modified":10,"untracked":null