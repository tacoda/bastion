he lost turn did not start again\");\n    });\n}\n54:pub(super) fn rig() -> Rig {\n55-    rig_on(engine())\n56-}\n57-\n58-pub(super) fn rig_on(engine: FakeEngine) -> Rig {\n59-    rig_with(engine, FakeMachine::new().run_ok(\"git\", \"\"))\n60-}\n61-\n62-/// A rig on `engine` and `machine`, with one workspace `w` on `/repo`.\n63-pub(super) fn rig_with(engine: FakeEngine, machine: FakeMachine) -> Rig {\n64-    let (engine, machine) = (Arc::new(engine), Arc::new(machine));\n65-    let store = Arc::new(FakeStore::default());\n66-    store.workspaces.lock().unwrap().push(workspace());\n67-    crate::rt::block_on(crate::seed_flows::seed(&*store)).unwrap();\n68-    let told = Arc::new(std::sync::Mutex::new(Vec::new()));\n69-    let keep = told.clone();\n70-    let factory = Factory::new(\n71-        engine.clone() as Arc<dyn Engine>,\n72-        store.clone() as Arc<dyn Store>,\n73-        machine.clone(),\n74-        Arc::new(move |c| keep.lock().unwrap().push(c)),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"f4b6322c-6de9-4215-93f2-869ffacdcf68","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":4,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"ba887a13-aee7-4c8c-ba4d-d443875f0ab0","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
