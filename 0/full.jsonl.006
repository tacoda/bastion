            Some(kept) => kept.clone(),\n597-            None => {\n598-                let made = self.create_worktree(job).await?;\n599-                self.set_runtime(&job.id, |r| r.worktree = Some(made.clone()))\n600-                    .await?;\n601-                made\n602-            }\n603-        };\n604-        let ws = self.workspace(record).await?;\n605-        let sandbox = self.create_vm(false, &ws).await?;\n606-        self.set_runtime(&job.id, |r| r.sandbox = Some(sandbox.clone()))\n607-            .await?;\n608-        let (path, branch) = self.worktree_path(&worktree).await?;\n609-        // What a review or refactor turn diffs against: where the job forked\n610-        // from its workspace's branch, so a revived VM still sees the change.\n611-        let base = self.fork_point(record, &path).await;\n612-        let bundle = self.bundle(&job.id, &path, &branch)?;\n613-        let repo = setup::Repo {\n614-            bundle,\n615-            branch: &branch,\n616-            base: &base,\n617-        };\n618-        self.fill(&ws, &sandbox, repo).await?;\n619-        self.put_screenshots(job, &sandbox).await?;\n620-        self.vm_exec(&sandbox, &[\"git\", \"-C\", REPO, \"tag\", \"-f\", BASE_TAG, &base])\n621-            .await?;\n622-        Ok(())\n623-    }\n624-\n625-    /// Where a request's screenshots are kept on the host: under the job\n626-    /// that was asked for.\n627-    fn screenshots_dir(&self, job: &Job) -> std::path::PathBuf {\n628-        self.scratch.join(\"requests\").join(&job.id)\n629-    }\n630-\n631-    /// Keep a request's screenshots on the host, named on the job.\n632-    fn keep_screenshots(&self, job: &mut Job, shots: &[(String, Vec<u8>)]) -> Result<(), String> {\n633-        let total: usize = shots.iter().map(|(_, b)| b.len()).sum();\n634-        if total > SCREENSHOT_BYTES {\n635-            return Err(format!(\n636-                \"the screenshots come to {total} bytes, past {SCREENSHOT_BYTES}\"\n637-          