"First steps on {server}\"),","+            body.into(),","+            true,","+        ))","+    });","+    cards.collect()","+}","+"," /// The one server the switcher shows, or none for every server."," fn scope(ctx: &Ctx) -> Option<&str> {","     (!ctx.all).then_some(ctx.current.as_str())"]},{"oldStart":452,"oldLines":6,"newStart":543,"newLines":7,"lines":["     let shown = state.shown(scope(ctx));","     let body = column![super::head(\"Journeys\", about, vec![new.into()])]","         .extend(super::problem(&page_note(&down, &state.errors)))","+        .extend(first_run(state, scope(ctx)))","         .extend([filters(state, ctx), overview(&shown), groups(state, ctx)])","         .spacing(16);","     super::scrolled(body)"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/jobs.rs"]}},"serverClassifierContext":{"request":"291ec86a-edda-4b1a-982a-e950c936afe9","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"3f73495f-f9ec-44af-8db0-ea188d8f1e1e","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
