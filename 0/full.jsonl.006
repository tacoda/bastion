.push(head).extend(rows).into())","+}","+","+/// A workspace's atlas: its field notes, about the workspace and about","+/// Bastion (D59).","+fn atlas_card<'a>(atlas: &'a [FieldNoteView], ws: &'a str, name: String) -> Element<'a, Message> {","+    let title = text(format!(\"The atlas of {ws}\"))","+        .size(15)","+        .font(theme::BOLD);","+    let close = crate::lift::button(text(\"Close\").size(13))","+        .style(theme::link)","+        .on_press(Message::Map(Msg::Close(name)));","+    let head = row![title, iced::widget::space::horizontal(), close].align_y(iced::Center);","+    let mine = |about: &'a str| -> Vec<&'a FieldNoteView> {","+        let all = atlas.iter().filter(|n| n.workspace == ws);","+        all.filter(|n| n.about == about).collect()","+    };","+    let shelves = [","+        shelf(\"About the workspace\", mine(\"workspace\")),","+        shelf(\"About Bastion\", mine(\"bastion\")),","+    ];","+    let mut body = Column::new()","+        .spacing(14)","+        .extend(shelves.into_iter().flatten());","+    if !atlas.iter().any(|n| n.workspace == ws) {","+        let none = \"No field notes yet. They are written when a journey comes home.\";","+        body = body.push(text(none).size(13).color(theme::muted()));","+    }","+    let body = scrollable(body).height(iced::Length::Shrink);","+    container(column![head, container(body).max_height(CARD_MAX)].spacing(8))","+        .padding(12)","+        .width(CARD)","+        .style(theme::panel)","+        .into()","+}","+"," /// The step a key names, `workflow/step`."," fn node<'a>(rules: &'a Rules, key: &str) -> Option<&'a NodeView> {","     let (w, step) = key.split_once('/')?;"]},{"oldStart":443,"oldLines":6,"newStart":526,"newLines":9,"lines":[" /// The card over the chart for the landmark picked: what the step does, or"," /// what applies there."," fn card<'a>(s: &'a Server, p: &'a Picked, name: String) -> Element<'a, Message> {","+    if let Some(ws) = p.key.strip_prefix(TOWN) {","+        return atlas_card(&s.atlas, ws, name);","+    }","     let at = At {","         scope: &p.key,","         stage: &p.stage,"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/map.rs"]}},"serverClassifierContext":{"request":"19fbbad5-845f-410b-8003-a1d68082423a","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages","platform":"macos"}},"sourceToolAssistantUUID":"3a902d6c-4223-4d59-a94c-fa239b35702c","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
