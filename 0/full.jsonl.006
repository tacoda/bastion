{"parentUuid":"dbbfc33a-2637-4551-884b-f72f9747362f","isSidechain":false,"promptId":"d00c8c47-529c-4df7-a0c3-28719a95a1dd","type":"user","message":{"role":"user","content":"<local-command-stdout>\u001b[2mCompacted (ctrl+o to see full summary)\u001b[22m\n\u001b[2mPreCompact [node \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact.mjs\"] completed successfully: {}\u001b[22m</local-command-stdout>"},"uuid":"8ee20a7f-9538-4bd3-9021-cd5102e0e2a5","timestamp":"2026-11-12T23:28:20.209Z","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"8ee20a7f-9538-4bd3-9021-cd5102e0e2a5","isSidechain":false,"attachment":{"type":"file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/lessons.rs","content":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/lessons.rs","content":"//! What a field note becomes (D61): a lesson (a rule file, or a hook or a\n//! permission in the settings) or a fact (a corpus entry), as files under\n//! `.agents/`. The API signs notes; the factory writes the ones signed\n//! while a journey was under way onto its branch when it lands.\n\nuse bastion_core::audit::Entry;\nuse bastion_core::corpus;\n\nuse crate::charter::{Codified, SETTINGS, with_lesson};\n\n/// The audit kind a field note is kept under.\npub const NOTE: &str = \"field-note\";\n\n/// The branch a note names while it waits for its journey to land: it is\n/// then written onto the journey's own branch.\npub const ON_LANDING: &str = \"on landing\";\n\n/// The longest a note may be: a sentence or two, not an essay.\nconst LONGEST: usize = 600;\n\n/// What a note may be: a lesson or a fact for the region, or about Bastion.\npub const ABOUT: [&str; 3] = [\"lesson\", \"fact\", \"bastion\"];\n\n/// What a person wrote and what kind of note it is, for one journey.\n#[derive(Clone, Debug, Default, PartialEq, Eq)]\npub struct Written {\n    pub about: String,\n    pub text: String,\n    pub by: String,\n    /// A lesson's shape: `rule`, `hook`, `allow`, `ask` or `deny`.\n    pub shape: String,\n    /// A hook's command, or a permission's rule.\n    pub detail: String,\n}\n\n/// A signed note as the audit keeps it: what was written, and the branch\n/// its charter change is on, or [`ON_LANDING`], or nothing.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Signed {\n    pub job: String,\n    pub at: u64,\n    pub written: Written,\n    pub branch: String,\n}\n\nimpl Written {\n    /// The note as kept: its words on one line, or why it may not be kept.\n    pub fn kept(&self) -> Result<Written, String> {\n        let text = self.text.split_whitespace().collect::<Vec<_>>().join(\" \");\n        match text.chars().count() {\n            0 => return Err(\"write what the journey taught\".into()),\n            n if n > LONGEST => {\n                return Err(format!(\"a field note is at most {LONGEST} characters\"));\n            }\n            _ => {}\n        }\n        if !ABOUT.contains(&self.about.as_str()) {\n            return Err(format!(\n                \"{:?} is not a lesson, a fact or bastion\",\n                self.about\n            ));\n        }\n        if self.codified().is_some() && self.detail.trim().is_empty() {\n            return Err(\"say the hook's command or the permission's rule\".into());\n        }\n        Ok(Written {\n            text,\n            detail: self.detail.trim().into(),\n            ..self.clone()\n        })\n    }\n\n    /// The lesson codified in the settings, when it is not a rule file.\n    pub fn codified(&self) -> Option<Codified> {\n        let detail = self.detail.trim().to_string();\n        match (self.about.as_str(), self.shape.as_str()) {\n            (\"lesson\", \"hook\") => Some(Codified::Hook(detail)),\n            (\"lesson\", kind @ (\"allow\" | \"ask\" | \"deny\")) => Some(Codified::Permission {\n                kind: kind.into(),\n                rule: detail,\n            }),\n            _ => None,\n        }\n    }\n\n    /// The audit entry's detail: `<by>\\t<about>\\t<text>\\t<branch>\\t<shape>\\t<detail>`.\n    pub fn detail_on(&self, branch: &str) -> String {\n        let w = self;\n        format!(\n            \"{}\\t{}\\t{}\\t{branch}\\t{}\\t{}\",\n            w.by, w.about, w.text, w.shape, w.detail\n        )\n    }\n}\n\n/// A note from its audit entry.\npub fn signed(e: &Entry) -> Signed {\n    let mut parts = e.record.detail.splitn(6, '\\t').map(String::from);\n    let mut next = || parts.next().unwrap_or_default();\n    let (by, about, text, branch) = (next(), next(), next(), next());\n    Signed {\n        job: e.record.subject.clone(),\n        at: e.at,\n        written: Written {\n            about,\n            text,\n            by,\n            shape: next(),\n            detail: next(),\n        },\n        branch,\n    }\n}\n\n/// The file a rule or a fact becomes: a rule file, or a corpus entry whose\n/// paths come from the journey's change and the note itself.\npub fn charter_file(w: &Written, job: &str, diff: &str) -> (String, String) {\n    let signed = format!(\n        \"{}\\n\\nLearned on journey {job}, signed by {}.\\n\",\n        w.text, w.by\n    );\n    let fact = corpus::Fact {\n        note: &w.text,\n        diff,\n    };\n    let name = fact.slug();\n    match w.about.as_str() {\n        \"lesson\" => (format!(\".agents/rules/{name}.md\"), signed),\n        _ => {\n            let paths = fact.paths().join(\", \");\n            let file = format!(\"---\\npaths: {paths}\\n---\\n{signed}\");\n            (format!(\"{}/{name}.md\", corpus::DIR), file)\n        }\n    }\n}\n\n/// What a journey and its notes need to become files.\npub struct Landing<'a> {\n    pub job: &'a str,\n    /// The journey's change, as a unified diff.\n    pub diff: &'a str,\n    /// The region's settings as they stand, if it has any.\n    pub settings: Option<String>,\n}\n\n/// The files the notes become, each a path and its text. Lessons for the\n/// settings fold into one settings file, in the order they were signed.\npub fn files(notes: &[Written], at: Landing) -> Result<Vec<(String, String)>, String> {\n    let mut settings = at.settings;\n    let mut out = Vec::new();\n    for w in notes.iter().filter(|w| w.about != \"bastion\") {\n        match w.codified() {\n            Some(lesson) => settings = Some(with_lesson(settings.as_deref(), &lesson)?),\n            None => out.push(charter_file(w, at.job, at.diff)),\n        }\n    }\n    let touched = notes.iter().any(|w| w.codified().is_some());\n    out.extend(\n        settings\n            .filter(|_| touched)\n            .map(|s| (SETTINGS.to_string(), s)),\n    );\n    Ok(out)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use bastion_core::audit::{Record, append};\n\n    fn written(about: &str, shape: &str, detail: &str) -> Written {\n        Written {\n            about: about.into(),\n            text: \"Keep calc small.\".into(),\n            by: \"Ian\".into(),\n            shape: shape.into(),\n            detail: detail.into(),\n        }\n    }\n\n    #[test]\n    fn a_note_reads_back_from_its_entry_and_keeps_only_what_it_may() {\n        let w = written(\"lesson\", \"deny\", \"Bash(rm:*)\");\n        let record = Record {\n            kind: NOTE.into(),\n            subject: \"j1\".into(),\n            detail: w.detail_on(ON_LANDING),\n        };\n        let s = signed(&append(None, 7, record, b\"k\"));\n        assert_eq!(\n            (s.job.as_str(), s.at, s.branch.as_str()),\n            (\"j1\", 7, ON_LANDING)\n        );\n        assert_eq!(s.written, w);\n        let spaced = Written {\n            text: \"  the test\\n named the bug \".into(),\n            ..written(\"fact\", \"\", \"\")\n        };\n        assert_eq!(spaced.kept().unwrap().text, \"the test named the bug\");\n        assert!(\n            written(\"lesson\", \"hook\", \" \").kept().is_err(),\n            \"a hook names its command\"\n        );\n        assert!(written(\"maybe\", \"\", \"\").kept().is_err());\n    }\n\n    #[test]\n    fn notes_become_a_rule_a_fact_and_one_settings_file() {\n        let notes = [\n            written(\"lesson\", \"rule\", \"\"),\n            written(\"fact\", \"\", \"\"),\n            written(\"lesson\", \"deny\", \"Bash(rm:*)\"),\n            written(\"lesson\", \"hook\", \"./lint.sh\"),\n            written(\"bastion\", \"\", \"\"),\n        ];\n        let at = Landing {\n            job: \"j1\",\n            diff: \"diff --git a/src/calc.py b/src/calc.py\\n\",\n            settings: Some(r#\"{\"model\":\"x\"}\"#.into()),\n        };\n        let out = files(&notes, at).unwrap();\n        let paths: Vec<&str> = out.iter().map(|(p, _)| p.as_str()).collect();\n        assert_eq!(\n            paths,\n            [\n                \".agents/rules/keep-calc-small.md\",\n                \".agents/corpus/keep-calc-small.md\",\n                SETTINGS\n            ]\n        );\n        let settings = &out[2].1;\n        assert!(\n            settings.contains(\"\\\"model\\\"\")\n                && settings.contains(\"Bash(rm:*)\")\n                && settings.contains(\"./lint.sh\")\n        );\n        assert!(out[1].1.starts_with(\"---\\npaths: src/**\\n---\\n\"));\n    }\n}\n","numLines":240,"startLine":1,"totalLines":240}},"displayPath":"crates/bastion-server/src/lessons.rs"},"type":"attachment","uuid":"44856c77-2fdb-4f00-93d8-554687c131af","timestamp":"2026-11-12T23:28:19.956Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/lessons.rs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t//! What a field note becomes (D61): a lesson (a rule file, or a hook or a\n2\t//! permission in the settings) or a fact (a corpus entry), as files under\n3\t//! `.agents/`. The API signs notes; the factory writes the ones signed\n4\t//! while a journey was under way onto its branch when it lands.\n5\t\n6\tuse bastion_core::audit::Entry;\n7\tuse bastion_core::corpus;\n8\t\n9\tuse crate::charter::{Codified, SETTINGS, with_lesson};\n10\t\n11\t/// The audit kind a field note is kept under.\n12\tpub const NOTE: &str = \"field-note\";\n13\t\n14\t/// The branch a note names while it waits for its journey to land: it is\n15\t/// then written onto the journey's own branch.\n16\tpub const ON_LANDING: &str = \"on landing\";\n17\t\n18\t/// The longest a note may be: a sentence or two, not an essay.\n19\tconst LONGEST: usize = 600;\n20\t\n21\t/// What a note may be: a lesson or a fact for the region, or about Bastion.\n22\tpub const ABOUT: [&str; 3] = [\"lesson\", \"fact\", \"bastion\"];\n23\t\n24\t/// What a person wrote and what kind of note it is, for one journey.\n25\t#[derive(Clone, Debug, Default, PartialEq, Eq)]\n26\tpub struct Written {\n27\t    pub about: String,\n28\t    pub text: String,\n29\t    pub by: String,\n30\t    /// A lesson's shape: `rule`, `hook`, `allow`, `ask` or `deny`.\n31\t    pub shape: String,\n32\t    /// A hook's command, or a permission's rule.\n33\t    pub detail: String,\n34\t}\n35\t\n36\t/// A signed note as the audit keeps it: what was written, and the branch\n37\t/// its charter change is on, or [`ON_LANDING`], or nothing.\n38\t#[derive(Clone, Debug, PartialEq, Eq)]\n39\tpub struct Signed {\n40\t    pub job: String,\n41\t    pub at: u64,\n42\t    pub written: Written,\n43\t    pub branch: String,\n44\t}\n45\t\n46\timpl Written {\n47\t    /// The note as kept: its words on one line, or why it may not be kept.\n48\t    pub fn kept(&self) -> Result<Written, String> {\n49\t        let text = self.text.split_whitespace().collect::<Vec<_>>().join(\" \");\n50\t        match text.chars().count() {\n51\t            0 => return Err(\"write what the journey taught\".into()),\n52\t            n if n > LONGEST => {\n53\t                return Err(format!(\"a field note is at most {LONGEST} characters\"));\n54\t            }\n55\t            _ => {}\n56\t        }\n57\t        if !ABOUT.contains(&self.about.as_str()) {\n58\t            return Err(format!(\n59\t                \"{:?} is not a lesson, a fact or bastion\",\n60\t                self.about\n61\t            ));\n62\t        }\n63\t        if self.codified().is_some() && self.detail.trim().is_empty() {\n64\t            return Err(\"say the hook's command or the permission's rule\".into());\n65\t        }\n66\t        Ok(Written {\n67\t            text,\n68\t            detail: self.detail.trim().into(),\n69\t            ..self.clone()\n70\t        })\n71\t    }\n72\t\n73\t    /// The lesson codified in the settings, when it is not a rule file.\n74\t    pub fn codified(&self) -> Option<Codified> {\n75\t        let detail = self.detail.trim().to_string();\n76\t        match (self.about.as_str(), self.shape.as_str()) {\n77\t            (\"lesson\", \"hook\") => Some(Codified::Hook(detail)),\n78\t            (\"lesson\", kind @ (\"allow\" | \"ask\" | \"deny\")) => Some(Codified::Permission {\n79\t                kind: kind.into(),\n80\t                rule: detail,\n81\t            }),\n82\t            _ => None,\n83\t        }\n84\t    }\n85\t\n86\t    /// The audit entry's detail: `<by>\\t<about>\\t<text>\\t<branch>\\t<shape>\\t<detail>`.\n87\t    pub fn detail_on(&self, branch: &str) -> String {\n88\t        let w = self;\n89\t        format!(\n90\t            \"{}\\t{}\\t{}\\t{branch}\\t{}\\t{}\",\n91\t            w.by, w.about, w.text, w.shape, w.detail\n92\t        )\n93\t    }\n94\t}\n95\t\n96\t/// A note from its audit entry.\n97\tpub fn signed(e: &Entry) -> Signed {\n98\t    let mut parts = e.record.detail.splitn(6, '\\t').map(String::from);\n99\t    let mut next = || parts.next().unwrap_or_default();\n100\t    let (by, about, text, branch) = (next(), next(), next(), next());\n101\t    Signed {\n102\t        job: e.record.subject.clone(),\n103\t        at: e.at,\n104\t        written: Written {\n105\t            about,\n106\t            text,\n107\t            by,\n108\t            shape: next(),\n109\t            detail: next(),\n110\t        },\n111\t        branch,\n112\t    }\n113\t}\n114\t\n115\t/// The file a rule or a fact becomes: a rule file, or a corpus entry whose\n116\t/// paths come from the journey's change and the note itself.\n117\tpub fn charter_file(w: &Written, job: &str, diff: &str) -> (String, String) {\n118\t    let signed = format!(\n119\t        \"{}\\n\\nLearned on journey {job}, signed by {}.\\n\",\n120\t        w.text, w.by\n121\t    );\n122\t    let fact = corpus::Fact {\n123\t        note: &w.text,\n124\t        diff,\n125\t    };\n126\t    let name = fact.slug();\n127\t    match w.about.as_str() {\n128\t        \"lesson\" => (format!(\".agents/rules/{name}.md\"), signed),\n129\t        _ => {\n130\t            let paths = fact.paths().join(\", \");\n131\t            let file = format!(\"---\\npaths: {paths}\\n---\\n{signed}\");\n132\t            (format!(\"{}/{name}.md\", corpus::DIR), file)\n133\t        }\n134\t    }\n135\t}\n136\t\n137\t/// What a journey and its notes need to become files.\n138\tpub struct Landing<'a> {\n139\t    pub job: &'a str,\n140\t    /// The journey's change, as a unified diff.\n141\t    pub diff: &'a str,\n142\t    /// The region's settings as they stand, if it has any.\n143\t    pub settings: Option<String>,\n144\t}\n145\t\n146\t/// The files the notes become, each a path and its text. Lessons for the\n147\t/// settings fold into one settings file, in the order they were signed.\n148\tpub fn files(notes: &[Written], at: Landing) -> Result<Vec<(String, String)>, String> {\n149\t    let mut settings = at.settings;\n150\t    let mut out = Vec::new();\n151\t    for w in notes.iter().filter(|w| w.about != \"bastion\") {\n152\t        match w.codified() {\n153\t            Some(lesson) => settings = Some(with_lesson(settings.as_deref(), &lesson)?),\n154\t            None => out.push(charter_file(w, at.job, at.diff)),\n155\t        }\n156\t    }\n157\t    let touched = notes.iter().any(|w| w.codified().is_some());\n158\t    out.extend(\n159\t        settings\n160\t            .filter(|_| touched)\n161\t            .map(|s| (SETTINGS.to_string(), s)),\n162\t    );\n163\t    Ok(out)\n164\t}\n165\t\n166\t#[cfg(test)]\n167\tmod tests {\n168\t    use super::*;\n169\t    use bastion_core::audit::{Record, append};\n170\t\n171\t    fn written(about: &str, shape: &str, detail: &str) -> Written {\n172\t        Written {\n173\t            about: about.into(),\n174\t            text: \"Keep calc small.\".into(),\n175\t            by: \"Ian\".into(),\n176\t            shape: shape.into(),\n177\t            detail: detail.into(),\n178\t        }\n179\t    }\n180\t\n181\t    #[test]\n182\t    fn a_note_reads_back_from_its_entry_and_keeps_only_what_it_may() {\n183\t        let w = written(\"lesson\", \"deny\", \"Bash(rm:*)\");\n184\t        let record = Record {\n185\t            kind: NOTE.into(),\n186\t            subject: \"j1\".into(),\n187\t            detail: w.detail_on(ON_LANDING),\n188\t        };\n189\t        let s = signed(&append(None, 7, record, b\"k\"));\n190\t        assert_eq!(\n191\t            (s.job.as_str(), s.at, s.branch.as_str()),\n192\t            (\"j1\", 7, ON_LANDING)\n193\t        );\n194\t        assert_eq!(s.written, w);\n195\t        let spaced = Written {\n196\t            text: \"  the test\\n named the bug \".into(),\n197\t            ..written(\"fact\", \"\", \"\")\n198\t        };\n199\t        assert_eq!(spaced.kept().unwrap().text, \"the test named the bug\");\n200\t        assert!(\n201\t            written(\"lesson\", \"hook\", \" \").kept().is_err(),\n202\t            \"a hook names its command\"\n203\t        );\n204\t        assert!(written(\"maybe\", \"\", \"\").kept().is_err());\n205\t    }\n206\t\n207\t    #[test]\n208\t    fn notes_become_a_rule_a_fact_and_one_settings_file() {\n209\t        let notes = [\n210\t            written(\"lesson\", \"rule\", \"\"),\n211\t            written(\"fact\", \"\", \"\"),\n212\t            written(\"lesson\", \"deny\", \"Bash(rm:*)\"),\n213\t            written(\"lesson\", \"hook\", \"./lint.sh\"),\n214\t            written(\"bastion\", \"\", \"\"),\n215\t        ];\n216\t        let at = Landing {\n217\t            job: \"j1\",\n218\t            diff: \"diff --git a/src/calc.py b/src/calc.py\\n\",\n219\t            settings: Some(r#\"{\"model\":\"x\"}\"#.into()),\n220\t        };\n221\t        let out = files(&notes, at).unwrap();\n222\t        let paths: Vec<&str> = out.iter().map(|(p, _)| p.as_str()).collect();\n223\t        assert_eq!(\n224\t            paths,\n225\t            [\n226\t                \".agents/rules/keep-calc-small.md\",\n227\t                \".agents/corpus/keep-calc-small.md\",\n228\t                SETTINGS\n229\t            ]\n230\t        );\n231\t        let settings = &out[2].1;\n232\t        assert!(\n233\t            settings.contains(\"\\\"model\\\"\")\n234\t                && settings.contains(\"Bash(rm:*)\")\n235\t                && settings.contains(\"./lint.sh\")\n236\t        );\n237\t        assert!(out[1].1.starts_with(\"---\\npaths: src/**\\n---\\n\"));\n238\t    }\n239\t}\n240\t\n</system-reminder>"}],"renderedRole":"system","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"44856c77-2fdb-4f00-93d8-554687c131af","isSidechain":false,"attachment":{"type":"file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/notes.rs","content":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/notes.rs","content":"//! Field notes (D61): what a journey taught, one sentence signed by the\n//! person who wrote it. A lesson or a fact about the region becomes a\n//! charter change under `.agents/`: signed while the journey is under way,\n//! it is written onto the journey's own branch when it lands; signed after\n//! it came home, it goes on a branch of its own. A note about Bastion\n//! stays here, for the learning loop on the Guide. Every note is also an\n//! audit entry, so the chain signs it.\n\nuse std::sync::Arc;\n\nuse bastion_core::State;\nuse bastion_core::audit::Record;\nuse bastion_protocol::{CharterChange, FieldNoteView};\n\nuse super::factory::{FactoryCell, factory};\nuse crate::charter::SETTINGS;\nuse crate::lessons::{self, Landing, NOTE, ON_LANDING, Written};\nuse crate::machine::Machine;\n\nfn view(e: &bastion_core::audit::Entry) -> FieldNoteView {\n    let s = lessons::signed(e);\n    FieldNoteView {\n        job: s.job,\n        by: s.written.by,\n        about: s.written.about,\n        text: s.written.text,\n        branch: s.branch,\n        at: s.at,\n        ..FieldNoteView::default()\n    }\n}\n\n/// Whether a journey has come home: at the summit or in the marsh.\nfn home(state: State) -> bool {\n    matches!(state, State::Landed | State::Failed | State::Stopped)\n}\n\n/// A note on a journey already home, committed on a branch of its own:\n/// its file, read against the region's base branch.\nasync fn on_its_own(\n    cell: &FactoryCell,\n    machine: &dyn Machine,\n    id: &str,\n    w: &Written,\n) -> Result<String, String> {\n    let factory = factory(cell)?;\n    let record = factory.store().load(id).await?;\n    let all = factory.store().workspaces().await?;\n    let ws = all.iter().find(|ws| ws.name == record.job.workspace);\n    let ws = ws.ok_or_else(|| format!(\"no region named {}\", record.job.workspace))?;\n    let artifacts = factory.store().artifacts(id).await?;\n    let change = artifacts\n        .iter()\n        .rev()\n        .find(|a| a.body.starts_with(\"diff --git\"));\n    let at = format!(\"{}:{SETTINGS}\", ws.branch);\n    let shown = machine.run(\"git\", &[\"show\", &at], Some(std::path::Path::new(&ws.path)))?;\n    let landing = Landing {\n        job: id,\n        diff: change.map_or(\"\", |a| a.body.as_str()),\n        settings: shown.success.then_some(shown.text),\n    };\n    let files = lessons::files(std::slice::from_ref(w), landing)?;\n    let (path, text) = files.into_iter().next().ok_or(\"the note makes no file\")?;\n    let change = CharterChange {\n        workspace: record.job.workspace,\n        path,\n        text,\n    };\n    super::charters::edit(cell, machine, change).await\n}\n\n/// Sign a field note on journey `id`.\npub async fn note(\n    cell: &FactoryCell,\n    machine: Arc<dyn Machine>,\n    id: String,\n    w: Written,\n) -> Result<(), String> {\n    let factory = factory(cell)?;\n    let w = w.kept()?;\n    let record = factory.store().load(&id).await?;\n    let branch = match (w.about.as_str(), home(record.job.state)) {\n        (\"bastion\", _) => String::new(),\n        (_, false) => ON_LANDING.into(),\n        (_, true) => on_its_own(cell, machine.as_ref(), &id, &w).await?,\n    };\n    factory.gate().audit()?.note(Record {\n        kind: NOTE.into(),\n        subject: id,\n        detail: w.detail_on(&branch),\n    });\n    Ok(())\n}\n\n/// The notes on job `id`, oldest first.\npub async fn notes_of(cell: &FactoryCell, id: &str) -> Result<Vec<FieldNoteView>, String> {\n    let entries = factory(cell)?.store().entries_of(NOTE).await?;\n    Ok(entries\n        .iter()\n        .filter(|e| e.record.subject == id)\n        .map(view)\n        .collect())\n}\n\n/// Every note on the server, newest first, each with its job's request.\npub async fn atlas(cell: &FactoryCell) -> Result<Vec<FieldNoteView>, String> {\n    let factory = factory(cell)?;\n    let mut notes: Vec<FieldNoteView> = factory\n        .store()\n        .entries_of(NOTE)\n        .await?\n        .iter()\n        .map(view)\n        .collect();\n    for n in &mut notes {\n        if let Ok(r) = factory.store().load(&n.job).await {\n            n.request = r.job.request;\n            n.workspace = r.job.workspace;\n            n.landed = r.job.state == State::Landed;\n            n.workflow = r.runtime.workflow.unwrap_or_default();\n        }\n    }\n    notes.sort_by_key(|n| std::cmp::Reverse(n.at));\n    Ok(notes)\n}\n","numLines":127,"startLine":1,"totalLines":127}},"displayPath":"crates/bastion-server/src/api/notes.rs"},"type":"attachment","uuid":"91953ba6-3345-436c-aa99-9a0239b885e4","timestamp":"2026-11-12T23:28:19.956Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/notes.rs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t//! Field notes (D61): what a journey taught, one sentence signed by the\n2\t//! person who wrote it. A lesson or a fact about the region becomes a\n3\t//! charter change under `.agents/`: signed while the journey is under way,\n4\t//! it is written onto the journey's own branch when it lands; signed after\n5\t//! it came home, it goes on a branch of its own. A note about Bastion\n6\t//! stays here, for the learning loop on the Guide. Every note is also an\n7\t//! audit entry, so the chain signs it.\n8\t\n9\tuse std::sync::Arc;\n10\t\n11\tuse bastion_core::State;\n12\tuse bastion_core::audit::Record;\n13\tuse bastion_protocol::{CharterChange, FieldNoteView};\n14\t\n15\tuse super::factory::{FactoryCell, factory};\n16\tuse crate::charter::SETTINGS;\n17\tuse crate::lessons::{self, Landing, NOTE, ON_LANDING, Written};\n18\tuse crate::machine::Machine;\n19\t\n20\tfn view(e: &bastion_core::audit::Entry) -> FieldNoteView {\n21\t    let s = lessons::signed(e);\n22\t    FieldNoteView {\n23\t        job: s.job,\n24\t        by: s.written.by,\n25\t        about: s.written.about,\n26\t        text: s.written.text,\n27\t        branch: s.branch,\n28\t        at: s.at,\n29\t        ..FieldNoteView::default()\n30\t    }\n31\t}\n32\t\n33\t/// Whether a journey has come home: at the summit or in the marsh.\n34\tfn home(state: State) -> bool {\n35\t    matches!(state, State::Landed | State::Failed | State::Stopped)\n36\t}\n37\t\n38\t/// A note on a journey already home, committed on a branch of its own:\n39\t/// its file, read against the region's base branch.\n40\tasync fn on_its_own(\n41\t    cell: &FactoryCell,\n42\t    machine: &dyn Machine,\n43\t    id: &str,\n44\t    w: &Written,\n45\t) -> Result<String, String> {\n46\t    let factory = factory(cell)?;\n47\t    let record = factory.store().load(id).await?;\n48\t    let all = factory.store().workspaces().await?;\n49\t    let ws = all.iter().find(|ws| ws.name == record.job.workspace);\n50\t    let ws = ws.ok_or_else(|| format!(\"no region named {}\", record.job.workspace))?;\n51\t    let artifacts = factory.store().artifacts(id).await?;\n52\t    let change = artifacts\n53\t        .iter()\n54\t        .rev()\n55\t        .find(|a| a.body.starts_with(\"diff --git\"));\n56\t    let at = format!(\"{}:{SETTINGS}\", ws.branch);\n57\t    let shown = machine.run(\"git\", &[\"show\", &at], Some(std::path::Path::new(&ws.path)))?;\n58\t    let landing = Landing {\n59\t        job: id,\n60\t        diff: change.map_or(\"\", |a| a.body.as_str()),\n61\t        settings: shown.success.then_some(shown.text),\n62\t    };\n63\t    let files = lessons::files(std::slice::from_ref(w), landing)?;\n64\t    let (path, text) = files.into_iter().next().ok_or(\"the note makes no file\")?;\n65\t    let change = CharterChange {\n66\t        workspace: record.job.workspace,\n67\t        path,\n68\t        text,\n69\t    };\n70\t    super::charters::edit(cell, machine, change).await\n71\t}\n72\t\n73\t/// Sign a field note on journey `id`.\n74\tpub async fn note(\n75\t    cell: &FactoryCell,\n76\t    machine: Arc<dyn Machine>,\n77\t    id: String,\n78\t    w: Written,\n79\t) -> Result<(), String> {\n80\t    let factory = factory(cell)?;\n81\t    let w = w.kept()?;\n82\t    let record = factory.store().load(&id).await?;\n83\t    let branch = match (w.about.as_str(), home(record.job.state)) {\n84\t        (\"bastion\", _) => String::new(),\n85\t        (_, false) => ON_LANDING.into(),\n86\t        (_, true) => on_its_own(cell, machine.as_ref(), &id, &w).await?,\n87\t    };\n88\t    factory.gate().audit()?.note(Record {\n89\t        kind: NOTE.into(),\n90\t        subject: id,\n91\t        detail: w.detail_on(&branch),\n92\t    });\n93\t    Ok(())\n94\t}\n95\t\n96\t/// The notes on job `id`, oldest first.\n97\tpub async fn notes_of(cell: &FactoryCell, id: &str) -> Result<Vec<FieldNoteView>, String> {\n98\t    let entries = factory(cell)?.store().entries_of(NOTE).await?;\n99\t    Ok(entries\n100\t        .iter()\n101\t        .filter(|e| e.record.subject == id)\n102\t        .map(view)\n103\t        .collect())\n104\t}\n105\t\n106\t/// Every note on the server, newest first, each with its job's request.\n107\tpub async fn atlas(cell: &FactoryCell) -> Result<Vec<FieldNoteView>, String> {\n108\t    let factory = factory(cell)?;\n109\t    let mut notes: Vec<FieldNoteView> = factory\n110\t        .store()\n111\t        .entries_of(NOTE)\n112\t        .await?\n113\t        .iter()\n114\t        .map(view)\n115\t        .collect();\n116\t    for n in &mut notes {\n117\t        if let Ok(r) = factory.store().load(&n.job).await {\n118\t            n.request = r.job.request;\n119\t            n.workspace = r.job.workspace;\n120\t            n.landed = r.job.state == State::Landed;\n121\t            n.workflow = r.runtime.workflow.unwrap_or_default();\n122\t        }\n123\t    }\n124\t    notes.sort_by_key(|n| std::cmp::Reverse(n.at));\n125\t    Ok(notes)\n126\t}\n127\t\n</system-reminder>"}],"renderedRole":"system","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"91953ba6-3345-436c-aa99-9a0239b885e4","isSidechain":false,"attachment":{"type":"file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/wear.rs","content":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/wear.rs","content":"//! A trail's wear on the Map: how many journeys took it, how many reached\n//! the summit and how many the marsh, and at each waypoint how many wait\n//! there and how many ended there.\n\nuse bastion_protocol::JobSummary;\n\n/// A trail's journeys, as the Map counts them.\n#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\npub struct Worn {\n    pub journeys: usize,\n    pub summit: usize,\n    pub marsh: usize,\n}\n\nfn lost(state: &str) -> bool {\n    matches!(state, \"failed\" | \"stopped\")\n}\n\n/// The wear on trail `workflow`.\npub fn trail(journeys: &[JobSummary], workflow: &str) -> Worn {\n    let mine = journeys\n        .iter()\n        .filter(|j| j.workflow.as_deref() == Some(workflow));\n    mine.fold(Worn::default(), |w, j| Worn {\n        journeys: w.journeys + 1,\n        summit: w.summit + usize::from(j.state == \"landed\"),\n        marsh: w.marsh + usize::from(lost(&j.state)),\n    })\n}\n\n/// At waypoint `key`, `workflow/step`: the journeys waiting there for a\n/// person, and the journeys that ended there in the marsh.\npub fn waypoint(journeys: &[JobSummary], key: &str) -> (usize, usize) {\n    let Some((workflow, step)) = key.split_once('/') else {\n        return (0, 0);\n    };\n    let here = journeys\n        .iter()\n        .filter(|j| j.workflow.as_deref() == Some(workflow) && j.node.as_deref() == Some(step));\n    here.fold((0, 0), |(waiting, ended), j| {\n        (\n            waiting + usize::from(j.state == \"needs_you\"),\n            ended + usize::from(lost(&j.state)),\n        )\n    })\n}\n\n/// The line under a trail's name.\npub fn line(w: Worn) -> String {\n    match w.journeys {\n        0 => \"no journeys yet\".into(),\n        1 => format!(\n            \"1 journey · {} at the summit · {} in the marsh\",\n            w.summit, w.marsh\n        ),\n        n => format!(\n            \"{n} journeys · {} at the summit · {} in the marsh\",\n            w.summit, w.marsh\n        ),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn journey(state: &str, at: Option<&str>) -> JobSummary {\n        JobSummary {\n            state: state.into(),\n            node: at.map(String::from),\n            workflow: Some(\"bug-fix\".into()),\n            ..JobSummary::default()\n        }\n    }\n\n    #[test]\n    fn a_trail_counts_its_journeys_and_where_they_wait_or_end() {\n        let all = [\n            journey(\"landed\", None),\n            journey(\"failed\", Some(\"build\")),\n            journey(\"needs_you\", Some(\"plan\")),\n            JobSummary {\n                workflow: Some(\"short\".into()),\n                ..journey(\"landed\", None)\n            },\n        ];\n        let worn = trail(&all, \"bug-fix\");\n        assert_eq!(\n            worn,\n            Worn {\n                journeys: 3,\n                summit: 1,\n                marsh: 1\n            }\n        );\n        assert_eq!(waypoint(&all, \"bug-fix/plan\"), (1, 0));\n        assert_eq!(waypoint(&all, \"bug-fix/build\"), (0, 1));\n        assert_eq!(waypoint(&all, \"short/plan\"), (0, 0));\n        assert_eq!(line(worn), \"3 journeys · 1 at the summit · 1 in the marsh\");\n        assert_eq!(line(Worn::default()), \"no journeys yet\");\n    }\n}\n","numLines":103,"startLine":1,"totalLines":103}},"displayPath":"crates/bastion-desktop/src/pages/wear.rs"},"type":"attachment","uuid":"f31abead-af67-49b7-bada-821abdfd59af","timestamp":"2026-11-12T23:28:19.956Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/wear.rs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t//! A trail's wear on the Map: how many journeys took it, how many reached\n2\t//! the summit and how many the marsh, and at each waypoint how many wait\n3\t//! there and how many ended there.\n4\t\n5\tuse bastion_protocol::JobSummary;\n6\t\n7\t/// A trail's journeys, as the Map counts them.\n8\t#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]\n9\tpub struct Worn {\n10\t    pub journeys: usize,\n11\t    pub summit: usize,\n12\t    pub marsh: usize,\n13\t}\n14\t\n15\tfn lost(state: &str) -> bool {\n16\t    matches!(state, \"failed\" | \"stopped\")\n17\t}\n18\t\n19\t/// The wear on trail `workflow`.\n20\tpub fn trail(journeys: &[JobSummary], workflow: &str) -> Worn {\n21\t    let mine = journeys\n22\t        .iter()\n23\t        .filter(|j| j.workflow.as_deref() == Some(workflow));\n24\t    mine.fold(Worn::default(), |w, j| Worn {\n25\t        journeys: w.journeys + 1,\n26\t        summit: w.summit + usize::from(j.state == \"landed\"),\n27\t        marsh: w.marsh + usize::from(lost(&j.state)),\n28\t    })\n29\t}\n30\t\n31\t/// At waypoint `key`, `workflow/step`: the journeys waiting there for a\n32\t/// person, and the journeys that ended there in the marsh.\n33\tpub fn waypoint(journeys: &[JobSummary], key: &str) -> (usize, usize) {\n34\t    let Some((workflow, step)) = key.split_once('/') else {\n35\t        return (0, 0);\n36\t    };\n37\t    let here = journeys\n38\t        .iter()\n39\t        .filter(|j| j.workflow.as_deref() == Some(workflow) && j.node.as_deref() == Some(step));\n40\t    here.fold((0, 0), |(waiting, ended), j| {\n41\t        (\n42\t            waiting + usize::from(j.state == \"needs_you\"),\n43\t            ended + usize::from(lost(&j.state)),\n44\t        )\n45\t    })\n46\t}\n47\t\n48\t/// The line under a trail's name.\n49\tpub fn line(w: Worn) -> String {\n50\t    match w.journeys {\n51\t        0 => \"no journeys yet\".into(),\n52\t        1 => format!(\n53\t            \"1 journey · {} at the summit · {} in the marsh\",\n54\t            w.summit, w.marsh\n55\t        ),\n56\t        n => format!(\n57\t            \"{n} journeys · {} at the summit · {} in the marsh\",\n58\t            w.summit, w.marsh\n59\t        ),\n60\t    }\n61\t}\n62\t\n63\t#[cfg(test)]\n64\tmod tests {\n65\t    use super::*;\n66\t\n67\t    fn journey(state: &str, at: Option<&str>) -> JobSummary {\n68\t        JobSummary {\n69\t            state: state.into(),\n70\t            node: at.map(String::from),\n71\t            workflow: Some(\"bug-fix\".into()),\n72\t            ..JobSummary::default()\n73\t        }\n74\t    }\n75\t\n76\t    #[test]\n77\t    fn a_trail_counts_its_journeys_and_where_they_wait_or_end() {\n78\t        let all = [\n79\t            journey(\"landed\", None),\n80\t            journey(\"failed\", Some(\"build\")),\n81\t            journey(\"needs_you\", Some(\"plan\")),\n82\t            JobSummary {\n83\t                workflow: Some(\"short\".into()),\n84\t                ..journey(\"landed\", None)\n85\t            },\n86\t        ];\n87\t        let worn = trail(&all, \"bug-fix\");\n88\t        assert_eq!(\n89\t            worn,\n90\t            Worn {\n91\t                journeys: 3,\n92\t                summit: 1,\n93\t                marsh: 1\n94\t            }\n95\t        );\n96\t        assert_eq!(waypoint(&all, \"bug-fix/plan\"), (1, 0));\n97\t        assert_eq!(waypoint(&all, \"bug-fix/build\"), (0, 1));\n98\t        assert_eq!(waypoint(&all, \"short/plan\"), (0, 0));\n99\t        assert_eq!(line(worn), \"3 journeys · 1 at the summit · 1 in the marsh\");\n100\t        assert_eq!(line(Worn::default()), \"no journeys yet\");\n101\t    }\n102\t}\n103\t\n</system-reminder>"}],"renderedRole":"system","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
{"parentUuid":"f31abead-af67-49b7-bada-821abdfd59af","isSidechain":false,"attachment":{"type":"file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/corpus.rs","content":{"type":"text","file":{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/corpus.rs","content":"//! A region's corpus (D61): the why behind its code (why it is shaped this\n//! way, what surprised someone, which scenario it serves), each in\n//! `.agents/corpus/<name>.md`. A lesson says what to do; the corpus says\n//! why. An entry opens with the paths it is relevant to, and an agent is\n//! given it only when it opens one of them.\n//!\n//! ```text\n//! ---\n//! paths: src/billing/**, docs/billing.md\n//! ---\n//! Invoices round half to even: the ledger reconciles to the bank's.\n//! ```\n\n/// Where a repository keeps its corpus.\npub const DIR: &str = \".agents/corpus\";\n\n/// A path glob, split into its parts: `*` takes any characters but `/`,\n/// `**` any number of whole parts.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Glob(Vec<String>);\n\n/// A path in the repository, split into its parts. The sandbox mounts the\n/// repository at `/work/repo`, so that prefix is dropped.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct RepoPath(Vec<String>);\n\nimpl Glob {\n    pub fn new(text: &str) -> Glob {\n        Glob(RepoPath::new(text).0)\n    }\n\n    pub fn matches(&self, path: &RepoPath) -> bool {\n        parts(&self.0, &path.0)\n    }\n}\n\nimpl RepoPath {\n    pub fn new(text: &str) -> RepoPath {\n        let text = text.strip_prefix(\"/work/repo/\").unwrap_or(text);\n        let text = text.trim_start_matches(\"./\");\n        RepoPath(text.split('/').map(String::from).collect())\n    }\n}\n\nfn parts(glob: &[String], path: &[String]) -> bool {\n    match (glob.first().map(String::as_str), path.first()) {\n        (None, None) => true,\n        (Some(\"**\"), _) => parts(&glob[1..], path) || (!path.is_empty() && parts(glob, &path[1..])),\n        (Some(g), Some(p)) => part(g.as_bytes(), p.as_bytes()) && parts(&glob[1..], &path[1..]),\n        _ => false,\n    }\n}\n\n/// Whether one part of a path matches one part of a glob, `*` within it,\n/// compared byte by byte.\nfn part(glob: &[u8], name: &[u8]) -> bool {\n    let Some(star) = glob.iter().position(|b| *b == b'*') else {\n        return glob == name;\n    };\n    let (head, tail) = (&glob[..star], &glob[star + 1..]);\n    let Some(rest) = name.strip_prefix(head) else {\n        return false;\n    };\n    (0..=rest.len()).any(|i| part(tail, &rest[i..]))\n}\n\n/// A corpus file: its name in `.agents/corpus/` and its text.\npub struct File<'a> {\n    pub name: &'a str,\n    pub text: &'a str,\n}\n\n/// One corpus entry: its name, the globs it is relevant to, and its why.\n#[derive(Clone, Debug, PartialEq, Eq)]\npub struct Entry {\n    pub name: String,\n    pub paths: Vec<Glob>,\n    pub text: String,\n}\n\nimpl Entry {\n    /// Whether the entry is relevant to `path`.\n    pub fn covers(&self, path: &RepoPath) -> bool {\n        self.paths.iter().any(|g| g.matches(path))\n    }\n}\n\n/// An entry from its file. An entry with no `paths:` line is relevant\n/// nowhere, so it is never given.\npub fn parse(file: File) -> Entry {\n    let (head, text) = front_matter(&file);\n    let line = head.lines().find_map(|l| l.trim().strip_prefix(\"paths:\"));\n    let globs = line.into_iter().flat_map(|list| list.split(','));\n    let globs = globs.map(|g| g.trim().trim_matches(['\"', '\\'']));\n    Entry {\n        name: file.name.trim_end_matches(\".md\").into(),\n        paths: globs.filter(|g| !g.is_empty()).map(Glob::new).collect(),\n        text: text.trim().into(),\n    }\n}\n\n/// The front matter between two `---` lines at the top, and the rest.\nfn front_matter<'a>(file: &File<'a>) -> (&'a str, &'a str) {\n    let Some(rest) = file.text.trim_start().strip_prefix(\"---\") else {\n        return (\"\", file.text);\n    };\n    match rest.split_once(\"\\n---\") {\n        Some((head, body)) => (head, body.trim_start_matches('-')),\n        None => (\"\", file.text),\n    }\n}\n\n/// The entries relevant to `path` that `given` does not hold yet.\npub fn relevant<'a>(entries: &'a [Entry], path: &RepoPath, given: &[String]) -> Vec<&'a Entry> {\n    let fresh = entries.iter().filter(|e| !given.contains(&e.name));\n    fresh.filter(|e| e.covers(path)).collect()\n}\n\n/// The entries as an agent is given them, ahead of what its call returned.\npub fn told(entries: &[&Entry]) -> String {\n    let each = entries\n        .iter()\n        .map(|e| format!(\"<corpus name=\\\"{}\\\">\\n{}\\n</corpus>\", e.name, e.text));\n    each.collect::<Vec<_>>().join(\"\\n\")\n}\n\n/// What a person learned on a journey, and the change the journey made:\n/// enough to place it in the corpus without anyone typing paths.\npub struct Fact<'a> {\n    pub note: &'a str,\n    /// The journey's change, as a unified diff; empty when it has none.\n    pub diff: &'a str,\n}\n\nimpl Fact<'_> {\n    /// The files the change touches, by their `b/` side.\n    pub fn changed(&self) -> Vec<String> {\n        let heads = self\n            .diff\n            .lines()\n            .filter_map(|l| l.strip_prefix(\"diff --git \"));\n        let sides = heads.filter_map(|h| h.split(\" b/\").nth(1));\n        sides.map(String::from).collect()\n    }\n\n    /// The globs the fact is relevant to: each path the note names, then\n    /// the folder of each file the journey changed. With neither, it is\n    /// relevant everywhere.\n    pub fn paths(&self) -> Vec<String> {\n        let trim: &[char] = &['`', '\"', '\\'', '(', ')', ',', ';', ':'];\n        let words = self.note.split_whitespace().map(|w| w.trim_matches(trim));\n        let path_like = |w: &&str| {\n            let ext = w.rsplit_once('.');\n            let ext = ext.is_some_and(|(stem, e)| !stem.is_empty() && (1..=5).contains(&e.len()));\n            w.contains('/') || ext\n        };\n        let named = words.map(|w| w.trim_end_matches('.')).filter(path_like);\n        let folders = self\n            .changed()\n            .into_iter()\n            .map(|f| match f.rsplit_once('/') {\n                Some((dir, _)) => format!(\"{dir}/**\"),\n                None => f,\n            });\n        let mut all: Vec<String> = Vec::new();\n        for glob in named.map(String::from).chain(folders) {\n            if !all.contains(&glob) {\n                all.push(glob);\n            }\n        }\n        match all.is_empty() {\n            true => vec![\"**\".into()],\n            false => all,\n        }\n    }\n\n    /// A file name from the note's first words: lower case, hyphenated.\n    pub fn slug(&self) -> String {\n        let words = self.note.split_whitespace().take(6).map(|w| {\n            let kept = w.chars().filter(|c| c.is_ascii_alphanumeric());\n            kept.collect::<String>().to_ascii_lowercase()\n        });\n        let words: Vec<String> = words.filter(|w| !w.is_empty()).collect();\n        match words.is_empty() {\n            true => \"note\".into(),\n            false => words.join(\"-\"),\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn hits(case: (&str, &str)) -> bool {\n        Glob::new(case.0).matches(&RepoPath::new(case.1))\n    }\n\n    #[test]\n    fn globs_match_whole_parts_and_stars_within_one() {\n        assert!(hits((\"src/billing/**\", \"src/billing/invoice.rs\")));\n        assert!(hits((\n            \"src/billing/**\",\n            \"/work/repo/src/billing/tax/vat.rs\"\n        )));\n        assert!(hits((\"src/**/mod.rs\", \"src/a/b/mod.rs\")));\n        assert!(hits((\"src/*.rs\", \"src/main.rs\")));\n        assert!(hits((\"docs/billing.md\", \"./docs/billing.md\")));\n        assert!(!hits((\"src/*.rs\", \"src/a/main.rs\")), \"* stays in one part\");\n        assert!(!hits((\"src/billing/**\", \"src/billingx/a.rs\")));\n        assert!(!hits((\"docs/billing.md\", \"docs/billing.mdx\")));\n    }\n\n    #[test]\n    fn an_entry_reads_its_paths_and_is_given_once_where_it_is_relevant() {\n        let text =\n            \"---\\npaths: src/billing/**, \\\"docs/billing.md\\\"\\n---\\nInvoices round half to even.\\n\";\n        let e = parse(File {\n            name: \"rounding.md\",\n            text,\n        });\n        assert_eq!(e.name, \"rounding\");\n        assert_eq!(\n            e.paths,\n            [Glob::new(\"src/billing/**\"), Glob::new(\"docs/billing.md\")]\n        );\n        assert_eq!(e.text, \"Invoices round half to even.\");\n        let all = [e];\n        let billing = RepoPath::new(\"/work/repo/src/billing/a.rs\");\n        let hit = relevant(&all, &billing, &[]);\n        assert_eq!(hit.len(), 1);\n        assert!(relevant(&all, &RepoPath::new(\"src/main.rs\"), &[]).is_empty());\n        assert!(relevant(&all, &billing, &[\"rounding\".into()]).is_empty());\n        assert!(told(&hit).contains(\"<corpus name=\\\"rounding\\\">\"));\n        let loose = File {\n            name: \"loose.md\",\n            text: \"No front matter.\",\n        };\n        assert!(parse(loose).paths.is_empty());\n    }\n\n    #[test]\n    fn a_fact_knows_its_paths_from_the_change_and_the_note() {\n        let diff = \"diff --git a/src/billing/a.rs b/src/billing/a.rs\\n+x\\ndiff --git a/README.md b/README.md\\n\";\n        let fact = Fact {\n            note: \"Rounding lives in `src/ledger/round.rs`, not in billing.\",\n            diff,\n        };\n        assert_eq!(fact.changed(), [\"src/billing/a.rs\", \"README.md\"]);\n        assert_eq!(\n            fact.paths(),\n            [\"src/ledger/round.rs\", \"src/billing/**\", \"README.md\"]\n        );\n        let loose = Fact {\n            note: \"Invoices round half-to-even, always!\",\n            diff: \"\",\n        };\n        assert_eq!(loose.paths(), [\"**\"], \"everywhere\");\n        assert_eq!(loose.slug(), \"invoices-round-halftoeven-always\");\n    }\n}\n","numLines":262,"startLine":1,"totalLines":262}},"displayPath":"crates/bastion-core/src/corpus.rs"},"type":"attachment","uuid":"164a98ab-bd35-4375-bd6b-3faf1785875e","timestamp":"2026-11-12T23:28:19.957Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Users/tacoda/tacoda/bastion/crates/bastion-core/src/corpus.rs\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\t//! A region's corpus (D61): the why behind its code (why it is shaped this\n2\t//! way, what surprised someone, which scenario it serves), each in\n3\t//! `.agents/corpus/<name>.md`. A lesson says what to do; the corpus says\n4\t//! why. An entry opens with the paths it is relevant to, and an agent is\n5\t//! given it only when it opens one of them.\n6\t//!\n7\t//! ```text\n8\t//! ---\n9\t//! paths: src/billing/**, docs/billing.md\n10\t//! ---\n11\t//! Invoices round half to even: the ledger reconciles to the bank's.\n12\t//! ```\n13\t\n14\t/// Where a repository keeps its corpus.\n15\tpub const DIR: &str = \".agents/corpus\";\n16\t\n17\t/// A path glob, split into its parts: `*` takes any characters but `/`,\n18\t/// `**` any number of whole parts.\n19\t#[derive(Clone, Debug, PartialEq, Eq)]\n20\tpub struct Glob(Vec<String>);\n21\t\n22\t/// A path in the repository, split into its parts. The sandbox mounts the\n23\t/// repository at `/work/repo`, so that prefix is dropped.\n24\t#[derive(Clone, Debug, PartialEq, Eq)]\n25\tpub struct RepoPath(Vec<String>);\n26\t\n27\timpl Glob {\n28\t    pub fn new(text: &str) -> Glob {\n29\t        Glob(RepoPath::new(text).0)\n30\t    }\n31\t\n32\t    pub fn matches(&self, path: &RepoPath) -> bool {\n33\t        parts(&self.0, &path.0)\n34\t    }\n35\t}\n36\t\n37\timpl RepoPath {\n38\t    pub fn new(text: &str) -> RepoPath {\n39\t        let text = text.strip_prefix(\"/work/repo/\").unwrap_or(text);\n40\t        let text = text.trim_start_matches(\"./\");\n41\t        RepoPath(text.split('/').map(String::from).collect())\n42\t    }\n43\t}\n44\t\n45\tfn parts(glob: &[String], path: &[String]) -> bool {\n46\t    match (glob.first().map(String::as_str), path.first()) {\n47\t        (None, None) => true,\n48\t        (Some(\"**\"), _) => parts(&glob[1..], path) || (!path.is_empty() && parts(glob, &path[1..])),\n49\t        (Some(g), Some(p)) => part(g.as_bytes(), p.as_bytes()) && parts(&glob[1..], &path[1..]),\n50\t        _ => false,\n51\t    }\n52\t}\n53\t\n54\t/// Whether one part of a path matches one part of a glob, `*` within it,\n55\t/// compared byte by byte.\n56\tfn part(glob: &[u8], name: &[u8]) -> bool {\n57\t    let Some(star) = glob.iter().position(|b| *b == b'*') else {\n58\t        return glob == name;\n59\t    };\n60\t    let (head, tail) = (&glob[..star], &glob[star + 1..]);\n61\t    let Some(rest) = name.strip_prefix(head) else {\n62\t        return false;\n63\t    };\n64\t    (0..=rest.len()).any(|i| part(tail, &rest[i..]))\n65\t}\n66\t\n67\t/// A corpus file: its name in `.agents/corpus/` and its text.\n68\tpub struct File<'a> {\n69\t    pub name: &'a str,\n70\t    pub text: &'a str,\n71\t}\n72\t\n73\t/// One corpus entry: its name, the globs it is relevant to, and its why.\n74\t#[derive(Clone, Debug, PartialEq, Eq)]\n75\tpub struct Entry {\n76\t    pub name: String,\n77\t    pub paths: Vec<Glob>,\n78\t    pub text: String,\n79\t}\n80\t\n81\timpl Entry {\n82\t    /// Whether the entry is relevant to `path`.\n83\t    pub fn covers(&self, path: &RepoPath) -> bool {\n84\t        self.paths.iter().any(|g| g.matches(path))\n85\t    }\n86\t}\n87\t\n88\t/// An entry from its file. An entry with no `paths:` line is relevant\n89\t/// nowhere, so it is never given.\n90\tpub fn parse(file: File) -> Entry {\n91\t    let (head, text) = front_matter(&file);\n92\t    let line = head.lines().find_map(|l| l.trim().strip_prefix(\"paths:\"));\n93\t    let globs = line.into_iter().flat_map(|list| list.split(','));\n94\t    let globs = globs.map(|g| g.trim().trim_matches([