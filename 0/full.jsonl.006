           // A corpus entry rides ahead of what the call opens (D61).\")\nj=s.index(\"            // The hooks run first, in the VM, so the call waits on them.\",i)\ns=s[:i]+'''            // A corpus entry rides ahead of what the call opens (D61).\n            Decision::Continue if !lead.is_empty() => self.with_corpus(held(), lead),\n'''+s[j:]\na='''    /// The corpus entries relevant to the path `call` opens that this turn'''\ns=s.replace(a,'''    /// The repository's hooks on `call`, then the step's own (D50).\n    fn hooks_for(&self, job: &str, step: &str, call: &Call) -> Vec<String> {\n        let mut hooks: Vec<String> = self\n            .charter(job)\n            .iter()\n            .flat_map(|c| c.before.iter())\n            .filter(|h| h.functions.contains(&call.function.as_str()))\n            .map(|h| h.command.clone())\n            .collect();\n        let constraints = self.constraints(job);\n        let own = govern::hooks_at(&constraints, step, call);\n        hooks.extend(own.into_iter().map(String::from));\n        hooks\n    }\n\n    /// Hold a call, run it, and send the turn its result with `lead`, the\n    /// corpus it opened, ahead of it.\n    fn with_corpus(self: &Arc<Self>, held: HeldCall, lead: String) -> Value {\n        let gate = self.clone();\n        crate::rt::spawn(async move {\n            if let Err(e) = gate.run_held(&held, \"corpus\", &lead).await {\n                eprintln!(\"job {}: a call with its corpus was not settled: {e}\", held.job);\n            }\n        });\n        json!({ \"decision\": \"hold\", \"reason\": \"The region's corpus goes with it.\" })\n    }\n\n'''+a,1)\nopen('gate.rs','w').write(s)\nEOF\ncd /Users/tacoda/tacoda/bastion && cargo fmt && CARGO_INCREMENTAL=0 cargo clippy --workspace --all-targets -- -D warnings 2>&1 | grep -E \"^(error|warning)\" -A8 | head -20; CARGO_INCREMENTAL=0 cargo test --workspace 2>&1 | grep -E \"test result\" | awk '{s+=$4; f+=$6} END {print \"passed\",s,\"failed\",f}'; git add