xt = self.git(&path, &[\"show\", &format!(\"{base}:{name}\")]).ok()?;","+                let file = name.rsplit('/').next().unwrap_or(name);","+                Some(bastion_core::corpus::parse(file, &text))","+            })","+            .collect()","+    }","+","     /// A file as the job's base commit has it, so nothing the agent writes","     /// to its worktree changes the charter that binds it. An empty file says","     /// nothing, so it reads as missing."]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/gate.rs","hunks":[{"oldStart":55,"oldLines":6,"newStart":55,"newLines":8,"lines":["     audit: Result<Arc<AuditLog>, String>,","     /// Each job's charter, read from its worktree when a turn starts.","     charters: Mutex<HashMap<String, Arc<Charter>>>,","+    /// The corpus entries each turn has been given, by `job/turn` (D61).","+    given: Mutex<HashMap<String, Vec<String>>>,","     /// Each job's repository hook runs, latest last.","     hook_runs: Mutex<HashMap<String, Vec<String>>>,","     /// What each job's latest review diff broke, by constraint."]},{"oldStart":158,"oldLines":6,"newStart":160,"newLines":7,"lines":["             policy: RwLock::new(None),","             audit,","             charters: Mutex::new(HashMap::new()),","+            given: Mutex::new(HashMap::new()),","             hook_runs: Mutex::new(HashMap::new()),","             findings: Mutex::new(HashMap::new()),","             overrides: Mutex::new(HashMap::new()),"]},{"oldStart":427,"oldLines":7,"newStart":430,"newLines":24,"lines":["             arguments: envelope[\"call\"][\"arguments\"].clone(),","             at: now(),","         };","+        let lead = match (&verdict.decision, hooks.is_empty()) {","+            (Decision::Continue, true) => self.corpus_for(&job, envelope, &call),","+            _ => String::new(),","+        };","         match verdict.decision {","+            // A corpus entry rides ahead of what the call opens (D61).","+            Decision::Continue if !lead.is_empty() => {","+                let (gate, held) = (self.clone(), held());","+                crate::rt::spawn(async move {","+                    if let Err(e) = gate.run_held(&held, \"corpus\", &lead).await {","+                        eprintln!(","+                            \"job {}: a call with its corpus was not settled: {e}\",","+                            held.job","+                        );","+                    }","+                });","+                json!({ \"decision\": \"hold\", \"reason\": \"The region's corpus goes with it.\" })","+            }","             // The hooks run first, in the VM, so the call waits on them.","             Decision::Continue if !hooks.is_empty() => {","                 let (gate, held) = (self.clone(), held());"]},{"oldStart":447,"oldLines":6,"newStart":467,"newLines":30,"lines":["         }","     }"," ","+    /// The corpus entries relevant to the path `call` opens that this turn","+    /// has not been given, as the agent is told them, and now given (D61).","+    fn corpus_for(&self, job: &str, envelope: &Value, call: &Call) -> String {","+        if !call.function.starts_with(\"sandbox::fs::\") {","+            return String::new();","+        }","+        let Some(charter) = self.charter(job) else {","+            return String::new();","+        };","+        let turn = envelope[\"turn_id\"].as_str().unwrap_or_default();","+        let mut given = self.given.lock().unwrap();","+        let had = given.entry(format!(\"{job}/{turn}\")).or_default();","+        let fresh = bastion_core::corpus::relevant(&charter.corpus, &call.text, had);","+        had.extend(fresh.iter().map(|e| e.name.clone()));","+        match fresh.is_empty() {","+            true => String::new(),","+            false => format!(","+                \"The region's corpus, for {}:\\n{}\\n\\n\",","+                call.text,","+                bastion_core::corpus::told(&fresh)","+            ),","+        }","+    }","+","     /// Save a held call for the job page, off the hook's path.","     fn keep(&self, held: HeldCall) {","         let (store, on_change) = (self.store.clone(), self.on_change.clone());"]},{"oldStart":522,"oldLines":7,"newStart":566,"newLines":7,"lines":["                         self.resolve(&held, text_result(&text, Value::Null, true), \"hook-refuse\")","                             .await","                     }","-                    None => self.run_held(&held, \"hook-pass\").await,","+                    None => self.run_held(&held, \"hook-pass\", \"\").await,","                 }","             }","             Err(e) => Err(e),"]},{"oldStart":558,"oldLines":10,"newStart":602,"newLines":12,"lines":["     /// The hold dropped the VM pin, so the server pins it again here.","     pub async fn allow_once(&self, job: &str, id: &str) -> Result<(), String> {","         let held = self.take(job, id).await?;","-        self.run_held(&held, \"allow-once\").await","+        self.run_held(&held, \"allow-once\", \"\").await","     }"," ","-    async fn run_held(&self, held: &HeldCall, kind: &str) -> Result<(), String> {","+    /// Run a held call in the job's VM and send the turn its result, with","+    /// `lead` ahead of it.","+    async fn run_held(&self, held: &HeldCall, kind: &str, lead: &str) -> Result<(), String> {","         let sandbox = self","             .store","             .load(&held.job)"]},{"oldStart":576,"oldLines":7,"newStart":622,"newLines":7,"lines":["             .call_for(DEFAULT_NAMESPACE, &held.call.function, arguments, RUN_MS)","             .await;","         let result = match ran {","-            Ok(out) => text_result(&out.to_string(), out, false),","+            Ok(out) => text_result(&format!(\"{lead}{out}\"), out, false),","             Err(e) => text_result(&e, Value::Null, true),","         };","         self.resolve(held, result, kind).await"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/