is_empty() {","+            return Ok(());","+        }","+        let base = self.fork_point(record, path).await;","+        let diff = self.git(path, &[\"diff\", &base, \"HEAD\"])?;","+        let settings = self.machine.read(&path.join(crate::charter::SETTINGS)).ok();","+        let landing = lessons::Landing {","+            job: id,","+            diff: &diff,","+            settings,","+        };","+        let files = lessons::files(&queued, landing)?;","+        for (name, text) in &files {","+            let file = path.join(name);","+            if let Some(dir) = file.parent() {","+                self.machine.make_dir(dir)?;","+            }","+            self.machine.write_bytes(&file, text.as_bytes())?;","+            self.git(path, &[\"add\", \"--\", name])?;","+        }","+        let message = format!(\"What journey {id} taught: lessons and facts\");","+        self.git(path, &[\"commit\", \"-q\", \"-m\", &message])?;","+        Ok(())","+    }","+","     /// Bring the VM's commits back to the job's worktree. Returns the","     /// worktree's path and the workspace branch the change goes into.","     pub(super) async fn bring_back(&self, record: &Record) -> Result<(PathBuf, String), String> {"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/http.rs","hunks":[{"oldStart":543,"oldLines":7,"newStart":543,"newLines":7,"lines":["     Path(id): Path<String>,","     Json(b): Json<Note>,"," ) -> Response {","-    let w = api::notes::Written {","+    let w = crate::lessons::Written {","         about: b.about,","         text: b.text,","         by: person.name.clone(),"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/lessons.rs","hunks":[{"oldStart":55,"oldLines":7,"newStart":55,"newLines":10,"lines":["             _ => {}","         }","         if !ABOUT.contains(&self.about.as_str()) {","-            return Err(format!(\"{:?} is not a lesson, a fact or bastion\", self.about));","+            return Err(f