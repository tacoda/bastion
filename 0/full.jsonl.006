{"parentUuid":"ba887a13-aee7-4c8c-ba4d-d443875f0ab0","isSidechain":false,"promptId":"a78f7f74-dbbf-44e3-937d-394ac394af3b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013s5RaCQJ5z6YkHKuwjkoN6","type":"tool_result","content":"        session,\n    }\n}\n\n#[test]\nfn a_cap_that_runs_out_after_an_extend_waits_out_the_new_one() {\n    let rig = rig();\n    crate::rt::block_on(async {\n        let extended = planning(&rig, \"j1\", super::now()).await;\n        let late = planning(&rig, \"j2\", 1).await;\n        rig.factory.arm_cap(&extended, 0);\n        rig.factory.arm_cap(&late, 0);\n        eventually(async || job_of(&rig, \"j2\").await.failures > 0).await;\n        let timed_out = job_of(&rig, \"j2\").await;\n        assert!(timed_out.failures > 0, \"the late turn ran past its cap\");\n        let job = job_of(&rig, \"j1\").await;\n        assert_eq!((job.state, job.failures), (State::Running, 0));\n    });\n}\n\n#[test]\nfn a_revived_vm_with_no_new_commits_lands_what_the_worktree_holds() {\n    let empty = Err(\"exited 128: \\\"fatal: Refusing to create empty bundle.\\\\n\\\"\".into());\n    let rig = rig_on(engine().answer(\"sandbox::exec\", empty));\n    let record = Record {\n        job: Job::new(\"j1\".into(), \"w\".into(), \"r\".into(), 1),\n        runtime: Runtime {\n            worktree: Some(\"wt1\".into()),\n            sandbox: Some(\"vm1\".into()),\n            ..Runtime::default()\n        },\n        rev: 1,\n        created_at: 1,\n    };\n    crate::rt::block_on(async {\n        let (path, target) = rig.factory.bring_back(&record).await.unwrap();\n        assert_eq!((path.to_str(), target.as_str()), (Some(\"/wt\"), \"main\"));\n        assert!(!rig.engine.called(\"sandbox::fs::read\"));\n    });\n}\n\n#[test]\nfn a_turn_the_harness_lost_starts_again_on_resume() {\n    let lost = Err(\"handler error: session/not_found: session j1-build-old does not exist\".into());\n    let rig = rig_on(engine().answer(\"harness::status\", lost));\n    let mut record = record_at(\"build\", State::Running);\n    record.job.updated_at = super::now();\n    record.runtime.session = Some(\"j1-build-old\".into());\n    crate::rt::block_on(async {\n        rig.store.insert(&record).await.unwrap();\n        rig.factory.clone().resume().await;\n        let again = async || {\n            let session = rig.store.load(\"j1\").await.unwrap().runtime.session;\n            session.as_deref() != Some(\"j1-build-old\") && rig.engine.called(\"harness::send\")\n        };\n        assert!(eventually(again).await, \"the lost turn did not start again\");\n    });\n}\n54:pub(super) fn rig() -> Rig {\n55-    rig_on(engine())\n56-}\n57-\n58-pub(super) fn rig_on(engine: FakeEngine) -> Rig {\n59-    rig_with(engine, FakeMachine::new().run_ok(\"git\", \"\"))\n60-}\n61-\n62-/// A rig on `engine` and `machine`, with one workspace `w` on `/repo`.\n63-pub(super) fn rig_with(engine: FakeEngine, machine: FakeMachine) -> Rig {\n64-    let (engine, machine) = (Arc::new(engine), Arc::new(machine));\n65-    let store = Arc::new(FakeStore::default());\n66-    store.workspaces.lock().unwrap().push(workspace());\n67-    crate::rt::block_on(crate::seed_flows::seed(&*store)).unwrap();\n68-    let told = Arc::new(std::sync::Mutex::new(Vec::new()));\n69-    let keep = told.clone();\n70-    let factory = Factory::new(\n71-        engine.clone() as Arc<dyn Engine>,\n72-        store.clone() as Arc<dyn Store>,\n73-        machine.clone(),\n74-        Arc::new(move |c| keep.lock().unwrap().push(c)),","is_error":false}]},"uuid":"87e52c07-dca5-4f9d-bcc8-844dfc97fb13","timestamp":"2026-11-12T23:23:58.778Z","toolUseResult":{"stdout":"        session,\n    }\n}\n\n#[test]\nfn a_cap_that_runs_out_after_an_extend_waits_out_the_new_one() {\n    let rig = rig();\n    crate::rt::block_on(async {\n        let extended = planning(&rig, \"j1\", super::now()).await;\n        let late = planning(&rig, \"j2\", 1).await;\n        rig.factory.arm_cap(&extended, 