filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/charters.rs","hunks":[{"oldStart":6,"oldLines":7,"newStart":6,"newLines":7,"lines":[" use std::path::Path;"," "," use bastion_core::charter::editable;","-use bastion_protocol::CharterChange;","+use bastion_protocol::{CharterBranch, CharterChange};"," "," use super::factory::{FactoryCell, factory};"," use crate::factory::now;"]},{"oldStart":57,"oldLines":6,"newStart":57,"newLines":48,"lines":["     pub worktree: &'a Path,"," }"," ","+/// The charter branches under `prefix` in the repository at `root` not","+/// yet merged into `base`: each one's name, last subject and time.","+pub fn unmerged(machine: &dyn Machine, root: &Path, prefix: &str, base: &str) -> Vec<CharterBranch> {","+    let pattern = format!(\"refs/heads/{prefix}charter-*\");","+    let format = \"--format=%(refname:short)%09%(subject)%09%(committerdate:unix)\";","+    let args = [\"for-each-ref\", \"--no-merged\", base, format, &pattern];","+    let Ok(out) = machine.run(\"git\", &args, Some(root)) else {","+        return Vec::new();","+    };","+    if !out.success {","+        return Vec::new();","+    }","+    let rows = out.text.lines().filter_map(|l| {","+        let mut parts = l.splitn(3, '\\t');","+        let (branch, subject, at) = (parts.next()?, parts.next()?, parts.next()?);","+        Some(CharterBranch {","+            branch: branch.into(),","+            subject: subject.into(),","+            at: at.trim().parse().unwrap_or_default(),","+            ..CharterBranch::default()","+        })","+    });","+    rows.collect()","+}","+","+/// Every region's charter branches waiting to be merged, newest first.","+pub async fn branches(cell: &FactoryCell, machine: &dyn Machine) -> Result<Vec<CharterBranch>, String> {","+    let workspaces = factory(cell)?.store().workspaces().await?;","+    let mut all: Vec<CharterBranch> = workspaces","+        .iter()","+        .flat_map(|w| {","+            let found = unmerged(machine, Path::new(&w.path), &w.branch_prefix, &w.branch);","+            found.into_iter().map(|b| CharterBranch {","+                workspace: w.name.clone(),","+                ..b","+            })","+        })","+        .collect();","+    all.sort_by_key(|b| std::cmp::Reverse(b.at));","+    Ok(all)","+}","+"," /// Commit `text` to `path` on a new branch from the base, in a worktree"," /// removed after. A branch with no commit is deleted again."," pub fn commit(machine: &dyn Machine, at: &Edit, path: &str, text: &str) -> Result<(), String> {"]},{"oldStart":169,"oldLines":6,"newStart":211,"newLines":23,"lines":["         );","     }"," ","+    #[test]","+    fn unmerged_charter_branches_read_with_their_subject_and_time() {","+        let listed = \"bastion/charter-2\\tWhat j1 taught\\t1700000002\\nbastion/charter-1\\tEdit AGENTS.md\\t1700000001\\n\";","+        let machine = FakeMachine::new().run_ok(\"git\", listed);","+        let found = unmerged(&machine, Path::new(\"/r\"), \"bastion/\", \"main\");","+        assert!(machine.called(","+            \"git for-each-ref --no-merged main --format=%(refname:short)%09%(subject)%09%(committerdate:unix) refs/heads/bastion/charter-*\"","+        ));","+        assert_eq!(found.len(), 2);","+        assert_eq!(","+            (found[0].branch.as_str(), found[0].subject.as_str(), found[0].at),","+            (\"bastion/charter-2\", \"What j1 taught\", 1700000002)","+        );","+        let none = FakeMachine::new().run_fails(\"git\", \"not a repo\");","+        assert!(unmerged(&none, Path::new(\"/r\"), \"bastion/\", \"main\").is_empty());","+    }","+","     #[test]","     fn a_failed_commit_leaves_no_branch_behind() {","         let machine = FakeMachine::new()"]}]},{"filePath":"/Users/tacoda/tacoda/bastion/crates/bastion-server/src/http.rs","hunks":[{"oldStart":188,"oldLines":6,"newStart":188,"newLines":7,"lines":["         .route(\"/capabilities/factory\", get(factory_capabilities))","         .route(\"/charters\", get(charters))","         .route(\"/charters/edit\", post(charter_edit))","+        .route(\"/charters/branches\", get(charter_branches))","         .route(\"/audit\", get(audit))","         .route(\"/audit/export\", post(audit_export))"," }"]},{"oldStart":764,"oldLines":6,"newStart":765,"newLines":11,"lines":["     answer(api::govern::charters(&app.server.factory, &app.server.machine).await)"," }"," ","+async fn charter_branches(State(app): State<App>) -> Response {","+    let machine = app.server.machine.as_ref();","+    answer(api::charters::branches(&app.server.factory, machine).await)","+}","+"," async fn charter_edit(","     State(app): State<App>,","     Json(change): Json<bastion_protocol::CharterChange>,"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-protocol/src/api.rs","/Users/tacoda/tacoda/bastion/crates/bastion-protocol/src/lib.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/api/charters.rs","/Users/tacoda/tacoda/bastion/crates/bastion-server/src/http.rs"]}},"serverClassifierContext":{"request":"d8f09f93-0e1c-42e9-828d-df532c623b8a","context":{"git_state":{"cwd":"/Users/tacoda/tacoda/bastion","root":"/Users/tacoda/tacoda/bastion","branch":"main","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":null,"push_remote":"origin","remotes":[],"visibility_cache":[]}},"live_cwd":"/Users/tacoda/tacoda/bastion","platform":"macos"}},"sourceToolAssistantUUID":"9601f5de-f6aa-4dab-960d-51350af2c9b8","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
