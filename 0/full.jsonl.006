{"parentUuid":"318203eb-eb6f-4afc-aacc-8dd2cdad1a51","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/wear.rs","snippet":"29\t}\n30\t\n31\t/// At waypoint `key`, `workflow/step`: the journeys waiting there for a\n32\t/// person, and the journeys that ended there in the marsh.\n33\tpub fn waypoint(journeys: &[JobSummary], key: &str) -> (usize, usize) {\n34\t    let Some((workflow, step)) = key.split_once('/') else {\n35\t        return (0, 0);\n36\t    };\n37\t    let here = journeys\n38\t        .iter()\n39\t        .filter(|j| j.workflow.as_deref() == Some(workflow) && j.node.as_deref() == Some(step));\n40\t    here.fold((0, 0), |(waiting, ended), j| {\n41\t        (\n42\t            waiting + usize::from(j.state == \"needs_you\"),\n43\t            ended + usize::from(lost(&j.state)),\n44\t        )\n45\t    })\n46\t}\n47\t\n48\t/// The line under a trail's name.\n49\tpub fn line(w: Worn) -> String {\n50\t    match w.journeys {\n51\t        0 => \"no journeys yet\".into(),\n52\t        1 => format!(\n53\t            \"1 journey · {} at the summit · {} in the marsh\",\n54\t            w.summit, w.marsh\n55\t        ),\n56\t        n => format!(\n57\t            \"{n} journeys · {} at the summit · {} in the marsh\",\n58\t            w.summit, w.marsh\n59\t        ),\n60\t    }\n61\t}\n62\t\n63\t#[cfg(test)]\n64\tmod tests {\n65\t    use super::*;\n66\t\n67\t    fn journey(state: &str, at: Option<&str>) -> JobSummary {\n...\n74\t            journey(\"failed\", Some(\"build\")),\n75\t            journey(\"needs_you\", Some(\"plan\")),\n76\t            JobSummary {\n77\t                workflow: Some(\"short\".into()),\n78\t                ..journey(\"landed\", None)\n79\t            },\n80\t        ];\n81\t        let worn = trail(&all, \"bug-fix\");\n82\t        assert_eq!(\n83\t            worn,\n84\t            Worn {\n85\t                journeys: 3,\n86\t                summit: 1,\n87\t                marsh: 1\n88\t            }\n89\t        );\n90\t        assert_eq!(waypoint(&all, \"bug-fix/plan\"), (1, 0));\n91\t        assert_eq!(waypoint(&all, \"bug-fix/build\"), (0, 1));\n92\t        assert_eq!(waypoint(&all, \"short/plan\"), (0, 0));\n93\t        assert_eq!(line(worn), \"3 journeys · 1 at the summit · 1 in the marsh\");\n94\t        assert_eq!(line(Worn::default()), \"no journeys yet\");\n95\t    }\n96\t}"},"type":"attachment","uuid":"eb1787e9-71e9-418a-a925-dd08556ebf78","timestamp":"2026-11-12T23:16:06.988Z","rendered":[{"content":"<system-reminder>\nNote: /Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/wear.rs changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n29\t}\n30\t\n31\t/// At waypoint `key`, `workflow/step`: the journeys waiting there for a\n32\t/// person, and the journeys that ended there in the marsh.\n33\tpub fn waypoint(journeys: &[JobSummary], key: &str) -> (usize, usize) {\n34\t    let Some((workflow, step)) = key.split_once('/') else {\n35\t        return (0, 0);\n36\t    };\n37\t    let here = journeys\n38\t        .iter()\n39\t        .filter(|j| j.workflow.as_deref() == Some(workflow) && j.node.as_deref() == Some(step));\n40\t    here.fold((0, 0), |(waiting, ended), j| {\n41\t        (\n42\t            waiting + usize::from(j.state == \"needs_you\"),\n43\t            ended + usize::from(lost(&j.state)),\n44\t        )\n45\t    })\n46\t}\n47\t\n48\t/// The line under a trail's name.\n49\tpub fn line(w: Worn) -> String {\n50\t    match w.journeys {\n51\t        0 => \"no journeys yet\".into(),\n52\t        1 => format!(\n53\t            \"1 journey · {} at the summit · {} in the marsh\",\n54\t            w.summit, w.marsh\n55\t        ),\n56\t        n => format!(\n57\t            \"{n} journeys · {} at the summit · {} in the marsh\",\n58\t            w.summit, w.marsh\n59\t        ),\n60\t    }\n61\t}\n62\t\n63\t#[cfg(test)]\n64\tmod tests {\n65\t    use super::*;\n66\t\n67\t    fn journey(state: &str, at: Option<&str>) -> JobSummary {\n...\n74\t            journey(\"failed\", Some(\"build\")),\n75\t            journey(\"needs_you\", Some(\"plan\")),\n76\t            JobSummary {\n77\t                workflow: Some(\"short\".into()),\n78\t                ..journey(\"landed\", None)\n79\t            },\n80\t        ];\n81\t        let worn = trail(&all, \"bug-fix\");\n82\t        assert_eq!(\n83\t            worn,\n84\t            Worn {\n85\t                journeys: 3,\n86\t                summit: 1,\n87\t                marsh: 1\n88\t            }\n89\t        );\n90\t        assert_eq!(waypoint(&all, \"bug-fix/plan\"), (1, 0));\n91\t        assert_eq!(waypoint(&all, \"bug-fix/build\"), (0, 1));\n92\t        assert_eq!(waypoint(&all, \"short/plan\"), (0, 0));\n93\t        assert_eq!(line(worn), \"3 journeys · 1 at the summit · 1 in the marsh\");\n94\t        assert_eq!(line(Worn::default()), \"no journeys yet\");\n95\t    }\n96\t}\n</system-reminder>"}],"renderedRole":"system","session_id":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","userType":"external","entrypoint":"cli","cwd":"/Users/tacoda/tacoda/bastion","sessionId":"4fe51ecd-d6cc-423f-a39e-68f5e5b7e45e","version":"2.1.285","gitBranch":"main","slug":"parsed-tinkering-blum"}
