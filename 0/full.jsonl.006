angle, Renderer, Size, Task, Theme, mouse};"," "," use super::step_rules::{self, At, Rules};","-use super::{Ctx, carto, scrolled};","+use super::{Ctx, carto, scrolled, wear};"," use crate::app::Message;"," use crate::route::Route;"," use crate::theme;"]},{"oldStart":92,"oldLines":9,"newStart":92,"newLines":12,"lines":[" }"," "," /// How tall the chart is: room for every route and every town.","+/// Room along the foot of the chart for its legend.","+const LEGEND: f32 = 70.0;","+"," fn height(rules: &Rules) -> f32 {","     let rows = rules.workflows().len().max(rules.charters().len()).max(1);","-    TOP + rows as f32 * ROW + 40.0","+    TOP + rows as f32 * ROW + 40.0 + LEGEND"," }"," "," /// The landmark under `p`, if one is near enough to press."]},{"oldStart":134,"oldLines":15,"newStart":137,"newLines":21,"lines":[" struct Chart<'a> {","     rules: &'a Rules,","     picked: Option<&'a str>,","+    /// The server's recent journeys, for each trail's wear.","+    journeys: &'a [JobSummary],"," }"," "," /// A count of the rules on at a landmark, as a red seal."," fn badge(frame: &mut Frame, at: Point, n: usize) {","+    seal(frame, Point::new(at.x + 16.0, at.y - 40.0), n, theme::bad());","+}","+","+/// A count in a round seal of `color`; nothing for none.","+fn seal(frame: &mut Frame, seal: Point, n: usize, color: iced::Color) {","     if n == 0 {","         return;","     }","-    let seal = Point::new(at.x + 16.0, at.y - 40.0);","-    frame.fill(&Path::circle(seal, 9.0), theme::bad());","+    frame.fill(&Path::circle(seal, 9.0), color);","     frame.fill_text(Text {","         content: n.to_string(),","         position: seal,"]},{"oldStart":171,"oldLines":7,"newStart":180,"newLines":58,"lines":[" "," /// A workflow's route: its name, the way out through its steps, and its"," /// summit.","-fn route(frame: &mut Frame, w: &WorkflowView, row: usize, width: f32, steps: &[Point]) {","+/// A trail's wear at each waypoint: an amber seal for the journeys waiting","+/// there, a red cross with a count for those that ended there.","+fn worn(frame: &mut Frame, journeys: &[JobSummary], p: &Place) {","+    let (waiting, ended) = wear::waypoint(journeys, &p.key);","+    seal(","+        frame,","+        Point::new(p.at.x - 18.0, p.at.y - 40.0),","+        waiting,","+        theme::warn(),","+    );","+    if ended > 0 {","+        let at = Point::new(p.at.x + 24.0, p.at.y - 6.0);","+        carto::cross(frame, at, theme::bad());","+        let count = ended.to_string();","+        carto::name(frame, Point::new(at.x + 14.0, at.y - 6.0), &count, \"\");","+    }","+}","+","+/// The legend along the foot of the chart: what each mark means.","+fn legend(frame: &mut Frame, size: Size) {","+    let y = size.height - LEGEND + 30.0;","+    let mut x = SHORE + 60.0;","+    let mut item = |frame: &mut Frame, draw: &dyn Fn(&mut Frame, Point), words: &str| {","+        draw(frame, Point::new(x, y));","+        carto::name(frame, Point::new(x + 70.0, y - 12.0), words, \"\");","+        x += 190.0;","+    };","+    item(frame, &|f, at| carto::outpost(f, at), \"a region\");","+    item(","+        frame,","+        &|f, at| carto::mountain(f, at, 24.0, false),","+        \"an agent's waypoint\",","+    );","+    item(frame, &|f, at| carto::castle(f, at, false), \"a script\");","+    item(","+        frame,","+        &|f, at| seal(f, Point::new(at.x, at.y - 8.0), 3, theme::bad()),","+        \"rules on here\",","+    );","+    item(","+        frame,","+        &|f, at| seal(f, Point::new(at.x, at.y - 8.0), 2, theme::warn()),","+        \"journeys waiting\",","+    );","+    item(","+        frame,","+        &|f, at| carto::cross(f, Point::new(at.x, at.y - 8.0), theme::bad()),","+        \"ended in the marsh\",","+    );","+}","+","+fn route(frame: &mut Frame, w: &WorkflowView, row: usize, width: f32, steps: &[Point], note: &str) {","     let base = TOP + row as f32 * ROW + 60.0;","     let start = Point::new(WEST - 60.0, base + 6.0);","     let end = Point::new(width - EAST * 0.55, base - 40.0);"]},{"oldStart":197,"oldLines":12,"newStart":257,"newLines":11,"lines":["         }","     });","     frame.stroke(&path, way.with_width(2.5).with_color(theme::link_color()));","-    let steps = format!(\"{} steps\", w.nodes.len());","     carto::name(","         frame,","         Point::new(start.x + 10.0, base - 64.0),","         &w.name,","-        &steps,","+        note,","     );","     carto::mountain(frame, Point::new(end.x, end.y + 30.0), 54.0, false);","     carto::flag(frame, Point::new(end.x, end.y - 24.0), theme::bad());"]},{"oldStart":269,"oldLines":7,"newStart":328,"newLines":8,"lines":["                 .filter(|p| p.key.starts_with(&prefix))","                 .map(|p| p.at)","                 .collect();","-            route(&mut frame, w, row, size.width, &mine);","+            let note = wear::line(wear::trail(self.journeys, &w.id));","+            route(&mut frame, w, row, size.width, &mine, &note);","         }","         for p in all.into_iter().filter(|p| p.stage != \"town\") {","             let lit = Some(p.key.as_str()) == self.picked || hovered.as_deref() == Some(&p.key);"]},{"oldStart":283,"oldLines":6,"newStart":343,"newLines":7,"lines":["                 stage: &p.stage,","             };","             badge(&mut frame, p.at, step_rules::count(self.rules, &at));","+            worn(&mut frame, self.journeys, &p);","             let step = p","                 .key","                 .split_once('/')"]},{"oldStart":293,"oldLines":6,"newStart":354,"newLines":7,"lines":["         }","         let corner = Point::new(size.width - 52.0, size.height - 60.0);","         carto::compass(&mut frame, corner, 24.0);","+        legend(&mut frame, size);","         carto::border(&mut frame, size);","         vec![frame.into_geometry()]","     }"]},{"oldStart":316,"oldLines":6,"newStart":378,"newLines":8,"lines":["     rules: Rules,","     /// The server's field notes, newest first (D59).","     atlas: Vec