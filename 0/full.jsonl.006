 => rest.split_once(\"\\n---\").unwrap_or((\"\", rest)),","         None => (\"\", body),","     };","     let paths = head.lines().find_map(|l| l.trim().strip_prefix(\"paths:\"));","-    let first = text_part","-        .trim_start_matches('-')","-        .trim()","-        .lines()","-        .next()","-        .unwrap_or(\"\");","+    let rest = rest.trim_start_matches('-').trim();","+    let first = rest.lines().next().unwrap_or(\"\").to_string();","     let whence = match paths {","         Some(p) => format!(\"{name} · given on {}\", p.trim()),","         None => name.to_string(),","     };","+    (first, whence)","+}","+","+/// A charter file under `dir` as a line: its name, and for a corpus entry","+/// the paths it is given on.","+fn charter_line(path: &str, body: &str) -> Element<'static, Message> {","+    let (first, whence) = charter_words(path, body);","     column![","-        text(first.to_string()).size(13),","+        text(first).size(13),","         text(whence).size(12).color(theme::muted())","     ]","     .spacing(2)"]},{"oldStart":702,"oldLines":6,"newStart":702,"newLines":22,"lines":[" "," #[cfg(test)]"," mod tests {","+","+    #[test]","+    fn a_charter_file_reads_as_its_first_line_and_where_it_is_given() {","+        let fact = \"---\\npaths: src/**, calc.py\\n---\\nCalc stays small.\\nMore.\";","+        assert_eq!(","+            charter_words(\".agents/corpus/calc.md\", fact),","+            (","+                \"Calc stays small.\".into(),","+                \"calc · given on src/**, calc.py\".into()","+            )","+        );","+        assert_eq!(","+            charter_words(\".agents/rules/small.md\", \"Keep it small.\\n\"),","+            (\"Keep it small.\".into(), \"small\".into())","+        );","+    }","     use super::*;"," ","     #[test]"]}]}],"moreFiles":0,"changedFiles":["/Users/tacoda/tacoda/bastion/crates/bastion-desktop/src/pages/map.rs"]}},"serverClassifierContext":{"request":"c9e17d9b-83c4-4ac7-9153-dc8eda7bafff