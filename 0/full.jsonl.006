h(group(\n            format!(\"Waiting for you ({})\", waiting.len()),\n            waiting,\n            ctx,\n            true,\n        ));\n    }\n    list = list.push(group(\n        format!(\"Under way ({})\", active.len()),\n        active,\n        ctx,\n        false,\n    ));\n    let arrow = if state.show_finished { \"▾\" } else { \"▸\" };\n    let toggle = crate::lift::button(text(format!(\"{arrow} Home again ({})\", done.len())).size(13))\n        .style(theme::link)\n        .on_press(Message::Jobs(Msg::ToggleFinished));\n    list = list.push(toggle);\n    if state.show_finished {\n        list = list.push(group(\n            format!(\"Home again ({})\", done.len()),\n            done,\n            ctx,\n            false,\n        ));\n    }\n    list.into()\n}\n\npub fn view<'a>(state: &'a State, ctx: &Ctx) -> Element<'a, Message> {\n492:pub struct JobSummary {\n493-    pub id: String,\n494-    pub workspace: String,\n495-    pub request: String,\n496-    /// The kind of step the job is at: `prompt`, `agent`, `skill`,\n497-    /// `command` or `shell`.\n498-    pub stage: String,\n499-    /// The id of the step the job is at; none at the finish.\n500-    #[serde(default)]\n501-    pub node: Option<String>,\n502-    /// `queued`, `provisioning`, `running`, `needs_you`, `landed`, `failed` or `stopped`.\n503-    pub state: String,\n504-    pub question: Option<String>,\n505-    pub error: Option<String>,\n506-    pub created_at: u64,\n507-    pub updated_at: u64,\n508-    /// What the owner may do now: `approve`, `comment`, `answer`, `stop`.\n509-    pub actions: Vec<String>,\n510-    /// The tracker issue the request came from.\n511-    pub issue: Option<String>,\n512-    /// Who asked for the job (D31).\n513-    #[serde(default)]\n514-    pub requester: Option<String>,\n515-    /// The trail the journey takes, for the Map's wear (D60).\n516-    #[serde(default)]\n517-    pub workflow: Option<String>,\n518-}\n519-\n520-#[derive(Clone, Debug, PartialEq