ee: &worktree,\n108-    };\n109-    commit(machine, &at, &change.path, &change.text)?;\n110-    Ok(branch)\n111-}\n112-\n113-#[cfg(test)]\n114-mod tests {\n115-    use super::*;\n116-    use crate::machine::fake::FakeMachine;\n117-","is_error":false}]},"uuid":"7a2c7a2d-d09e-4227-9892-b168042fc7b1","timestamp":"2026-11-12T22:59:19.276Z","toolUseResult":{"stdout":"    let factory = factory(cell)?;\n    let mut notes: Vec<FieldNoteView> = factory\n        .store()\n        .entries_of(NOTE)\n        .await?\n        .iter()\n        .map(view)\n        .collect();\n    for n in &mut notes {\n        if let Ok(r) = factory.store().load(&n.job).await {\n            n.request = r.job.request;\n            n.workspace = r.job.workspace;\n            n.landed = r.job.state == State::Landed;\n        }\n    }\n    notes.sort_by_key(|n| std::cmp::Reverse(n.at));\n    Ok(notes)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn a_note_is_one_line_and_short_and_reads_back_with_its_author() {\n        assert_eq!(\n            kept(\"  the test\\n named the bug  \").unwrap(),\n            \"the test named the bug\"\n        );\n        assert!(kept(\"   \").is_err());\n        assert!(kept(&\"x\".repeat(LONGEST + 1)).is_err());\n87:pub async fn edit(\n88-    cell: &FactoryCell,\n89-    machine: &dyn Machine,\n90-    change: CharterChange,\n91-) -> Result<String, String> {\n92-    if !editable(&change.path) {\n93-        return Err(format!(\"{} is not a charter file\", change.path));\n94-    }\n95-    let workspaces = factory(cell)?.store().workspaces().await?;\n96-    let w = workspaces\n97-        .into_iter()\n98-        .find(|w| w.name == change.workspace)\n99-        .ok_or_else(|| format!(\"no workspace named {}\", change.workspace))?;\n100-    let stamp = now();\n101-    let branch = format!(\"{}charter-{stamp}\", w.branch_prefix);\n102-    let worktree = std::env::temp_dir().join(format!(\"bastion-charter-{stamp}\"));\n103-    let at = Edit {\n104- 